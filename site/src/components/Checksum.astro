---
/**
 * Checksums for people who never needed one: a fingerprint for any data,
 * what changing one character does to it (live), and what it is for.
 */
import { FileCheck, FolderSync, Layers, ShieldCheck } from 'lucide-static';
import Backdrop from './Backdrop.astro';
import Icon from './Icon.astro';
import { blake3Hex } from '../lib/blake3';

const A = 'Release notes v2.0';
const B = 'Release notes v2.1';
const da = blake3Hex(A);
const db = blake3Hex(B);
const differ = [...da].filter((ch, i) => ch !== db[i]).length;

const uses = [
  { icon: FileCheck, text: 'Prove a download arrived intact' },
  { icon: FolderSync, text: 'Spot exactly which files changed' },
  { icon: Layers, text: 'Store each file only once' },
  { icon: ShieldCheck, text: 'Name content by what it is' },
];
---

<section id="checksum" class="home-section checksum" aria-labelledby="checksum-title">
  <Backdrop name="checksum" />
  <div class="wrap grid">
    <header class="home-head copy">
      <p class="kicker" data-reveal>What is a checksum</p>
      <h2 id="checksum-title" data-reveal style="--i: 1">A fingerprint for <span class="glow">any file.</span></h2>
      <p data-reveal style="--i: 2">
        A hash function turns any data, a sentence or a 100 GB model, into a short fingerprint. Same data, same fingerprint, every time. Change one
        byte and it changes completely. turboblake computes BLAKE3 checksums in parallel so you can check downloads, compare files and identify content.
      </p>
      <ul class="uses" role="list" data-reveal style="--i: 3">
        {
          uses.map((u) => (
            <li>
              <Icon svg={u.icon} />
              {u.text}
            </li>
          ))
        }
      </ul>
    </header>

    <div class="demo tile" data-avalanche data-reveal style="--i: 2">
      <Backdrop name="tile-fingerprint" focus="85% 85%" scrim="bottom" sizes="(min-width: 62rem) 36rem, 100vw" />
      <p class="tile-kicker">Try it: edit either line</p>
      <label class="row">
        <span class="sr-only">Input A</span>
        <input value={A} data-av-in="a" aria-label="Input A" spellcheck="false" autocomplete="off" />
        <output class="hex" data-av-out="a">{da}</output>
      </label>
      <label class="row">
        <span class="sr-only">Input B</span>
        <input value={B} data-av-in="b" aria-label="Input B" spellcheck="false" autocomplete="off" />
        <output class="hex b" data-av-out="b">{db}</output>
      </label>
      <div class="meter">
        <p class="count mega"><span data-av-count>{differ}</span><span class="of">/64</span></p>
        <p class="tile-body">of the 64 hexadecimal characters differ between these fingerprints. Edit the inputs to compare them.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { blake3Hex } from '../lib/blake3';

  const root = document.querySelector<HTMLElement>('[data-avalanche]');
  if (root) {
    const ia = root.querySelector<HTMLInputElement>('[data-av-in="a"]');
    const ib = root.querySelector<HTMLInputElement>('[data-av-in="b"]');
    const oa = root.querySelector<HTMLElement>('[data-av-out="a"]');
    const ob = root.querySelector<HTMLElement>('[data-av-out="b"]');
    const count = root.querySelector<HTMLElement>('[data-av-count]');
    // Mark each hex character of B that differs from A.
    const render = () => {
      if (!ia || !ib || !oa || !ob) return;
      const a = blake3Hex(ia.value);
      const b = blake3Hex(ib.value);
      oa.textContent = a;
      ob.replaceChildren(
        ...[...b].map((ch, i) => {
          const span = document.createElement('span');
          span.textContent = ch;
          if (ch !== a[i]) span.className = 'diff';
          return span;
        }),
      );
      if (count) count.textContent = String([...a].filter((ch, i) => ch !== b[i]).length);
    };
    ia?.addEventListener('input', render);
    ib?.addEventListener('input', render);
    render();
  }
</script>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 4rem;
    }
  }

  .copy {
    margin-bottom: 0;
  }

  .uses {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .uses li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .uses :global(svg.icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--volt);
  }

  @media (max-width: 30rem) {
    .uses {
      grid-template-columns: 1fr;
    }
  }

  .demo {
    gap: 1rem;
  }

  .row {
    display: grid;
    gap: 0.5rem;
  }

  .row input {
    min-width: 0;
    min-height: 46px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--void);
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    caret-color: var(--volt);
  }

  .row input:focus-visible {
    outline: 2px solid var(--volt);
    outline-offset: 1px;
  }

  .hex {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.65rem + 0.35vw, 0.875rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .hex.b {
    color: var(--ink-3);
  }

  .hex :global(.diff) {
    color: var(--volt);
    text-shadow: 0 0 12px rgb(212 255 58 / 0.45);
  }

  .meter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .count {
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    color: var(--volt);
  }

  .of {
    color: var(--ink-3);
    font-size: 0.4em;
    letter-spacing: -0.02em;
  }
</style>
