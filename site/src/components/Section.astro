---
interface Props {
  id: string;
  title: string;
  kicker?: string;
  /** Position in the race, shown as "Lap 01" before the kicker. */
  lap?: number;
  tone?: 'plain' | 'alt';
}

const { id, title, kicker, lap, tone = 'plain' } = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section-head">
      {
        (kicker || lap !== undefined) && (
          <p class="kicker" data-reveal>
            {lap !== undefined && <span class="lap">Lap {String(lap).padStart(2, '0')}</span>}
            {kicker}
          </p>
        )
      }
      <h2 id={`${id}-title`} data-reveal style="--i: 1">{title}</h2>
      <div class="lede prose" data-reveal style="--i: 2">
        <slot name="lede" />
      </div>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: clamp(4rem, 2.5rem + 5vw, 7.5rem);
  }

  /* A hairline of heat across the top of every section. */
  .section::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(70 227 255 / 0.35) 30%, rgb(212 255 58 / 0.45) 70%, transparent);
    opacity: 0.6;
  }

  .tone-alt {
    background: var(--surface);
  }

  .section-head {
    display: grid;
    gap: 1.1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .lap {
    color: var(--volt);
  }

  .lede:empty {
    display: none;
  }

  .lede {
    font-size: 1.0625rem;
  }
</style>
