---
import BrandMark from './BrandMark.astro';
import type { MarkName } from '../lib/brands';

interface Props {
  id: string;
  title: string;
  kicker?: string;
  /** A mark before the kicker, such as the vendor of the machine a section measured. */
  mark?: MarkName | undefined;
  tone?: 'plain' | 'alt';
}

const { id, title, kicker, mark, tone = 'plain' } = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="section-head">
      {kicker && (
        <p class="kicker" data-reveal>
          {mark && <BrandMark name={mark} class="kicker-mark" />}
          {kicker}
        </p>
      )}
      <h2 id={`${id}-title`} data-reveal style="--i: 1">{title}</h2>
      <div class="lede prose" data-reveal style="--i: 2">
        <slot name="lede" />
      </div>
    </header>
    <slot />
  </div>
</section>

<style>
  .section-head :global(.kicker-mark) {
    margin-right: 0.5em;
  }

  .section {
    position: relative;
    padding-block: clamp(4rem, 2.5rem + 4vw, 6.5rem);
  }

  .section {
    border-top: 1px solid var(--line);
  }

  .tone-alt {
    background: var(--surface);
  }

  .section-head {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 2.75rem);
  }

  .section-head h2 {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.375rem);
  }

  .lede:empty {
    display: none;
  }

  .lede {
    font-size: 1.0625rem;
  }
</style>
