---
/**
 * From SHA-256 to the GPU: one gigabyte on the fastest GPU measured and on the
 * Mac, every way of hashing it side by side, to scale. The home page shows it as
 * a section; the benchmarks page passes `bare` and gives it its own heading.
 * Numbers come from src/lib/versus.ts.
 */
import { Laptop } from 'lucide-static';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { fmtTimes, versus } from '../lib/versus';
import { story } from '../lib/news';
import { withBase } from '../lib/site';

interface Props {
  /** Panels and footnote only, without the section and its heading. */
  bare?: boolean;
}

const { bare = false } = Astro.props;
const lead = versus?.lead;
const input = versus?.input ?? '';
const kernels = story('0013');
---

{
  versus && lead && (
    <section id={bare ? undefined : 'versus'} class:list={['versus', { 'home-section': !bare }]} aria-labelledby={bare ? undefined : 'versus-title'}>
      <div class:list={{ wrap: !bare }}>
        {!bare && (
          <header class="home-head">
            <p class="kicker" data-reveal>
              SHA-256 · BLAKE3 · turboblake
            </p>
            <h2 id="versus-title" data-reveal style="--i: 1">
              {fmtTimes(lead.fastest.timesSha)} faster <span class="glow">than SHA-256.</span>
            </h2>
            <p data-reveal style="--i: 2">
              One gigabyte. On an {lead.title}, SHA-256 takes {lead.sha.ms} ms: each block waits for the one before, so it runs on one core however many the
              machine has. BLAKE3 is a tree, so it can use every core. turboblake runs that tree on the GPU too, and finishes in {lead.fastest.ms} ms.
            </p>
          </header>
        )}

        <div class="machines">
          {versus.machines.map((m, i) => (
            <article class:list={['tile', 'machine', `m-${m.id}`]} data-reveal style={`--i: ${i}`}>
              <div class="m-head">
                <p class="tile-kicker">
                  {m.api === 'CUDA' ? <BrandMark name="nvidia" tone="brand" /> : <Icon svg={Laptop} />} {m.title} · {m.api}
                </p>
                <p class="m-where">{m.where}</p>
              </div>
              <p class="mega m-num">
                {m.fastest.gbps}
                <span class="unit">GB/s</span>
              </p>
              <p class="tile-body">
                {input} in {m.fastest.ms} ms, {fmtTimes(m.fastest.timesSha)} SHA-256
                {m.blake3 && <> and {fmtTimes(m.fastest.timesSha / m.blake3.timesSha)} the official BLAKE3 on one core</>}.
              </p>
              <p class="cols" aria-hidden="true">
                <span>GB/s, to scale</span>
                <span>× SHA-256</span>
              </p>
              <ol class="bars" role="list">
                {m.bars.map((b, j) => (
                  <li class:list={['bar', `k-${b.kind}`, `s-${b.key}`, { best: b.best }]} style={`--p: ${b.share.toFixed(5)}; --j: ${j}`}>
                    <span class="label">
                      <span class="name">
                        {b.kind === 'bend' && <BrandMark name="merge" />}
                        {b.label}
                      </span>
                      <span class="detail">{b.detail}</span>
                    </span>
                    <span class="times num">{b.key === 'sha256' ? '1×' : fmtTimes(b.timesSha)}</span>
                    <span class="track" aria-hidden="true">
                      <span class="fill" />
                    </span>
                    <span class="rate num">
                      {b.ms} ms · {b.gbps} GB/s
                    </span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>

        <p class="footnote" data-reveal>
          {!bare && (
            <>
              {versus.input} already in memory, hashed once per run, medians; every BLAKE3 gives the same digest.
              {versus.machines.some((m) => m.gpuMemory) && <> On the {versus.machines.find((m) => m.gpuMemory)?.title} the GPU reads it from its own memory.</>}{' '}
            </>
          )}
          The native kernels are hand-written CUDA and Metal in the repository; the command line and the library run Bend's tree on the CPU today and take
          the GPU <a href={kernels?.href}>next</a>.{' '}
          {bare ? (
            <>
              Each GPU at every size is on <a href={withBase('gpu/')}>the GPU page</a>.
            </>
          ) : (
            <>
              Every number, and how it was measured, is on <a href={withBase('benchmarks/#versus')}>the benchmarks page</a>.
            </>
          )}
        </p>
      </div>
    </section>
  )
}

<style>
  .versus.home-section {
    background:
      radial-gradient(46rem 28rem at 85% 10%, rgb(70 227 255 / 0.06), transparent 70%),
      radial-gradient(40rem 26rem at 10% 90%, rgb(212 255 58 / 0.04), transparent 70%);
  }

  .machines {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 61.99rem) {
    .machines {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .machine {
    gap: 1rem;
  }

  .m-b200 {
    background:
      radial-gradient(70% 60% at 100% 0%, rgb(118 185 0 / 0.08), transparent 70%),
      var(--surface);
  }

  .m-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .m-where {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .m-num {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: clamp(3.25rem, 2rem + 3.5vw, 5rem);
    background: linear-gradient(90deg, var(--ion), var(--volt));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .unit {
    font-size: 0.32em;
    letter-spacing: -0.02em;
    color: var(--ink-3);
    -webkit-text-fill-color: var(--ink-3);
  }

  .cols {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .bars {
    display: grid;
    gap: 0.95rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.3rem 1rem;
  }

  .label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    min-width: 0;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 550;
  }

  .name :global(.brandmark) {
    width: 1rem;
    height: 1rem;
    color: var(--volt);
  }

  .k-bend .name {
    color: var(--ink);
  }

  .detail {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .times {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    text-align: right;
  }

  .k-bend .times {
    color: var(--ink);
  }

  .best .times {
    color: var(--volt);
    font-weight: 600;
  }

  .track {
    height: 8px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow: hidden;
  }

  .fill {
    display: block;
    width: max(3px, calc(var(--p) * 100%));
    height: 100%;
    border-radius: inherit;
    background: var(--s-base-2);
  }

  .s-blake3_all .fill,
  .s-blake3 .fill {
    background: var(--s-base-1);
  }

  .s-bend_cpu .fill {
    background: var(--volt);
  }

  .s-bend_gpu .fill {
    background: var(--ion);
  }

  .s-bend_native .fill {
    background: var(--heat);
    box-shadow: 0 0 16px rgb(212 255 58 / 0.45);
  }

  .rate {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: right;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fill {
      transition: width 1.4s var(--ease-out) calc(0.3s + var(--j) * 0.09s);
    }

    :global(.js) .machine:not(:global(.in)) .fill {
      width: 3px;
    }
  }

  .footnote {
    max-width: var(--measure);
    margin-top: 1.5rem;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .footnote a {
    color: var(--ink-2);
  }

  /* Phones: each bar gets the full width, its time and rate under it. */
  @media (max-width: 39.99rem) {
    .track,
    .rate {
      grid-column: 1 / -1;
    }

    .rate {
      font-size: 0.6875rem;
      text-align: left;
    }
  }
</style>
