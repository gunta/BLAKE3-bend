---
/**
 * A photographic background slot, filled from the preencoded exports listed in
 * backgrounds/manifest.json (AVIF, JPEG XL and WebP at 960 to 3840 px, made by
 * scripts/optimize-backgrounds.py from backgrounds/originals). A slot with no
 * exports renders nothing. The prompts for every slot are in BACKGROUNDS.md.
 *
 * `focus` is the object-position (keep the subject clear of the copy), and
 * `focusNarrow` the one for phones, where cover-cropping keeps a thin slice; `scrim`
 * darkens toward the page so text stays legible over any photo; `sizes` is the
 * rendered width of the photo after cover-cropping, so the browser picks the
 * right file. The default is a section band (at least 64rem wide) at two thirds
 * of its width: under that scrim the extra pixels do not show, and a phone at
 * 3x loads 2400 px instead of 3840.
 */
import { backdrop } from '../lib/backdrops';

interface Props {
  name: string;
  focus?: string;
  focusNarrow?: string;
  scrim?: 'none' | 'left' | 'bottom' | 'center' | 'edges';
  sizes?: string;
  /** Eager for the hero, lazy everywhere else. */
  priority?: boolean;
}

const { name, focus = '50% 50%', focusNarrow = focus, scrim = 'edges', sizes = '(max-width: 64rem) 43rem, 67vw', priority = false } = Astro.props;

const picture = backdrop(name);
---

{
  picture && (
    <div class:list={['backdrop', `scrim-${scrim}`]} data-motion={name} style={`--focus: ${focus}; --focus-narrow: ${focusNarrow}`} aria-hidden="true">
      <picture>
        {picture.sources.map((source) => (
          <source type={source.type} srcset={source.srcset} sizes={sizes} />
        ))}
        <img
          {...picture.fallback}
          sizes={sizes}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      </picture>
    </div>
  )
}

<script>
  // The motion (src/gl/living.ts) loads only where it can run: WebGPU, and no
  // request for reduced motion. Everywhere else the photo stays a still.
  if ('gpu' in navigator && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    void import('../gl/living').then((m) => m.startLiving());
  }
</script>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .backdrop picture {
    display: contents;
  }

  .backdrop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }

  @media (max-width: 48rem) {
    .backdrop img {
      object-position: var(--focus-narrow);
    }
  }

  /* A section is far taller than 16:9: the photo takes a 16:9 band at its top
     (never under 36rem) and fades into the page, instead of being blown up to cover it. */
  .scrim-edges {
    bottom: auto;
    height: min(100%, max(56.25vw, 36rem));
  }

  /* The living canvas covers the still once its first frame is up. */
  .backdrop :global(canvas.living) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }

  .backdrop:global(.is-live) :global(canvas.living) {
    opacity: 1;
  }

  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The hero: dark under the copy column (about 55% of the width), clear where the subject is. */
  .scrim-left::after {
    background:
      linear-gradient(90deg, rgb(6 6 8 / 0.94) 0%, rgb(6 6 8 / 0.82) 42%, rgb(6 6 8 / 0.4) 60%, rgb(6 6 8 / 0) 78%),
      linear-gradient(180deg, rgb(6 6 8 / 0) 75%, var(--void) 100%);
  }

  /* Tiles: the photo shows at the top, and the text and charts below sit on near-black. */
  .scrim-bottom::after {
    background: linear-gradient(180deg, rgb(6 6 8 / 0.5) 0%, rgb(6 6 8 / 0.72) 45%, rgb(6 6 8 / 0.94) 100%);
  }

  .scrim-center::after {
    background: radial-gradient(65% 60% at 50% 50%, rgb(6 6 8 / 0.82), rgb(6 6 8 / 0.45) 100%);
  }

  /* Sections: a dark pool behind the left-aligned heading, and fades into the page at both ends. */
  .scrim-edges::after {
    background:
      radial-gradient(60rem 26rem at 22% 15rem, rgb(6 6 8 / 0.82), rgb(6 6 8 / 0) 100%),
      linear-gradient(180deg, var(--void) 0%, rgb(6 6 8 / 0.5) 14%, rgb(6 6 8 / 0.5) 86%, var(--void) 100%);
  }

  /* Tall screens (Hero.astro drops the copy below a band under the header): the
     photo fills that band and fades out under the first lines of copy. */
  /* Phones: the copy spans the width, so the pool would black out the whole band; the
     lead's text-shadow halo keeps it legible with a lighter scrim. */
  @media (max-width: 48rem) {
    .scrim-edges::after {
      background: linear-gradient(180deg, var(--void) 0%, rgb(6 6 8 / 0.66) 18%, rgb(6 6 8 / 0.66) 82%, var(--void) 100%);
    }
  }

  @media (max-aspect-ratio: 23/20) {
    .scrim-left {
      bottom: auto;
      height: calc(var(--header-h) + 40svh);
    }
    .scrim-left::after {
      background: linear-gradient(180deg, rgb(6 6 8 / 0.35) 0%, rgb(6 6 8 / 0) 25%, rgb(6 6 8 / 0) 55%, var(--void) 100%);
    }
  }
</style>
