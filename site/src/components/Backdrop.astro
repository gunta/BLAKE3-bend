---
/**
 * A photographic background slot. Drop `src/assets/bg/<name>.{png,jpg,webp,avif}`
 * in and it fills the nearest positioned parent, cover-cropped behind the
 * content, as AVIF and WebP at full width; with no file it renders nothing.
 * The prompts for every slot are in site/BACKGROUNDS.md.
 *
 * `focus` is the object-position (keep the subject clear of the copy); `scrim`
 * darkens toward the page so text stays legible over any photo.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  focus?: string;
  scrim?: 'none' | 'left' | 'bottom' | 'center' | 'edges';
  /** Eager for the hero, lazy everywhere else. */
  priority?: boolean;
}

const { name, focus = '50% 50%', scrim = 'edges', priority = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/bg/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const hit = Object.entries(files).find(([path]) => path.replace(/^.*\/|\.[^.]+$/g, '') === name);
const image = hit?.[1].default;
---

{
  image && (
    <div class:list={['backdrop', `scrim-${scrim}`]} aria-hidden="true">
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={[960, 1600, 2400, 3200].filter((w) => w <= image.width)}
        sizes="100vw"
        quality={90}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        style={`object-position: ${focus}`}
      />
    </div>
  )
}

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .scrim-left::after {
    background:
      linear-gradient(90deg, rgb(6 6 8 / 0.92) 0%, rgb(6 6 8 / 0.6) 40%, rgb(6 6 8 / 0) 65%),
      linear-gradient(180deg, rgb(6 6 8 / 0) 75%, var(--void) 100%);
  }

  .scrim-bottom::after {
    background: linear-gradient(180deg, rgb(6 6 8 / 0.2) 0%, rgb(6 6 8 / 0.85) 100%);
  }

  .scrim-center::after {
    background: radial-gradient(60% 55% at 50% 50%, rgb(6 6 8 / 0.75), rgb(6 6 8 / 0.35) 100%);
  }

  .scrim-edges::after {
    background: linear-gradient(180deg, var(--void) 0%, rgb(6 6 8 / 0.55) 18%, rgb(6 6 8 / 0.55) 82%, var(--void) 100%);
  }

  @media (max-aspect-ratio: 23/20) {
    .scrim-left::after {
      background: linear-gradient(180deg, rgb(6 6 8 / 0.1) 0%, rgb(6 6 8 / 0.85) 50%, var(--void) 100%);
    }
  }
</style>
