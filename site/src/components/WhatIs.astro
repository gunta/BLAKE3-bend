---
/**
 * BLAKE3 for people who have never thought about hashing: a fingerprint for
 * any data, what changing one character does to it (live, in the page), and
 * what fingerprints are for.
 */
import { FileCheck, FolderSync, Layers, ShieldCheck } from 'lucide-static';
import Icon from './Icon.astro';
import { blake3Hex } from '../lib/blake3';

const A = 'Release notes v2.0';
const B = 'Release notes v2.1';
const da = blake3Hex(A);
const db = blake3Hex(B);
const differ = [...da].filter((ch, i) => ch !== db[i]).length;

const uses = [
  { icon: FileCheck, title: 'Check a download', body: 'Compare the fingerprint of what arrived with the one the publisher posted. Equal means intact, byte for byte.' },
  { icon: FolderSync, title: 'Spot what changed', body: 'Fingerprint a folder today and tomorrow: only the files whose fingerprints moved need copying, testing or rebuilding.' },
  { icon: Layers, title: 'Store things once', body: 'Two files with the same fingerprint are the same file. Deduplicating backups, caches and blob stores starts here.' },
  { icon: ShieldCheck, title: 'Name content by what it is', body: 'Content-addressed systems (git, iroh, build caches) use the fingerprint as the address, so nothing can be swapped underneath.' },
];
---

<section id="blake3" class="what" aria-labelledby="what-title">
  <div class="wrap">
    <header class="head">
      <p class="kicker" data-reveal>What is BLAKE3</p>
      <h2 id="what-title" data-reveal style="--i: 1">A fingerprint for any file.</h2>
      <p class="lede prose" data-reveal style="--i: 2">
        A hash function turns any amount of data, a sentence or a 100 GB model, into a short fixed-size fingerprint: 32 bytes, written as 64 hex
        characters. The same data always gives the same fingerprint, and no one has found a way to make two different files share one. BLAKE3,
        released in 2020 by cryptographers behind BLAKE2, is the modern choice: faster than MD5 and SHA-256, and secure where MD5 and SHA-1 are
        broken.
      </p>
    </header>

    <div class="avalanche card" data-avalanche data-reveal style="--i: 3">
      <p class="av-title">Change one character, and the whole fingerprint changes.</p>
      <div class="av-rows">
        <label class="av-row">
          <span class="av-label">Input A</span>
          <input value={A} data-av-in="a" spellcheck="false" autocomplete="off" />
          <output class="av-hex" data-av-out="a">{da}</output>
        </label>
        <label class="av-row">
          <span class="av-label">Input B</span>
          <input value={B} data-av-in="b" spellcheck="false" autocomplete="off" />
          <output class="av-hex" data-av-out="b">{db}</output>
        </label>
      </div>
      <p class="av-count" aria-live="polite"><strong data-av-count>{differ}</strong> of 64 characters differ. Edit either line.</p>
    </div>

    <ul class="uses" role="list">
      {
        uses.map((u, i) => (
          <li class="use card" data-reveal style={`--i: ${i}`}>
            <Icon svg={u.icon} class="use-icon" />
            <h3>{u.title}</h3>
            <p>{u.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { blake3Hex } from '../lib/blake3';

  const root = document.querySelector<HTMLElement>('[data-avalanche]');
  if (root) {
    const inputs = { a: root.querySelector<HTMLInputElement>('[data-av-in="a"]'), b: root.querySelector<HTMLInputElement>('[data-av-in="b"]') };
    const outs = { a: root.querySelector<HTMLElement>('[data-av-out="a"]'), b: root.querySelector<HTMLElement>('[data-av-out="b"]') };
    const count = root.querySelector<HTMLElement>('[data-av-count]');

    // Mark each hex character of B that differs from A.
    const render = () => {
      if (!inputs.a || !inputs.b || !outs.a || !outs.b) return;
      const a = blake3Hex(inputs.a.value);
      const b = blake3Hex(inputs.b.value);
      outs.a.textContent = a;
      outs.b.replaceChildren(
        ...[...b].map((ch, i) => {
          const span = document.createElement('span');
          span.textContent = ch;
          if (ch !== a[i]) span.className = 'diff';
          return span;
        }),
      );
      if (count) count.textContent = String([...a].filter((ch, i) => ch !== b[i]).length);
    };
    inputs.a?.addEventListener('input', render);
    inputs.b?.addEventListener('input', render);
    render();
  }
</script>

<style>
  .what {
    padding-block: clamp(5rem, 3rem + 6vw, 8rem);
  }

  .head {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .lede {
    font-size: 1.0625rem;
  }

  .avalanche {
    display: grid;
    gap: 1rem;
    padding: clamp(1.1rem, 0.8rem + 1vw, 1.6rem);
    margin-bottom: 1rem;
  }

  .av-title {
    font-weight: 600;
  }

  .av-rows {
    display: grid;
    gap: 0.75rem;
  }

  .av-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 14rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .av-label {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .av-row input {
    min-width: 0;
    min-height: 40px;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--void);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
  }

  .av-row input:focus-visible {
    outline: 2px solid var(--volt);
    outline-offset: 1px;
  }

  .av-hex {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .av-hex :global(.diff) {
    color: var(--volt);
  }

  .av-count {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .av-count strong {
    color: var(--volt);
  }

  @media (max-width: 47.99rem) {
    .av-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }
    .av-hex {
      grid-column: 1 / -1;
    }
  }

  .uses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .use {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .use :global(.use-icon) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--ink);
  }

  .use p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
</style>
