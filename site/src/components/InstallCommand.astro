---
/**
 * The install line for this visitor, with a copy button: Homebrew on Apple
 * devices, Cargo everywhere else. Both are in the HTML; Base.astro marks Apple
 * devices with .apple before first paint, so the line never flips. Without
 * JavaScript, Cargo shows.
 */
import { Copy } from 'lucide-static';
import Icon from './Icon.astro';
import { INSTALLS } from '../lib/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['install', className]} data-install>
  {
    INSTALLS.map((i) => (
      <p class:list={['channel', i.apple ? 'on-apple' : 'off-apple']}>
        <span class="via">{i.label}</span> {i.note}
      </p>
    ))
  }
  <div class="line">
    <code>
      <span class="prompt" aria-hidden="true">$</span>{' '}
      {
        INSTALLS.map((i) => (
          <span class:list={['cmd', i.apple ? 'on-apple' : 'off-apple']} data-command>
            {i.command}
          </span>
        ))
      }
    </code>
    <button class="copy" type="button" data-install-copy>
      <Icon svg={Copy} class="copy-icon" />
      <span class="copy-label" data-label>Copy</span><span class="sr-only"> the install command</span>
    </button>
  </div>
</div>

<script>
  const shown = document.documentElement.classList.contains('apple') ? '.on-apple' : '.off-apple';

  for (const root of document.querySelectorAll<HTMLElement>('[data-install]')) {
    root.addEventListener('click', async (e) => {
      const copy = (e.target as Element).closest<HTMLButtonElement>('[data-install-copy]');
      if (!copy) return;
      const label = copy.querySelector<HTMLElement>('[data-label]');
      const text = root.querySelector<HTMLElement>(`[data-command]${shown}`)?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        if (label) label.textContent = 'Copied';
        copy.classList.add('done');
      } catch {
        if (label) label.textContent = 'Select it';
      }
      setTimeout(() => {
        if (label) label.textContent = 'Copy';
        copy.classList.remove('done');
      }, 1500);
    });
  }
</script>

<style>
  .install {
    display: grid;
    gap: 0.4rem;
    width: fit-content;
    max-width: 100%;
  }

  /* One channel per visitor: Homebrew on Apple devices (Base.astro adds .apple), Cargo elsewhere. */
  :global(.apple) .off-apple,
  :global(html:not(.apple)) .on-apple {
    display: none;
  }

  .channel {
    margin: 0;
    padding-left: 0.2rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-stretch: 90%;
    letter-spacing: 0.06em;
  }

  .via {
    color: var(--volt);
    text-transform: uppercase;
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.35rem 0.4rem 0.35rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: rgb(6 6 8 / 0.7);
  }

  code {
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .prompt {
    color: var(--volt);
  }

  .copy {
    flex: none;
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--surface-3);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-stretch: 90%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .copy:global(.done) {
    background: var(--volt);
    border-color: var(--volt);
    color: var(--volt-ink);
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .copy :global(.copy-icon) {
    display: none;
  }

  /* Narrow screens: smaller type and an icon button, so the whole command fits. */
  @media (max-width: 30rem) {
    code {
      font-size: 0.8125rem;
    }
    .line {
      padding-left: 0.75rem;
      gap: 0.5rem;
    }
    .copy {
      padding: 0.3rem 0.5rem;
    }
    .copy :global(.copy-icon) {
      display: inline-block;
      width: 1rem;
      height: 1rem;
    }
    .copy-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
