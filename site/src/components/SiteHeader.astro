---
import { REPO_URL, SITE_TITLE, withBase } from '../lib/site';

interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase()}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="1" y="1" width="30" height="30" rx="8" class="mark-bg"></rect>
        <rect x="7" y="8.5" width="18" height="4" rx="2" class="mark-fg"></rect>
        <rect x="7" y="14" width="12" height="4" rx="2" class="mark-fg"></rect>
        <rect x="7" y="19.5" width="6.5" height="4" rx="2" class="mark-dot"></rect>
      </svg>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="Sections">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li>
          <a class="gh" href={REPO_URL}>GitHub</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: color-mix(in srgb, var(--page) 88%, transparent);
    border-bottom: 1px solid var(--line);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      backdrop-filter: saturate(1.4) blur(10px);
      -webkit-backdrop-filter: saturate(1.4) blur(10px);
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 0.5rem;
  }

  .brand {
    flex: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark {
    width: 1.75rem;
    height: 1.75rem;
  }

  .mark-bg {
    fill: var(--ink);
  }

  .mark-fg {
    fill: var(--page);
  }

  .mark-dot {
    fill: var(--s-gpu);
  }

  nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  nav ul {
    display: flex;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
  }

  nav ul::-webkit-scrollbar {
    display: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .gh {
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    :global(:root) {
      --header-h: 61px;
    }

    .site-header {
      position: sticky;
      top: 0;
    }

    .bar {
      flex-wrap: nowrap;
    }

    nav ul {
      justify-content: flex-end;
      mask-image: none;
    }
  }
</style>
