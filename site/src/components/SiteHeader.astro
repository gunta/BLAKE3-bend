---
import Logo from './Logo.astro';
import BrandMark from './BrandMark.astro';
import { REPO_URL, withBase } from '../lib/site';

interface Props {
  /** In-page sections; without them the header shows the site's pages. */
  links?: { href: string; label: string }[];
}

const SITE_NAV = [
  { href: withBase('#why'), label: 'Why BLAKE3' },
  { href: withBase('#how'), label: 'How it works' },
  { href: withBase('install/'), label: 'Install' },
  { href: withBase('languages/'), label: 'Languages' },
  { href: withBase('gpu/'), label: 'GPU' },
  { href: withBase('benchmarks/'), label: 'Benchmarks' },
  { href: withBase('changelog/'), label: 'Changelog' },
];

const { links = SITE_NAV } = Astro.props;
const here = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={withBase()} aria-label="turboblake: home">
      <Logo wordmark tagline />
    </a>
    <nav class="desktop-nav" aria-label="Sections">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="mobile-menu" data-mobile-menu>
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul role="list">
          {links.map((l) => (
            <li><a href={l.href} aria-current={l.href === here ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
    <a class="gh" href={REPO_URL}>
      <BrandMark name="github" />
      <span>GitHub</span>
    </a>
  </div>
</header>

<script>
  // Transparent over the hero, solid once the page moves.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
    const menu = header.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
    menu?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu?.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
  }

  .site-header:global(.solid) {
    background: rgb(6 6 8 / 0.78);
    border-bottom-color: var(--line);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header:global(.solid) {
      background: rgb(6 6 8 / 0.6);
      backdrop-filter: saturate(1.5) blur(14px);
      -webkit-backdrop-filter: saturate(1.5) blur(14px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 4rem;
  }

  .brand {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1rem;
    text-decoration: none;
  }

  /* The tagline only where there is room for it next to the nav. */
  .brand :global(.tagline) {
    display: none;
  }

  @media (min-width: 30rem) and (max-width: 69.99rem), (min-width: 86rem) {
    .brand :global(.tagline) {
      display: inline;
    }
  }

  .brand :global(.mark) {
    transition: transform var(--t-med) var(--ease-out);
  }

  .brand:hover :global(.mark) {
    transform: translateX(3px);
  }

  .desktop-nav {
    flex: 1 1 auto;
    min-width: 0;
    display: none;
  }

  nav ul {
    display: flex;
    justify-content: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 450;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.05);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
  }

  .gh {
    margin-left: 0;
    flex: none;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .gh:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .gh :global(.brandmark) {
    font-size: 1rem;
  }

  .mobile-menu {
    margin-left: auto;
  }

  .mobile-menu summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: pointer;
    font-size: 0.875rem;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-menu nav {
    position: absolute;
    inset: calc(100% + 0.5rem) var(--gutter) auto;
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.5);
  }

  .mobile-menu ul { display: grid; }
  .mobile-menu a { width: 100%; min-height: 44px; }

  @media (min-width: 70rem) {
    .desktop-nav {
      display: block;
    }
    .mobile-menu { display: none; }
    .gh {
      margin-left: 0;
    }
  }

  @media (max-width: 26rem) {
    .brand {
      font-size: 0.875rem;
    }
    .gh span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
