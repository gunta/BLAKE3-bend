---
import Logo from './Logo.astro';
import BrandMark from './BrandMark.astro';
import { REPO_URL, withBase } from '../lib/site';

interface Props {
  links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={withBase()} aria-label="turboblake: home">
      <Logo wordmark tagline />
    </a>
    <nav aria-label="Sections">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="gh" href={REPO_URL}>
      <BrandMark name="github" />
      <span>GitHub</span>
    </a>
  </div>
</header>

<script>
  // Transparent over the hero, solid once the page moves.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
  }

  .site-header:global(.solid) {
    background: rgb(6 6 8 / 0.78);
    border-bottom-color: var(--line);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header:global(.solid) {
      background: rgb(6 6 8 / 0.6);
      backdrop-filter: saturate(1.5) blur(14px);
      -webkit-backdrop-filter: saturate(1.5) blur(14px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 4rem;
  }

  .brand {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1rem;
    text-decoration: none;
  }

  /* The tagline only where there is room for it next to the nav. */
  .brand :global(.tagline) {
    display: none;
  }

  @media (min-width: 30rem) and (max-width: 69.99rem), (min-width: 86rem) {
    .brand :global(.tagline) {
      display: inline;
    }
  }

  .brand :global(.mark) {
    transition: transform var(--t-med) var(--ease-out);
  }

  .brand:hover :global(.mark) {
    transform: translateX(3px);
  }

  nav {
    flex: 1 1 auto;
    min-width: 0;
    display: none;
  }

  nav ul {
    display: flex;
    justify-content: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 450;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.05);
  }

  .gh {
    margin-left: auto;
    flex: none;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .gh:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .gh :global(.brandmark) {
    font-size: 1rem;
  }

  @media (min-width: 70rem) {
    nav {
      display: block;
    }
    .gh {
      margin-left: 0;
    }
  }

  @media (max-width: 26rem) {
    .brand {
      font-size: 0.875rem;
    }
    .gh span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
