---
/** Wins, ties and losses for each Bend series against a baseline, counted from the data. */
import type { Tally, Verdict } from '../lib/model';
import { VERDICT } from '../lib/model';
import { fmtRange } from '../lib/format';

interface Props {
  tallies: Tally[];
}

const { tallies } = Astro.props;
const order: Verdict[] = ['faster', 'tie', 'slower'];
const nouns: Record<Verdict, [string, string]> = {
  faster: ['faster', 'faster'],
  tie: ['tie', 'ties'],
  slower: ['slower', 'slower'],
};
---

{
  tallies.length > 0 && (
    <ul class="scorecard" role="list">
      {tallies.map((t) => (
        <li class="card">
          <p class="who">
            <strong>{t.bend.label}</strong> <span class="vs">vs {t.against}</span>
          </p>
          <p class="counts">
            {order.map((v) => {
              const n = t[v].length;
              return (
                <span class:list={['count', `v-${v}`, { zero: n === 0 }]}>
                  <span class="icon" aria-hidden="true">
                    {VERDICT[v].icon}
                  </span>
                  <span class="n">{n}</span> {nouns[v][n === 1 ? 0 : 1]}
                </span>
              );
            })}
            <span class="of">of {t.all.length}</span>
          </p>
          <p class="range">
            Speedup {fmtRange(t.min, t.max)}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .scorecard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.6rem;
  }

  .who {
    font-size: 0.9375rem;
  }

  .vs {
    color: var(--ink-2);
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    font-size: 0.9375rem;
  }

  .count {
    white-space: nowrap;
  }

  .count .n {
    font-family: var(--font-display);
    font-weight: 820;
    font-stretch: 125%;
    font-style: italic;
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .count.v-faster:not(.zero) .n {
    color: var(--volt);
  }

  .count .icon {
    font-size: 0.7em;
    margin-right: 0.2rem;
  }

  .count.v-faster .icon {
    color: var(--good);
  }

  .count.v-slower .icon {
    color: var(--critical);
  }

  .count.v-tie .icon {
    color: var(--ink-2);
  }

  .count.zero {
    color: var(--ink-3);
  }

  .of,
  .range {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .range {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-stretch: 90%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
