---
/**
 * Why BLAKE3, as a bento: faster than SHA-256 (the BLAKE3 team's own chart),
 * secure where MD5 and SHA-1 are broken, a tree inside, one function for every
 * job, and who already ships it (the README's adoption list). Nothing here is
 * measured by this project; src/lib/official.ts says where each claim is from.
 */
import { Binary, KeyRound, Network, ShieldCheck, Zap } from 'lucide-static';
import Backdrop from './Backdrop.astro';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import type { MarkName } from '../lib/brands';
import { official } from '../lib/home';
import { BLAKE3_README } from '../lib/official';

const fmt = new Intl.NumberFormat('en-US');

const safety = [
  { name: 'MD5', ok: false, note: 'Broken' },
  { name: 'SHA‑1', ok: false, note: 'Broken' },
  { name: 'SHA‑256', ok: true, note: 'Secure' },
  { name: 'BLAKE3', ok: true, note: 'Secure' },
];

const jobs = [
  { icon: Binary, name: 'Hash', flag: 'default' },
  { icon: KeyRound, name: 'MAC', flag: '--keyed' },
  { icon: KeyRound, name: 'Key derivation', flag: '--derive-key' },
  { icon: Zap, name: 'Any length', flag: '--length' },
];

// The README's "Adoption & deployment" list, where the project has a mark.
const adopters: { name: string; mark: MarkName }[] = [
  { name: 'LLVM', mark: 'llvm' },
  { name: 'Cargo', mark: 'rust' },
  { name: 'Bazel', mark: 'bazel' },
  { name: 'Nix', mark: 'nixos' },
  { name: 'OpenZFS', mark: 'openzfs' },
  { name: 'IPFS', mark: 'ipfs' },
  { name: 'ClickHouse', mark: 'clickhouse' },
  { name: 'Solana', mark: 'solana' },
  { name: 'Wasmer', mark: 'wasmer' },
  { name: 'Redox', mark: 'redox' },
  { name: 'Farcaster', mark: 'farcaster' },
];

// The tree tile: 8 chunks, 4, 2, 1, in a 200 x 150 box.
const rows = [8, 4, 2, 1].map((n, k) => Array.from({ length: n }, (_, i) => ({ x: ((i + 0.5) * 200) / n, y: 132 - k * 38, k })));
const edges = rows.slice(1).flatMap((row, k) =>
  row.flatMap((p, j) => [rows[k]![2 * j]!, rows[k]![2 * j + 1]!].map((c) => ({ d: `M${c.x} ${c.y}C${c.x} ${(c.y + p.y) / 2} ${p.x} ${(c.y + p.y) / 2} ${p.x} ${p.y}`, k }))),
);
---

<section id="why" class="home-section why" aria-labelledby="why-title">
  <Backdrop name="why" />
  <div class="wrap">
    <header class="home-head">
      <p class="kicker" data-reveal>Why BLAKE3</p>
      <h2 id="why-title" data-reveal style="--i: 1">The modern fingerprint. <span class="glow">Fast and safe.</span></h2>
      <p data-reveal style="--i: 2">
        MD5 dates from 1992 and SHA‑256 from 2001. BLAKE3 arrived in 2020 from the cryptographers behind BLAKE2, built for the many-core machines we
        actually have.
      </p>
    </header>

    <div class="bento">
      <article class="tile t-fast" data-reveal data-bars>
        <Backdrop name="tile-fast" focus="20% 20%" scrim="bottom" sizes="(min-width: 62rem) 57rem, 100vw" />
        <p class="tile-kicker"><Icon svg={Zap} /> Speed</p>
        <p class="mega fast-num">{official.times}<span class="x">×</span></p>
        <p class="tile-title">faster than SHA‑256, on a single core.</p>
        <ul class="bars" role="list">
          {
            official.bars.map((b) => (
              <li class:list={{ us: b.name === 'BLAKE3' }} style={`--f: ${(b.value / official.max).toFixed(4)}`}>
                <span class="name">{b.name.replace('-', '‑')}</span>
                <span class="track" aria-hidden="true">
                  <span class="fill" />
                </span>
                <span class="value">{fmt.format(b.value)}</span>
              </li>
            ))
          }
        </ul>
        <p class="src">
          MiB/s, {official.setup}. From the BLAKE3 team's <a href={official.source}>benchmark</a>.
        </p>
      </article>

      <article class="tile t-safe" data-reveal style="--i: 1">
        <p class="tile-kicker"><Icon svg={ShieldCheck} /> Security</p>
        <p class="tile-title">Secure where MD5 and SHA‑1 are broken.</p>
        <ul class="chips" role="list">
          {
            safety.map((s) => (
              <li class:list={{ ok: s.ok }}>
                <span class="dot" aria-hidden="true" />
                <span>{s.name}</span>
                <span class="note">{s.note}</span>
              </li>
            ))
          }
        </ul>
        <p class="tile-body">And unlike SHA‑256, safe from length-extension attacks, so it works as a MAC on its own.</p>
      </article>

      <article class="tile t-tree" data-reveal style="--i: 2">
        <p class="tile-kicker"><Icon svg={Network} /> Parallel by design</p>
        <svg class="tree" viewBox="0 0 200 150" aria-hidden="true" focusable="false">
          <g class="edges">{edges.map((e) => <path d={e.d} class={`k${e.k}`} />)}</g>
          <g class="edges flow">{edges.map((e) => <path d={e.d} class={`k${e.k}`} />)}</g>
          {rows.flat().map((n) => <circle cx={n.x} cy={n.y} r={n.k === 3 ? 6 : 3.5} class={`n${n.k}`} />)}
        </svg>
        <p class="tile-body">A tree inside: one big file splits into chunks that every core hashes at once.</p>
      </article>

      <article class="tile t-one" data-reveal style="--i: 3">
        <p class="tile-kicker"><Icon svg={KeyRound} /> One function</p>
        <ul class="jobs" role="list">
          {
            jobs.map((j) => (
              <li>
                <span>{j.name}</span>
                <code>{j.flag}</code>
              </li>
            ))
          }
        </ul>
        <p class="tile-body">Hashing, MACs and key derivation built in. No HMAC or HKDF wrappers.</p>
      </article>

      <article class="tile t-adopt" data-reveal>
        <p class="tile-kicker">Already shipping BLAKE3</p>
        <ul class="logos" role="list">
          {
            adopters.map((a) => (
              <li>
                <BrandMark name={a.mark} />
                <span>{a.name}</span>
              </li>
            ))
          }
          <li class="more">
            <a href={BLAKE3_README}>and more →</a>
          </li>
        </ul>
      </article>
    </div>
  </div>
</section>

<script>
  // The speed bars grow from zero the first time the tile is on screen.
  for (const tile of document.querySelectorAll<HTMLElement>('[data-bars]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    tile.classList.add('armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        tile.classList.add('grown');
      },
      { threshold: 0.35 },
    );
    io.observe(tile);
  }
</script>

<style>
  .bento {
    grid-template-areas:
      'fast fast safe safe'
      'fast fast tree one'
      'adopt adopt adopt adopt';
  }

  .t-fast {
    grid-area: fast;
  }
  .t-safe {
    grid-area: safe;
  }
  .t-tree {
    grid-area: tree;
  }
  .t-one {
    grid-area: one;
  }
  .t-adopt {
    grid-area: adopt;
  }

  @media (max-width: 61.99rem) {
    .bento {
      grid-template-areas:
        'fast fast'
        'safe safe'
        'tree one'
        'adopt adopt';
    }
  }

  @media (max-width: 39.99rem) {
    .bento {
      grid-template-areas: none;
    }
    .bento > * {
      grid-area: auto;
    }
  }

  /* Speed */
  .t-fast {
    justify-content: space-between;
  }

  .fast-num {
    font-size: clamp(5rem, 3rem + 7vw, 9rem);
    background: linear-gradient(120deg, #fff 20%, var(--volt) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .x {
    font-size: 0.6em;
    margin-left: 0.04em;
  }

  .bars {
    display: grid;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .bars li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .bars .us {
    color: var(--ink);
    font-weight: 600;
  }

  .track {
    height: 12px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow: hidden;
  }

  .fill {
    display: block;
    width: calc(var(--f) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--s-base-2);
    transition: width 1.4s var(--ease-out);
  }

  .us .fill {
    background: var(--heat);
    box-shadow: 0 0 18px rgb(212 255 58 / 0.5);
  }

  :global(.armed:not(.grown)) .fill {
    width: 0;
  }

  .value {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: right;
  }

  .src {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .tile a {
    color: var(--ink-2);
  }

  /* Security */
  .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.25rem 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--void);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .chips .note {
    margin-left: auto;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chips .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ff5d5d;
    box-shadow: 0 0 10px rgb(255 93 93 / 0.6);
  }

  .chips .ok .dot {
    background: var(--volt);
    box-shadow: 0 0 10px rgb(212 255 58 / 0.6);
  }

  .chips li:last-child {
    border-color: rgb(212 255 58 / 0.35);
    color: var(--ink);
  }

  /* Tree */
  .tree {
    width: 100%;
    max-height: 9.5rem;
  }

  .edges path {
    fill: none;
    stroke: var(--ion);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.3;
  }

  .flow path {
    stroke-width: 2.2;
    opacity: 0;
  }

  .edges .k1 {
    stroke: color-mix(in oklab, var(--ion), var(--volt));
  }

  .edges .k2 {
    stroke: var(--volt);
  }

  .tree circle {
    fill: var(--ion);
  }

  .tree .n2,
  .tree .n3 {
    fill: var(--volt);
  }

  .tree .n3 {
    filter: drop-shadow(0 0 6px rgb(212 255 58 / 0.9));
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow path {
      opacity: 1;
      stroke-dasharray: 8 70;
      animation: climb 2.4s linear infinite;
    }
    .flow .k1 {
      animation-delay: 0.3s;
    }
    .flow .k2 {
      animation-delay: 0.6s;
    }
    @keyframes climb {
      from {
        stroke-dashoffset: 78;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    .tree .n3 {
      animation: beat 2.4s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes beat {
      0%,
      70%,
      100% {
        transform: scale(1);
      }
      80% {
        transform: scale(1.5);
      }
    }
  }

  /* One function */
  .jobs {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jobs li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .jobs code {
    color: var(--volt);
    font-size: 0.75rem;
  }

  /* Adopters */
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
    font-weight: 550;
    transition: color var(--t-fast);
  }

  .logos li:hover {
    color: var(--ink);
  }

  .logos :global(.brandmark) {
    font-size: 1.3rem;
  }

  .logos .more a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .logos .more a:hover {
    color: var(--ink);
  }
</style>
