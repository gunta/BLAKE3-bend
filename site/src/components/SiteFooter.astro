---
import BrandMark from './BrandMark.astro';
import Logo from './Logo.astro';
import { ADR_INDEX_URL } from '../lib/adr';
import { TIE_TEXT } from '../lib/model';
import { BEND_URL, REPO_URL, RELEASES_URL, UPSTREAM_URL, blobUrl, buildCommit } from '../lib/site';

const commit = buildCommit();

const columns = [
  {
    title: 'Product',
    links: [
      { href: '#install', label: 'Install' },
      { href: '#blake3', label: 'What is BLAKE3' },
      { href: '#outcomes', label: 'Performance' },
      { href: '#benchmarks', label: 'Benchmarks' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: REPO_URL, label: 'GitHub' },
      { href: RELEASES_URL, label: 'Releases' },
      { href: 'https://crates.io/crates/turboblake', label: 'crates.io' },
      { href: ADR_INDEX_URL, label: 'Decision records' },
    ],
  },
  {
    title: 'BLAKE3',
    links: [
      { href: UPSTREAM_URL, label: 'Official BLAKE3' },
      { href: 'https://github.com/BLAKE3-team/BLAKE3-specs/blob/master/blake3.pdf', label: 'The paper' },
      { href: BEND_URL, label: 'Bend2' },
    ],
  },
];

const builtWith = [
  { name: 'bend', label: 'Bend2', href: BEND_URL },
  { name: 'vgpu', label: 'vgpu', href: 'https://vgpu.sh' },
  { name: 'webgpu', label: 'WebGPU', href: 'https://www.w3.org/TR/webgpu/' },
  { name: 'astro', label: 'Astro', href: 'https://astro.build' },
] as const;
---

<footer class="site-footer">
  <div class="wrap top">
    <div class="brand-col">
      <a class="home" href="#top" aria-label="turboblake: back to the top">
        <Logo wordmark />
      </a>
      <p class="pitch">BLAKE3, turbocharged. A drop-in b3sum for macOS and Linux.</p>
    </div>
    {
      columns.map((c) => (
        <nav class="col" aria-label={c.title}>
          <p class="col-title">{c.title}</p>
          <ul role="list">
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="wrap bottom">
    <p class="fine">
      Every number on this page is read from
      <a href={blobUrl('bend/bench/results/results.json')}><code>results.json</code></a>
      when the site builds{
        commit && (
          <>
            {' '}
            (commit <a href={`${REPO_URL}/commit/${commit}`}><code>{commit.slice(0, 7)}</code></a>)
          </>
        )
      }. A result within {TIE_TEXT} either way is called a tie.
    </p>
    <ul class="built" role="list" aria-label="Built with">
      {
        builtWith.map((b) => (
          <li>
            <a href={b.href} title={b.label}>
              <BrandMark name={b.name} label={b.label} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .top {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 2.5rem;
  }

  @media (min-width: 48rem) {
    .top {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    }
  }

  .brand-col {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .home {
    display: inline-flex;
    width: fit-content;
    min-height: 40px;
    align-items: center;
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .pitch {
    max-width: 22rem;
  }

  .col-title {
    margin-bottom: 0.75rem;
    color: var(--ink);
    font-weight: 600;
  }

  .col ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--ink-3);
    text-decoration: none;
  }

  .col a:hover {
    color: var(--ink);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .fine {
    max-width: 44rem;
  }

  .fine a {
    color: var(--ink-2);
  }

  .built {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .built a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--ink-3);
    font-size: 1.125rem;
    transition: color var(--t-fast) var(--ease-out);
  }

  .built a:hover {
    color: var(--ink);
  }
</style>
