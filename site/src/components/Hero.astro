---
/**
 * The hero: the tree as light (src/gl/hero.ts, on WebGPU through vgpu) behind
 * the headline, and a live BLAKE3 box: what you type is hashed in the page,
 * the wave runs down the tree, and the beam picks up the new bits.
 *
 * Without WebGPU (or with reduced motion and no GPU) the same tree is drawn as
 * static SVG from the same geometry, with CSS packets on it.
 */
import { blake3Hex } from '../lib/blake3';
import { treePaths } from '../lib/tree';
import { CLI_VERSION } from '../lib/site';
import { latest } from '../lib/news';
import InstallCommand from './InstallCommand.astro';

const SEED = 'hello, world';
const seedDigest = blake3Hex(SEED);

// The fallback tree: merge.wgsl's layout, frozen, in a 1600 x 900 box.
const W = 1600;
const H = 900;
const { edges, root } = treePaths({ x0: 0.42 * W, rootX: 0.84 * W, y: 0.5 * H, half: 0.38 * H });
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="stage" aria-hidden="true">
    <svg class="fallback" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <linearGradient id="hero-heat" x1="0" y1="0" x2={W} y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0.05" style="stop-color: var(--ion)" />
          <stop offset="0.7" style="stop-color: var(--volt)" />
        </linearGradient>
        <radialGradient id="hero-root">
          <stop offset="0" stop-color="#fff" />
          <stop offset="0.25" style="stop-color: var(--volt)" />
          <stop offset="1" style="stop-color: var(--volt)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <g fill="none" stroke="url(#hero-heat)" stroke-linecap="round">
        {edges.map((e) => <path class={`lv lv-${e.level}`} d={e.d} />)}
      </g>
      <path class="beam" d={`M${root.x} ${root.y}H${W + 20}`} />
      <circle class="root" cx={root.x} cy={root.y} r="70" fill="url(#hero-root)" />
    </svg>
    <canvas class="gl" data-hero-canvas></canvas>
    <div class="scrim"></div>
  </div>

  <div class="wrap content">
    <a class="pill" href={latest?.href ?? '#install'} data-reveal>
      <span class="pill-tag">New</span>
      <span>{latest?.headline ?? `turboblake ${CLI_VERSION} on Homebrew and crates.io`}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>

    <h1 id="hero-title" class="display" data-reveal style="--i: 1">
      Checksum anything <span class="glow">at the speed of your SSD.</span>
    </h1>

    <p class="lead" data-reveal style="--i: 2">
      turboblake fingerprints files of any size with BLAKE3, the modern replacement for SHA‑256, on every core you have. Use it anywhere you use{' '}
      <code>sha256sum</code>.
    </p>

    <div class="cta" data-reveal style="--i: 3">
      <InstallCommand />
      <p class="actions">
        <a class="button primary" href="#install"><span>Get started <span class="arrow" aria-hidden="true">→</span></span></a>
        <a class="button" href="#speed"><span>See how fast</span></a>
      </p>
    </div>

    <form class="hashbox" data-hashbox data-reveal style="--i: 4" action="#" aria-labelledby="hb-title">
      <p class="hb-head">
        <span id="hb-title" class="hb-title">Try BLAKE3 in your browser</span>
        <span class="hb-tip" data-hb-tip aria-hidden="true">Click the fingerprint to copy</span>
      </p>
      <div class="hb-row">
        <label class="sr-only" for="hb-in">Text to hash</label>
        <input id="hb-in" name="text" value={SEED} autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="240" />
      </div>
      <button class="hb-out" type="button" data-digest aria-describedby="hb-note" title="Copy the fingerprint">{seedDigest}</button>
      <p class="sr-only" aria-live="polite" data-hb-live></p>
      <p id="hb-note" class="hb-note">
        Same as <code>printf '%s' 'hello, world' | turboblake</code>. Every keystroke runs through the tree behind this text.
      </p>
    </form>
  </div>
</section>

<script>
  import { blake3, toHex } from '../lib/blake3';
  import { getGpu } from '../gl/gpu';
  import type { HeroHandle } from '../gl/hero';

  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = host?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const form = host?.querySelector<HTMLFormElement>('[data-hashbox]');
  const input = form?.querySelector<HTMLInputElement>('input');
  const out = form?.querySelector<HTMLButtonElement>('[data-digest]');
  const live = form?.querySelector<HTMLElement>('[data-hb-live]');
  const tip = form?.querySelector<HTMLElement>('[data-hb-tip]');
  const note = form?.querySelector<HTMLElement>('#hb-note code:not(.plain)');
  const encoder = new TextEncoder();
  let hero: HeroHandle | undefined;

  // The digest resolves left to right through a blur of hex, like a split-flap board on fast-forward.
  const HEX = '0123456789abcdef';
  let scrambleFrame = 0;
  function show(el: HTMLElement, next: string): void {
    cancelAnimationFrame(scrambleFrame);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = next;
      return;
    }
    const started = performance.now();
    const step = (now: number) => {
      const settled = Math.floor(((now - started) / 340) * next.length);
      let text = next.slice(0, settled);
      for (let i = settled; i < next.length; i++) text += HEX[(Math.random() * 16) | 0];
      el.textContent = text;
      if (settled < next.length) scrambleFrame = requestAnimationFrame(step);
      else el.textContent = next;
    };
    scrambleFrame = requestAnimationFrame(step);
  }

  let liveTimer = 0;
  function update(): void {
    if (!input || !out) return;
    const bytes = blake3(encoder.encode(input.value));
    const hex = toHex(bytes);
    out.dataset.value = hex;
    show(out, hex);
    if (note) note.textContent = `printf '%s' '${input.value.replace(/'/g, `'\\''`)}' | turboblake`;
    clearTimeout(liveTimer);
    liveTimer = window.setTimeout(() => {
      if (live) live.textContent = `Digest: ${hex}`;
    }, 900);
    hero?.pulse(bytes);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    hero?.boost();
  });
  input?.addEventListener('input', update);
  out?.addEventListener('click', async () => {
    const hex = out.dataset.value ?? out.textContent ?? '';
    try {
      await navigator.clipboard.writeText(hex);
      if (tip) {
        tip.textContent = 'Copied';
        tip.classList.add('on');
        setTimeout(() => {
          tip.textContent = 'Click the fingerprint to copy';
          tip.classList.remove('on');
        }, 1600);
      }
    } catch {
      // Clipboard can be blocked; the digest is still selectable text.
    }
  });

  // Click anywhere on the hero that is not a control: floor it.
  host?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a, button, input, label, form')) return;
    hero?.boost();
  });

  void (async () => {
    if (!host || !canvas || !input) return;
    const gpu = await getGpu();
    if (!gpu) return;
    try {
      const { mountHero } = await import('../gl/hero');
      hero = await mountHero(gpu, canvas, host, blake3(encoder.encode(input.value)));
      host.classList.add('gpu-ready');
    } catch (error) {
      console.warn('hero: WebGPU scene unavailable, keeping the static tree', error);
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: max(100svh, 44rem);
    padding-block: calc(var(--header-h) + 3rem) 4rem;
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .gl,
  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 1.2s var(--ease-out);
  }

  .gl {
    opacity: 0;
  }

  :global(.gpu-ready) .gl {
    opacity: 1;
  }

  :global(.gpu-ready) .fallback {
    opacity: 0;
  }

  /* The static tree: thin lines that thicken toward the root. */
  .fallback {
    opacity: 0.8;
  }

  .lv {
    stroke-width: 1.2;
    opacity: 0.45;
  }
  .lv-1 {
    stroke-width: 1.6;
    opacity: 0.55;
  }
  .lv-2 {
    stroke-width: 2;
    opacity: 0.65;
  }
  .lv-3 {
    stroke-width: 2.6;
    opacity: 0.8;
  }
  .lv-4 {
    stroke-width: 3.2;
    opacity: 0.9;
  }

  .beam {
    stroke: var(--volt);
    stroke-width: 2.5;
    stroke-dasharray: 10 6 4 6 14 6;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lv {
      stroke-dasharray: 26 140;
      animation: flow 3.2s linear infinite;
    }
    .lv-2,
    .lv-3,
    .lv-4 {
      stroke-dasharray: 30 70;
      animation-duration: 1.8s;
    }
    .beam {
      animation: flow 1.4s linear infinite;
    }
    @keyframes flow {
      to {
        stroke-dashoffset: -166;
      }
    }
  }

  /* Keep the copy legible over the light. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 6 8 / 0.9) 0%, rgb(6 6 8 / 0.7) 38%, rgb(6 6 8 / 0) 60%),
      linear-gradient(180deg, rgb(6 6 8 / 0.5) 0%, rgb(6 6 8 / 0) 20%, rgb(6 6 8 / 0) 80%, rgb(6 6 8 / 1) 100%);
  }

  .content {
    position: relative;
    min-width: 0;
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(12 12 16 / 0.7);
    color: var(--ink-2);
    font-size: 0.8125rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .pill:hover {
    color: var(--ink);
    border-color: rgb(255 255 255 / 0.24);
  }

  .pill-tag {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--volt);
    color: var(--volt-ink);
    font-size: 0.75rem;
    font-weight: 600;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.75rem);
  }

  .lead {
    max-width: 40rem;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.25rem;
    max-width: 100%;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Over the light, the outline button needs its own backing to stay legible. */
  .actions .button:not(.primary) {
    background: rgb(12 12 16 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* The live hash box. */
  .hashbox {
    display: grid;
    gap: 0.65rem;
    width: min(100%, 36rem);
    margin-top: 0.75rem;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(12 12 16 / 0.72);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  .hb-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: 0.8125rem;
  }

  .hb-title {
    color: var(--ink);
    font-weight: 600;
  }

  .hb-tip {
    color: var(--ink-3);
    transition: color var(--t-fast);
  }

  .hb-tip:global(.on) {
    color: var(--volt);
  }

  .hb-row {
    display: flex;
  }

  .hb-row input {
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    min-height: 42px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--void);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    caret-color: var(--volt);
  }

  .hb-row input:focus-visible {
    outline: 2px solid var(--volt);
    outline-offset: 1px;
    border-color: transparent;
  }

  .hb-out {
    all: unset;
    display: block;
    cursor: copy;
    color: var(--volt);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.65rem + 0.4vw, 0.875rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .hb-out:focus-visible {
    outline: 2px solid var(--volt);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .hb-note {
    color: var(--ink-3);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .hb-note code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* Tall screens: the copy starts lower, leaving a band under the header where the tree grows. */
  @media (max-aspect-ratio: 23/20) {
    .hero {
      align-items: end;
      padding-top: calc(var(--header-h) + 28svh);
    }
    .scrim {
      background: linear-gradient(
        180deg,
        rgb(6 6 8 / 0) 0,
        rgb(6 6 8 / 0) calc(var(--header-h) + 20svh),
        rgb(6 6 8 / 0.82) calc(var(--header-h) + 32svh),
        rgb(6 6 8 / 0.9) 100%
      );
    }
    .fallback {
      height: calc(var(--header-h) + 30svh);
    }
  }
</style>
