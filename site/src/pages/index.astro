---
/**
 * The home page, for people who hash files rather than people who benchmark
 * hashers: what turboblake does for you, what a checksum is, why BLAKE3, how
 * it is fast, and the install line. Every measurement, method and proof lives
 * on /benchmarks/.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SpeedBento from '../components/SpeedBento.astro';
import Versus from '../components/Versus.astro';
import HashThings from '../components/HashThings.astro';
import Checksum from '../components/Checksum.astro';
import WhyBlake3 from '../components/WhyBlake3.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhatsNew from '../components/WhatsNew.astro';
import InstallCta from '../components/InstallCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { HERO_SIZES, backdrop } from '../lib/backdrops';

// The hero photo is the largest paint: fetch it from the head, not 120 KB into the body.
const hero = backdrop('hero')?.sources.find((s) => s.type === 'image/avif');
---

<Base>
  {hero && <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={hero.srcset} imagesizes={HERO_SIZES} fetchpriority="high" />}
  <SiteHeader slot="header" />
  <Hero />
  <SpeedBento />
  <Versus />
  <HashThings />
  <Checksum />
  <WhyBlake3 />
  <HowItWorks />
  <WhatsNew />
  <InstallCta />
  <SiteFooter slot="footer" />
</Base>
