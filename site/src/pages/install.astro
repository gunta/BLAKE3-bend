---
/**
 * Install and swap: the command, then each language's package with the line
 * that replaces the BLAKE3 package it stands in for. The native bindings retain their supported predecessor APIs; the browser build
 * exposes a portable hashing API.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '../components/Section.astro';
import InstallCommand from '../components/InstallCommand.astro';
import { INSTALLS, REPO_URL, RELEASES_URL, blobUrl, treeUrl, withBase } from '../lib/site';

interface Step {
  /** What the block is, e.g. "Cargo.toml". */
  label: string;
  code: string;
  /** A shell block gets the $ prompt on each command line. */
  shell?: boolean;
}

interface Package {
  id: string;
  title: string;
  name: string;
  /** The packages it stands in for. */
  replaces: string[];
  /** Where it is published, or how it is installed until it is. */
  where: string;
  steps: Step[];
  notes: string[];
  readme: string;
}

const CLONE = `git clone ${REPO_URL}`;

const packages: Package[] = [
  {
    id: 'rust',
    title: 'Rust',
    name: 'turboblake',
    replaces: ['blake3'],
    where: 'from GitHub until its next crates.io release (turboblake 1.8.7 there is the command line alone)',
    steps: [
      { label: 'shell', shell: true, code: 'cargo add turboblake --git https://github.com/gunta/turboblake' },
      { label: 'or in Cargo.toml', code: 'turboblake = { git = "https://github.com/gunta/turboblake" }' },
    ],
    notes: [
      'The library is still named blake3, so use blake3::… compiles unchanged: hash, Hasher::update, update_rayon, keyed_hash, derive_key and extended output all reach the engine past the size it calibrates at the first big input.',
      'The crate holds the command line too, behind its default cli feature. For the library alone: default-features = false, features = ["std"].',
      'To swap it under every crate in a dependency graph, generate a copy named blake3 and add it to [patch.crates-io] (the README shows how).',
      'Building needs clang; without it the crate builds as upstream and says so in a warning.',
    ],
    readme: 'bend/rust/README.md',
  },
  {
    id: 'c',
    title: 'C',
    name: 'libturboblake',
    replaces: ['the official C library (blake3.h)'],
    where: 'from the repository',
    steps: [
      { label: 'shell', shell: true, code: `${CLONE}\nturboblake/bend/lib/build.sh\ncc -I turboblake/bend/lib/build/include app.c turboblake/bend/lib/build/lib/libblake3.a -lpthread -o app` },
    ],
    notes: [
      'blake3.h, its symbols and the blake3_hasher layout are upstream’s, so programs relink unchanged. build.sh also writes libblake3.dylib or libblake3.so, and libturboblake links to the same library.',
    ],
    readme: 'bend/lib/README.md',
  },
  {
    id: 'python',
    title: 'Python',
    name: 'turboblake',
    replaces: ['blake3 (PyPI)'],
    where: 'from the repository until it is on PyPI',
    steps: [
      { label: 'shell', shell: true, code: 'pip uninstall blake3\npip install "turboblake @ git+https://github.com/gunta/turboblake#subdirectory=bend/python"' },
      { label: 'your code, unchanged', code: 'from blake3 import blake3\n\nblake3(data).hexdigest()\nh = blake3(key=key)\nh.update_mmap("big.iso")\nh.digest(length=64)' },
    ],
    notes: [
      'It installs the same blake3 module, so remove the PyPI one first. max_threads is accepted and ignored: big updates go to the engine on every core.',
      'Building needs a C compiler, and clang for the engine (CC=clang if gcc is the default).',
    ],
    readme: 'bend/python/README.md',
  },
  {
    id: 'node',
    title: 'Node.js, Bun and Deno',
    name: 'turboblake',
    replaces: ['@noble/hashes/blake3', 'blake3 (npm)', '@napi-rs/blake-hash'],
    where: 'from the repository until it is on npm',
    steps: [
      { label: 'shell', shell: true, code: `${CLONE}\n(cd turboblake/bend/node && npm install)\nnpm install ./turboblake/bend/node` },
      {
        label: 'swap the import',
        code: '// was: import { blake3 } from "@noble/hashes/blake3.js";\nimport { blake3 } from "turboblake";\n\n// was: import { hash, createHash } from "blake3";\nimport { hash, createHash } from "turboblake";',
      },
    ],
    notes: [
      'Both APIs, from one package: blake3(data, { dkLen, key, context }) and blake3.create() as in @noble/hashes; hash, keyedHash, deriveKey and createHash as in the blake3 package. hashFiles(paths) hashes many files at once.',
      'Installing builds the native addon with clang. Without a compiler it still installs, and runs on Bend’s JavaScript; backend says which one runs.',
    ],
    readme: 'bend/node/README.md',
  },
  {
    id: 'browser',
    title: 'Browsers and workers',
    name: 'turboblake/js',
    replaces: ['@noble/hashes/blake3', 'hash-wasm'],
    where: 'the same package',
    steps: [
      { label: 'your code', code: 'import { blake3 } from "turboblake"; // bundlers pick turboblake/js for browsers and workers\n// Or import { blake3 } from "turboblake/js"; to select the JS build explicitly' },
    ],
    notes: [
      'BLAKE3 as written in Bend, emitted to JavaScript by Bend2’s own JS target: no native code, no WebAssembly, every mode. It exposes the noble-style API; hash-wasm users need to adapt their calls. It is the portable fallback for environments where the native addon cannot run.',
    ],
    readme: 'bend/node/README.md',
  },
  {
    id: 'go',
    title: 'Go',
    name: 'github.com/gunta/turboblake/bend/go',
    replaces: ['lukechampine.com/blake3', 'github.com/zeebo/blake3'],
    where: 'a Go module',
    steps: [
      { label: 'shell', shell: true, code: 'go get github.com/gunta/turboblake/bend/go' },
      {
        label: 'swap the import',
        code: '// was: import "lukechampine.com/blake3"\nimport blake3 "github.com/gunta/turboblake/bend/go"\n\n// was: import "github.com/zeebo/blake3"\nimport blake3 "github.com/gunta/turboblake/bend/go/zeebo"',
      },
    ],
    notes: [
      'Same functions, types and output as each package it replaces, plus NewDeriveKey, Hasher.Clone and HashFiles. Needs cgo.',
      'The engine comes prebuilt for darwin and linux on arm64 and amd64; anywhere else cgo builds it at plain flags, slower and still on every core.',
    ],
    readme: 'bend/go/README.md',
  },
];

const links = [
  { href: '#cli', label: 'Command line' },
  ...packages.map((p) => ({ href: `#${p.id}`, label: p.title.split(',')[0]! })),
  { href: '#controls', label: 'Controls' },
];

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** A block's HTML in one string, since a template inside <pre> keeps its indentation. */
const html = (s: Step) =>
  s.shell
    ? s.code
        .split('\n')
        .map((l) => `<span class="p" aria-hidden="true">$ </span>${escape(l)}`)
        .join('\n')
    : escape(s.code);
---

<Base title="Install: the command and every library" path="install/" description="Install turboblake, the drop-in b3sum, and swap in its libraries for Rust, C, Python, Node.js, Bun, Deno, browsers and Go: one line each, the same API as the BLAKE3 package each replaces.">
  <SiteHeader slot="header" links={links} />

  <section class="intro" id="cli" aria-labelledby="cli-title">
    <div class="wrap">
      <p class="kicker">Install</p>
      <h1 id="cli-title">The command, and a library for each language</h1>
      <div class="prose lede">
        <p>
          The <code>turboblake</code> command is the official <code>b3sum</code> with the Bend engine: the same flags, output and messages. Each library keeps the
          supported API of the BLAKE3 package it replaces. The browser build exposes the noble-style API; other APIs may need changes. How each one compares:{' '}
          <a href={withBase('languages/')}>languages</a>.
        </p>
      </div>

      <div class="cli">
        <InstallCommand class="big" />
        <ul class="channels" role="list">
          <li class="off-apple">
            <code>{INSTALLS[0].command}</code>
            <span>Homebrew on Linux, prebuilt.</span>
          </li>
          <li class="on-apple">
            <code>{INSTALLS[1].command}</code>
            <span>From source, tuned for your CPU.</span>
          </li>
          <li>
            <code>cargo binstall turboblake</code>
            <span>The prebuilt binaries, through cargo (requires cargo-binstall).</span>
          </li>
          <li>
            <code>cargo install turboblake --features replace</code>
            <span>Also installs it as <code>b3sum</code>, for scripts that call that name.</span>
          </li>
          <li>
            <a href={RELEASES_URL}>GitHub Releases</a>
            <span>Archives for macOS and Linux, arm64 and x86-64, with SHA256SUMS. Prebuilt x86-64 binaries require AVX2; build from source for older CPUs.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {
    packages.map((p, i) => (
      <Section id={p.id} kicker={p.where} title={p.title} tone={i % 2 === 0 ? 'alt' : 'plain'}>
        <Fragment slot="lede">
          <p>
            <code>{p.name}</code>, in place of{' '}
            {p.replaces.map((r, j) => (
              <>
                {j > 0 && (j === p.replaces.length - 1 ? ' and ' : ', ')}
                <code>{r}</code>
              </>
            ))}
            .
          </p>
        </Fragment>
        <div class="pkg">
          <div class="steps">
            {p.steps.map((s) => (
              <figure class="step">
                <figcaption>{s.label}</figcaption>
                <pre><code set:html={html(s)} /></pre>
              </figure>
            ))}
          </div>
          <div class="notes prose">
            {p.notes.map((n) => (
              <p>{n}</p>
            ))}
            <p>
              <a href={blobUrl(p.readme)}>{p.readme}</a>
            </p>
          </div>
        </div>
      </Section>
    ))
  }

  <Section id="controls" kicker="Every package" title="Controls">
    <Fragment slot="lede">
      <p>The native libraries and command read these environment variables. The JavaScript-only browser build does not read environment variables.</p>
    </Fragment>
    <dl class="env">
      <div>
        <dt><code>TURBOBLAKE=0</code></dt>
        <dd>Disables the Bend CPU engine. The caller’s upstream configuration determines threading.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_GPU=0</code></dt>
        <dd>Disables the native Metal and CUDA backend in GPU-enabled library builds.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_THREADS=&lt;n&gt;</code></dt>
        <dd>Caps the engine’s threads.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_MIN=&lt;bytes&gt;</code></dt>
        <dd>The smallest subtree the engine takes, instead of the size it calibrates.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_TRACE=1</code></dt>
        <dd>Prints what the engine did, to stderr.</dd>
      </div>
    </dl>
    <p class="aside prose">
      The 1.8.7 releases (the <code>turboblake</code> command from Homebrew, GitHub Releases or crates.io, and the <code>blake3-bend</code> crate) read
      the same settings under their earlier names: <code>BLAKE3_BEND=0</code>, <code>BLAKE3_BEND_THREADS</code>, <code>BLAKE3_BEND_MIN</code>,
      <code>BLAKE3_BEND_TRACE</code>.
    </p>
    <p class="aside prose">
      All of it is built from one tree: <a href={treeUrl('bend/lib')}><code>bend/lib</code></a> is the C library every binding wraps, and its engine is the
      Bend program in <a href={blobUrl('bend/lib/engine.bend')}><code>engine.bend</code></a>.
    </p>
  </Section>

  <SiteFooter slot="footer" />
</Base>

<style>
  .intro {
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 5.5rem)) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .intro h1 {
    max-width: 20ch;
    margin-block: 0.6rem 1.2rem;
    font-size: clamp(2.125rem, 1.4rem + 3vw, 3.5rem);
  }

  .lede {
    max-width: 44rem;
    font-size: 1.0625rem;
  }

  .cli {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-top: 2.25rem;
  }

  /* The channel the install line above does not show (Base.astro adds .apple). */
  :global(.apple) .channels .off-apple,
  :global(html:not(.apple)) .channels .on-apple {
    display: none;
  }

  .channels {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li {
    display: grid;
    gap: 0.15rem;
  }

  .channels span {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .pkg {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .pkg {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .steps {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .step {
    margin: 0;
    min-width: 0;
  }

  .step figcaption {
    margin-bottom: 0.4rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .step pre {
    margin: 0;
    overflow-x: auto;
  }

  .step :global(.p) {
    color: var(--ink-3);
    user-select: none;
  }

  .channels li {
    min-width: 0;
  }

  .channels code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .notes p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .notes p + p {
    margin-top: 0.75rem;
  }

  .env {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
  }

  .env div {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius, 12px);
    background: var(--surface-2);
  }

  .env dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .aside {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
  }
</style>
