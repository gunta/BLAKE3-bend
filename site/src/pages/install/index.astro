---
/**
 * Install: the command, a card per language (each with its own guide, /install/<slug>/), and
 * the settings every package reads. Links to the old per-language sections (#rust, #node…)
 * go on to the guides.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Section from '../../components/Section.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import LanguageInstalls from '../../components/LanguageInstalls.astro';
import { INSTALLS, RELEASES_URL, blobUrl, treeUrl, withBase } from '../../lib/site';

import { GUIDES } from '../../lib/guides';

const links = [
  { href: '#cli', label: 'Command line' },
  ...GUIDES.map((g) => ({ href: withBase(`install/${g.slug}/`), label: g.title })),
  { href: '#controls', label: 'Controls' },
];

/** The old sections of this page, now guides of their own. */
const moved = { rust: 'rust', c: 'c', python: 'python', node: 'typescript', browser: 'typescript', go: 'go' };
---

<Base title="Install: the command and every library" path="install/" description="Install turboblake, the drop-in b3sum, and swap in its libraries for Rust, C, Python, Node.js, Bun, Deno, browsers and Go: one line each, the same API as the BLAKE3 package each replaces.">
  <SiteHeader slot="header" links={links} />

  <section class="intro" id="cli" aria-labelledby="cli-title">
    <div class="wrap">
      <p class="kicker">Install</p>
      <h1 id="cli-title">The command, and a library for each language</h1>
      <div class="prose lede">
        <p>
          The <code>turboblake</code> command is the official <code>b3sum</code> with the Bend engine: the same flags, output and messages. Each library keeps the
          supported API of the BLAKE3 package it replaces. The browser build exposes the noble-style API; other APIs may need changes. How each one compares:{' '}
          <a href={withBase('languages/')}>languages</a>.
        </p>
      </div>

      <div class="cli">
        <InstallCommand class="big" />
        <ul class="channels" role="list">
          <li class="off-apple">
            <code>{INSTALLS[0].command}</code>
            <span>Homebrew on Linux, prebuilt.</span>
          </li>
          <li class="on-apple">
            <code>{INSTALLS[1].command}</code>
            <span>From source, tuned for your CPU.</span>
          </li>
          <li>
            <code>cargo binstall turboblake</code>
            <span>The prebuilt binaries, through cargo (requires cargo-binstall).</span>
          </li>
          <li>
            <code>cargo install turboblake --features replace</code>
            <span>Also installs it as <code>b3sum</code>, for scripts that call that name.</span>
          </li>
          <li>
            <a href={RELEASES_URL}>GitHub Releases</a>
            <span>Archives for macOS, Linux (glibc 2.28+, or static musl) and Windows, arm64 and x86-64, with SHA256SUMS and build attestations. The x86-64 binaries use AVX2 where the CPU has it and run on any x86-64 CPU. On Windows it is the official b3sum, until the engine runs there.</span>
          </li>
        </ul>
      </div>

      <div class="libs">
        <h2 class="libs-title">A library for each language</h2>
        <LanguageInstalls />
      </div>
    </div>
  </section>

  <Section id="controls" kicker="Every package" title="Controls">
    <Fragment slot="lede">
      <p>The native libraries and command read these environment variables. The JavaScript-only browser build does not read environment variables.</p>
    </Fragment>
    <dl class="env">
      <div>
        <dt><code>TURBOBLAKE=0</code></dt>
        <dd>Disables the Bend CPU engine. The caller’s upstream configuration determines threading.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_GPU=0</code></dt>
        <dd>Disables the native Metal and CUDA backend in GPU-enabled library builds.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_THREADS=&lt;n&gt;</code></dt>
        <dd>Caps the engine’s threads.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_MIN=&lt;bytes&gt;</code></dt>
        <dd>The smallest subtree the engine takes, instead of the size it calibrates.</dd>
      </div>
      <div>
        <dt><code>TURBOBLAKE_TRACE=1</code></dt>
        <dd>Prints what the engine did, to stderr.</dd>
      </div>
    </dl>
    <p class="aside prose">
      The 1.8.7 releases (the <code>turboblake</code> command from Homebrew, GitHub Releases or crates.io, and the <code>blake3-bend</code> crate) read
      the same settings under their earlier names: <code>BLAKE3_BEND=0</code>, <code>BLAKE3_BEND_THREADS</code>, <code>BLAKE3_BEND_MIN</code>,
      <code>BLAKE3_BEND_TRACE</code>.
    </p>
    <p class="aside prose">
      All of it is built from one tree: <a href={treeUrl('bend/lib')}><code>bend/lib</code></a> is the C library every binding wraps, and its engine is the
      Bend program in <a href={blobUrl('bend/lib/engine.bend')}><code>engine.bend</code></a>.
    </p>
  </Section>

  <SiteFooter slot="footer" />
</Base>

<script is:inline define:vars={{ moved, base: withBase('install/') }}>
  const to = moved[location.hash.slice(1)];
  if (to) location.replace(base + to + '/');
</script>

<style>
  .intro {
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 5.5rem)) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .intro h1 {
    max-width: 20ch;
    margin-block: 0.6rem 1.2rem;
    font-size: clamp(2.125rem, 1.4rem + 3vw, 3.5rem);
  }

  .lede {
    max-width: 44rem;
    font-size: 1.0625rem;
  }

  .cli {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-top: 2.25rem;
  }

  .libs {
    display: grid;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .libs-title {
    margin: 0;
    font-size: 1.375rem;
  }

  /* The channel the install line above does not show (Base.astro adds .apple). */
  :global(.apple) .channels .off-apple,
  :global(html:not(.apple)) .channels .on-apple {
    display: none;
  }

  .channels {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li {
    display: grid;
    gap: 0.15rem;
  }

  .channels span {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .pkg {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .pkg {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .steps {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .step {
    margin: 0;
    min-width: 0;
  }

  .step figcaption {
    margin-bottom: 0.4rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .step pre {
    margin: 0;
    overflow-x: auto;
  }

  .step :global(.p) {
    color: var(--ink-3);
    user-select: none;
  }

  .channels li {
    min-width: 0;
  }

  .channels code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .notes p {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .notes p + p {
    margin-top: 0.75rem;
  }

  .env {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
  }

  .env div {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius, 12px);
    background: var(--surface-2);
  }

  .env dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .aside {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
  }
</style>
