---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---

<Base title="Not found" path="404.html" noindex>
  <section class="wrap missing" aria-labelledby="missing-title">
    <p class="code display fast" aria-hidden="true">404</p>
    <h1 id="missing-title"><span class="sr-only">404: </span>Nothing hashes to this address.</h1>
    <p>The page you asked for is not here.</p>
    <p><a class="button primary" href={withBase()}><span>Back to the race</span></a></p>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .code {
    font-size: clamp(6rem, 3rem + 14vw, 13rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--volt);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 3vw, 3.25rem);
    letter-spacing: -0.03em;
  }
</style>
