---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---

<Base title="Not found" path="404.html" noindex>
  <section class="wrap missing" aria-labelledby="missing-title">
    <p class="code">404</p>
    <h1 id="missing-title">Nothing hashes to this address.</h1>
    <p>The page you asked for is not here.</p>
    <p><a class="button primary" href={withBase()}>Back to the results</a></p>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .code {
    font-weight: 700;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 3vw, 3.25rem);
    letter-spacing: -0.03em;
  }
</style>
