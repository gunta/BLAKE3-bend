# Register-only compress8 loop: isolates what clang does with Bend's shape.
import Base
import ../../blake3.bend as B3

def Clock.us() -> IO(Nat):
  import "../../effs/clock.c"
  import "../../effs/clock.js"

def spin8(n: Nat, cv: B3.CV8, +m: B3.B128) -> B3.CV8:
  match n:
    case 0n:
      cv
    case 1n+p:
      spin8(p, B3.compress8(cv, m, 0, 1, 0, 64, 0), m)

def first(cv: B3.CV8) -> U32:
  match cv:
    case B3.CV8{h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31, h32, h33, h34, h35, h36, h37, h38, h39, h40, h41, h42, h43, h44, h45, h46, h47, h48, h49, h50, h51, h52, h53, h54, h55, h56, h57, h58, h59, h60, h61, h62, h63}:
      (h0 .^. h1 .^. h2 .^. h3 .^. h4 .^. h5 .^. h6 .^. h7 .^. h8 .^. h9 .^. h10 .^. h11 .^. h12 .^. h13 .^. h14 .^. h15 .^. h16 .^. h17 .^. h18 .^. h19 .^. h20 .^. h21 .^. h22 .^. h23 .^. h24 .^. h25 .^. h26 .^. h27 .^. h28 .^. h29 .^. h30 .^. h31 .^. h32 .^. h33 .^. h34 .^. h35 .^. h36 .^. h37 .^. h38 .^. h39 .^. h40 .^. h41 .^. h42 .^. h43 .^. h44 .^. h45 .^. h46 .^. h47 .^. h48 .^. h49 .^. h50 .^. h51 .^. h52 .^. h53 .^. h54 .^. h55 .^. h56 .^. h57 .^. h58 .^. h59 .^. h60 .^. h61 .^. h62 .^. h63 : U32)

def run(+j: U32) -> U32:
  first(spin8(131072n, B3.IV8(), B3.B128{(j + 0 : U32), (j + 1 : U32), (j + 2 : U32), (j + 3 : U32), (j + 4 : U32), (j + 5 : U32), (j + 6 : U32), (j + 7 : U32), (j + 8 : U32), (j + 9 : U32), (j + 10 : U32), (j + 11 : U32), (j + 12 : U32), (j + 13 : U32), (j + 14 : U32), (j + 15 : U32), (j + 16 : U32), (j + 17 : U32), (j + 18 : U32), (j + 19 : U32), (j + 20 : U32), (j + 21 : U32), (j + 22 : U32), (j + 23 : U32), (j + 24 : U32), (j + 25 : U32), (j + 26 : U32), (j + 27 : U32), (j + 28 : U32), (j + 29 : U32), (j + 30 : U32), (j + 31 : U32), (j + 32 : U32), (j + 33 : U32), (j + 34 : U32), (j + 35 : U32), (j + 36 : U32), (j + 37 : U32), (j + 38 : U32), (j + 39 : U32), (j + 40 : U32), (j + 41 : U32), (j + 42 : U32), (j + 43 : U32), (j + 44 : U32), (j + 45 : U32), (j + 46 : U32), (j + 47 : U32), (j + 48 : U32), (j + 49 : U32), (j + 50 : U32), (j + 51 : U32), (j + 52 : U32), (j + 53 : U32), (j + 54 : U32), (j + 55 : U32), (j + 56 : U32), (j + 57 : U32), (j + 58 : U32), (j + 59 : U32), (j + 60 : U32), (j + 61 : U32), (j + 62 : U32), (j + 63 : U32), (j + 64 : U32), (j + 65 : U32), (j + 66 : U32), (j + 67 : U32), (j + 68 : U32), (j + 69 : U32), (j + 70 : U32), (j + 71 : U32), (j + 72 : U32), (j + 73 : U32), (j + 74 : U32), (j + 75 : U32), (j + 76 : U32), (j + 77 : U32), (j + 78 : U32), (j + 79 : U32), (j + 80 : U32), (j + 81 : U32), (j + 82 : U32), (j + 83 : U32), (j + 84 : U32), (j + 85 : U32), (j + 86 : U32), (j + 87 : U32), (j + 88 : U32), (j + 89 : U32), (j + 90 : U32), (j + 91 : U32), (j + 92 : U32), (j + 93 : U32), (j + 94 : U32), (j + 95 : U32), (j + 96 : U32), (j + 97 : U32), (j + 98 : U32), (j + 99 : U32), (j + 100 : U32), (j + 101 : U32), (j + 102 : U32), (j + 103 : U32), (j + 104 : U32), (j + 105 : U32), (j + 106 : U32), (j + 107 : U32), (j + 108 : U32), (j + 109 : U32), (j + 110 : U32), (j + 111 : U32), (j + 112 : U32), (j + 113 : U32), (j + 114 : U32), (j + 115 : U32), (j + 116 : U32), (j + 117 : U32), (j + 118 : U32), (j + 119 : U32), (j + 120 : U32), (j + 121 : U32), (j + 122 : U32), (j + 123 : U32), (j + 124 : U32), (j + 125 : U32), (j + 126 : U32), (j + 127 : U32)}))

def main() -> IO(Unit):
  do IO<Unit>:
    t0 : Nat <- Clock.us()
    x : U32 = run(7)
    t1 : Nat <- Clock.us()
    IO.print("us " ++ Nat.show(Nat.sub(t1, t0)) ++ " x " ++ U32.show(x) ++ " (131072 x 8 compressions = 64 MiB)")
