    case L7{} B3.B128{m0_0, m1_0, m2_0, m3_0, m4_0, m5_0, m6_0, m7_0, m0_1, m1_1, m2_1, m3_1, m4_1, m5_1, m6_1, m7_1, m0_2, m1_2, m2_2, m3_2, m4_2, m5_2, m6_2, m7_2, m0_3, m1_3, m2_3, m3_3, m4_3, m5_3, m6_3, m7_3, m0_4, m1_4, m2_4, m3_4, m4_4, m5_4, m6_4, m7_4, m0_5, m1_5, m2_5, m3_5, m4_5, m5_5, m6_5, m7_5, m0_6, m1_6, m2_6, m3_6, m4_6, m5_6, m6_6, m7_6, m0_7, m1_7, m2_7, m3_7, m4_7, m5_7, m6_7, m7_7, m0_8, m1_8, m2_8, m3_8, m4_8, m5_8, m6_8, m7_8, m0_9, m1_9, m2_9, m3_9, m4_9, m5_9, m6_9, m7_9, m0_10, m1_10, m2_10, m3_10, m4_10, m5_10, m6_10, m7_10, m0_11, m1_11, m2_11, m3_11, m4_11, m5_11, m6_11, m7_11, m0_12, m1_12, m2_12, m3_12, m4_12, m5_12, m6_12, m7_12, m0_13, m1_13, m2_13, m3_13, m4_13, m5_13, m6_13, m7_13, m0_14, m1_14, m2_14, m3_14, m4_14, m5_14, m6_14, m7_14, m0_15, m1_15, m2_15, m3_15, m4_15, m5_15, m6_15, m7_15}:
      B3.M16{m7_0, m7_1, m7_2, m7_3, m7_4, m7_5, m7_6, m7_7, m7_8, m7_9, m7_10, m7_11, m7_12, m7_13, m7_14, m7_15}

# What lane l of par8(x, y) must be: the parent of lanes 2l and 2l + 1 of x
# for l < 4, of y's lanes 2(l - 4) and 2(l - 4) + 1 after.
def par.ref(l: Lane, +x: B3.CV8, +y: B3.CV8) -> B3.CV:
  match l:
    case L0{}:
      B3.parent(cv.at(L0{}, x), cv.at(L1{}, x), 0)
    case L1{}:
      B3.parent(cv.at(L2{}, x), cv.at(L3{}, x), 0)
    case L2{}:
      B3.parent(cv.at(L4{}, x), cv.at(L5{}, x), 0)
    case L3{}:
      B3.parent(cv.at(L6{}, x), cv.at(L7{}, x), 0)
    case L4{}:
      B3.parent(cv.at(L0{}, y), cv.at(L1{}, y), 0)
    case L5{}:
      B3.parent(cv.at(L2{}, y), cv.at(L3{}, y), 0)
    case L6{}:
      B3.parent(cv.at(L4{}, y), cv.at(L5{}, y), 0)
    case L7{}:
      B3.parent(cv.at(L6{}, y), cv.at(L7{}, y), 0)

law compress8.lane:
  for +l: Lane
  for +cv: B3.CV8
  for +m: B3.B128
  for +ctr: U32
  for +step: U32
  for +hi: U32
  for +blen: U32
  for +flags: U32
  {cv.at(l, B3.compress8(cv, m, ctr, step, hi, blen, flags)) ==
    B3.compress(cv.at(l, cv), m.at(l, m), (ctr + (step * Lane.u32(l) : U32) : U32),
      hi, blen, flags) : B3.CV}

law par8.lane:
  for +l: Lane
  for +x: B3.CV8
  for +y: B3.CV8
  {cv.at(l, B3.par8(x, y)) == par.ref(l, x, y) : B3.CV}

# The message schedule
# --------------------
#
# Round r + 1 reads perm^r of the block: rows 1-6 of MSG_SCHEDULE in the
# official C code (c/blake3_impl.h), which compress8 reads by index.

law schedule:
  for +m0: U32
  for +m1: U32
  for +m2: U32
  for +m3: U32
  for +m4: U32
  for +m5: U32
  for +m6: U32
  for +m7: U32
  for +m8: U32
  for +m9: U32
  for +m10: U32
  for +m11: U32
  for +m12: U32
  for +m13: U32
  for +m14: U32
  for +m15: U32
  {[B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}),
    B3.perm(B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15})),
    B3.perm(B3.perm(B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}))),
    B3.perm(B3.perm(B3.perm(B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15})))),
    B3.perm(B3.perm(B3.perm(B3.perm(B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}))))),
    B3.perm(B3.perm(B3.perm(B3.perm(B3.perm(B3.perm(B3.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}))))))] ==
    [B3.M16{m2, m6, m3, m10, m7, m0, m4, m13, m1, m11, m12, m5, m9, m14, m15, m8},
    B3.M16{m3, m4, m10, m12, m13, m2, m7, m14, m6, m5, m9, m0, m11, m15, m8, m1},
    B3.M16{m10, m7, m12, m9, m14, m3, m13, m15, m4, m0, m11, m2, m5, m8, m1, m6},
    B3.M16{m12, m13, m9, m11, m15, m10, m14, m8, m7, m2, m5, m3, m0, m1, m6, m4},
    B3.M16{m9, m14, m11, m5, m8, m12, m15, m1, m13, m3, m0, m10, m2, m6, m4, m7},
    B3.M16{m11, m15, m5, m0, m1, m9, m8, m6, m14, m10, m2, m12, m3, m4, m7, m13}] : List<&2, B3.M16>}

# Constants
# ---------
#
# The IV and the four domain flags, against the official C code's
# (c/blake3_impl.h, read by the generator like MSG_SCHEDULE). The flags are
# distinct bits: a chunk's blocks, a parent and the root never compress
# alike.

law consts.iv:
  {B3.IV() == B3.CV{1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225} : B3.CV}

law consts.flags:
  {[B3.CHUNK_START(), B3.CHUNK_END(), B3.PARENT(), B3.ROOT()] == [1, 2, 4, 8] :
    List<&2, U32>}

# The CPU tree, for every input
# -----------------------------
#
# The reference is blake3.bend's scalar tree: tree1 over the chunks, each
# chunk chained block by block through compress, one at a time. H.hash runs
# tree8 instead: eight chunks at once through compress8, 32-chunk leaves,
# and node kinds computed from a U32 copy of the depth. For every array and
# every span (any counter base and high word, chunk count, last chunk's
# length and root flag) the two give the same CV (proof/cpu.bend).

def ref.go(+k: Nat, a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> B3.CV:
  match k:
    case 0n:
      B3.chunk(a, 0, cb, hi, nch, last, rf)
    case 1n+p:
      B3.tree1(~share, 1n+p, B3.big(1n+p, nch), share(a), 0, nch, cb, hi, nch, last, rf)

# The scalar tree over a span, as hash.at takes it.
def ref.at(a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> B3.CV:
  ref.go(B3.depth(nch), a, cb, hi, nch, last, rf)

# The scalar tree over a len-byte input, as hash takes it.
def ref(a: Array<U32>, +len: U32) -> B3.CV:
  +n = B3.chunks(len)
  ref.at(a, 0, 0, n, B3.tail(len, n), B3.ROOT())

# The laws' copy is Array.fork's own body, (a, a): Base defines Array.fork
# as `(a, a)` (it is @unsafe because the runtime then shares one buffer).
law share.fork:
  for a: Array<U32>
  {share(a) == (a, a) : Array<U32> & Array<U32>}

law cpu.at:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.hash.at(~share, a, cb, hi, nch, last, rf) == ref.at(a, cb, hi, nch, last, rf) : B3.CV}

law cpu.hash:
  for a: Array<U32>
  for +len: U32
  {B3.hash(~share, a, len) == ref(a, len) : B3.CV}

# The GPU tree, for every input
# -----------------------------
#
# hash1 is the shape the GPU runs: it forks down to whole, full subtrees of
# 4, 16 or 64 chunks, one lane each, and at leaf level 6 hands bigger whole
# subtrees to strided lanes (ADR 0011). For every array and every span it
# gives the scalar tree's CV (proof/gpu.bend).

law gpu.at:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.hash1.at(~share, a, cb, hi, nch, last, rf) == ref.at(a, cb, hi, nch, last, rf) : B3.CV}

law gpu.hash:
  for a: Array<U32>
  for +len: U32
  {B3.hash1(~share, a, len) == ref(a, len) : B3.CV}

# The keyed tree, for every input
# -------------------------------
#
# BLAKE3's keyed and key-derivation modes hash the same tree from another
# key, with a mode flag on every compression (blake3.bend's .k defs). The
# library's engine runs them on hash8.at.k, the CPU's 8-lane tree; for
# every array, span, key and flag it is the scalar keyed tree, hash.at.k
# (proof/keyed.bend).

law keyed.at:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +key: B3.CV
  for +kf: U32
  {B3.hash8.at.k(~share, a, cb, hi, nch, last, rf, key, kf) == B3.hash.at.k(~share, a, cb, hi, nch, last, rf, key, kf) : B3.CV}

# Outboards
# ---------
#
# iroh-blobs' bao outboard comes from tree8o (hash.ob, hash.ob.at): the CPU
# tree that also keeps the pairs above every 16-chunk group. For every input
# array, every length and every span, its CV is the plain tree's, so writing
# an outboard never changes the hash. The proof never reads the array: both
# trees make the same reads, node for node.

law ob.hash:
  for a: Array<U32>
  for +len: U32
  {Pair.fst(B3.CV, B3.OB, B3.hash.ob(~share, a, len)) == B3.hash(~share, a, len) :
    B3.CV}

law ob.at:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {Pair.fst(B3.CV, B3.OB, B3.hash.ob.at(~share, a, cb, hi, nch, last, rf)) ==
    B3.hash.at(~share, a, cb, hi, nch, last, rf) : B3.CV}

# Tree shapes
# -----------
#
# A Shape is a tree with the chunks at its leaves, left to right, so a law
# about Shapes holds for any compression function. BLAKE3's tree over the
# chunks 0..r (r + 1 of them, at most 2^k) is tree(digits(k, r, [])): reading
# the k binary digits of r from the top, a 1 at a node of depth d means the
# last chunk is past the first 2^(d-1), so the node is a parent of the
# complete tree over those 2^(d-1) chunks and the tree over the rest; a 0
# means every chunk fits in the left half, and the node is that half. That is
# blake3.bend's tree1 split (big: n > 2^p, for n = r + 1 chunks): the law
# tree1.digits proves the two agree.

type Shape is Data:
  Tip{}
  Fork{l: Shape, r: Shape}

# The complete tree over 2^k chunks.
def full(+k: Nat) -> Shape:
  match k:
    case 0n:
      Tip{}
    case 1n+p:
      Fork{full(p), full(p)}

# BLAKE3's tree for the binary digits ds (most significant first) of the
# last chunk's index.
def tree(+ds: List<&2, Bool>) -> Shape:
  match ds:
    case Nil{}:
      Tip{}
    case Con{True{}, rest}:
      Fork{full(List.length(&2, Bool, rest)), tree(rest)}
    case Con{False{}, rest}:
      tree(rest)

def half(+v: Nat) -> Nat:
  match v:
    case 0n:
      0n
    case 1n+p:
      match p:
        case 0n:
          0n
        case 1n+q:
          1n+half(q)

def odd(+v: Nat) -> Bool:
  match v:
    case 0n:
      False{}
    case 1n+p:
      match p:
        case 0n:
          True{}
        case 1n+q:
          odd(q)

# v >> k
def shr(+k: Nat, +v: Nat) -> Nat:
  match k:
    case 0n:
      v
    case 1n+p:
      shr(p, half(v))

# The low k binary digits of v, most significant first, in front of acc.
def digits(+k: Nat, +v: Nat, +acc: List<&2, Bool>) -> List<&2, Bool>:
  match k:
    case 0n:
      acc
    case 1n+p:
      digits(p, half(v), odd(v) <> acc)

# blake3.bend's tree1 on Nat chunk counts: a node of depth k over n chunks
# (1 <= n <= 2^k) is a parent when n > 2^(k-1) (`big`), of the complete
# tree over the first 2^(k-1) chunks and the tree over the rest.
def pow2(+k: Nat) -> Nat:
  match k:
    case 0n:
      1n
    case 1n+p:
      Nat.double(pow2(p))

def big(+k: Nat, +n: Nat) -> Bool:
  match k:
    case 0n:
      False{}
    case 1n+p:
      Nat.is_gt(n, pow2(p))

def tree1(+k: Nat, b: Bool, +n: Nat) -> Shape:
  match k b:
    case 0n _:
      Tip{}
    case 1n+p False{}:
      tree1(p, big(p, n), n)
    case 1n+p True{}:
      +h = pow2(p)
      +n2 = Nat.sub(n, h)
      Fork{tree1(p, big(p, h), h), tree1(p, big(p, n2), n2)}

# tree(digits) is tree1's rule: the node of depth k over r + 1 chunks
# (r < 2^k) is the tree of r's k digits, for every chunk count.
law tree1.digits:
  for +k: Nat
  for +r: Nat
  for e: {shr(k, r) == 0n : Nat}
  {tree1(k, big(k, 1n+r), 1n+r) == tree(digits(k, r, [])) : Shape}

# Every leaf of t, made the complete tree over 2^k chunks.
def grow(t: Shape, +k: Nat) -> Shape:
  match t:
    case Tip{}:
      full(k)
    case Fork{l, r}:
      Fork{grow(l, k), grow(r, k)}

# The tree over a big input's segments, t, with each segment's own tree at
# its leaf: every one but the last (rightmost) is complete; the last is
# BLAKE3's tree over the digits lo of the last chunk's offset in it.
def graft(t: Shape, +lo: List<&2, Bool>) -> Shape:
  match t:
    case Tip{}:
      tree(lo)
    case Fork{l, r}:
      Fork{grow(l, List.length(&2, Bool, lo)), graft(r, lo)}

# Segments (ADR 0004): with 2^k chunks a segment, the tree over chunks
# 0..r is the parts' own BLAKE3 tree over segments 0..(r >> k), each segment
# a complete subtree but the last. So b3sum may hash a file's 1 GiB parts
# (k = 20) as separate spans and merge them with parents, for any file size.
law segments:
  for +k: Nat
  for +j: Nat
  for +r: Nat
  {tree(digits(Nat.add(k, j), r, [])) ==
    graft(tree(digits(j, shr(k, r), [])), digits(k, r, [])) : Shape}

# The r + 1 chunks, one leaf each.
def leaves(+r: Nat) -> List<&2, Shape>:
  match r:
    case 0n:
      [Tip{}]
    case 1n+p:
      Tip{} <> leaves(p)

# One level of a GPU reduction: neighbours pair up, an odd last one goes up
# unchanged.
def pairs(+xs: List<&2, Shape>) -> List<&2, Shape>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, rest}:
      match rest:
        case Nil{}:
          [x]
        case Con{y, more}:
          Fork{x, y} <> pairs(more)

# k levels of pairs.
def reduce(+k: Nat, +xs: List<&2, Shape>) -> List<&2, Shape>:
  match k:
    case 0n:
      xs
    case 1n+p:
      reduce(p, pairs(xs))

# v complete trees over 2^len(lo) chunks each, then BLAKE3's tree over lo.
def row(+v: Nat, +lo: List<&2, Bool>) -> List<&2, Shape>:
  List.append(&2, Shape, List.replicate(Shape, v, full(List.length(&2, Bool, lo))),
    [tree(lo)])

# Levels: after k levels of pairing the r + 1 chunk leaves, the row holds
# r >> k complete subtrees of 2^k chunks, then BLAKE3's tree over the rest.
law levels:
  for +k: Nat
  for +r: Nat
  {reduce(k, leaves(r)) == row(shr(k, r), digits(k, r, [])) : List<&2, Shape>}

# So once 2^k > r, a level-by-level GPU reduction is BLAKE3's tree.
law levels.root:
  for +k: Nat
  for +r: Nat
  for e: {shr(k, r) == 0n : Nat}
  {reduce(k, leaves(r)) == [tree(digits(k, r, []))] : List<&2, Shape>}

# Counts: the leaves and the parents of a tree.
def tips(+t: Shape) -> Nat:
  match t:
    case Tip{}:
      1n
    case Fork{l, r}:
      Nat.add(tips(l), tips(r))

def forks(+t: Shape) -> Nat:
  match t:
    case Tip{}:
      0n
    case Fork{l, r}:
      1n+Nat.add(forks(l), forks(r))

# BLAKE3's tree over chunks 0..r has r + 1 leaves, for every r < 2^k: no
# chunk is dropped or hashed twice...
law tree.leaves:
  for +k: Nat
  for +r: Nat
  for e: {shr(k, r) == 0n : Nat}
  {tips(tree(digits(k, r, []))) == 1n+r : Nat}

# ...and r parents: n chunks cost n - 1 parent compressions, and the tree
# above a blob's g chunk groups (by `segments`, with k = 4) has g - 1
# parents, the pairs of its bao outboard.
law tree.parents:
  for +k: Nat
  for +r: Nat
  for e: {shr(k, r) == 0n : Nat}
  {forks(tree(digits(k, r, []))) == r : Nat}

# BLAKE3's tree, on the code
# --------------------------
#
# The CV of shape t over the chunks of a span from chunk c: a Tip is that
# chunk (blake3.bend's chunk), a Fork the parent of its two sides, the
# right one from c + (the left side's leaf count). Each side takes its own
# copy of the input (share), as tree1's nodes do.
def ev(+t: Shape, aa: Array<U32> & Array<U32>, +c: U32, +cb: U32, +hi: U32,
  +nch: U32, +last: U32, +rf: U32) -> B3.CV:
  match t:
    case Tip{}:
      (a1, a2) = aa
      _ = a2
      B3.chunk(a1, c, cb, hi, nch, last, rf)
    case Fork{l, r}:
      (a1, a2) = aa
      B3.parent(ev(l, share(a1), c, cb, hi, nch, last, 0),
        ev(r, share(a2), (c + U32.from_nat(tips(l)) : U32), cb, hi, nch, last, 0), rf)

# So the tree laws are about the code: for every array and every span, the
# scalar tree is BLAKE3's tree over the span's chunks, tree(digits) of the
# last chunk's index, each leaf a chunk and each node a parent
# (proof/spec.bend)...
# ev with a key and a mode flag: BLAKE3's keyed and key-derivation modes.
def ev.k(+t: Shape, aa: Array<U32> & Array<U32>, +c: U32, +cb: U32, +hi: U32,
  +nch: U32, +last: U32, +rf: U32, +key: B3.CV, +kf: U32) -> B3.CV:
  match t:
    case Tip{}:
      (a1, a2) = aa
      _ = a2
      B3.chunk.k(a1, c, cb, hi, nch, last, rf, key, kf)
    case Fork{l, r}:
      (a1, a2) = aa
      B3.parent.k(ev.k(l, share(a1), c, cb, hi, nch, last, 0, key, kf),
        ev.k(r, share(a2), (c + U32.from_nat(tips(l)) : U32), cb, hi, nch, last, 0, key, kf), rf, key, kf)

law ref.spec:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {ref.at(a, cb, hi, nch, last, rf) ==
    ev(tree(digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), share(a), 0, cb, hi, nch, last, rf) : B3.CV}

# ...and so are the trees that run: the CPU's (cpu.at) and the GPU's (gpu.at).
law cpu.spec:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.hash.at(~share, a, cb, hi, nch, last, rf) ==
    ev(tree(digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), share(a), 0, cb, hi, nch, last, rf) : B3.CV}

law gpu.spec:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.hash1.at(~share, a, cb, hi, nch, last, rf) ==
    ev(tree(digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), share(a), 0, cb, hi, nch, last, rf) : B3.CV}

# The keyed tree that runs (keyed.at) is BLAKE3's keyed tree.
law keyed.spec:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +key: B3.CV
  for +kf: U32
  {B3.hash8.at.k(~share, a, cb, hi, nch, last, rf, key, kf) ==
    ev.k(tree(digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), share(a), 0, cb, hi, nch, last, rf, key, kf) : B3.CV}

# Streaming
# ---------
#
# A file the page cache cannot hold streams (b3io.bend's FStream): its
# 1 GiB segments are hashed one after another, and their CVs merge on a
# stack as BLAKE3's Hasher merges chunks, lazily: before segment k joins,
# the top two merge while k is even, so the last merge knows it is the
# root. These defs model stack.bend's stk.pop2, stk.even, stk.lazy,
# stk.fin, stk.root and stk.go with a Tree for a CV (Seg{k} is segment
# k's, Par a parent; the ROOT flag is not modelled) and a Nat for the U32
# count; `fuel` bounds the merges, 32 in stack.bend. stream.hash, below,
# is about stack.bend's own defs.

type Tree is Data:
  Seg{k: Nat}
  Par{l: Tree, r: Tree}

def stk.pop2(s: List<&2, Tree>) -> List<&2, Tree>:
  match s:
    case Con{r, rest}:
      match rest:
        case Con{l, more}:
          Par{l, r} <> more
        case Nil{}:
          [r]
    case Nil{}:
      []

# n is even and not 0.
def stk.even(+n: Nat) -> Bool:
  match n:
    case 0n:
      False{}
    case 1n+p:
      odd(p)

def stk.lazy(fuel: Nat, s: List<&2, Tree>, +n: Nat, b: Bool) -> List<&2, Tree>:
  match fuel b:
    case 0n _:
      s
    case 1n+f True{}:
      +m = half(n)
      stk.lazy(f, stk.pop2(s), m, stk.even(m))
    case 1n+f False{}:
      s

def stk.fin(s: List<&2, Tree>, r: Tree) -> Tree:
  match s:
    case Nil{}:
      r
    case Con{l, rest}:
      stk.fin(rest, Par{l, r})

def stk.root(s: List<&2, Tree>) -> Tree:
  match s:
    case Con{top, rest}:
      stk.fin(rest, top)
    case Nil{}:
      Seg{0n}

# n segments to go, from segment k.
def stream.go(n: Nat, +fuel: Nat, +k: Nat, s: List<&2, Tree>) -> Tree:
  match n:
    case 0n:
      stk.root(s)
    case 1n+p:
      stream.go(p, fuel, 1n+k, Seg{k} <> stk.lazy(fuel, s, k, stk.even(k)))

# A Tree's shape, and its segments left to right.
def shape(+t: Tree) -> Shape:
  match t:
    case Seg{k}:
      Tip{}
    case Par{l, r}:
      Fork{shape(l), shape(r)}

def order(+t: Tree) -> List<&2, Nat>:
  match t:
    case Seg{k}:
      [k]
    case Par{l, r}:
      List.append(&2, Nat, order(l), order(r))

# The n numbers from k.
def range(+n: Nat, +k: Nat) -> List<&2, Nat>:
  match n:
    case 0n:
      []
    case 1n+p:
      k <> range(p, 1n+k)

# The stack builds BLAKE3's tree over r + 1 segments, for every r < 2^fuel...
law stream.shape:
  for +f: Nat
  for +r: Nat
  for e: {shr(f, r) == 0n : Nat}
  {shape(stream.go(1n+r, f, 0n, [])) == tree(digits(f, r, [])) : Shape}

# ...with every segment once, in order, whatever the fuel. A shape and its
# leaves in order are the whole tree: the streamed hash is the mapped one.
law stream.order:
  for +f: Nat
  for +r: Nat
  {order(stream.go(1n+r, f, 0n, [])) == range(1n+r, 0n) : List<&2, Nat>}

# The stack that runs
# -------------------
#
# stack.bend's stk.go is the loop b3io runs, its reads a template: b3io's
# read and hash a segment, these answer from a list, segment k's CV being
# seg(cs, k).

def seg(+cs: List<&2, B3.CV>, +k: Nat) -> B3.CV:
  match cs:
    case Nil{}:
      B3.IV()
    case Con{c, rest}:
      match k:
        case 0n:
          c
        case 1n+j:
          seg(rest, j)

def seg.rd(cs: List<&2, B3.CV>, k: U32) -> IO(B3.CV):
  IO.pure(B3.CV, seg(cs, U32.to_nat(k)))

# The CV of shape t over the segments from j: a Tip is segment j's CV, a
# Fork the parent of its sides, the right one from j + (the left side's
# leaf count); rf on the top parent.
def ev.segs(+t: Shape, +j: Nat, +cs: List<&2, B3.CV>, +rf: U32) -> B3.CV:
  match t:
    case Tip{}:
      seg(cs, j)
    case Fork{l, r}:
      B3.parent(ev.segs(l, j, cs, 0), ev.segs(r, Nat.add(j, tips(l)), cs, 0), rf)

# For every count of segments and every CV the reads answer, the loop that
# runs answers BLAKE3's tree over the segments, tree(digits) of the last
# one's index, each leaf a segment's CV and each node a parent, ROOT on the
# top one. One segment is its own CV, unflagged: b3io hashes a one-segment
# stream with ROOT instead (b3io's stream.one).
law stream.hash:
  for +nseg: U32
  for +e: {U32.is_ne(nseg, 0) == True{} : Bool}
  for +cs: List<&2, B3.CV>
  {St.stk.go(~List<&2, B3.CV>, ~seg.rd, U32.to_nat(nseg), cs, 0, St.KNil{}) ==
    IO.pure(B3.CV, ev.segs(tree(digits(32n, Nat.sub(U32.to_nat(nseg), 1n), [])), 0n, cs, B3.ROOT())) : IO(B3.CV)}
