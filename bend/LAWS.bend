# The GPU tree (hash.bend's H.hash1, run with !).
law kat.hash1.len0:
  {B3.hex(B3.hash1(~share, vec(0), 0)) ==
    "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262" : String}

law kat.hash1.len2049:
