# Laws of BLAKE3 in Bend2
# =======================
#
# GENERATED by tools/gen_laws.py: edit the generator, not this file.
#
# What blake3.bend must satisfy, as claims the checker holds it to. PROOF.bend
# proves every one, and `bend PROOF.bend` is the gate: ALL PROOFS CHECK.
#
# - Known answers: the official test vectors, computed by the checker itself
#   through the defs that run (the CPU tree, the GPU tree, a GPU leaf, and
#   spans with a chunk-counter base, as b3sum hashes a big file's parts: one
#   past 4 TiB, whose counter has a high word).
# - The 8-lane path: for every input, each lane of compress8 and of par8 is
#   the scalar compress or parent of that lane (both counter words too).
# - The CPU tree: for every array and every span (both words of its chunk
#   counter), H.hash's 8-lane tree is blake3.bend's scalar tree (tree1, one
#   chunk at a time), and the laws' copy of the input (share) is
#   Array.fork's own body.
# - The GPU tree: for every array and every span, hash1's tree (flat 4-,
#   16- and 64-chunk leaves, strided lanes for bigger subtrees) is the
#   scalar tree too.
# - The keyed tree: for every array, span, key and mode flag, the 8-lane
#   tree of the keyed and key-derivation modes is the scalar keyed tree.
# - BLAKE3's tree: the scalar, CPU, GPU and keyed trees compute BLAKE3's
#   left-full tree over the chunks (ev of the tree model below), so the
#   tree laws are about the code.
# - The message schedule: perm iterated is the C code's MSG_SCHEDULE.
# - Constants: the IV and the flags are the C code's.
# - Outboards: for every input, the tree that writes iroh's bao outboard
#   gives the plain tree's hash.
# - Tree shapes, for any compression function: BLAKE3's left-full tree over
#   n chunks splits into its 2^k-chunk segments (ADR 0004), and pairing
#   neighbours level by level, the odd one carried up (a GPU reduction),
#   builds that same tree, with n leaves and n - 1 parents. tree1's split
#   rule (n > 2^p) is the digit form these use, for every chunk count.
# - Streaming: the loop that hashes a streamed file's segments (stack.bend's
#   stk.go, which b3io runs) answers BLAKE3's tree over the segments' CVs,
#   for every count of segments: its lazy merge stack builds that tree,
#   every segment once and in order.

import Base
import ./blake3.bend as B3
import ./stack.bend as St

# Known answers
# -------------
#
# The input of an official vector (test_vectors.json): byte i is i % 251.
# The trees take `~share`, a proof-safe copy of the input for each half,
# where hash.bend passes Array.fork; nothing else differs.

def share(a: Array<U32>) -> Array<U32> & Array<U32>:
  Array.clone(U32, a)

def vec.byte(+i: U32, +len: U32) -> U32:
  ((i % 251 : U32) .&. (0 - Bool.to_u32(U32.is_lt(i, len)) : U32) : U32)

def vec.word(+j: U32, +len: U32) -> U32:
  +i = (j << 2n : U32)
  (vec.byte(i, len) .|. (vec.byte((i + 1 : U32), len) << 8n : U32) .|.
    (vec.byte((i + 2 : U32), len) << 16n : U32) .|.
    (vec.byte((i + 3 : U32), len) << 24n : U32) : U32)

# The 2^d words from word j of a len-byte input, zero past len.
def vec.fill(+d: Nat, +j: U32, +len: U32) -> Array<U32>:
  match d:
    case 0n:
      ALeaf{vec.word(j, len)}
    case 1n+p:
      ANode{vec.fill(p, j, len), vec.fill(p, (j + U32.shln(1, p) : U32), len)}

# A len-byte input, zero-padded to a power of two words, one block at least.
def vec(+len: U32) -> Array<U32>:
  vec.fill(B3.depth(U32.max((((len + 63 : U32) >> 6n : U32) << 4n : U32), 16)),
    0, len)

# The CPU tree (8-lane leaves; hash.bend's H.hash).
law kat.hash.len0:
  {B3.hex(B3.hash(~share, vec(0), 0)) ==
    "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262" : String}

law kat.hash.len1:
  {B3.hex(B3.hash(~share, vec(1), 1)) ==
    "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213" : String}

law kat.hash.len64:
