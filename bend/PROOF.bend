# Counts
# ------
#
# Pairing never drops or adds a leaf, so `levels.root` counts the tree's
# leaves; a tree has one parent fewer than leaves.

def total(+xs: List<&2, Laws.Shape>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{x, rest}:
      Nat.add(Laws.tips(x), total(rest))

def pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

law add_zero:
  for +a: Nat
  {a == Nat.add(a, 0n) : Nat}

def add_zero(a):
  match a:
    case 0n:
      {==}
    case 1n+p:
      %add_zero(p) : {1n+p == 1n+_ : Nat}
      {==}

law add_succ:
  for +a: Nat
  for +b: Nat
  {1n+Nat.add(a, b) == Nat.add(a, 1n+b) : Nat}

def add_succ(a, b):
  match a:
    case 0n:
      {==}
    case 1n+p:
      %add_succ(p, b) : {1n+1n+Nat.add(p, b) == 1n+_ : Nat}
      {==}

law add_assoc:
  for +a: Nat
  for +b: Nat
  for +c: Nat
  {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}

def add_assoc(a, b, c):
  match a:
    case 0n:
      {==}
    case 1n+p:
      %add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

law tips_forks:
  for +t: Laws.Shape
  {1n+Laws.forks(t) == Laws.tips(t) : Nat}

def tips_forks(t):
  match t:
    case Laws.Tip{}:
      {==}
    case Laws.Fork{l, r}:
      %tips_forks(l) : {1n+1n+Nat.add(Laws.forks(l), Laws.forks(r)) == Nat.add(_, Laws.tips(r)) : Nat}
      %tips_forks(r) : {1n+1n+Nat.add(Laws.forks(l), Laws.forks(r)) == 1n+Nat.add(Laws.forks(l), _) : Nat}
      %add_succ(Laws.forks(l), Laws.forks(r)) : {1n+1n+Nat.add(Laws.forks(l), Laws.forks(r)) == 1n+_ : Nat}
      {==}

law pairs_total:
  for +xs: List<&2, Laws.Shape>
  {total(Laws.pairs(xs)) == total(xs) : Nat}

def pairs_total(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{x, rest}:
      match rest:
        case Nil{}:
          {==}
        case Con{y, more}:
          %pairs_total(more) : {Nat.add(Nat.add(Laws.tips(x), Laws.tips(y)), total(Laws.pairs(more))) ==
            Nat.add(Laws.tips(x), Nat.add(Laws.tips(y), _)) : Nat}
          add_assoc(Laws.tips(x), Laws.tips(y), total(Laws.pairs(more)))

law reduce_total:
  for +k: Nat
  for +xs: List<&2, Laws.Shape>
  {total(Laws.reduce(k, xs)) == total(xs) : Nat}

def reduce_total(k, xs):
  match k:
    case 0n:
      {==}
    case 1n+p:
      %pairs_total(xs) : {total(Laws.reduce(p, Laws.pairs(xs))) == _ : Nat}
      reduce_total(p, Laws.pairs(xs))

law leaves_total:
  for +r: Nat
  {total(Laws.leaves(r)) == 1n+r : Nat}

def leaves_total(r):
  match r:
    case 0n:
      {==}
    case 1n+p:
      %leaves_total(p) : {1n+total(Laws.leaves(p)) == 1n+_ : Nat}
      {==}

def Laws.tree.leaves(k, r, e):
  %leaves_total(r) : {Laws.tips(Laws.tree(Laws.digits(k, r, []))) == _ : Nat}
  %reduce_total(k, Laws.leaves(r)) : {Laws.tips(Laws.tree(Laws.digits(k, r, []))) == _ : Nat}
  %Equal.sym(List<&2, Laws.Shape>, Laws.reduce(k, Laws.leaves(r)), [Laws.tree(Laws.digits(k, r, []))],
    Laws.levels.root(k, r, e)) : {Laws.tips(Laws.tree(Laws.digits(k, r, []))) == total(_) : Nat}
  add_zero(Laws.tips(Laws.tree(Laws.digits(k, r, []))))

def Laws.tree.parents(k, r, e):
  Equal.cong(Nat, Nat, pred, 1n+Laws.forks(Laws.tree(Laws.digits(k, r, []))), 1n+r,
    Equal.trans(Nat, 1n+Laws.forks(Laws.tree(Laws.digits(k, r, []))), Laws.tips(Laws.tree(Laws.digits(k, r, []))), 1n+r,
      tips_forks(Laws.tree(Laws.digits(k, r, []))), Laws.tree.leaves(k, r, e)))

# Streaming
# ---------
#
# The stack's shapes (sh.*: stk.* on Shapes). After segments 0..v the
# stack is Tip over bits(f, 0, v): v's 1 digits, lowest on top, each the
# complete tree of its level (bits keeps an overflow as a pile, so the
# merge lemma needs no bound). The merges before segment 1 + v carry v's
# trailing 1s like a binary increment (lazy.inc), and the last fold reads
# the digits from the top (fold), as `tree` does.

def sh.pop2(s: List<&2, Laws.Shape>) -> List<&2, Laws.Shape>:
  match s:
    case Con{r, rest}:
      match rest:
        case Con{l, more}:
          Laws.Fork{l, r} <> more
        case Nil{}:
          [r]
    case Nil{}:
      []

def sh.lazy(fuel: Nat, s: List<&2, Laws.Shape>, +n: Nat, b: Bool) -> List<&2, Laws.Shape>:
  match fuel b:
    case 0n _:
      s
    case 1n+f True{}:
      +m = Laws.half(n)
      sh.lazy(f, sh.pop2(s), m, Laws.stk.even(m))
    case 1n+f False{}:
      s

def sh.fin(s: List<&2, Laws.Shape>, r: Laws.Shape) -> Laws.Shape:
  match s:
    case Nil{}:
      r
    case Con{l, rest}:
      sh.fin(rest, Laws.Fork{l, r})

def sh.root(s: List<&2, Laws.Shape>) -> Laws.Shape:
  match s:
    case Con{top, rest}:
      sh.fin(rest, top)
    case Nil{}:
      Laws.Tip{}

def sh.go(n: Nat, +fuel: Nat, +k: Nat, s: List<&2, Laws.Shape>) -> Laws.Shape:
  match n:
    case 0n:
      sh.root(s)
    case 1n+p:
      sh.go(p, fuel, 1n+k, Laws.Tip{} <> sh.lazy(fuel, s, k, Laws.stk.even(k)))

def push.if(b: Bool, x: Laws.Shape, xs: List<&2, Laws.Shape>) -> List<&2, Laws.Shape>:
  match b:
    case True{}:
      x <> xs
    case False{}:
      xs

def bits(+j: Nat, +i: Nat, +v: Nat) -> List<&2, Laws.Shape>:
  match j:
    case 0n:
      List.replicate(Laws.Shape, v, Laws.full(i))
    case 1n+p:
      push.if(Laws.odd(v), Laws.full(i), bits(p, 1n+i, Laws.half(v)))

def disc.b(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

law absurd.tf:
  for e: {True{} == False{} : Bool}
  Empty

def absurd.tf(e):
  %e : disc.b(_)
  Unit{}

law absurd.ft:
  for e: {False{} == True{} : Bool}
  Empty

def absurd.ft(e):
  absurd.tf(Equal.sym(Bool, False{}, True{}, e))

law par.even:
  for +w: Nat
  for +eo: {Laws.odd(w) == False{} : Bool}
  {True{} == Laws.odd(1n+w) : Bool}

def par.even(w, eo):
  match w:
    case 0n:
      {==}
    case 1n+u:
      match u:
        case 0n:
          Empty.absurd({True{} == Laws.odd(1n+1n+0n) : Bool}, absurd.tf(eo))
        case 1n+t:
          par.even(t, eo)

law half.even:
  for +w: Nat
  for +eo: {Laws.odd(w) == False{} : Bool}
  {Laws.half(w) == Laws.half(1n+w) : Nat}

def half.even(w, eo):
  match w:
    case 0n:
      {==}
    case 1n+u:
      match u:
        case 0n:
          Empty.absurd({Laws.half(1n+0n) == Laws.half(1n+1n+0n) : Nat}, absurd.tf(eo))
        case 1n+t:
          %half.even(t, eo) : {1n+Laws.half(t) == 1n+_ : Nat}
          {==}

law par.odd:
  for +w: Nat
  for +eo: {Laws.odd(w) == True{} : Bool}
  {False{} == Laws.odd(1n+w) : Bool}

def par.odd(w, eo):
  match w:
    case 0n:
      Empty.absurd({False{} == Laws.odd(1n+0n) : Bool}, absurd.ft(eo))
    case 1n+u:
      match u:
        case 0n:
          {==}
        case 1n+t:
          par.odd(t, eo)

law half.odd:
  for +w: Nat
  for +eo: {Laws.odd(w) == True{} : Bool}
  {1n+Laws.half(w) == Laws.half(1n+w) : Nat}

def half.odd(w, eo):
  match w:
    case 0n:
      Empty.absurd({1n+Laws.half(0n) == Laws.half(1n+0n) : Nat}, absurd.ft(eo))
    case 1n+u:
      match u:
        case 0n:
          {==}
        case 1n+t:
          %half.odd(t, eo) : {1n+1n+Laws.half(t) == 1n+_ : Nat}
          {==}

# Before segment 1 + w joins, a carry full(i) over the trees of w's digits
# from level i merges into the trees of 1 + w's.
law lazy.inc:
  for +q: Nat
  for +i: Nat
  for +w: Nat
  for +b: Bool
  for +eo: {Laws.odd(w) == b : Bool}
  {sh.lazy(q, Laws.full(i) <> bits(q, i, w), 1n+w, Laws.stk.even(1n+w)) == bits(q, i, 1n+w) :
    List<&2, Laws.Shape>}

def lazy.inc(q, i, w, b, eo):
  match q:
    case 0n:
      {==}
    case 1n+p:
      match b:
        case False{}:
          %Equal.sym(Bool, Laws.odd(w), False{}, eo) : {sh.lazy(1n+p, Laws.full(i) <> push.if(_,
            Laws.full(i), bits(p, 1n+i, Laws.half(w))), 1n+w, _) == push.if(Laws.odd(1n+w), Laws.full(i),
            bits(p, 1n+i, Laws.half(1n+w))) : List<&2, Laws.Shape>}
          %par.even(w, eo) : {Laws.full(i) <> bits(p, 1n+i, Laws.half(w)) == push.if(_, Laws.full(i),
            bits(p, 1n+i, Laws.half(1n+w))) : List<&2, Laws.Shape>}
          %half.even(w, eo) : {Laws.full(i) <> bits(p, 1n+i, Laws.half(w)) ==
            Laws.full(i) <> bits(p, 1n+i, _) : List<&2, Laws.Shape>}
          {==}
        case True{}:
          %Equal.sym(Bool, Laws.odd(w), True{}, eo) : {sh.lazy(1n+p, Laws.full(i) <> push.if(_,
            Laws.full(i), bits(p, 1n+i, Laws.half(w))), 1n+w, _) == push.if(Laws.odd(1n+w), Laws.full(i),
            bits(p, 1n+i, Laws.half(1n+w))) : List<&2, Laws.Shape>}
          %par.odd(w, eo) : {sh.lazy(p, Laws.full(1n+i) <> bits(p, 1n+i, Laws.half(w)), Laws.half(1n+w),
            Laws.stk.even(Laws.half(1n+w))) == push.if(_, Laws.full(i), bits(p, 1n+i, Laws.half(1n+w))) :
            List<&2, Laws.Shape>}
          %half.odd(w, eo) : {sh.lazy(p, Laws.full(1n+i) <> bits(p, 1n+i, Laws.half(w)), _,
            Laws.stk.even(_)) == bits(p, 1n+i, _) : List<&2, Laws.Shape>}
          lazy.inc(p, 1n+i, Laws.half(w), Laws.odd(Laws.half(w)), {==})

law push.fin:
  for +b: Bool
  for +acc: List<&2, Bool>
  for +xs: List<&2, Laws.Shape>
  {sh.fin(push.if(b, Laws.full(List.length(&2, Bool, acc)), xs), Laws.tree(acc)) ==
    sh.fin(xs, Laws.tree(b <> acc)) : Laws.Shape}

def push.fin(b, acc, xs):
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# Folding the trees of v's digits onto the tree of the lower digits acc
# builds BLAKE3's tree over v's digits, then acc.
law fold:
  for +j: Nat
  for +v: Nat
  for +acc: List<&2, Bool>
  for e: {Laws.shr(j, v) == 0n : Nat}
  {sh.fin(bits(j, List.length(&2, Bool, acc), v), Laws.tree(acc)) == Laws.tree(Laws.digits(j, v, acc)) :
    Laws.Shape}

def fold(j, v, acc, e):
  match j:
    case 0n:
      %Equal.sym(Nat, v, 0n, e) : {sh.fin(List.replicate(Laws.Shape, _,
        Laws.full(List.length(&2, Bool, acc))), Laws.tree(acc)) == Laws.tree(acc) : Laws.Shape}
      {==}
    case 1n+p:
      Equal.trans(Laws.Shape, sh.fin(push.if(Laws.odd(v), Laws.full(List.length(&2, Bool, acc)),
        bits(p, 1n+List.length(&2, Bool, acc), Laws.half(v))), Laws.tree(acc)),
        sh.fin(bits(p, 1n+List.length(&2, Bool, acc), Laws.half(v)), Laws.tree(Laws.odd(v) <> acc)),
        Laws.tree(Laws.digits(p, Laws.half(v), Laws.odd(v) <> acc)),
        push.fin(Laws.odd(v), acc, bits(p, 1n+List.length(&2, Bool, acc), Laws.half(v))),
        fold(p, Laws.half(v), Laws.odd(v) <> acc, e))

# m segments to go after segments 0..v.
law sh.go.tree:
  for +m: Nat
  for +f: Nat
  for +v: Nat
  for e: {Laws.shr(f, Nat.add(v, m)) == 0n : Nat}
  {sh.go(m, f, 1n+v, Laws.Tip{} <> bits(f, 0n, v)) == Laws.tree(Laws.digits(f, Nat.add(v, m), [])) :
    Laws.Shape}

def sh.go.tree(m, f, v, e):
  match m:
    case 0n:
      %add_zero(v) : {sh.fin(bits(f, 0n, v), Laws.Tip{}) == Laws.tree(Laws.digits(f, _, [])) : Laws.Shape}
      fold(f, v, [], Equal.trans(Nat, Laws.shr(f, v), Laws.shr(f, Nat.add(v, 0n)), 0n,
        Equal.cong(Nat, Nat, x => Laws.shr(f, x), v, Nat.add(v, 0n), add_zero(v)), e))
    case 1n+p:
      %Equal.sym(List<&2, Laws.Shape>, sh.lazy(f, Laws.Tip{} <> bits(f, 0n, v), 1n+v, Laws.stk.even(1n+v)),
        bits(f, 0n, 1n+v), lazy.inc(f, 0n, v, Laws.odd(v), {==})) :
        {sh.go(p, f, 1n+1n+v, Laws.Tip{} <> _) == Laws.tree(Laws.digits(f, Nat.add(v, 1n+p), [])) : Laws.Shape}
      %add_succ(v, p) : {sh.go(p, f, 1n+1n+v, Laws.Tip{} <> bits(f, 0n, 1n+v)) ==
        Laws.tree(Laws.digits(f, _, [])) : Laws.Shape}
      sh.go.tree(p, f, 1n+v, Equal.trans(Nat, Laws.shr(f, 1n+Nat.add(v, p)),
        Laws.shr(f, Nat.add(v, 1n+p)), 0n, Equal.cong(Nat, Nat, x => Laws.shr(f, x),
        1n+Nat.add(v, p), Nat.add(v, 1n+p), add_succ(v, p)), e))

law sh.lazy.none:
  for +fuel: Nat
  for s: List<&2, Laws.Shape>
  for +n: Nat
  {sh.lazy(fuel, s, n, False{}) == s : List<&2, Laws.Shape>}

def sh.lazy.none(fuel, s, n):
  match fuel:
    case 0n:
      {==}
    case 1n+f:
      {==}

law bits.zero:
  for +j: Nat
  for +i: Nat
  {[] == bits(j, i, 0n) : List<&2, Laws.Shape>}

def bits.zero(j, i):
  match j:
    case 0n:
      {==}
    case 1n+p:
      bits.zero(p, 1n+i)

law sh.tree:
  for +f: Nat
  for +r: Nat
  for e: {Laws.shr(f, r) == 0n : Nat}
  {sh.go(1n+r, f, 0n, []) == Laws.tree(Laws.digits(f, r, [])) : Laws.Shape}

def sh.tree(f, r, e):
  %Equal.sym(List<&2, Laws.Shape>, sh.lazy(f, [], 0n, False{}), [], sh.lazy.none(f, [], 0n)) :
    {sh.go(r, f, 1n, Laws.Tip{} <> _) == Laws.tree(Laws.digits(f, r, [])) : Laws.Shape}
  %Equal.sym(List<&2, Laws.Shape>, [], bits(f, 0n, 0n), bits.zero(f, 0n)) :
    {sh.go(r, f, 1n, Laws.Tip{} <> _) == Laws.tree(Laws.digits(f, r, [])) : Laws.Shape}
  sh.go.tree(r, f, 0n, e)

# Erasing the segment numbers: the stack of Trees is the stack of Shapes.
def shapes(+s: List<&2, Laws.Tree>) -> List<&2, Laws.Shape>:
  match s:
    case Nil{}:
      []
    case Con{x, rest}:
      Laws.shape(x) <> shapes(rest)

law pop2.shape:
  for +s: List<&2, Laws.Tree>
  {shapes(Laws.stk.pop2(s)) == sh.pop2(shapes(s)) : List<&2, Laws.Shape>}

def pop2.shape(s):
  match s:
    case Con{r, rest}:
      match rest:
        case Con{l, more}:
          {==}
        case Nil{}:
          {==}
    case Nil{}:
      {==}

law lazy.shape:
  for +fuel: Nat
  for +s: List<&2, Laws.Tree>
  for +n: Nat
  for +b: Bool
  {shapes(Laws.stk.lazy(fuel, s, n, b)) == sh.lazy(fuel, shapes(s), n, b) : List<&2, Laws.Shape>}

def lazy.shape(fuel, s, n, b):
  match fuel b:
    case 0n _:
      {==}
    case 1n+f True{}:
      %pop2.shape(s) : {shapes(Laws.stk.lazy(f, Laws.stk.pop2(s), Laws.half(n), Laws.stk.even(Laws.half(n)))) ==
        sh.lazy(f, _, Laws.half(n), Laws.stk.even(Laws.half(n))) : List<&2, Laws.Shape>}
      lazy.shape(f, Laws.stk.pop2(s), Laws.half(n), Laws.stk.even(Laws.half(n)))
    case 1n+f False{}:
      {==}

law fin.shape:
  for +s: List<&2, Laws.Tree>
  for +r: Laws.Tree
  {Laws.shape(Laws.stk.fin(s, r)) == sh.fin(shapes(s), Laws.shape(r)) : Laws.Shape}

def fin.shape(s, r):
  match s:
    case Nil{}:
      {==}
    case Con{l, rest}:
      fin.shape(rest, Laws.Par{l, r})

law go.shape:
  for +n: Nat
  for +f: Nat
  for +k: Nat
  for +s: List<&2, Laws.Tree>
  {Laws.shape(Laws.stream.go(n, f, k, s)) == sh.go(n, f, k, shapes(s)) : Laws.Shape}

def go.shape(n, f, k, s):
  match n:
    case 0n:
      match s:
        case Con{top, rest}:
          fin.shape(rest, top)
        case Nil{}:
          {==}
    case 1n+p:
      %lazy.shape(f, s, k, Laws.stk.even(k)) : {Laws.shape(Laws.stream.go(p, f, 1n+k,
        Laws.Seg{k} <> Laws.stk.lazy(f, s, k, Laws.stk.even(k)))) == sh.go(p, f, 1n+k, Laws.Tip{} <> _) : Laws.Shape}
      go.shape(p, f, 1n+k, Laws.Seg{k} <> Laws.stk.lazy(f, s, k, Laws.stk.even(k)))

def Laws.stream.shape(f, r, e):
  Equal.trans(Laws.Shape, Laws.shape(Laws.stream.go(1n+r, f, 0n, [])), sh.go(1n+r, f, 0n, []),
    Laws.tree(Laws.digits(f, r, [])), go.shape(1n+r, f, 0n, []), sh.tree(f, r, e))

# Order: a merge joins neighbours, so the segments read bottom to top stay
# in order through every merge and the final fold.
def flat(+s: List<&2, Laws.Tree>) -> List<&2, Nat>:
  match s:
    case Nil{}:
      []
    case Con{x, rest}:
      List.append(&2, Nat, flat(rest), Laws.order(x))

law append_assoc.n:
  for +xs: List<&2, Nat>
  for +ys: List<&2, Nat>
  for +zs: List<&2, Nat>
  {List.append(&2, Nat, List.append(&2, Nat, xs, ys), zs) ==
    List.append(&2, Nat, xs, List.append(&2, Nat, ys, zs)) : List<&2, Nat>}

def append_assoc.n(xs, ys, zs):
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %append_assoc.n(t, ys, zs) : {x <> List.append(&2, Nat, List.append(&2, Nat, t, ys),
        zs) == x <> _ : List<&2, Nat>}
      {==}

law append_nil.n:
  for +xs: List<&2, Nat>
  {xs == List.append(&2, Nat, xs, []) : List<&2, Nat>}

def append_nil.n(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %append_nil.n(t) : {x <> t == x <> _ : List<&2, Nat>}
      {==}

law pop2.flat:
  for +s: List<&2, Laws.Tree>
  {flat(Laws.stk.pop2(s)) == flat(s) : List<&2, Nat>}

def pop2.flat(s):
  match s:
    case Con{r, rest}:
      match rest:
        case Con{l, more}:
          Equal.sym(List<&2, Nat>, List.append(&2, Nat, List.append(&2, Nat, flat(more),
            Laws.order(l)), Laws.order(r)), List.append(&2, Nat, flat(more), List.append(&2, Nat,
            Laws.order(l), Laws.order(r))), append_assoc.n(flat(more), Laws.order(l), Laws.order(r)))
        case Nil{}:
          {==}
    case Nil{}:
      {==}

law lazy.flat:
  for +fuel: Nat
  for +s: List<&2, Laws.Tree>
  for +n: Nat
  for +b: Bool
  {flat(Laws.stk.lazy(fuel, s, n, b)) == flat(s) : List<&2, Nat>}

def lazy.flat(fuel, s, n, b):
  match fuel b:
    case 0n _:
      {==}
    case 1n+f True{}:
      Equal.trans(List<&2, Nat>, flat(Laws.stk.lazy(f, Laws.stk.pop2(s), Laws.half(n), Laws.stk.even(Laws.half(n)))),
        flat(Laws.stk.pop2(s)), flat(s), lazy.flat(f, Laws.stk.pop2(s), Laws.half(n), Laws.stk.even(Laws.half(n))),
        pop2.flat(s))
    case 1n+f False{}:
      {==}

law fin.flat:
  for +s: List<&2, Laws.Tree>
  for +r: Laws.Tree
  {Laws.order(Laws.stk.fin(s, r)) == List.append(&2, Nat, flat(s), Laws.order(r)) : List<&2, Nat>}

def fin.flat(s, r):
  match s:
    case Nil{}:
      {==}
    case Con{l, rest}:
      %Equal.sym(List<&2, Nat>, List.append(&2, Nat, List.append(&2, Nat, flat(rest),
        Laws.order(l)), Laws.order(r)), List.append(&2, Nat, flat(rest), List.append(&2, Nat, Laws.order(l),
        Laws.order(r))), append_assoc.n(flat(rest), Laws.order(l), Laws.order(r))) :
        {Laws.order(Laws.stk.fin(rest, Laws.Par{l, r})) == _ : List<&2, Nat>}
      fin.flat(rest, Laws.Par{l, r})

law go.flat:
  for +n: Nat
  for +f: Nat
  for +k: Nat
  for +x: Laws.Tree
  for +rest: List<&2, Laws.Tree>
  {Laws.order(Laws.stream.go(n, f, k, x <> rest)) == List.append(&2, Nat, flat(x <> rest),
    Laws.range(n, k)) : List<&2, Nat>}

def go.flat(n, f, k, x, rest):
  match n:
    case 0n:
      %append_nil.n(flat(x <> rest)) : {Laws.order(Laws.stk.fin(rest, x)) == _ : List<&2, Nat>}
      fin.flat(rest, x)
    case 1n+p:
      %lazy.flat(f, x <> rest, k, Laws.stk.even(k)) : {Laws.order(Laws.stream.go(p, f, 1n+k,
        Laws.Seg{k} <> Laws.stk.lazy(f, x <> rest, k, Laws.stk.even(k)))) ==
        List.append(&2, Nat, _, k <> Laws.range(p, 1n+k)) : List<&2, Nat>}
      %append_assoc.n(flat(Laws.stk.lazy(f, x <> rest, k, Laws.stk.even(k))), [k], Laws.range(p, 1n+k)) :
        {Laws.order(Laws.stream.go(p, f, 1n+k, Laws.Seg{k} <> Laws.stk.lazy(f, x <> rest, k, Laws.stk.even(k)))) ==
        _ : List<&2, Nat>}
      go.flat(p, f, 1n+k, Laws.Seg{k}, Laws.stk.lazy(f, x <> rest, k, Laws.stk.even(k)))

law lazy.none:
  for +fuel: Nat
  for +s: List<&2, Laws.Tree>
  for +n: Nat
  {Laws.stk.lazy(fuel, s, n, False{}) == s : List<&2, Laws.Tree>}

def lazy.none(fuel, s, n):
  match fuel:
    case 0n:
      {==}
    case 1n+f:
      {==}

def Laws.stream.order(f, r):
  %Equal.sym(List<&2, Laws.Tree>, Laws.stk.lazy(f, [], 0n, False{}), [], lazy.none(f, [], 0n)) :
    {Laws.order(Laws.stream.go(r, f, 1n, Laws.Seg{0n} <> _)) == Laws.range(1n+r, 0n) : List<&2, Nat>}
  go.flat(r, f, 1n, Laws.Seg{0n}, [])

# The stack that runs
# -------------------
#
# stack.bend's stack on CVs is the model's stack on Trees, mapped: kst
# turns each Tree into its CV (tcv: segment k's from cs, a parent per Par),
# and pop2, lazy, fin and the loop commute with that map. The U32 steps are
# the model's Nat ones (even.k; U32.shr halves), the counter does not wrap
# while segments remain (inc.k), and the last merge is the one stk.fin
# flags ROOT. The model's laws then give the tree's shape and its
# segments' order, and an ordered tree's CV is ev.segs of its shape.

def tcv(+t: Laws.Tree, +cs: List<&2, B3.CV>, +rf: U32) -> B3.CV:
  match t:
    case Laws.Seg{k}:
      Laws.seg(cs, k)
    case Laws.Par{l, r}:
      B3.parent(tcv(l, cs, 0), tcv(r, cs, 0), rf)

def kst(+s: List<&2, Laws.Tree>, +cs: List<&2, B3.CV>) -> St.Stk:
  match s:
    case Nil{}:
      St.KNil{}
    case Con{x, rest}:
      St.KCon{tcv(x, cs, 0), kst(rest, cs)}

law pop2.k:
  for +s: List<&2, Laws.Tree>
  for +cs: List<&2, B3.CV>
  {St.stk.pop2(kst(s, cs)) == kst(Laws.stk.pop2(s), cs) : St.Stk}

def pop2.k(s, cs):
  match s:
    case Con{r, rest}:
      match rest:
        case Con{l, more}:
          {==}
        case Nil{}:
          {==}
    case Nil{}:
      {==}

# Parity: a U32's low bit is its value's.
law odd.dbl0:
  for +t: Nat
  {Laws.odd(Nat.double(t)) == False{} : Bool}

def odd.dbl0(t):
  match t:
    case 0n:
      {==}
    case 1n+q:
      odd.dbl0(q)

law odd.dbl1:
  for +t: Nat
  {Laws.odd(1n+Nat.double(t)) == True{} : Bool}

def odd.dbl1(t):
  match t:
    case 0n:
      {==}
    case 1n+q:
      odd.dbl1(q)

law even.dbl:
  for +t: Nat
  {Laws.stk.even(Nat.double(t)) == Bool.not(Nat.is_eq(Nat.double(t), 0n)) : Bool}

def even.dbl(t):
  match t:
    case 0n:
      {==}
    case 1n+q:
      odd.dbl1(q)

law and1.even:
  for +t: Word(31n)
  {U32.and(U32{WCon{False{}, t}}, 1) == 0 : U32}

def and1.even(t):
  Equal.cong(Word(31n), U32, z => U32{WCon{False{}, z}}, Word.and(31n, t, Word.zero(31n)), Word.zero(31n), A.w.and_zero(31n, t))

law and1.odd:
  for +t: Word(31n)
  {U32.and(U32{WCon{True{}, t}}, 1) == 1 : U32}

def and1.odd(t):
  Equal.cong(Word(31n), U32, z => U32{WCon{True{}, z}}, Word.and(31n, t, Word.zero(31n)), Word.zero(31n), A.w.and_zero(31n, t))

# stack.bend's stk.even is the model's, on the value.
law even.k:
  for +n: U32
  {St.stk.even(n) == Laws.stk.even(U32.to_nat(n)) : Bool}

def even.k(n):
  match n:
    case U32{w}:
      match w:
        case WCon{False{}, t}:
          %Equal.sym(U32, U32.and(U32{WCon{False{}, t}}, 1), 0, and1.even(t)) :
            {(U32.is_eq(_, 0) && U32.is_ne(U32{WCon{False{}, t}}, 0)) == Laws.stk.even(Nat.double(Word.to_nat(31n, t))) : Bool}
          %Equal.sym(Bool, U32.is_eq(U32{WCon{False{}, t}}, 0), Nat.is_eq(Nat.double(Word.to_nat(31n, t)), 0n),
            A.u.is_eq_nat(U32{WCon{False{}, t}}, 0)) :
            {Bool.not(_) == Laws.stk.even(Nat.double(Word.to_nat(31n, t))) : Bool}
          Equal.sym(Bool, Laws.stk.even(Nat.double(Word.to_nat(31n, t))), Bool.not(Nat.is_eq(Nat.double(Word.to_nat(31n, t)), 0n)),
            even.dbl(Word.to_nat(31n, t)))
        case WCon{True{}, t}:
          %Equal.sym(U32, U32.and(U32{WCon{True{}, t}}, 1), 1, and1.odd(t)) :
            {(U32.is_eq(_, 0) && U32.is_ne(U32{WCon{True{}, t}}, 0)) == Laws.stk.even(1n+Nat.double(Word.to_nat(31n, t))) : Bool}
          Equal.sym(Bool, Laws.odd(Nat.double(Word.to_nat(31n, t))), False{}, odd.dbl0(Word.to_nat(31n, t)))

law lazy.k:
  for +fuel: Nat
  for +s: List<&2, Laws.Tree>
  for +n: U32
  for +b: Bool
  for +cs: List<&2, B3.CV>
  {St.stk.lazy(fuel, kst(s, cs), n, b) == kst(Laws.stk.lazy(fuel, s, U32.to_nat(n), b), cs) : St.Stk}

def lazy.k(fuel, s, n, b, cs):
  match fuel b:
    case 0n _:
      {==}
    case 1n+f True{}:
      %S.u.shr_half(n) : {St.stk.lazy(f, St.stk.pop2(kst(s, cs)), U32.shr(n), St.stk.even(U32.shr(n))) ==
        kst(Laws.stk.lazy(f, Laws.stk.pop2(s), _, Laws.stk.even(_)), cs) : St.Stk}
      %Equal.sym(Bool, St.stk.even(U32.shr(n)), Laws.stk.even(U32.to_nat(U32.shr(n))), even.k(U32.shr(n))) :
        {St.stk.lazy(f, St.stk.pop2(kst(s, cs)), U32.shr(n), _) ==
        kst(Laws.stk.lazy(f, Laws.stk.pop2(s), U32.to_nat(U32.shr(n)), Laws.stk.even(U32.to_nat(U32.shr(n)))), cs) : St.Stk}
      %Equal.sym(St.Stk, St.stk.pop2(kst(s, cs)), kst(Laws.stk.pop2(s), cs), pop2.k(s, cs)) :
        {St.stk.lazy(f, _, U32.shr(n), Laws.stk.even(U32.to_nat(U32.shr(n)))) ==
        kst(Laws.stk.lazy(f, Laws.stk.pop2(s), U32.to_nat(U32.shr(n)), Laws.stk.even(U32.to_nat(U32.shr(n)))), cs) : St.Stk}
      lazy.k(f, Laws.stk.pop2(s), U32.shr(n), Laws.stk.even(U32.to_nat(U32.shr(n))), cs)
    case 1n+f False{}:
      {==}

# The last merge: stk.fin flags the top parent ROOT.
law fin.k:
  for +rest: List<&2, Laws.Tree>
  for +l: Laws.Tree
  for +r: Laws.Tree
  for +cs: List<&2, B3.CV>
  {St.stk.fin(kst(l <> rest, cs), tcv(r, cs, 0)) == tcv(Laws.stk.fin(l <> rest, r), cs, B3.ROOT()) : B3.CV}

def fin.k(rest, l, r, cs):
  match rest:
    case Nil{}:
      {==}
    case Con{l2, more}:
      fin.k(more, l2, Laws.Par{l, r}, cs)

# The loop's counter: k + 1 does not wrap while segments remain.
law add1:
  for +x: Nat
  {Nat.add(x, 1n) == 1n+x : Nat}

def add1(x):
  Equal.trans(Nat, Nat.add(x, 1n), 1n+Nat.add(x, 0n), 1n+x, A.add_succ(x, 0n),
    Equal.cong(Nat, Nat, z => 1n+z, Nat.add(x, 0n), x, A.add_zero(x)))

law le.addl:
  for +p: Nat
  for +x: Nat
  {Nat.is_le(x, Nat.add(p, x)) == True{} : Bool}

def le.addl(p, x):
  match p:
    case 0n:
      A.n.le_refl(x)
    case 1n+q:
      A.n.le_trans(x, Nat.add(q, x), 1n+Nat.add(q, x), le.addl(q, x), A.n.le_succ(Nat.add(q, x)))

law inc.le:
  for +x: Nat
  for +zz: Nat
  for +p: Nat
  for +e: {Nat.is_le(1n+Nat.add(p, x), zz) == True{} : Bool}
  {Nat.is_le(Nat.add(x, 1n), zz) == True{} : Bool}

def inc.le(x, zz, p, e):
  %Equal.sym(Nat, Nat.add(x, 1n), 1n+x, add1(x)) : {Nat.is_le(_, zz) == True{} : Bool}
  A.n.le_trans(1n+x, 1n+Nat.add(p, x), zz, le.addl(p, x), e)

law inc.k:
  for +k: U32
  for +z: U32
  for +p: Nat
  for +e: {Nat.is_le(1n+Nat.add(p, U32.to_nat(k)), U32.to_nat(z)) == True{} : Bool}
  {U32.to_nat((k + 1 : U32)) == 1n+U32.to_nat(k) : Nat}

def inc.k(k, z, p, e):
  Equal.trans(Nat, U32.to_nat((k + 1 : U32)), Nat.add(U32.to_nat(k), 1n), 1n+U32.to_nat(k),
    A.u.tn_add(k, 1, z, inc.le(U32.to_nat(k), U32.to_nat(z), p, e)), add1(U32.to_nat(k)))

law go.le:
  for +p: Nat
  for +k: U32
  for +z: U32
  for +e: {Nat.is_le(1n+Nat.add(p, U32.to_nat(k)), U32.to_nat(z)) == True{} : Bool}
  {Nat.is_le(Nat.add(p, U32.to_nat((k + 1 : U32))), U32.to_nat(z)) == True{} : Bool}

def go.le(p, k, z, e):
  %Equal.sym(Nat, U32.to_nat((k + 1 : U32)), 1n+U32.to_nat(k), inc.k(k, z, p, e)) :
    {Nat.is_le(Nat.add(p, _), U32.to_nat(z)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(p, 1n+U32.to_nat(k)), 1n+Nat.add(p, U32.to_nat(k)), A.add_succ(p, U32.to_nat(k))) :
    {Nat.is_le(_, U32.to_nat(z)) == True{} : Bool}
  e

# The loop: with segment j on top (the last pushed), n segments to go from
# segment k and k + n at most z's value, stk.go answers the model tree's
# CV, ROOT on top.
law go.k:
  for +n: Nat
  for +k: U32
  for +j: Nat
  for +rest: List<&2, Laws.Tree>
  for +cs: List<&2, B3.CV>
  for +z: U32
  for +e: {Nat.is_le(Nat.add(n, U32.to_nat(k)), U32.to_nat(z)) == True{} : Bool}
  {St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, n, cs, k, kst(Laws.Seg{j} <> rest, cs)) ==
    IO.pure(B3.CV, tcv(Laws.stream.go(n, 32n, U32.to_nat(k), Laws.Seg{j} <> rest), cs, B3.ROOT())) : IO(B3.CV)}

def go.k(n, k, j, rest, cs, z, e):
  match n:
    case 0n:
      match rest:
        case Nil{}:
          {==}
        case Con{x, more}:
          Equal.cong(B3.CV, IO(B3.CV), v => IO.pure(B3.CV, v), St.stk.fin(kst(x <> more, cs), tcv(Laws.Seg{j}, cs, 0)),
            tcv(Laws.stk.fin(x <> more, Laws.Seg{j}), cs, B3.ROOT()), fin.k(more, x, Laws.Seg{j}, cs))
    case 1n+p:
      +K = U32.to_nat(k)
      +L = Laws.stk.lazy(32n, Laws.Seg{j} <> rest, K, Laws.stk.even(K))
      %Equal.sym(Bool, St.stk.even(k), Laws.stk.even(K), even.k(k)) :
        {(R => q => St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, p, cs, (k + 1 : U32),
          St.KCon{Laws.seg(cs, K), St.stk.lazy(32n, kst(Laws.Seg{j} <> rest, cs), k, _)})(R, q)) ==
          IO.pure(B3.CV, tcv(Laws.stream.go(p, 32n, 1n+K, Laws.Seg{K} <> L), cs, B3.ROOT())) : IO(B3.CV)}
      %Equal.sym(St.Stk, St.stk.lazy(32n, kst(Laws.Seg{j} <> rest, cs), k, Laws.stk.even(K)), kst(L, cs),
        lazy.k(32n, Laws.Seg{j} <> rest, k, Laws.stk.even(K), cs)) :
        {(R => q => St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, p, cs, (k + 1 : U32), St.KCon{Laws.seg(cs, K), _})(R, q)) ==
          IO.pure(B3.CV, tcv(Laws.stream.go(p, 32n, 1n+K, Laws.Seg{K} <> L), cs, B3.ROOT())) : IO(B3.CV)}
      %inc.k(k, z, p, e) :
        {(R => q => St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, p, cs, (k + 1 : U32), kst(Laws.Seg{K} <> L, cs))(R, q)) ==
          IO.pure(B3.CV, tcv(Laws.stream.go(p, 32n, _, Laws.Seg{K} <> L), cs, B3.ROOT())) : IO(B3.CV)}
      %Equal.sym(IO(B3.CV), St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, p, cs, (k + 1 : U32), kst(Laws.Seg{K} <> L, cs)),
        IO.pure(B3.CV, tcv(Laws.stream.go(p, 32n, U32.to_nat((k + 1 : U32)), Laws.Seg{K} <> L), cs, B3.ROOT())),
        go.k(p, (k + 1 : U32), K, L, cs, z, go.le(p, k, z, e))) :
        {(R => q => _(R, q)) ==
          IO.pure(B3.CV, tcv(Laws.stream.go(p, 32n, U32.to_nat((k + 1 : U32)), Laws.Seg{K} <> L), cs, B3.ROOT())) : IO(B3.CV)}
      {==}

# An ordered tree's CV is ev.segs of its shape: a Tree whose segments read
# m numbers from j has segment j leftmost, and its right side starts after
# the left side's leaves.
def hd(+xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{x, t}:
      x

def tl(+xs: List<&2, Nat>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      []
    case Con{x, t}:
      t

def is.con(+xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{x, t}:
      True{}

law con.nil:
  for +x: Nat
  for +t: List<&2, Nat>
  for +e: {x <> t == [] : List<&2, Nat>}
  Empty

def con.nil(x, t, e):
  A.absurd.tf(Equal.cong(List<&2, Nat>, Bool, z => is.con(z), x <> t, [], e))

law one.range:
  for +k: Nat
  for +m: Nat
  for +j: Nat
  for +e: {[k] == Laws.range(m, j) : List<&2, Nat>}
  {k == j : Nat}

def one.range(k, m, j, e):
  match m:
    case 0n:
      Empty.absurd({k == j : Nat}, con.nil(k, [], e))
    case 1n+q:
      Equal.cong(List<&2, Nat>, Nat, z => hd(z), [k], j <> Laws.range(q, 1n+j), e)

law range.app:
  for +xs: List<&2, Nat>
  for +ys: List<&2, Nat>
  for +m: Nat
  for +j: Nat
  for +e: {List.append(&2, Nat, xs, ys) == Laws.range(m, j) : List<&2, Nat>}
  {xs == Laws.range(List.length(&2, Nat, xs), j) : List<&2, Nat>}

def range.app(xs, ys, m, j, e):
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      match m:
        case 0n:
          Empty.absurd({x <> t == Laws.range(1n+List.length(&2, Nat, t), j) : List<&2, Nat>},
            con.nil(x, List.append(&2, Nat, t, ys), e))
        case 1n+q:
          %Equal.sym(Nat, x, j, Equal.cong(List<&2, Nat>, Nat, z => hd(z), x <> List.append(&2, Nat, t, ys),
            j <> Laws.range(q, 1n+j), e)) :
            {_ <> t == j <> Laws.range(List.length(&2, Nat, t), 1n+j) : List<&2, Nat>}
          Equal.cong(List<&2, Nat>, List<&2, Nat>, z => j <> z, t, Laws.range(List.length(&2, Nat, t), 1n+j),
            range.app(t, ys, q, 1n+j, Equal.cong(List<&2, Nat>, List<&2, Nat>, z => tl(z),
              x <> List.append(&2, Nat, t, ys), j <> Laws.range(q, 1n+j), e)))

law range.rest:
  for +xs: List<&2, Nat>
  for +ys: List<&2, Nat>
  for +m: Nat
  for +j: Nat
  for +e: {List.append(&2, Nat, xs, ys) == Laws.range(m, j) : List<&2, Nat>}
  {ys == Laws.range(Nat.sub(m, List.length(&2, Nat, xs)), Nat.add(j, List.length(&2, Nat, xs))) : List<&2, Nat>}

def range.rest(xs, ys, m, j, e):
  match xs:
    case Nil{}:
      %Equal.sym(Nat, Nat.sub(m, 0n), m, A.n.sub_zero(m)) : {ys == Laws.range(_, Nat.add(j, 0n)) : List<&2, Nat>}
      %Equal.sym(Nat, Nat.add(j, 0n), j, A.add_zero(j)) : {ys == Laws.range(m, _) : List<&2, Nat>}
      e
    case Con{x, t}:
      match m:
        case 0n:
          Empty.absurd({ys == Laws.range(Nat.sub(0n, 1n+List.length(&2, Nat, t)), Nat.add(j, 1n+List.length(&2, Nat, t))) : List<&2, Nat>},
            con.nil(x, List.append(&2, Nat, t, ys), e))
        case 1n+q:
          %Equal.sym(Nat, Nat.add(j, 1n+List.length(&2, Nat, t)), 1n+Nat.add(j, List.length(&2, Nat, t)),
            A.add_succ(j, List.length(&2, Nat, t))) :
            {ys == Laws.range(Nat.sub(q, List.length(&2, Nat, t)), _) : List<&2, Nat>}
          range.rest(t, ys, q, 1n+j, Equal.cong(List<&2, Nat>, List<&2, Nat>, z => tl(z),
            x <> List.append(&2, Nat, t, ys), j <> Laws.range(q, 1n+j), e))

law len.app:
  for +xs: List<&2, Nat>
  for +ys: List<&2, Nat>
  {List.length(&2, Nat, List.append(&2, Nat, xs, ys)) ==
    Nat.add(List.length(&2, Nat, xs), List.length(&2, Nat, ys)) : Nat}

def len.app(xs, ys):
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, Nat, List.append(&2, Nat, t, ys)),
        Nat.add(List.length(&2, Nat, t), List.length(&2, Nat, ys)), len.app(t, ys))

law ord.len:
  for +t: Laws.Tree
  {List.length(&2, Nat, Laws.order(t)) == Laws.tips(Laws.shape(t)) : Nat}

def ord.len(t):
  match t:
    case Laws.Seg{k}:
      {==}
    case Laws.Par{l, r}:
      %Equal.sym(Nat, List.length(&2, Nat, List.append(&2, Nat, Laws.order(l), Laws.order(r))),
        Nat.add(List.length(&2, Nat, Laws.order(l)), List.length(&2, Nat, Laws.order(r))), len.app(Laws.order(l), Laws.order(r))) :
        {_ == Nat.add(Laws.tips(Laws.shape(l)), Laws.tips(Laws.shape(r))) : Nat}
      %Equal.sym(Nat, List.length(&2, Nat, Laws.order(l)), Laws.tips(Laws.shape(l)), ord.len(l)) :
        {Nat.add(_, List.length(&2, Nat, Laws.order(r))) == Nat.add(Laws.tips(Laws.shape(l)), Laws.tips(Laws.shape(r))) : Nat}
      %Equal.sym(Nat, List.length(&2, Nat, Laws.order(r)), Laws.tips(Laws.shape(r)), ord.len(r)) :
        {Nat.add(Laws.tips(Laws.shape(l)), _) == Nat.add(Laws.tips(Laws.shape(l)), Laws.tips(Laws.shape(r))) : Nat}
      {==}

law tcv.segs:
  for +t: Laws.Tree
  for +m: Nat
  for +j: Nat
  for +cs: List<&2, B3.CV>
  for +rf: U32
  for +e: {Laws.order(t) == Laws.range(m, j) : List<&2, Nat>}
  {tcv(t, cs, rf) == Laws.ev.segs(Laws.shape(t), j, cs, rf) : B3.CV}

def tcv.segs(t, m, j, cs, rf, e):
  match t:
    case Laws.Seg{k}:
      Equal.cong(Nat, B3.CV, i => Laws.seg(cs, i), k, j, one.range(k, m, j, e))
    case Laws.Par{l, r}:
      +nl = List.length(&2, Nat, Laws.order(l))
      %ord.len(l) : {B3.parent(tcv(l, cs, 0), tcv(r, cs, 0), rf) ==
        B3.parent(Laws.ev.segs(Laws.shape(l), j, cs, 0), Laws.ev.segs(Laws.shape(r), Nat.add(j, _), cs, 0), rf) : B3.CV}
      %Equal.sym(B3.CV, tcv(l, cs, 0), Laws.ev.segs(Laws.shape(l), j, cs, 0),
        tcv.segs(l, nl, j, cs, 0, range.app(Laws.order(l), Laws.order(r), m, j, e))) :
        {B3.parent(_, tcv(r, cs, 0), rf) ==
          B3.parent(Laws.ev.segs(Laws.shape(l), j, cs, 0), Laws.ev.segs(Laws.shape(r), Nat.add(j, nl), cs, 0), rf) : B3.CV}
      %Equal.sym(B3.CV, tcv(r, cs, 0), Laws.ev.segs(Laws.shape(r), Nat.add(j, nl), cs, 0),
        tcv.segs(r, Nat.sub(m, nl), Nat.add(j, nl), cs, 0, range.rest(Laws.order(l), Laws.order(r), m, j, e))) :
        {B3.parent(Laws.ev.segs(Laws.shape(l), j, cs, 0), _, rf) ==
          B3.parent(Laws.ev.segs(Laws.shape(l), j, cs, 0), Laws.ev.segs(Laws.shape(r), Nat.add(j, nl), cs, 0), rf) : B3.CV}
      {==}

# The whole stream: the first segment is pushed onto the empty stack, the
# loop answers the model tree's CV, and stream.shape and stream.order make
# that BLAKE3's tree over the segments.
law first.le:
  for +r: Nat
  for +nseg: U32
  for +en: {U32.to_nat(nseg) == 1n+r : Nat}
  {Nat.is_le(Nat.add(r, 1n), U32.to_nat(nseg)) == True{} : Bool}

def first.le(r, nseg, en):
  %Equal.sym(Nat, U32.to_nat(nseg), 1n+r, en) : {Nat.is_le(Nat.add(r, 1n), _) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(r, 1n), 1n+r, add1(r)) : {Nat.is_le(_, 1n+r) == True{} : Bool}
  A.n.le_refl(1n+r)

law stream.hash.r:
  for +r: Nat
  for +nseg: U32
  for +en: {U32.to_nat(nseg) == 1n+r : Nat}
  for +es: {Laws.shr(32n, r) == 0n : Nat}
  for +cs: List<&2, B3.CV>
  {St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, 1n+r, cs, 0, St.KNil{}) ==
    IO.pure(B3.CV, Laws.ev.segs(Laws.tree(Laws.digits(32n, r, [])), 0n, cs, B3.ROOT())) : IO(B3.CV)}

def stream.hash.r(r, nseg, en, es, cs):
  %Laws.stream.shape(32n, r, es) : {St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, 1n+r, cs, 0, St.KNil{}) ==
    IO.pure(B3.CV, Laws.ev.segs(_, 0n, cs, B3.ROOT())) : IO(B3.CV)}
  %tcv.segs(Laws.stream.go(1n+r, 32n, 0n, []), 1n+r, 0n, cs, B3.ROOT(), Laws.stream.order(32n, r)) :
    {St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, 1n+r, cs, 0, St.KNil{}) == IO.pure(B3.CV, _) : IO(B3.CV)}
  %Equal.sym(IO(B3.CV), St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, r, cs, 1, kst([Laws.Seg{0n}], cs)),
    IO.pure(B3.CV, tcv(Laws.stream.go(1n+r, 32n, 0n, []), cs, B3.ROOT())),
    go.k(r, 1, 0n, [], cs, nseg, first.le(r, nseg, en))) :
    {(R => q => _(R, q)) == IO.pure(B3.CV, tcv(Laws.stream.go(1n+r, 32n, 0n, []), cs, B3.ROOT())) : IO(B3.CV)}
  {==}

law pos.le:
  for +x: Nat
  for +e: {Bool.not(Nat.is_eq(x, 0n)) == True{} : Bool}
  {Nat.is_le(1n, x) == True{} : Bool}

def pos.le(x, e):
  match x:
    case 0n:
      Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, A.absurd.ft(e))
    case 1n+q:
      S.le0(q)

law nseg.pos:
  for +nseg: U32
  for +e: {U32.is_ne(nseg, 0) == True{} : Bool}
  {Nat.is_le(1n, U32.to_nat(nseg)) == True{} : Bool}

def nseg.pos(nseg, e):
  pos.le(U32.to_nat(nseg), Equal.trans(Bool, Bool.not(Nat.is_eq(U32.to_nat(nseg), 0n)), U32.is_ne(nseg, 0), True{},
    Equal.cong(Bool, Bool, z => Bool.not(z), Nat.is_eq(U32.to_nat(nseg), 0n), U32.is_eq(nseg, 0),
      Equal.sym(Bool, U32.is_eq(nseg, 0), Nat.is_eq(U32.to_nat(nseg), 0n), A.u.is_eq_nat(nseg, 0))), e))

law shr.last:
  for +nseg: U32
  for +el: {Nat.is_le(1n, U32.to_nat(nseg)) == True{} : Bool}
  {Laws.shr(32n, Nat.sub(U32.to_nat(nseg), 1n)) == 0n : Nat}

def shr.last(nseg, el):
  %A.u.tn_sub(nseg, 1, el) : {Laws.shr(32n, _) == 0n : Nat}
  S.u.shr32(U32.sub(nseg, 1))

def Laws.stream.hash(nseg, e, cs):
  +r = Nat.sub(U32.to_nat(nseg), 1n)
  +el = nseg.pos(nseg, e)
  +en = Equal.trans(Nat, U32.to_nat(nseg), Nat.add(r, 1n), 1n+r,
    Equal.sym(Nat, Nat.add(r, 1n), U32.to_nat(nseg), A.n.sub_add(U32.to_nat(nseg), 1n, el)), add1(r))
  %Equal.sym(Nat, U32.to_nat(nseg), 1n+r, en) :
    {St.stk.go(~List<&2, B3.CV>, ~Laws.seg.rd, _, cs, 0, St.KNil{}) ==
      IO.pure(B3.CV, Laws.ev.segs(Laws.tree(Laws.digits(32n, r, [])), 0n, cs, B3.ROOT())) : IO(B3.CV)}
  stream.hash.r(r, nseg, en, shr.last(nseg, el), cs)
