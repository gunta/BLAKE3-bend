# Tree shapes
# -----------

law full_grow:
  for +d: Nat
  for +k: Nat
  {Laws.full(Nat.add(d, k)) == Laws.grow(Laws.full(d), k) : Laws.Shape}

def full_grow(d, k):
  match d:
    case 0n:
      {==}
    case 1n+p:
      %full_grow(p, k) : {Laws.Fork{Laws.full(Nat.add(p, k)), Laws.full(Nat.add(p, k))}
        == Laws.Fork{_, _} : Laws.Shape}
      {==}

law add_length:
  for +xs: List<&2, Bool>
  for +ys: List<&2, Bool>
  {Nat.add(List.length(&2, Bool, xs), List.length(&2, Bool, ys)) ==
    List.length(&2, Bool, List.append(&2, Bool, xs, ys)) : Nat}

def add_length(xs, ys):
  match xs:
    case Nil{}:
      {==}
    case Con{x, rest}:
      %add_length(rest, ys) : {1n+Nat.add(List.length(&2, Bool, rest),
        List.length(&2, Bool, ys)) == 1n+_ : Nat}
      {==}

# The segment law on digit lists: hi the segment index, lo the offset.
law tree_append:
  for +hi: List<&2, Bool>
  for +lo: List<&2, Bool>
  {Laws.tree(List.append(&2, Bool, hi, lo)) == Laws.graft(Laws.tree(hi), lo) : Laws.Shape}

def tree_append(hi, lo):
  match hi:
    case Nil{}:
      {==}
    case Con{True{}, rest}:
      %tree_append(rest, lo) : {Laws.Fork{Laws.full(List.length(&2, Bool,
        List.append(&2, Bool, rest, lo))), Laws.tree(List.append(&2, Bool, rest, lo))} ==
        Laws.Fork{Laws.grow(Laws.full(List.length(&2, Bool, rest)),
        List.length(&2, Bool, lo)), _} : Laws.Shape}
      %full_grow(List.length(&2, Bool, rest), List.length(&2, Bool, lo)) :
        {Laws.Fork{Laws.full(List.length(&2, Bool, List.append(&2, Bool, rest, lo))),
        Laws.tree(List.append(&2, Bool, rest, lo))} ==
        Laws.Fork{_, Laws.tree(List.append(&2, Bool, rest, lo))} : Laws.Shape}
      %add_length(rest, lo) : {Laws.Fork{Laws.full(_),
        Laws.tree(List.append(&2, Bool, rest, lo))} ==
        Laws.Fork{Laws.full(Nat.add(List.length(&2, Bool, rest), List.length(&2, Bool, lo))),
        Laws.tree(List.append(&2, Bool, rest, lo))} : Laws.Shape}
      {==}
    case Con{False{}, rest}:
      tree_append(rest, lo)

law append_assoc:
  for +xs: List<&2, Bool>
  for +ys: List<&2, Bool>
  for +zs: List<&2, Bool>
  {List.append(&2, Bool, List.append(&2, Bool, xs, ys), zs) ==
    List.append(&2, Bool, xs, List.append(&2, Bool, ys, zs)) : List<&2, Bool>}

def append_assoc(xs, ys, zs):
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %append_assoc(t, ys, zs) : {x <> List.append(&2, Bool, List.append(&2, Bool, t, ys), zs)
        == x <> _ : List<&2, Bool>}
      {==}

law digits_acc:
  for +j: Nat
  for +w: Nat
  for +acc: List<&2, Bool>
  {List.append(&2, Bool, Laws.digits(j, w, []), acc) == Laws.digits(j, w, acc) : List<&2, Bool>}

def digits_acc(j, w, acc):
  match j:
    case 0n:
      {==}
    case 1n+p:
      %digits_acc(p, Laws.half(w), Laws.odd(w) <> acc) : {List.append(&2, Bool,
        Laws.digits(p, Laws.half(w), [Laws.odd(w)]), acc) == _ : List<&2, Bool>}
      %digits_acc(p, Laws.half(w), [Laws.odd(w)]) : {List.append(&2, Bool, _, acc) ==
        List.append(&2, Bool, Laws.digits(p, Laws.half(w), []), Laws.odd(w) <> acc) :
        List<&2, Bool>}
      append_assoc(Laws.digits(p, Laws.half(w), []), [Laws.odd(w)], acc)

law digits_add:
  for +k: Nat
  for +j: Nat
  for +v: Nat
  for +acc: List<&2, Bool>
  {Laws.digits(j, Laws.shr(k, v), Laws.digits(k, v, acc)) ==
    Laws.digits(Nat.add(k, j), v, acc) : List<&2, Bool>}

def digits_add(k, j, v, acc):
  match k:
    case 0n:
      {==}
    case 1n+p:
      digits_add(p, j, Laws.half(v), Laws.odd(v) <> acc)

def Laws.segments(k, j, r):
  %digits_add(k, j, r, []) : {Laws.tree(_) == Laws.graft(Laws.tree(Laws.digits(j,
    Laws.shr(k, r), [])), Laws.digits(k, r, [])) : Laws.Shape}
  %digits_acc(j, Laws.shr(k, r), Laws.digits(k, r, [])) : {Laws.tree(_) ==
    Laws.graft(Laws.tree(Laws.digits(j, Laws.shr(k, r), [])), Laws.digits(k, r, [])) :
    Laws.Shape}
  tree_append(Laws.digits(j, Laws.shr(k, r), []), Laws.digits(k, r, []))

law row_leaves:
  for +r: Nat
  {Laws.row(r, []) == Laws.leaves(r) : List<&2, Laws.Shape>}

def row_leaves(r):
  match r:
    case 0n:
      {==}
    case 1n+p:
      %row_leaves(p) : {Laws.Tip{} <> Laws.row(p, []) == Laws.Tip{} <> _ :
        List<&2, Laws.Shape>}
      {==}

# One level: pairing a row of v complete trees and a last tree halves v and
# takes v's low digit into the last tree.
law pairs_row:
  for +v: Nat
  for +lo: List<&2, Bool>
  {Laws.pairs(Laws.row(v, lo)) == Laws.row(Laws.half(v), Laws.odd(v) <> lo) :
    List<&2, Laws.Shape>}

def pairs_row(v, lo):
  match v:
    case 0n:
      {==}
    case 1n+p:
      match p:
        case 0n:
          {==}
        case 1n+w:
          %pairs_row(w, lo) : {Laws.full(1n+List.length(&2, Bool, lo)) <>
            Laws.pairs(Laws.row(w, lo)) == Laws.full(1n+List.length(&2, Bool, lo)) <> _ :
            List<&2, Laws.Shape>}
          {==}

law levels.go:
  for +k: Nat
  for +v: Nat
  for +lo: List<&2, Bool>
  {Laws.reduce(k, Laws.row(v, lo)) == Laws.row(Laws.shr(k, v), Laws.digits(k, v, lo)) :
    List<&2, Laws.Shape>}

def levels.go(k, v, lo):
  match k:
    case 0n:
      {==}
    case 1n+p:
      %levels.go(p, Laws.half(v), Laws.odd(v) <> lo) : {Laws.reduce(p,
        Laws.pairs(Laws.row(v, lo))) == _ : List<&2, Laws.Shape>}
      %pairs_row(v, lo) : {Laws.reduce(p, Laws.pairs(Laws.row(v, lo))) ==
        Laws.reduce(p, _) : List<&2, Laws.Shape>}
      {==}

def Laws.levels(k, r):
  %row_leaves(r) : {Laws.reduce(k, _) == Laws.row(Laws.shr(k, r), Laws.digits(k, r, [])) :
    List<&2, Laws.Shape>}
  levels.go(k, r, [])

law row_zero:
  for +v: Nat
  for +lo: List<&2, Bool>
  for e: {v == 0n : Nat}
  {Laws.row(v, lo) == [Laws.tree(lo)] : List<&2, Laws.Shape>}

def row_zero(v, lo, e):
  %Equal.sym(Nat, v, 0n, e) : {Laws.row(_, lo) == [Laws.tree(lo)] : List<&2, Laws.Shape>}
  {==}

def Laws.levels.root(k, r, e):
  Equal.trans(List<&2, Laws.Shape>, Laws.reduce(k, Laws.leaves(r)),
    Laws.row(Laws.shr(k, r), Laws.digits(k, r, [])), [Laws.tree(Laws.digits(k, r, []))],
    Laws.levels(k, r), row_zero(Laws.shr(k, r), Laws.digits(k, r, []), e))
