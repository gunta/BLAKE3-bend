  for r: Array<U32> & B3.CV8
  for +rf: U32
  {(B3.leaf8.fin(r, rf), Pair.snd(B3.CV, B3.OB, B3.leaf32o.fin(r, rf))) ==
    B3.leaf32o.fin(r, rf) : B3.CV & B3.OB}

