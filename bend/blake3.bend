  ld.s11(a[(w + 11 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10)

def ld.s9(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32) -> Array<U32> & M16:
  (a, m9) = r
  ld.s10(a[(w + 10 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9)

def ld.s8(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32) -> Array<U32> & M16:
  (a, m8) = r
  ld.s9(a[(w + 9 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8)

def ld.s7(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32) -> Array<U32> & M16:
  (a, m7) = r
  ld.s8(a[(w + 8 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7)

def ld.s6(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32) -> Array<U32> & M16:
  (a, m6) = r
  ld.s7(a[(w + 7 : U32)], w, m0, m1, m2, m3, m4, m5, m6)

def ld.s5(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32) -> Array<U32> & M16:
  (a, m5) = r
  ld.s6(a[(w + 6 : U32)], w, m0, m1, m2, m3, m4, m5)

def ld.s4(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32) -> Array<U32> & M16:
  (a, m4) = r
  ld.s5(a[(w + 5 : U32)], w, m0, m1, m2, m3, m4)

def ld.s3(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32) -> Array<U32> & M16:
  (a, m3) = r
  ld.s4(a[(w + 4 : U32)], w, m0, m1, m2, m3)

def ld.s2(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32) -> Array<U32> & M16:
  (a, m2) = r
  ld.s3(a[(w + 3 : U32)], w, m0, m1, m2)

def ld.s1(r: Array<U32> & U32, +w: U32, m0: U32) -> Array<U32> & M16:
  (a, m1) = r
  ld.s2(a[(w + 2 : U32)], w, m0, m1)

def ld.s0(r: Array<U32> & U32, +w: U32) -> Array<U32> & M16:
  (a, m0) = r
  ld.s1(a[(w + 1 : U32)], w, m0)

# The 16 little-endian words of the block at word offset w.
def ld(a: Array<U32>, +w: U32) -> Array<U32> & M16:
  ld.s0(a[w], w)

# One round: four column G steps, then four diagonal ones.
def round(s: S16, +m: M16) -> S16:
  match s m:
    case S16{+v0_0, +v1_0, +v2_0, +v3_0, +v4_0, +v5_0, +v6_0, +v7_0, +v8_0, +v9_0, +v10_0, +v11_0, +v12_0, +v13_0, +v14_0, +v15_0} M16{+m0, +m1, +m2, +m3, +m4, +m5, +m6, +m7, +m8, +m9, +m10, +m11, +m12, +m13, +m14, +m15}:
      +v0_1 = (v0_0 + v4_0 + m0 : U32)
      +v12_1 = rotr16((v12_0 .^. v0_1 : U32))
      +v8_1 = (v8_0 + v12_1 : U32)
      +v4_1 = rotr12((v4_0 .^. v8_1 : U32))
      +v0_2 = (v0_1 + v4_1 + m1 : U32)
      +v12_2 = rotr8((v12_1 .^. v0_2 : U32))
      +v8_2 = (v8_1 + v12_2 : U32)
      +v4_2 = rotr7((v4_1 .^. v8_2 : U32))
      +v1_1 = (v1_0 + v5_0 + m2 : U32)
      +v13_1 = rotr16((v13_0 .^. v1_1 : U32))
      +v9_1 = (v9_0 + v13_1 : U32)
      +v5_1 = rotr12((v5_0 .^. v9_1 : U32))
      +v1_2 = (v1_1 + v5_1 + m3 : U32)
      +v13_2 = rotr8((v13_1 .^. v1_2 : U32))
      +v9_2 = (v9_1 + v13_2 : U32)
      +v5_2 = rotr7((v5_1 .^. v9_2 : U32))
      +v2_1 = (v2_0 + v6_0 + m4 : U32)
      +v14_1 = rotr16((v14_0 .^. v2_1 : U32))
      +v10_1 = (v10_0 + v14_1 : U32)
      +v6_1 = rotr12((v6_0 .^. v10_1 : U32))
      +v2_2 = (v2_1 + v6_1 + m5 : U32)
      +v14_2 = rotr8((v14_1 .^. v2_2 : U32))
      +v10_2 = (v10_1 + v14_2 : U32)
      +v6_2 = rotr7((v6_1 .^. v10_2 : U32))
      +v3_1 = (v3_0 + v7_0 + m6 : U32)
      +v15_1 = rotr16((v15_0 .^. v3_1 : U32))
      +v11_1 = (v11_0 + v15_1 : U32)
      +v7_1 = rotr12((v7_0 .^. v11_1 : U32))
      +v3_2 = (v3_1 + v7_1 + m7 : U32)
      +v15_2 = rotr8((v15_1 .^. v3_2 : U32))
      +v11_2 = (v11_1 + v15_2 : U32)
      +v7_2 = rotr7((v7_1 .^. v11_2 : U32))
      +v0_3 = (v0_2 + v5_2 + m8 : U32)
      +v15_3 = rotr16((v15_2 .^. v0_3 : U32))
      +v10_3 = (v10_2 + v15_3 : U32)
      +v5_3 = rotr12((v5_2 .^. v10_3 : U32))
      +v0_4 = (v0_3 + v5_3 + m9 : U32)
      +v15_4 = rotr8((v15_3 .^. v0_4 : U32))
      +v10_4 = (v10_3 + v15_4 : U32)
      +v5_4 = rotr7((v5_3 .^. v10_4 : U32))
      +v1_3 = (v1_2 + v6_2 + m10 : U32)
      +v12_3 = rotr16((v12_2 .^. v1_3 : U32))
      +v11_3 = (v11_2 + v12_3 : U32)
      +v6_3 = rotr12((v6_2 .^. v11_3 : U32))
      +v1_4 = (v1_3 + v6_3 + m11 : U32)
      +v12_4 = rotr8((v12_3 .^. v1_4 : U32))
      +v11_4 = (v11_3 + v12_4 : U32)
      +v6_4 = rotr7((v6_3 .^. v11_4 : U32))
      +v2_3 = (v2_2 + v7_2 + m12 : U32)
      +v13_3 = rotr16((v13_2 .^. v2_3 : U32))
      +v8_3 = (v8_2 + v13_3 : U32)
      +v7_3 = rotr12((v7_2 .^. v8_3 : U32))
      +v2_4 = (v2_3 + v7_3 + m13 : U32)
      +v13_4 = rotr8((v13_3 .^. v2_4 : U32))
      +v8_4 = (v8_3 + v13_4 : U32)
      +v7_4 = rotr7((v7_3 .^. v8_4 : U32))
      +v3_3 = (v3_2 + v4_2 + m14 : U32)
      +v14_3 = rotr16((v14_2 .^. v3_3 : U32))
      +v9_3 = (v9_2 + v14_3 : U32)
      +v4_3 = rotr12((v4_2 .^. v9_3 : U32))
      +v3_4 = (v3_3 + v4_3 + m15 : U32)
      +v14_4 = rotr8((v14_3 .^. v3_4 : U32))
      +v9_4 = (v9_3 + v14_4 : U32)
      +v4_4 = rotr7((v4_3 .^. v9_4 : U32))
      S16{v0_4, v1_4, v2_4, v3_4, v4_4, v5_4, v6_4, v7_4, v8_4, v9_4, v10_4, v11_4, v12_4, v13_4, v14_4, v15_4}

# The message schedule between rounds.
def perm(m: M16) -> M16:
  match m:
    case M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}:
      M16{m2, m6, m3, m10, m7, m0, m4, m13, m1, m11, m12, m5, m9, m14, m15, m8}

def out(s: S16) -> CV:
  match s:
    case S16{v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15}:
      CV{(v0 .^. v8 : U32), (v1 .^. v9 : U32), (v2 .^. v10 : U32), (v3 .^. v11 : U32), (v4 .^. v12 : U32), (v5 .^. v13 : U32), (v6 .^. v14 : U32), (v7 .^. v15 : U32)}

# The compression function, truncated to the 8 words a CV needs.
def compress(cv: CV, +m1: M16, +t0: U32, +t1: U32, +blen: U32, +flags: U32) -> CV:
  match cv:
    case CV{h0, h1, h2, h3, h4, h5, h6, h7}:
      +m2 = perm(m1)
      +m3 = perm(m2)
      +m4 = perm(m3)
      +m5 = perm(m4)
      +m6 = perm(m5)
      +m7 = perm(m6)
      s0 = {S16{h0, h1, h2, h3, h4, h5, h6, h7, 1779033703, 3144134277, 1013904242, 2773480762, t0, t1, blen, flags} : S16}
      out(round(round(round(round(round(round(round(s0, m1), m2), m3), m4), m5), m6), m7))


# Chains one chunk's blocks. `r` is the block at word w, already loaded; n
# counts the blocks after it. Only the last block takes `endf` and `lastlen`.
def chunk.go(n: Nat, r: Array<U32> & M16, +w: U32, cv: CV, +ctr: U32, +hi: U32,
  +fl: U32, +endf: U32, +lastlen: U32) -> Array<U32> & CV:
  match n:
    case 0n:
      (a, m) = r
      (a, compress(cv, m, ctr, hi, lastlen, (fl .|. endf : U32)))
    case 1n+p:
      (a, m) = r
      +w2 = (w + 16 : U32)
      chunk.go(p, ld(a, w2), w2, compress(cv, m, ctr, hi, 64, fl), ctr, hi, 0,
        endf, lastlen)

def chunk.fin(r: Array<U32> & CV) -> CV:
  (a, cv) = r
  _ = a
  cv

# The CV of chunk c of a span (see hash.at); rf is ROOT for a one-chunk
# input. Every chunk holds 1024 bytes but the span's last, which holds last.
def chunk(a: Array<U32>, +c: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32) -> CV:
  +w = (c << 8n : U32)
  +m = (0 - Bool.to_u32(U32.is_eq((c + 1 : U32), nch)) : U32)
  +rem = ((last .&. m) .|. (1024 .&. U32.not(m)) : U32)
  +nb = U32.max(((rem + 63 : U32) >> 6n : U32), 1)
  +lastlen = (rem - ((nb - 1 : U32) << 6n : U32) : U32)
  chunk.fin(chunk.go(U32.to_nat((nb - 1 : U32)), ld(a, w), w, IV(),
    (cb + c : U32), hi, CHUNK_START(), (CHUNK_END() .|. rf : U32), lastlen))

def parent(l: CV, r: CV, +rf: U32) -> CV:
  match l r:
    case CV{l0, l1, l2, l3, l4, l5, l6, l7} CV{r0, r1, r2, r3, r4, r5, r6, r7}:
      compress(IV(), M16{l0, l1, l2, l3, l4, l5, l6, l7, r0, r1, r2, r3, r4, r5,
        r6, r7}, 0, 0, 64, (PARENT() .|. rf : U32))

# Whether n chunks overflow a left subtree of 2^(k-1): if so, a level of
# depth k has a parent node.
def big(+k: Nat, +n: U32) -> Bool:
  match k:
    case 0n:
      False{}
    case 1n+p:
      U32.is_gt(n, U32.shln(1, p))

# The CV of the n chunks from chunk c, n <= 2^k. Each node holds two read
# handles of the input (dup: an O(1) Array.fork in hash.bend), so both
# halves read it at once.
def tree1(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, b: Bool, aa: Array<U32> & Array<U32>, +c: U32, +n: U32,
  +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV:
  match k b:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk(a1, c, cb, hi, nch, last, rf)
    case 1n+p False{}:
      tree1(~dup, p, big(p, n), aa, c, n, cb, hi, nch, last, rf)
    case 1n+p True{}:
      (a1, a2) = aa
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      l r = tree1(~dup, p, big(p, h), dup(a1), c, h, cb, hi, nch, last, 0) tree1(~dup, p, big(p, n2), dup(a2), (c + h : U32), n2, cb, hi, nch, last, 0)
      parent(l, r, rf)

def chunks(+len: U32) -> U32:
  U32.max(((len + 1023 : U32) >> 10n : U32), 1)

# ceil(log2(n)) for n >= 1
def depth.go(b: Bool, +n: U32) -> Nat:
  match b:
    case True{}:
      0n
    case False{}:
      1n+U32.log2((n - 1 : U32))

def depth(+n: U32) -> Nat:
  depth.go(U32.is_le(n, 1), n)


# Keyed hashing, key derivation, extended output
# ----------------------------------------------
#
# BLAKE3's keyed and key-derivation modes hash the same tree from another
# starting key, with a mode flag on every compression: `key` is that key
# (the 32-byte key, or the context's derived key) and kf the flag
# (KEYED_HASH 16, DERIVE_KEY_CONTEXT 32, DERIVE_KEY_MATERIAL 64). The .k
# defs are the default mode's with the two threaded through; key = IV() and
# kf = 0 is the default mode.

def KEYED_HASH() -> U32:
  16

def DERIVE_KEY_CONTEXT() -> U32:
  32

def DERIVE_KEY_MATERIAL() -> U32:
  64

def chunk.go.k(n: Nat, r: Array<U32> & M16, +w: U32, cv: CV, +ctr: U32, +hi: U32,
  +fl: U32, +endf: U32, +lastlen: U32, +kf: U32) -> Array<U32> & CV:
  match n:
    case 0n:
      (a, m) = r
      (a, compress(cv, m, ctr, hi, lastlen, ((fl .|. endf : U32) .|. kf : U32)))
    case 1n+p:
      (a, m) = r
      +w2 = (w + 16 : U32)
      chunk.go.k(p, ld(a, w2), w2, compress(cv, m, ctr, hi, 64, (fl .|. kf : U32)), ctr, hi, 0,
        endf, lastlen, kf)

def chunk.k(a: Array<U32>, +c: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32, +key: CV, +kf: U32) -> CV:
  +w = (c << 8n : U32)
  +m = (0 - Bool.to_u32(U32.is_eq((c + 1 : U32), nch)) : U32)
  +rem = ((last .&. m) .|. (1024 .&. U32.not(m)) : U32)
  +nb = U32.max(((rem + 63 : U32) >> 6n : U32), 1)
  +lastlen = (rem - ((nb - 1 : U32) << 6n : U32) : U32)
  chunk.fin(chunk.go.k(U32.to_nat((nb - 1 : U32)), ld(a, w), w, key,
    (cb + c : U32), hi, CHUNK_START(), (CHUNK_END() .|. rf : U32), lastlen, kf))

def parent.k(l: CV, r: CV, +rf: U32, +key: CV, +kf: U32) -> CV:
  match l r:
    case CV{l0, l1, l2, l3, l4, l5, l6, l7} CV{r0, r1, r2, r3, r4, r5, r6, r7}:
      compress(key, M16{l0, l1, l2, l3, l4, l5, l6, l7, r0, r1, r2, r3, r4, r5, r6, r7}, 0, 0, 64, ((PARENT() .|. rf : U32) .|. kf : U32))

def tree1.k(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, b: Bool, aa: Array<U32> & Array<U32>, +c: U32, +n: U32,
  +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32, +key: CV, +kf: U32) -> CV:
  match k b:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk.k(a1, c, cb, hi, nch, last, rf, key, kf)
    case 1n+p False{}:
      tree1.k(~dup, p, big(p, n), aa, c, n, cb, hi, nch, last, rf, key, kf)
    case 1n+p True{}:
      (a1, a2) = aa
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      l r = tree1.k(~dup, p, big(p, h), dup(a1), c, h, cb, hi, nch, last, 0, key, kf) tree1.k(~dup, p, big(p, n2), dup(a2), (c + h : U32), n2, cb, hi, nch, last, 0, key, kf)
      parent.k(l, r, rf, key, kf)

# The CV of a span (as hash.at) in any mode, on the scalar tree.
def hash.at.k(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32, +key: CV, +kf: U32) -> CV:
  +k = depth(nch)
  tree1.k(~dup, k, big(k, nch), dup(a), 0, nch, cb, hi, nch, last, rf, key, kf)

# The root's node before its last compression: what the extended output
# expands, a block of 64 bytes for each counter (root.out).
type Root is Data:
  Root{cv: CV, m: M16, blen: U32, fl: U32}

def chunk.root.go(n: Nat, r: Array<U32> & M16, +w: U32, cv: CV, +ctr: U32, +fl: U32,
  +lastlen: U32, +kf: U32) -> Root:
  match n:
    case 0n:
      (a, m) = r
      _ = a
      Root{cv, m, lastlen, ((fl .|. CHUNK_END() : U32) .|. kf : U32)}
    case 1n+p:
      (a, m) = r
      +w2 = (w + 16 : U32)
      chunk.root.go(p, ld(a, w2), w2, compress(cv, m, ctr, 0, 64, (fl .|. kf : U32)), ctr, 0,
        lastlen, kf)

# The root of a one-chunk input (`last` bytes, counter cb): its last block.
def chunk.root(a: Array<U32>, +cb: U32, +last: U32, +key: CV, +kf: U32) -> Root:
  +nb = U32.max(((last + 63 : U32) >> 6n : U32), 1)
  +lastlen = (last - ((nb - 1 : U32) << 6n : U32) : U32)
  chunk.root.go(U32.to_nat((nb - 1 : U32)), ld(a, 0), 0, key, cb, CHUNK_START(), lastlen, kf)

# The root of a bigger input: the parent of its two children.
def parent.root(l: CV, r: CV, +key: CV, +kf: U32) -> Root:
  match l r:
    case CV{l0, l1, l2, l3, l4, l5, l6, l7} CV{r0, r1, r2, r3, r4, r5, r6, r7}:
      Root{key, M16{l0, l1, l2, l3, l4, l5, l6, l7, r0, r1, r2, r3, r4, r5, r6, r7}, 64, (PARENT() .|. kf : U32)}

# The whole compression: its first 8 words (as compress) and its last 8.
def out2(s: S16, c: CV) -> CV & CV:
  match s c:
    case S16{v0, v1, v2, v3, v4, v5, v6, v7, +v8, +v9, +v10, +v11, +v12, +v13, +v14, +v15} CV{h0, h1, h2, h3, h4, h5, h6, h7}:
      (CV{(v0 .^. v8 : U32), (v1 .^. v9 : U32), (v2 .^. v10 : U32), (v3 .^. v11 : U32), (v4 .^. v12 : U32), (v5 .^. v13 : U32), (v6 .^. v14 : U32), (v7 .^. v15 : U32)}, CV{(v8 .^. h0 : U32), (v9 .^. h1 : U32), (v10 .^. h2 : U32), (v11 .^. h3 : U32), (v12 .^. h4 : U32), (v13 .^. h5 : U32), (v14 .^. h6 : U32), (v15 .^. h7 : U32)})

def compress.xof(cv: CV, +m1: M16, +t0: U32, +t1: U32, +blen: U32, +flags: U32) -> CV & CV:
  match cv:
    case CV{+h0, +h1, +h2, +h3, +h4, +h5, +h6, +h7}:
      +m2 = perm(m1)
      +m3 = perm(m2)
      +m4 = perm(m3)
      +m5 = perm(m4)
      +m6 = perm(m5)
      +m7 = perm(m6)
      s0 = {S16{h0, h1, h2, h3, h4, h5, h6, h7, 1779033703, 3144134277, 1013904242, 2773480762, t0, t1, blen, flags} : S16}
      out2(round(round(round(round(round(round(round(s0, m1), m2), m3), m4), m5), m6), m7),
        CV{h0, h1, h2, h3, h4, h5, h6, h7})

# Block t (t1:t0) of the extended output: 64 bytes, as two CVs' words.
def root.out(r: Root, +t0: U32, +t1: U32) -> CV & CV:
  match r:
    case Root{cv, m, blen, fl}:
      compress.xof(cv, m, t0, t1, blen, (fl .|. ROOT() : U32))


# GPU leaves
# ----------
# One full chunk, then 4, 16 and 64 full chunks in order, each a chain with
# no fork: the GPU tree forks down to 64-chunk subtrees and every lane hashes
# one start to end, the shape the shaders guide asks for (one flat task per
# lane), instead of a task per chunk.

# A full chunk at array chunk c, counter hi:t; rf ignored (a quad's leaf).
def gch(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  +w = (c << 8n : U32)
  chunk.go(15n, ld(a, w), w, IV(), t, hi, CHUNK_START(), CHUNK_END(), 64)

def g4.s3(r: Array<U32> & CV, y: CV, x2: CV, +rf: U32) -> Array<U32> & CV:
  (a, x3) = r
  (a, parent(y, parent(x2, x3, 0), rf))

def g4.s2(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, y: CV, +rf: U32) -> Array<U32> & CV:
  (a, x2) = r
  g4.s3(gch(a, (c + 3 : U32), (t + 3 : U32), hi, 0), y, x2, rf)

def g4.s1(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, x0: CV, +rf: U32) -> Array<U32> & CV:
  (a, x1) = r
  g4.s2(gch(a, (c + 2 : U32), (t + 2 : U32), hi, 0), c, t, hi, parent(x0, x1, 0), rf)

def g4.s0(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  (a, x0) = r
  g4.s1(gch(a, (c + 1 : U32), (t + 1 : U32), hi, 0), c, t, hi, x0, rf)

def g4(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  g4.s0(gch(a, c, t, hi, 0), c, t, hi, rf)

def g16.s3(r: Array<U32> & CV, y: CV, x2: CV, +rf: U32) -> Array<U32> & CV:
  (a, x3) = r
  (a, parent(y, parent(x2, x3, 0), rf))

def g16.s2(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, y: CV, +rf: U32) -> Array<U32> & CV:
  (a, x2) = r
  g16.s3(g4(a, (c + 12 : U32), (t + 12 : U32), hi, 0), y, x2, rf)

def g16.s1(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, x0: CV, +rf: U32) -> Array<U32> & CV:
  (a, x1) = r
  g16.s2(g4(a, (c + 8 : U32), (t + 8 : U32), hi, 0), c, t, hi, parent(x0, x1, 0), rf)

def g16.s0(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  (a, x0) = r
  g16.s1(g4(a, (c + 4 : U32), (t + 4 : U32), hi, 0), c, t, hi, x0, rf)

def g16(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  g16.s0(g4(a, c, t, hi, 0), c, t, hi, rf)

def g64.s3(r: Array<U32> & CV, y: CV, x2: CV, +rf: U32) -> Array<U32> & CV:
  (a, x3) = r
  (a, parent(y, parent(x2, x3, 0), rf))

def g64.s2(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, y: CV, +rf: U32) -> Array<U32> & CV:
  (a, x2) = r
  g64.s3(g16(a, (c + 48 : U32), (t + 48 : U32), hi, 0), y, x2, rf)

def g64.s1(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, x0: CV, +rf: U32) -> Array<U32> & CV:
  (a, x1) = r
  g64.s2(g16(a, (c + 32 : U32), (t + 32 : U32), hi, 0), c, t, hi, parent(x0, x1, 0), rf)

def g64.s0(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  (a, x0) = r
  g64.s1(g16(a, (c + 16 : U32), (t + 16 : U32), hi, 0), c, t, hi, x0, rf)

def g64(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> Array<U32> & CV:
  g64.s0(g16(a, c, t, hi, 0), c, t, hi, rf)

def g.fin(r: Array<U32> & CV) -> CV:
  (a, cv) = r
  _ = a
  cv

# Strided lanes for big subtrees
# ------------------------------
# 64-chunk leaves make 16384 lanes stream 16384 separate 64 KiB runs spread
# over the input, and the GPU reads that at 2/3 of what it can (ADR 0006).
# So at that leaf level a whole subtree of 64 S chunks goes to S lanes (as
# many as its leaves) that read neighbouring memory: lane l hashes the
# 16-chunk groups l, l + S, l + 2S and l + 3S, so the lanes running together
# read one window of 16 S KiB (ADR 0011). The fork over the lanes is the
# tree over lane numbers, and a join pairs its halves' four CVs group for
# group: BLAKE3's tree of groups, level by level (the `levels` law), so
# after log2(S) joins the four CVs are the subtree's quarters.

# Four CVs, one per quarter of a subtree, in order.
type CV4 is Data:
  CV4{a: CV, b: CV, c: CV, d: CV}

def quad.s3(r: Array<U32> & CV, x0: CV, x1: CV, x2: CV) -> CV4:
  (a, x3) = r
  _ = a
  CV4{x0, x1, x2, x3}

def quad.s2(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +st: U32, x0: CV, x1: CV) ->
  CV4:
  (a, x2) = r
  +s3 = (st + (st << 1n : U32) : U32)
  quad.s3(g16(a, (c + s3 : U32), (t + s3 : U32), hi, 0), x0, x1, x2)

def quad.s1(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +st: U32, x0: CV) -> CV4:
  (a, x1) = r
  +s2 = (st << 1n : U32)
  quad.s2(g16(a, (c + s2 : U32), (t + s2 : U32), hi, 0), c, t, hi, st, x0, x1)

def quad.s0(r: Array<U32> & CV, +c: U32, +t: U32, +hi: U32, +st: U32) -> CV4:
  (a, x0) = r
  quad.s1(g16(a, (c + st : U32), (t + st : U32), hi, 0), c, t, hi, st, x0)

# One lane: the 16-chunk groups at array chunks c, c + st, c + 2st and
# c + 3st (counters t, t + st, ...).
def quad(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +st: U32) -> CV4:
  quad.s0(g16(a, c, t, hi, 0), c, t, hi, st)

def par4(x: CV4, y: CV4) -> CV4:
  match x y:
    case CV4{x0, x1, x2, x3} CV4{y0, y1, y2, y3}:
      CV4{parent(x0, y0, 0), parent(x1, y1, 0), parent(x2, y2, 0),
        parent(x3, y3, 0)}

def fold4(x: CV4, +rf: U32) -> CV:
  match x:
    case CV4{x0, x1, x2, x3}:
      parent(parent(x0, x1, 0), parent(x2, x3, 0), rf)

# 2^k lanes from the one whose first group is at array chunk c (counter t),
# st chunks between a lane's groups.
def qtree(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, aa: Array<U32> & Array<U32>, +c: U32, +t: U32, +hi: U32, +st: U32) -> CV4:
  match k:
    case 0n:
      (a1, a2) = aa
      _ = a2
      quad(a1, c, t, hi, st)
    case 1n+p:
      (a1, a2) = aa
      +h = U32.shln(16, p)
      l r = qtree(~dup, p, dup(a1), c, t, hi, st) qtree(~dup, p, dup(a2), (c + h : U32), (t + h : U32), hi, st)
      par4(l, r)

# Whether chunks up to e (exclusive) are all full: the last chunk, nch - 1,
# holds `last` bytes.
def full(+e: U32, +nch: U32, +last: U32) -> Bool:
  U32.is_lt(e, nch) || (U32.is_eq(e, nch) && U32.is_eq(last, 1024))

type Node1 is Data:
  GDown{}
  GSplit{}
  G4{}
  G16{}
  G64{}
  GQuad{}

def kind1.at4(b: Bool) -> Node1:
  match b:
    case True{}:
      G4{}
    case False{}:
      GSplit{}

def kind1.at16(b: Bool, +k: U32) -> Node1:
  match b:
    case True{}:
      G16{}
    case False{}:
      kind1.at4(U32.is_eq(k, 2))

def kind1.at64(b: Bool, +k: U32) -> Node1:
  match b:
    case True{}:
      G64{}
    case False{}:
      kind1.at16(U32.is_eq(k, 4), k)

def kind1.full(+k: U32, full: Bool) -> Node1:
  match full:
    case False{}:
      GSplit{}
    case True{}:
      kind1.at64(U32.is_eq(k, 6), k)

def kind1.wq(q: Bool, +k: U32, +lv: U32) -> Node1:
  match q:
    case True{}:
      GQuad{}
    case False{}:
      kind1.full(k, U32.is_le(k, lv))

def kind1.whole(+k: U32, +lv: U32, whole: Bool) -> Node1:
  match whole:
    case False{}:
      GSplit{}
    case True{}:
      kind1.wq(U32.is_eq(lv, 6) && U32.is_gt(k, 6), k, lv)

def kind1.big(+k: U32, +n: U32, +c: U32, +nch: U32, +last: U32, +lv: U32,
  b: Bool) -> Node1:
  match b:
    case False{}:
      GDown{}
    case True{}:
      kind1.whole(k, lv, U32.is_eq(n, U32.shln(1, U32.to_nat(k))) &&
        full((c + n : U32), nch, last))

# The kind of a node of depth k >= 1 of the GPU tree: a full subtree of
# 4, 16 or 64 chunks, no deeper than the leaf level lv, is one lane's leaf;
# at leaf level 6 a bigger whole subtree goes to strided lanes instead, as
# many as its 64-chunk leaves would take.
def kind1(+k: U32, +n: U32, +c: U32, +nch: U32, +last: U32, +lv: U32) -> Node1:
  kind1.big(k, n, c, nch, last, lv,
    U32.is_gt(n, U32.shln(1, U32.to_nat((k - 1 : U32)))))

# The leaf level for an input of depth k: the GPU runs 2^14 lanes, so
# leaves of 2^(k - 14) chunks (rounded down to 4^j, at most 64) keep every
# lane busy without a task per chunk.
def level(+k: U32) -> U32:
  +l = U32.min(U32.max(k, 14), 20)
  (((l - 14 : U32) >> 1n : U32) << 1n : U32)

# The GPU tree: forks to full 64-, 16- or 4-chunk subtrees, one lane each,
# and at leaf level 6 hands bigger whole subtrees to strided lanes.
def treeg(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, +ku: U32, d: Node1, aa: Array<U32> & Array<U32>, +c: U32,
  +n: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32, +lv: U32, +rf: U32) -> CV:
  match k d:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk(a1, c, cb, hi, nch, last, rf)
    case 1n+p GDown{}:
      +kp = (ku - 1 : U32)
      treeg(~dup, p, kp, kind1(kp, n, c, nch, last, lv), aa, c, n, cb, hi, nch, last, lv, rf)
    case 1n+p GQuad{}:
      (a1, a2) = aa
      _ = a2
      +q = U32.to_nat((ku - 6 : U32))
      fold4(qtree(~dup, q, dup(a1), c, (cb + c : U32), hi, U32.shln(16, q)), rf)
    case 1n+p G64{}:
      (a1, a2) = aa
      _ = a2
      g.fin(g64(a1, c, (cb + c : U32), hi, rf))
    case 1n+p G16{}:
      (a1, a2) = aa
      _ = a2
      g.fin(g16(a1, c, (cb + c : U32), hi, rf))
    case 1n+p G4{}:
      (a1, a2) = aa
      _ = a2
      g.fin(g4(a1, c, (cb + c : U32), hi, rf))
    case 1n+p GSplit{}:
      (a1, a2) = aa
      +kp = (ku - 1 : U32)
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      +c2 = (c + h : U32)
      l r = treeg(~dup, p, kp, kind1(kp, h, c, nch, last, lv), dup(a1), c, h, cb, hi, nch, last, lv, 0) treeg(~dup, p, kp, kind1(kp, n2, c2, nch, last, lv), dup(a2), c2, n2, cb, hi, nch, last, lv, 0)
      parent(l, r, rf)

type CV8 is Data:
  CV8{h0_0: U32, h1_0: U32, h2_0: U32, h3_0: U32, h4_0: U32, h5_0: U32, h6_0: U32, h7_0: U32, h0_1: U32, h1_1: U32, h2_1: U32, h3_1: U32, h4_1: U32, h5_1: U32, h6_1: U32, h7_1: U32, h0_2: U32, h1_2: U32, h2_2: U32, h3_2: U32, h4_2: U32, h5_2: U32, h6_2: U32, h7_2: U32, h0_3: U32, h1_3: U32, h2_3: U32, h3_3: U32, h4_3: U32, h5_3: U32, h6_3: U32, h7_3: U32, h0_4: U32, h1_4: U32, h2_4: U32, h3_4: U32, h4_4: U32, h5_4: U32, h6_4: U32, h7_4: U32, h0_5: U32, h1_5: U32, h2_5: U32, h3_5: U32, h4_5: U32, h5_5: U32, h6_5: U32, h7_5: U32, h0_6: U32, h1_6: U32, h2_6: U32, h3_6: U32, h4_6: U32, h5_6: U32, h6_6: U32, h7_6: U32, h0_7: U32, h1_7: U32, h2_7: U32, h3_7: U32, h4_7: U32, h5_7: U32, h6_7: U32, h7_7: U32}

type B128 is Data:
