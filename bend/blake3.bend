def ld.s1(r: Array<U32> & U32, +w: U32, m0: U32) -> Array<U32> & M16:
  (a, m1) = r
  ld.s2(a[(w + 2 : U32)], w, m0, m1)

def ld.s0(r: Array<U32> & U32, +w: U32) -> Array<U32> & M16:
  (a, m0) = r
  ld.s1(a[(w + 1 : U32)], w, m0)

# The 16 little-endian words of the block at word offset w.
def ld(a: Array<U32>, +w: U32) -> Array<U32> & M16:
  ld.s0(a[w], w)

# One round: four column G steps, then four diagonal ones.
def round(s: S16, +m: M16) -> S16:
  match s m:
    case S16{+v0_0, +v1_0, +v2_0, +v3_0, +v4_0, +v5_0, +v6_0, +v7_0, +v8_0, +v9_0, +v10_0, +v11_0, +v12_0, +v13_0, +v14_0, +v15_0} M16{+m0, +m1, +m2, +m3, +m4, +m5, +m6, +m7, +m8, +m9, +m10, +m11, +m12, +m13, +m14, +m15}:
      +v0_1 = (v0_0 + v4_0 + m0 : U32)
      +v12_1 = rotr16((v12_0 .^. v0_1 : U32))
      +v8_1 = (v8_0 + v12_1 : U32)
      +v4_1 = rotr12((v4_0 .^. v8_1 : U32))
      +v0_2 = (v0_1 + v4_1 + m1 : U32)
      +v12_2 = rotr8((v12_1 .^. v0_2 : U32))
      +v8_2 = (v8_1 + v12_2 : U32)
      +v4_2 = rotr7((v4_1 .^. v8_2 : U32))
      +v1_1 = (v1_0 + v5_0 + m2 : U32)
      +v13_1 = rotr16((v13_0 .^. v1_1 : U32))
      +v9_1 = (v9_0 + v13_1 : U32)
      +v5_1 = rotr12((v5_0 .^. v9_1 : U32))
      +v1_2 = (v1_1 + v5_1 + m3 : U32)
      +v13_2 = rotr8((v13_1 .^. v1_2 : U32))
      +v9_2 = (v9_1 + v13_2 : U32)
      +v5_2 = rotr7((v5_1 .^. v9_2 : U32))
      +v2_1 = (v2_0 + v6_0 + m4 : U32)
      +v14_1 = rotr16((v14_0 .^. v2_1 : U32))
      +v10_1 = (v10_0 + v14_1 : U32)
      +v6_1 = rotr12((v6_0 .^. v10_1 : U32))
      +v2_2 = (v2_1 + v6_1 + m5 : U32)
      +v14_2 = rotr8((v14_1 .^. v2_2 : U32))
      +v10_2 = (v10_1 + v14_2 : U32)
      +v6_2 = rotr7((v6_1 .^. v10_2 : U32))
      +v3_1 = (v3_0 + v7_0 + m6 : U32)
      +v15_1 = rotr16((v15_0 .^. v3_1 : U32))
      +v11_1 = (v11_0 + v15_1 : U32)
      +v7_1 = rotr12((v7_0 .^. v11_1 : U32))
      +v3_2 = (v3_1 + v7_1 + m7 : U32)
      +v15_2 = rotr8((v15_1 .^. v3_2 : U32))
      +v11_2 = (v11_1 + v15_2 : U32)
      +v7_2 = rotr7((v7_1 .^. v11_2 : U32))
      +v0_3 = (v0_2 + v5_2 + m8 : U32)
      +v15_3 = rotr16((v15_2 .^. v0_3 : U32))
      +v10_3 = (v10_2 + v15_3 : U32)
      +v5_3 = rotr12((v5_2 .^. v10_3 : U32))
      +v0_4 = (v0_3 + v5_3 + m9 : U32)
      +v15_4 = rotr8((v15_3 .^. v0_4 : U32))
      +v10_4 = (v10_3 + v15_4 : U32)
      +v5_4 = rotr7((v5_3 .^. v10_4 : U32))
      +v1_3 = (v1_2 + v6_2 + m10 : U32)
      +v12_3 = rotr16((v12_2 .^. v1_3 : U32))
      +v11_3 = (v11_2 + v12_3 : U32)
      +v6_3 = rotr12((v6_2 .^. v11_3 : U32))
      +v1_4 = (v1_3 + v6_3 + m11 : U32)
      +v12_4 = rotr8((v12_3 .^. v1_4 : U32))
      +v11_4 = (v11_3 + v12_4 : U32)
      +v6_4 = rotr7((v6_3 .^. v11_4 : U32))
      +v2_3 = (v2_2 + v7_2 + m12 : U32)
      +v13_3 = rotr16((v13_2 .^. v2_3 : U32))
      +v8_3 = (v8_2 + v13_3 : U32)
      +v7_3 = rotr12((v7_2 .^. v8_3 : U32))
      +v2_4 = (v2_3 + v7_3 + m13 : U32)
      +v13_4 = rotr8((v13_3 .^. v2_4 : U32))
      +v8_4 = (v8_3 + v13_4 : U32)
      +v7_4 = rotr7((v7_3 .^. v8_4 : U32))
      +v3_3 = (v3_2 + v4_2 + m14 : U32)
      +v14_3 = rotr16((v14_2 .^. v3_3 : U32))
      +v9_3 = (v9_2 + v14_3 : U32)
      +v4_3 = rotr12((v4_2 .^. v9_3 : U32))
      +v3_4 = (v3_3 + v4_3 + m15 : U32)
      +v14_4 = rotr8((v14_3 .^. v3_4 : U32))
      +v9_4 = (v9_3 + v14_4 : U32)
      +v4_4 = rotr7((v4_3 .^. v9_4 : U32))
      S16{v0_4, v1_4, v2_4, v3_4, v4_4, v5_4, v6_4, v7_4, v8_4, v9_4, v10_4, v11_4, v12_4, v13_4, v14_4, v15_4}

# The message schedule between rounds.
def perm(m: M16) -> M16:
  match m:
    case M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}:
      M16{m2, m6, m3, m10, m7, m0, m4, m13, m1, m11, m12, m5, m9, m14, m15, m8}

def out(s: S16) -> CV:
  match s:
    case S16{v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15}:
      CV{(v0 .^. v8 : U32), (v1 .^. v9 : U32), (v2 .^. v10 : U32), (v3 .^. v11 : U32), (v4 .^. v12 : U32), (v5 .^. v13 : U32), (v6 .^. v14 : U32), (v7 .^. v15 : U32)}

# The compression function, truncated to the 8 words a CV needs.
def compress(cv: CV, +m1: M16, +t0: U32, +t1: U32, +blen: U32, +flags: U32) -> CV:
  match cv:
    case CV{h0, h1, h2, h3, h4, h5, h6, h7}:
      +m2 = perm(m1)
      +m3 = perm(m2)
      +m4 = perm(m3)
      +m5 = perm(m4)
      +m6 = perm(m5)
      +m7 = perm(m6)
      s0 = {S16{h0, h1, h2, h3, h4, h5, h6, h7, 1779033703, 3144134277, 1013904242, 2773480762, t0, t1, blen, flags} : S16}
      out(round(round(round(round(round(round(round(s0, m1), m2), m3), m4), m5), m6), m7))


# Chains one chunk's blocks. `r` is the block at word w, already loaded; n
# counts the blocks after it. Only the last block takes `endf` and `lastlen`.
def chunk.go(n: Nat, r: Array<U32> & M16, +w: U32, cv: CV, +ctr: U32, +fl: U32,
  +endf: U32, +lastlen: U32) -> Array<U32> & CV:
  match n:
    case 0n:
      (a, m) = r
      (a, compress(cv, m, ctr, 0, lastlen, (fl .|. endf : U32)))
    case 1n+p:
      (a, m) = r
      +w2 = (w + 16 : U32)
      chunk.go(p, ld(a, w2), w2, compress(cv, m, ctr, 0, 64, fl), ctr, 0, endf,
        lastlen)

def chunk.fin(r: Array<U32> & CV) -> CV:
  (a, cv) = r
  _ = a
  cv

# The CV of chunk c of a `len`-byte input; `rf` is ROOT for a one-chunk input.
def chunk(a: Array<U32>, +c: U32, +len: U32, +rf: U32) -> CV:
  +w = (c << 8n : U32)
  +rem = U32.min((len - (c << 10n : U32) : U32), 1024)
  +nb = U32.max(((rem + 63 : U32) >> 6n : U32), 1)
  +lastlen = (rem - ((nb - 1 : U32) << 6n : U32) : U32)
  chunk.fin(chunk.go(U32.to_nat((nb - 1 : U32)), ld(a, w), w, IV(), c,
    CHUNK_START(), (CHUNK_END() .|. rf : U32), lastlen))

def parent(l: CV, r: CV, +rf: U32) -> CV:
  match l r:
    case CV{l0, l1, l2, l3, l4, l5, l6, l7} CV{r0, r1, r2, r3, r4, r5, r6, r7}:
      compress(IV(), M16{l0, l1, l2, l3, l4, l5, l6, l7, r0, r1, r2, r3, r4, r5,
        r6, r7}, 0, 0, 64, (PARENT() .|. rf : U32))

# Whether n chunks overflow a left subtree of 2^(k-1): if so, a level of
# depth k has a parent node.
def big(+k: Nat, +n: U32) -> Bool:
  match k:
    case 0n:
      False{}
    case 1n+p:
      U32.is_gt(n, U32.shln(1, p))

# The CV of the n chunks from chunk c, n <= 2^k. Each node holds two read
# handles of the input (an O(1) Array.fork), so both halves read it at once.
def tree(+k: Nat, b: Bool, aa: Array<U32> & Array<U32>, +c: U32, +n: U32,
  +len: U32, +rf: U32) -> CV:
  match k b:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk(a1, c, len, rf)
    case 1n+p False{}:
      tree(p, big(p, n), aa, c, n, len, rf)
    case 1n+p True{}:
      (a1, a2) = aa
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      l r = tree(p, big(p, h), Array.fork(U32, a1), c, h, len, 0) tree(p, big(p, n2), Array.fork(U32, a2), (c + h : U32), n2, len, 0)
      parent(l, r, rf)

def chunks(+len: U32) -> U32:
  U32.max(((len + 1023 : U32) >> 10n : U32), 1)

# ceil(log2(n)) for n >= 1
def depth.go(b: Bool, +n: U32) -> Nat:
  match b:
    case True{}:
      0n
    case False{}:
      1n+U32.log2((n - 1 : U32))

def depth(+n: U32) -> Nat:
  depth.go(U32.is_le(n, 1), n)

def hash.go(+k: Nat, a: Array<U32>, +n: U32, +len: U32) -> CV:
  tree(k, big(k, n), Array.fork(U32, a), 0, n, len, ROOT())

# The BLAKE3 hash (first 32 bytes) of `len` bytes held in `a`.
def hash(a: Array<U32>, +len: U32) -> CV:
  +n = chunks(len)
  hash.go(depth(n), a, n, len)

# Hex
# ---

def hex.pick(b: Bool, +d: U32) -> Char:
  match b:
    case True{}:
      Chr{(d + 48 : U32)}
    case False{}:
      Chr{(d + 87 : U32)}

def hex.digit(+d: U32) -> Char:
  hex.pick(U32.is_lt(d, 10), d)

def hex.byte(+x: U32, s: String) -> String:
  SCon{hex.digit(((x >> 4n) .&. 15 : U32)), SCon{hex.digit((x .&. 15 : U32)), s}}

def hex.word(+x: U32, s: String) -> String:
  hex.byte(x, hex.byte((x >> 8n : U32), hex.byte((x >> 16n : U32),
    hex.byte((x >> 24n : U32), s))))

def hex(cv: CV) -> String:
  match cv:
    case CV{h0, h1, h2, h3, h4, h5, h6, h7}:
      hex.word(h0, hex.word(h1, hex.word(h2, hex.word(h3, hex.word(h4,
        hex.word(h5, hex.word(h6, hex.word(h7, SNil{}))))))))
