# The step to the next block: none after the last, so the loop's one extra
# load re-reads a block of the chunks instead of reading past them (a
# mapped file may end right there).
def step(+p: Nat) -> U32:
  match p:
    case 0n:
      0
    case 1n+q:
      16

# Chains eight full chunks from word w at once; n counts the blocks left.
# The loop has one compress8, so clang inlines it and vectorizes the whole
# loop from the word-major stores of its result. At n = 0, r holds a block
# read for nothing.
def c8.go(+n: Nat, r: Array<U32> & B128, +w: U32, cv: CV8, +ctr: U32,
  +hi: U32, +fl: U32) -> Array<U32> & CV8:
  match n:
    case 0n:
      (a, m) = r
      (a, cv)
    case 1n+p:
      (a, m) = r
      +w2 = (w + step(p) : U32)
      c8.go(p, ld8(a, w2), w2, compress8(cv, m, ctr, 1, hi, 64,
        (fl .|. endf(p) : U32)), ctr, hi, 0)

# The CVs of chunks c..c+7 of the array, whose counters start at hi:t.
def group(a: Array<U32>, +c: U32, +t: U32, +hi: U32) -> Array<U32> & CV8:
  +w = (c << 8n : U32)
  c8.go(16n, ld8(a, w), w, IV8(), t, hi, CHUNK_START())

# One level of parents over 16 CVs: lanes 0-3 merge x's lane pairs,
# lanes 4-7 merge y's, so a level stays in lane order.
def par8(x: CV8, y: CV8) -> CV8:
  match x y:
    case CV8{x0_0, x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, x0_1, x1_1, x2_1, x3_1, x4_1, x5_1, x6_1, x7_1, x0_2, x1_2, x2_2, x3_2, x4_2, x5_2, x6_2, x7_2, x0_3, x1_3, x2_3, x3_3, x4_3, x5_3, x6_3, x7_3, x0_4, x1_4, x2_4, x3_4, x4_4, x5_4, x6_4, x7_4, x0_5, x1_5, x2_5, x3_5, x4_5, x5_5, x6_5, x7_5, x0_6, x1_6, x2_6, x3_6, x4_6, x5_6, x6_6, x7_6, x0_7, x1_7, x2_7, x3_7, x4_7, x5_7, x6_7, x7_7} CV8{y0_0, y1_0, y2_0, y3_0, y4_0, y5_0, y6_0, y7_0, y0_1, y1_1, y2_1, y3_1, y4_1, y5_1, y6_1, y7_1, y0_2, y1_2, y2_2, y3_2, y4_2, y5_2, y6_2, y7_2, y0_3, y1_3, y2_3, y3_3, y4_3, y5_3, y6_3, y7_3, y0_4, y1_4, y2_4, y3_4, y4_4, y5_4, y6_4, y7_4, y0_5, y1_5, y2_5, y3_5, y4_5, y5_5, y6_5, y7_5, y0_6, y1_6, y2_6, y3_6, y4_6, y5_6, y6_6, y7_6, y0_7, y1_7, y2_7, y3_7, y4_7, y5_7, y6_7, y7_7}:
      compress8.p(IV8(), B128{x0_0, x2_0, x4_0, x6_0, y0_0, y2_0, y4_0, y6_0, x0_1, x2_1, x4_1, x6_1, y0_1, y2_1, y4_1, y6_1, x0_2, x2_2, x4_2, x6_2, y0_2, y2_2, y4_2, y6_2, x0_3, x2_3, x4_3, x6_3, y0_3, y2_3, y4_3, y6_3, x0_4, x2_4, x4_4, x6_4, y0_4, y2_4, y4_4, y6_4, x0_5, x2_5, x4_5, x6_5, y0_5, y2_5, y4_5, y6_5, x0_6, x2_6, x4_6, x6_6, y0_6, y2_6, y4_6, y6_6, x0_7, x2_7, x4_7, x6_7, y0_7, y2_7, y4_7, y6_7, x1_0, x3_0, x5_0, x7_0, y1_0, y3_0, y5_0, y7_0, x1_1, x3_1, x5_1, x7_1, y1_1, y3_1, y5_1, y7_1, x1_2, x3_2, x5_2, x7_2, y1_2, y3_2, y5_2, y7_2, x1_3, x3_3, x5_3, x7_3, y1_3, y3_3, y5_3, y7_3, x1_4, x3_4, x5_4, x7_4, y1_4, y3_4, y5_4, y7_4, x1_5, x3_5, x5_5, x7_5, y1_5, y3_5, y5_5, y7_5, x1_6, x3_6, x5_6, x7_6, y1_6, y3_6, y5_6, y7_6, x1_7, x3_7, x5_7, x7_7, y1_7, y3_7, y5_7, y7_7}, 64, PARENT())

# The last three levels over a CV8's lanes, one compression each.
def fold8(x: CV8, +rf: U32) -> CV:
  match x:
    case CV8{x0_0, x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, x0_1, x1_1, x2_1, x3_1, x4_1, x5_1, x6_1, x7_1, x0_2, x1_2, x2_2, x3_2, x4_2, x5_2, x6_2, x7_2, x0_3, x1_3, x2_3, x3_3, x4_3, x5_3, x6_3, x7_3, x0_4, x1_4, x2_4, x3_4, x4_4, x5_4, x6_4, x7_4, x0_5, x1_5, x2_5, x3_5, x4_5, x5_5, x6_5, x7_5, x0_6, x1_6, x2_6, x3_6, x4_6, x5_6, x6_6, x7_6, x0_7, x1_7, x2_7, x3_7, x4_7, x5_7, x6_7, x7_7}:
      parent(parent(parent(CV{x0_0, x0_1, x0_2, x0_3, x0_4, x0_5, x0_6, x0_7}, CV{x1_0, x1_1, x1_2, x1_3, x1_4, x1_5, x1_6, x1_7}, 0), parent(CV{x2_0, x2_1, x2_2, x2_3, x2_4, x2_5, x2_6, x2_7}, CV{x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7}, 0), 0),
        parent(parent(CV{x4_0, x4_1, x4_2, x4_3, x4_4, x4_5, x4_6, x4_7}, CV{x5_0, x5_1, x5_2, x5_3, x5_4, x5_5, x5_6, x5_7}, 0), parent(CV{x6_0, x6_1, x6_2, x6_3, x6_4, x6_5, x6_6, x6_7}, CV{x7_0, x7_1, x7_2, x7_3, x7_4, x7_5, x7_6, x7_7}, 0), 0), rf)

def leaf8.fin(r: Array<U32> & CV8, +rf: U32) -> CV:
  (a, x) = r
  _ = a
  fold8(x, rf)

def leaf8(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> CV:
  leaf8.fin(group(a, c, t, hi), rf)

# 32 full chunks: four groups, two levels of par8, then fold8.
def leaf32.s3(r: Array<U32> & CV8, x: CV8, g2: CV8) -> Array<U32> & CV8:
  (a, g3) = r
  (a, par8(x, par8(g2, g3)))

def leaf32.s2(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32, x: CV8) -> Array<U32> & CV8:
  (a, g2) = r
  leaf32.s3(group(a, (c + 24 : U32), (t + 24 : U32), hi), x, g2)

def leaf32.s1(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32, g0: CV8) -> Array<U32> & CV8:
  (a, g1) = r
  leaf32.s2(group(a, (c + 16 : U32), (t + 16 : U32), hi), c, t, hi, par8(g0, g1))

def leaf32.s0(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32) -> Array<U32> & CV8:
  (a, g0) = r
  leaf32.s1(group(a, (c + 8 : U32), (t + 8 : U32), hi), c, t, hi, g0)

def leaf32(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> CV:
  leaf8.fin(leaf32.s0(group(a, c, t, hi), c, t, hi), rf)

# What a node of the CPU tree does.
type Node is Data:
  Down{}
  Split{}
  Leaf8{}
  Leaf32{}

def kind.at3(b: Bool) -> Node:
  match b:
    case True{}:
      Leaf8{}
    case False{}:
      Split{}

def kind.at(b: Bool, +k: U32) -> Node:
  match b:
    case True{}:
      Leaf32{}
    case False{}:
      kind.at3(U32.is_eq(k, 3))

def kind.full(+k: U32, full: Bool) -> Node:
  match full:
    case False{}:
      Split{}
    case True{}:
      kind.at(U32.is_eq(k, 5), k)

def kind.big(+k: U32, +n: U32, +c: U32, +nch: U32, +last: U32, b: Bool) -> Node:
  match b:
    case False{}:
      Down{}
    case True{}:
      kind.full(k, U32.is_eq(n, U32.shln(1, U32.to_nat(k))) &&
        full((c + n : U32), nch, last))

# The kind of a node of depth k >= 1 over chunks c..c+n: a wide leaf needs
# all 2^k chunks full.
def kind(+k: U32, +n: U32, +c: U32, +nch: U32, +last: U32) -> Node:
  kind.big(k, n, c, nch, last,
    U32.is_gt(n, U32.shln(1, U32.to_nat((k - 1 : U32)))))

# tree1's shape, but full 32- and 8-chunk subtrees go through compress8.
def tree8(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, +ku: U32, d: Node, aa: Array<U32> & Array<U32>, +c: U32,
  +n: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV:
  match k d:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk(a1, c, cb, hi, nch, last, rf)
    case 1n+p Down{}:
      +kp = (ku - 1 : U32)
      tree8(~dup, p, kp, kind(kp, n, c, nch, last), aa, c, n, cb, hi, nch, last, rf)
    case 1n+p Leaf32{}:
      (a1, a2) = aa
      _ = a2
      leaf32(a1, c, (cb + c : U32), hi, rf)
    case 1n+p Leaf8{}:
      (a1, a2) = aa
      _ = a2
      leaf8(a1, c, (cb + c : U32), hi, rf)
    case 1n+p Split{}:
      (a1, a2) = aa
      +kp = (ku - 1 : U32)
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      +c2 = (c + h : U32)
      l r = tree8(~dup, p, kp, kind(kp, h, c, nch, last), dup(a1), c, h, cb, hi, nch, last, 0) tree8(~dup, p, kp, kind(kp, n2, c2, nch, last), dup(a2), c2, n2, cb, hi, nch, last, 0)
      parent(l, r, rf)

# Entry points
# ------------
#
# An input is a span: nch chunks held from word 0 of an array, the last
# holding `last` bytes (1..1024, or 0 for the empty input), with chunk
# counters from cb. A whole input takes rf = ROOT; a span that is a
# complete subtree of a larger input (a 1 GiB segment of a big file) takes
# rf = 0 and gives that subtree's CV.
#
# BLAKE3's chunk counter is 64 bits: hi is its high word, the same for every
# chunk of a span, so a span never crosses a multiple of 2^32 chunks (cb +
# nch <= 2^32). A file's 1 GiB segments never do, and with hi a file is no
# longer held to 2^32 chunks (4 TiB): BLAKE3 goes to 2^64 bytes.
#
# The trees and entry points take `~dup`, which hands a tree node two read
# handles of the input. hash.bend passes Array.fork (O(1), the fast path,
# but @unsafe in Base); the laws pass Array.clone, so every def in this file
# is proof-safe and LAWS.bend states facts about the code that runs.

def hash.go(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32) -> CV:
  match k:
    case 0n:
      chunk(a, 0, cb, hi, nch, last, rf)
    case 1n+p:
      +ku = U32.from_nat(k)
      tree8(~dup, k, ku, kind(ku, nch, 0, nch, last), dup(a), 0, nch, cb, hi,
        nch, last, rf)

# The CV of a span, on the CPU's 8-lane tree.
def hash.at(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV:
  hash.go(~dup, depth(nch), a, cb, hi, nch, last, rf)

# The bytes of the last chunk of a len-byte input of n chunks.
def tail(+len: U32, +n: U32) -> U32:
  (len - ((n - 1 : U32) << 10n : U32) : U32)

# The BLAKE3 hash (first 32 bytes) of `len` bytes held in `a`, for the CPU.
def hash(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +len: U32) -> CV:
  +n = chunks(len)
  hash.at(~dup, a, 0, 0, n, tail(len, n), ROOT())

# Bao outboards
# -------------
#
# iroh-blobs (bao-tree) stores, beside a blob, the pair (left CV, right CV)
# of every parent above its 16 KiB chunk groups, in pre-order: a blob of B
# groups has B - 1 pairs. A group is 2^4 chunks, so those are BLAKE3's own
# parents of level 5 and up (each child at least a whole group). tree8o is
# tree8 that keeps them as an OB tree (the pair, then the left side's pairs,
# then the right side's), as it computes them.

type OB is Data:
  ONil{}
  ONode{l: CV, r: CV, a: OB, b: OB}

def join.pick(rec: Bool, +l: CV, +r: CV, a: OB, b: OB, +rf: U32) -> CV & OB:
  match rec:
    case True{}:
      (parent(l, r, rf), ONode{l, r, a, b})
    case False{}:
      (parent(l, r, rf), ONil{})

# A parent over two subtrees' results; rec says whether it is an outboard
# node (both children at least a chunk group).
def join.o(x: CV & OB, y: CV & OB, +rf: U32, rec: Bool) -> CV & OB:
  (l, a) = x
  (r, b) = y
  join.pick(rec, l, r, a, b, rf)

# fold8 that keeps its top parent: over a CV8 of 4-chunk subtrees, that
# parent's children are the two 16-chunk groups.
def fold8o(x: CV8, +rf: U32) -> CV & OB:
  match x:
    case CV8{x0_0, x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, x0_1, x1_1, x2_1, x3_1, x4_1, x5_1, x6_1, x7_1, x0_2, x1_2, x2_2, x3_2, x4_2, x5_2, x6_2, x7_2, x0_3, x1_3, x2_3, x3_3, x4_3, x5_3, x6_3, x7_3, x0_4, x1_4, x2_4, x3_4, x4_4, x5_4, x6_4, x7_4, x0_5, x1_5, x2_5, x3_5, x4_5, x5_5, x6_5, x7_5, x0_6, x1_6, x2_6, x3_6, x4_6, x5_6, x6_6, x7_6, x0_7, x1_7, x2_7, x3_7, x4_7, x5_7, x6_7, x7_7}:
      +gl = parent(parent(CV{x0_0, x0_1, x0_2, x0_3, x0_4, x0_5, x0_6, x0_7}, CV{x1_0, x1_1, x1_2, x1_3, x1_4, x1_5, x1_6, x1_7}, 0), parent(CV{x2_0, x2_1, x2_2, x2_3, x2_4, x2_5, x2_6, x2_7}, CV{x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7}, 0), 0)
      +gr = parent(parent(CV{x4_0, x4_1, x4_2, x4_3, x4_4, x4_5, x4_6, x4_7}, CV{x5_0, x5_1, x5_2, x5_3, x5_4, x5_5, x5_6, x5_7}, 0), parent(CV{x6_0, x6_1, x6_2, x6_3, x6_4, x6_5, x6_6, x6_7}, CV{x7_0, x7_1, x7_2, x7_3, x7_4, x7_5, x7_6, x7_7}, 0), 0)
      (parent(gl, gr, rf), ONode{gl, gr, ONil{}, ONil{}})

def leaf32o.fin(r: Array<U32> & CV8, +rf: U32) -> CV & OB:
  (a, x) = r
  _ = a
  fold8o(x, rf)

def leaf32o(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32) -> CV & OB:
  leaf32o.fin(leaf32.s0(group(a, c, t, hi), c, t, hi), rf)

def tree8o(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, +ku: U32, d: Node, aa: Array<U32> & Array<U32>, +c: U32,
  +n: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV & OB:
  match k d:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      (chunk(a1, c, cb, hi, nch, last, rf), ONil{})
    case 1n+p Down{}:
      +kp = (ku - 1 : U32)
      tree8o(~dup, p, kp, kind(kp, n, c, nch, last), aa, c, n, cb, hi, nch, last, rf)
    case 1n+p Leaf32{}:
      (a1, a2) = aa
      _ = a2
      leaf32o(a1, c, (cb + c : U32), hi, rf)
    case 1n+p Leaf8{}:
      (a1, a2) = aa
      _ = a2
      (leaf8(a1, c, (cb + c : U32), hi, rf), ONil{})
    case 1n+p Split{}:
      (a1, a2) = aa
      +kp = (ku - 1 : U32)
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      +c2 = (c + h : U32)
      x y = tree8o(~dup, p, kp, kind(kp, h, c, nch, last), dup(a1), c, h, cb, hi, nch, last, 0) tree8o(~dup, p, kp, kind(kp, n2, c2, nch, last), dup(a2), c2, n2, cb, hi, nch, last, 0)
      join.o(x, y, rf, U32.is_ge(ku, 5))

def hash.ob.go(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32) -> CV & OB:
  match k:
    case 0n:
      (chunk(a, 0, cb, hi, nch, last, rf), ONil{})
    case 1n+p:
      +ku = U32.from_nat(k)
      tree8o(~dup, k, ku, kind(ku, nch, 0, nch, last), dup(a), 0, nch,
        cb, hi, nch, last, rf)

# The CV of a span, with its outboard pairs (see above).
def hash.ob.at(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV & OB:
  hash.ob.go(~dup, depth(nch), a, cb, hi, nch, last, rf)

def hash.ob(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +len: U32) -> CV & OB:
  +n = chunks(len)
  hash.ob.at(~dup, a, 0, 0, n, tail(len, n), ROOT())

def hash1.go(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32) -> CV:
  match k:
    case 0n:
      chunk(a, 0, cb, hi, nch, last, rf)
    case 1n+p:
      +ku = U32.from_nat(k)
      +lv = level(ku)
      treeg(~dup, k, ku, kind1(ku, nch, 0, nch, last, lv), dup(a), 0,
        nch, cb, hi, nch, last, lv, rf)

# The CV of a span, one lane per chunk: the shape for the GPU (call with !).
def hash1.at(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32) -> CV:
  hash1.go(~dup, depth(nch), a, cb, hi, nch, last, rf)

def hash1(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +len: U32) -> CV:
  +n = chunks(len)
  hash1.at(~dup, a, 0, 0, n, tail(len, n), ROOT())

# Keyed and key-derivation modes, 8 lanes
# ---------------------------------------
#
# The CPU tree's defs again, with the key (`key`, and `k8` in every lane)
# and the mode flag (kf) threaded through, as the scalar .k defs do;
# compress8 and the node kinds are the default mode's.

def key8(+k: CV) -> CV8:
  match k:
    case CV{+h0, +h1, +h2, +h3, +h4, +h5, +h6, +h7}:
      CV8{h0, h0, h0, h0, h0, h0, h0, h0, h1, h1, h1, h1, h1, h1, h1, h1, h2, h2, h2, h2, h2, h2, h2, h2, h3, h3, h3, h3, h3, h3, h3, h3, h4, h4, h4, h4, h4, h4, h4, h4, h5, h5, h5, h5, h5, h5, h5, h5, h6, h6, h6, h6, h6, h6, h6, h6, h7, h7, h7, h7, h7, h7, h7, h7}

def c8.go.k(+n: Nat, r: Array<U32> & B128, +w: U32, cv: CV8, +ctr: U32,
  +hi: U32, +fl: U32, +kf: U32) -> Array<U32> & CV8:
  match n:
    case 0n:
      (a, m) = r
      (a, cv)
    case 1n+p:
      (a, m) = r
      +w2 = (w + step(p) : U32)
      c8.go.k(p, ld8(a, w2), w2, compress8(cv, m, ctr, 1, hi, 64,
        ((fl .|. endf(p) : U32) .|. kf : U32)), ctr, hi, 0, kf)

def group.k(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +key: CV, +kf: U32) -> Array<U32> & CV8:
  +w = (c << 8n : U32)
  c8.go.k(16n, ld8(a, w), w, key8(key), t, hi, CHUNK_START(), kf)

# One level of parents over 16 CVs: lanes 0-3 merge x's lane pairs,
# lanes 4-7 merge y's, so a level stays in lane order.
def par8.k(x: CV8, y: CV8, +key: CV, +kf: U32) -> CV8:
  match x y:
    case CV8{x0_0, x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, x0_1, x1_1, x2_1, x3_1, x4_1, x5_1, x6_1, x7_1, x0_2, x1_2, x2_2, x3_2, x4_2, x5_2, x6_2, x7_2, x0_3, x1_3, x2_3, x3_3, x4_3, x5_3, x6_3, x7_3, x0_4, x1_4, x2_4, x3_4, x4_4, x5_4, x6_4, x7_4, x0_5, x1_5, x2_5, x3_5, x4_5, x5_5, x6_5, x7_5, x0_6, x1_6, x2_6, x3_6, x4_6, x5_6, x6_6, x7_6, x0_7, x1_7, x2_7, x3_7, x4_7, x5_7, x6_7, x7_7} CV8{y0_0, y1_0, y2_0, y3_0, y4_0, y5_0, y6_0, y7_0, y0_1, y1_1, y2_1, y3_1, y4_1, y5_1, y6_1, y7_1, y0_2, y1_2, y2_2, y3_2, y4_2, y5_2, y6_2, y7_2, y0_3, y1_3, y2_3, y3_3, y4_3, y5_3, y6_3, y7_3, y0_4, y1_4, y2_4, y3_4, y4_4, y5_4, y6_4, y7_4, y0_5, y1_5, y2_5, y3_5, y4_5, y5_5, y6_5, y7_5, y0_6, y1_6, y2_6, y3_6, y4_6, y5_6, y6_6, y7_6, y0_7, y1_7, y2_7, y3_7, y4_7, y5_7, y6_7, y7_7}:
      compress8.p(key8(key), B128{x0_0, x2_0, x4_0, x6_0, y0_0, y2_0, y4_0, y6_0, x0_1, x2_1, x4_1, x6_1, y0_1, y2_1, y4_1, y6_1, x0_2, x2_2, x4_2, x6_2, y0_2, y2_2, y4_2, y6_2, x0_3, x2_3, x4_3, x6_3, y0_3, y2_3, y4_3, y6_3, x0_4, x2_4, x4_4, x6_4, y0_4, y2_4, y4_4, y6_4, x0_5, x2_5, x4_5, x6_5, y0_5, y2_5, y4_5, y6_5, x0_6, x2_6, x4_6, x6_6, y0_6, y2_6, y4_6, y6_6, x0_7, x2_7, x4_7, x6_7, y0_7, y2_7, y4_7, y6_7, x1_0, x3_0, x5_0, x7_0, y1_0, y3_0, y5_0, y7_0, x1_1, x3_1, x5_1, x7_1, y1_1, y3_1, y5_1, y7_1, x1_2, x3_2, x5_2, x7_2, y1_2, y3_2, y5_2, y7_2, x1_3, x3_3, x5_3, x7_3, y1_3, y3_3, y5_3, y7_3, x1_4, x3_4, x5_4, x7_4, y1_4, y3_4, y5_4, y7_4, x1_5, x3_5, x5_5, x7_5, y1_5, y3_5, y5_5, y7_5, x1_6, x3_6, x5_6, x7_6, y1_6, y3_6, y5_6, y7_6, x1_7, x3_7, x5_7, x7_7, y1_7, y3_7, y5_7, y7_7}, 64, (PARENT() .|. kf : U32))

# The last three levels over a CV8's lanes, one compression each.
def fold8.k(x: CV8, +rf: U32, +key: CV, +kf: U32) -> CV:
  match x:
    case CV8{x0_0, x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, x0_1, x1_1, x2_1, x3_1, x4_1, x5_1, x6_1, x7_1, x0_2, x1_2, x2_2, x3_2, x4_2, x5_2, x6_2, x7_2, x0_3, x1_3, x2_3, x3_3, x4_3, x5_3, x6_3, x7_3, x0_4, x1_4, x2_4, x3_4, x4_4, x5_4, x6_4, x7_4, x0_5, x1_5, x2_5, x3_5, x4_5, x5_5, x6_5, x7_5, x0_6, x1_6, x2_6, x3_6, x4_6, x5_6, x6_6, x7_6, x0_7, x1_7, x2_7, x3_7, x4_7, x5_7, x6_7, x7_7}:
      parent.k(parent.k(parent.k(CV{x0_0, x0_1, x0_2, x0_3, x0_4, x0_5, x0_6, x0_7}, CV{x1_0, x1_1, x1_2, x1_3, x1_4, x1_5, x1_6, x1_7}, 0, key, kf), parent.k(CV{x2_0, x2_1, x2_2, x2_3, x2_4, x2_5, x2_6, x2_7}, CV{x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7}, 0, key, kf), 0, key, kf),
        parent.k(parent.k(CV{x4_0, x4_1, x4_2, x4_3, x4_4, x4_5, x4_6, x4_7}, CV{x5_0, x5_1, x5_2, x5_3, x5_4, x5_5, x5_6, x5_7}, 0, key, kf), parent.k(CV{x6_0, x6_1, x6_2, x6_3, x6_4, x6_5, x6_6, x6_7}, CV{x7_0, x7_1, x7_2, x7_3, x7_4, x7_5, x7_6, x7_7}, 0, key, kf), 0, key, kf), rf, key, kf)

def leaf8.fin.k(r: Array<U32> & CV8, +rf: U32, +key: CV, +kf: U32) -> CV:
  (a, x) = r
  _ = a
  fold8.k(x, rf, key, kf)

def leaf8.k(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32, +key: CV, +kf: U32) -> CV:
  leaf8.fin.k(group.k(a, c, t, hi, key, kf), rf, key, kf)

def leaf32.s3.k(r: Array<U32> & CV8, x: CV8, g2: CV8, +key: CV, +kf: U32) -> Array<U32> & CV8:
  (a, g3) = r
  (a, par8.k(x, par8.k(g2, g3, key, kf), key, kf))

def leaf32.s2.k(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32, x: CV8, +key: CV, +kf: U32) -> Array<U32> & CV8:
  (a, g2) = r
  leaf32.s3.k(group.k(a, (c + 24 : U32), (t + 24 : U32), hi, key, kf), x, g2, key, kf)

def leaf32.s1.k(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32, g0: CV8, +key: CV, +kf: U32) -> Array<U32> & CV8:
  (a, g1) = r
  leaf32.s2.k(group.k(a, (c + 16 : U32), (t + 16 : U32), hi, key, kf), c, t, hi, par8.k(g0, g1, key, kf), key, kf)

def leaf32.s0.k(r: Array<U32> & CV8, +c: U32, +t: U32, +hi: U32, +key: CV, +kf: U32) -> Array<U32> & CV8:
  (a, g0) = r
  leaf32.s1.k(group.k(a, (c + 8 : U32), (t + 8 : U32), hi, key, kf), c, t, hi, g0, key, kf)

def leaf32.k(a: Array<U32>, +c: U32, +t: U32, +hi: U32, +rf: U32, +key: CV, +kf: U32) -> CV:
  leaf8.fin.k(leaf32.s0.k(group.k(a, c, t, hi, key, kf), c, t, hi, key, kf), rf, key, kf)

def tree8.k(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, +ku: U32, d: Node, aa: Array<U32> & Array<U32>, +c: U32,
  +n: U32, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32, +key: CV,
  +kf: U32) -> CV:
  match k d:
    case 0n _:
      (a1, a2) = aa
      _ = a2
      chunk.k(a1, c, cb, hi, nch, last, rf, key, kf)
    case 1n+p Down{}:
      +kp = (ku - 1 : U32)
      tree8.k(~dup, p, kp, kind(kp, n, c, nch, last), aa, c, n, cb, hi, nch, last, rf, key, kf)
    case 1n+p Leaf32{}:
      (a1, a2) = aa
      _ = a2
      leaf32.k(a1, c, (cb + c : U32), hi, rf, key, kf)
    case 1n+p Leaf8{}:
      (a1, a2) = aa
      _ = a2
      leaf8.k(a1, c, (cb + c : U32), hi, rf, key, kf)
    case 1n+p Split{}:
      (a1, a2) = aa
      +kp = (ku - 1 : U32)
      +h = U32.shln(1, p)
      +n2 = (n - h : U32)
      +c2 = (c + h : U32)
      l r = tree8.k(~dup, p, kp, kind(kp, h, c, nch, last), dup(a1), c, h, cb, hi, nch, last, 0, key, kf) tree8.k(~dup, p, kp, kind(kp, n2, c2, nch, last), dup(a2), c2, n2, cb, hi, nch, last, 0, key, kf)
      parent.k(l, r, rf, key, kf)

def hash8.go.k(~dup: Array<U32> -> Array<U32> & Array<U32>,
  +k: Nat, a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32,
  +rf: U32, +key: CV, +kf: U32) -> CV:
  match k:
    case 0n:
      chunk.k(a, 0, cb, hi, nch, last, rf, key, kf)
    case 1n+p:
      +ku = U32.from_nat(k)
      tree8.k(~dup, k, ku, kind(ku, nch, 0, nch, last), dup(a), 0, nch, cb, hi,
        nch, last, rf, key, kf)

# The CV of a span (as hash.at) in any mode, on the CPU's 8-lane tree.
def hash8.at.k(~dup: Array<U32> -> Array<U32> & Array<U32>,
  a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32, +key: CV, +kf: U32) -> CV:
  hash8.go.k(~dup, depth(nch), a, cb, hi, nch, last, rf, key, kf)

# Hex
# ---

def hex.pick(b: Bool, +d: U32) -> Char:
  match b:
    case True{}:
      Chr{(d + 48 : U32)}
    case False{}:
      Chr{(d + 87 : U32)}

def hex.digit(+d: U32) -> Char:
  hex.pick(U32.is_lt(d, 10), d)

def hex.byte(+x: U32, s: String) -> String:
  SCon{hex.digit(((x >> 4n) .&. 15 : U32)), SCon{hex.digit((x .&. 15 : U32)), s}}

def hex.word(+x: U32, s: String) -> String:
  hex.byte(x, hex.byte((x >> 8n : U32), hex.byte((x >> 16n : U32),
    hex.byte((x >> 24n : U32), s))))

# The 64 hex digits of a CV, in front of s.
def hex.onto(cv: CV, s: String) -> String:
  match cv:
    case CV{h0, h1, h2, h3, h4, h5, h6, h7}:
      hex.word(h0, hex.word(h1, hex.word(h2, hex.word(h3, hex.word(h4,
        hex.word(h5, hex.word(h6, hex.word(h7, s))))))))

def hex(cv: CV) -> String:
  hex.onto(cv, SNil{})
