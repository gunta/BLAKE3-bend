# BLAKE3 in Bend2
# ===============
#
# GENERATED by tools/gen_blake3.py: edit the generator, not this file.
#
# The input is an Array<U32> of little-endian words, zero-padded past `len`
# up to the end of its last 64-byte block. The hash is the BLAKE3 tree: every
# 1024-byte chunk is chained through its 16 blocks, then chunk CVs merge
# pairwise up a left-full binary tree. The tree's two halves are a parallel
# let, so `H.hash` (hash.bend) runs on every CPU core and `H.hash1!` on the
# GPU.

import Base

# Records of scalars ride in registers: a CV or a block never touches the heap.
type CV is Data:
  CV{h0: U32, h1: U32, h2: U32, h3: U32, h4: U32, h5: U32, h6: U32, h7: U32}

type M16 is Data:
  M16{m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32, m11: U32, m12: U32, m13: U32, m14: U32, m15: U32}

type S16 is Data:
  S16{v0: U32, v1: U32, v2: U32, v3: U32, v4: U32, v5: U32, v6: U32, v7: U32, v8: U32, v9: U32, v10: U32, v11: U32, v12: U32, v13: U32, v14: U32, v15: U32}

# Flags
def CHUNK_START() -> U32:
  1

def CHUNK_END() -> U32:
  2

def PARENT() -> U32:
  4

def ROOT() -> U32:
  8

def IV() -> CV:
  CV{1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225}

def rotr16(+x: U32) -> U32:
  ((x >> 16n) .|. (x << 16n) : U32)

def rotr12(+x: U32) -> U32:
  ((x >> 12n) .|. (x << 20n) : U32)

def rotr8(+x: U32) -> U32:
  ((x >> 8n) .|. (x << 24n) : U32)

def rotr7(+x: U32) -> U32:
  ((x >> 7n) .|. (x << 25n) : U32)

def ld.s15(r: Array<U32> & U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32, m11: U32, m12: U32, m13: U32, m14: U32) -> Array<U32> & M16:
  (a, m15) = r
  (a, M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15})

def ld.s14(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32, m11: U32, m12: U32, m13: U32) -> Array<U32> & M16:
  (a, m14) = r
  ld.s15(a[(w + 15 : U32)], m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14)

def ld.s13(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32, m11: U32, m12: U32) -> Array<U32> & M16:
  (a, m13) = r
  ld.s14(a[(w + 14 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13)

def ld.s12(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32, m11: U32) -> Array<U32> & M16:
  (a, m12) = r
  ld.s13(a[(w + 13 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12)

def ld.s11(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32, m10: U32) -> Array<U32> & M16:
  (a, m11) = r
  ld.s12(a[(w + 12 : U32)], w, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11)

def ld.s10(r: Array<U32> & U32, +w: U32, m0: U32, m1: U32, m2: U32, m3: U32, m4: U32, m5: U32, m6: U32, m7: U32, m8: U32, m9: U32) -> Array<U32> & M16:
