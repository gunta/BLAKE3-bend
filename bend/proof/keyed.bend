# A lane of the key xor-ed into ZERO8() is the key.
law zk:
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  {B3.CV{U32.xor(0, k0), U32.xor(0, k1), U32.xor(0, k2), U32.xor(0, k3), U32.xor(0, k4), U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}

def zk(k0, k1, k2, k3, k4, k5, k6, k7):
  %Equal.sym(U32, U32.xor(0, k0), k0, A.u.xor_zero_l(k0)) :
    {B3.CV{_, U32.xor(0, k1), U32.xor(0, k2), U32.xor(0, k3), U32.xor(0, k4), U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k1), k1, A.u.xor_zero_l(k1)) :
    {B3.CV{k0, _, U32.xor(0, k2), U32.xor(0, k3), U32.xor(0, k4), U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k2), k2, A.u.xor_zero_l(k2)) :
    {B3.CV{k0, k1, _, U32.xor(0, k3), U32.xor(0, k4), U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k3), k3, A.u.xor_zero_l(k3)) :
    {B3.CV{k0, k1, k2, _, U32.xor(0, k4), U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k4), k4, A.u.xor_zero_l(k4)) :
    {B3.CV{k0, k1, k2, k3, _, U32.xor(0, k5), U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k5), k5, A.u.xor_zero_l(k5)) :
    {B3.CV{k0, k1, k2, k3, k4, _, U32.xor(0, k6), U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k6), k6, A.u.xor_zero_l(k6)) :
    {B3.CV{k0, k1, k2, k3, k4, k5, _, U32.xor(0, k7)} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  %Equal.sym(U32, U32.xor(0, k7), k7, A.u.xor_zero_l(k7)) :
    {B3.CV{k0, k1, k2, k3, k4, k5, k6, _} == B3.CV{k0, k1, k2, k3, k4, k5, k6, k7} : B3.CV}
  {==}

# The 8-lane path
# ---------------

law compress8.lane:
  for +l: Laws.Lane
  for +cv: B3.CV8
  for +m: B3.B128
  for +ctr: U32
  for +step: U32
  for +blen: U32
  for +flags: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {Laws.cv.at(l, B3.compress8.k(cv, m, ctr, step, hi, blen, (flags .|. kf : U32))) ==
    B3.compress(Laws.cv.at(l, cv), Laws.m.at(l, m), (ctr + (step * Laws.Lane.u32(l) : U32) : U32),
      hi, blen, (flags .|. kf : U32)) : B3.CV}

