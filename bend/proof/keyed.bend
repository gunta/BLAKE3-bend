def leaf32.split(a, c, t, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  leaf32.split.h(a, c, t, rf, C.wits(7n, a), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

