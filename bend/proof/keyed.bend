# Lane 0 of the 8-lane loop is the scalar loop of chunk 0.
law loop.l0:
  for +p: Nat
  for -a0: Array<U32>
  for r: Array<U32> & B3.B128
  for +er: {Pair.fst(Array<U32>, B3.B128, r) == a0 : Array<U32>}
  for +m0: B3.M16
  for +m1: B3.M16
  for +m2: B3.M16
  for +m3: B3.M16
  for +m4: B3.M16
  for +m5: B3.M16
  for +m6: B3.M16
  for +m7: B3.M16
  for +em: {Pair.snd(Array<U32>, B3.B128, r) == B3.b128.of(m0, m1, m2, m3, m4, m5, m6, m7) : B3.B128}
  for +w: U32
  for +cv: B3.CV8
  for +ctr: U32
  for +fl: U32
  for C.bun: C.Bun(a0, p)
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  for +d: B3.CV
  {Laws.cv.at(Laws.L0{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(1n+p, r, w, cv, ctr, hi, fl, kf, d))) ==
    B3.chunk.fin(B3.chunk.go.k(p, (a0, m0), w, Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), (ctr + 0 : U32), hi, fl, B3.CHUNK_END(), 64, kf)) : B3.CV}

def loop.l0(p, a0, r, er, m0, m1, m2, m3, m4, m5, m6, m7, em, w, cv, ctr, fl, C.bun, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, d):
  match p:
    case 0n:
      match r:
        case (a, +m):
          _ = C.bun
          %Equal.sym(Array<U32> & B3.B128, B3.ld8(a, (w + 0 : U32)), (a, Pair.snd(Array<U32>, B3.B128, B3.ld8(a, (w + 0 : U32)))), C.ld8.eta(a, (w + 0 : U32))) :
            {Laws.cv.at(Laws.L0{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(0n, _, (w + 0 : U32), B3.compress8.k(B3.mix8(cv, d), m, ctr, 1, hi, 64, ((fl .|. B3.CHUNK_END() : U32) .|. kf : U32)), ctr, hi, 0, kf, B3.CV{0, 0, 0, 0, 0, 0, 0, 0}))) == B3.chunk.fin(B3.chunk.go.k(0n, (a0, m0), w, Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), (ctr + 0 : U32), hi, fl, B3.CHUNK_END(), 64, kf)) : B3.CV}
          %Equal.sym(B3.CV, Laws.cv.at(Laws.L0{}, B3.compress8.k(B3.mix8(cv, d), m, ctr, 1, hi, 64, ((fl .|. B3.CHUNK_END() : U32) .|. kf : U32))), B3.compress(Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), Laws.m.at(Laws.L0{}, m), (ctr + 0 : U32), hi, 64, ((fl .|. B3.CHUNK_END() : U32) .|. kf : U32)), compress8.lane(Laws.L0{}, B3.mix8(cv, d), m, ctr, 1, 64, (fl .|. B3.CHUNK_END() : U32), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)) :
            {_ == B3.chunk.fin(B3.chunk.go.k(0n, (a0, m0), w, Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), (ctr + 0 : U32), hi, fl, B3.CHUNK_END(), 64, kf)) : B3.CV}
          %Equal.sym(B3.B128, m, B3.b128.of(m0, m1, m2, m3, m4, m5, m6, m7), em) :
            {B3.compress(Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), Laws.m.at(Laws.L0{}, _), (ctr + 0 : U32), hi, 64, ((fl .|. B3.CHUNK_END() : U32) .|. kf : U32)) == B3.chunk.fin(B3.chunk.go.k(0n, (a0, m0), w, Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), (ctr + 0 : U32), hi, fl, B3.CHUNK_END(), 64, kf)) : B3.CV}
          %Equal.sym(B3.M16, Laws.m.at(Laws.L0{}, B3.b128.of(m0, m1, m2, m3, m4, m5, m6, m7)), C.m.pick(Laws.L0{}, m0, m1, m2, m3, m4, m5, m6, m7), C.b128.lane(Laws.L0{}, m0, m1, m2, m3, m4, m5, m6, m7)) :
            {B3.compress(Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), _, (ctr + 0 : U32), hi, 64, ((fl .|. B3.CHUNK_END() : U32) .|. kf : U32)) == B3.chunk.fin(B3.chunk.go.k(0n, (a0, m0), w, Laws.cv.at(Laws.L0{}, B3.mix8(cv, d)), (ctr + 0 : U32), hi, fl, B3.CHUNK_END(), 64, kf)) : B3.CV}
          {==}
    case 1n+q:
      match r:
        case (a, +m):
          match C.bun:
            case (lvl, rest):
              match lvl:
                case (x1, w1):
                  match w1:
                    case (+e1, w1b):
                      match w1b:
                        case (x2, w2):
                          match w2:
                            case (+e2, w2b):
                              match w2b:
                                case (x3, w3):
                                  match w3:
                                    case (+e3, w3b):
                                      match w3b:
                                        case (x4, w4):
                                          match w4:
                                            case (+e4, w4b):
                                              match w4b:
                                                case (x5, w5):
                                                  match w5:
                                                    case (+e5, w5b):
                                                      match w5b:
                                                        case (x6, w6):
                                                          match w6:
                                                            case (+e6, w6b):
                                                              match w6b:
                                                                case (x7, w7):
                                                                  match w7:
                                                                    case (+e7, w7b):
                                                                      match w7b:
                                                                        case (x8, w8):
                                                                          match w8:
                                                                            case (+e8, w8b):
                                                                              match w8b:
                                                                                case (x9, w9):
                                                                                  match w9:
                                                                                    case (+e9, w9b):
                                                                                      match w9b:
                                                                                        case (x10, w10):
                                                                                          match w10:
                                                                                            case (+e10, w10b):
                                                                                              match w10b:
                                                                                                case (x11, w11):
                                                                                                  match w11:
                                                                                                    case (+e11, w11b):
                                                                                                      _ = w11b
                                                                                                      +ea = er
                                                                                                      +mm0 = Pair.snd(Array<U32>, B3.M16, B3.ld(x1, (w + 16 : U32)))
                                                                                                      +mm1 = Pair.snd(Array<U32>, B3.M16, B3.ld(x2, ((w + 16 : U32) + 256 : U32)))
                                                                                                      +mm2 = Pair.snd(Array<U32>, B3.M16, B3.ld(x3, ((w + 16 : U32) + 512 : U32)))
