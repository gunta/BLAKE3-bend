                                                                                                  +fr = C.eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(xr, (c << 8n : U32))), xr, a, C.tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (c << 8n : U32))) == arr : Array<U32>}, xf, xr, C.eq.trans(xf, a, xr, exf, Equal.sym(Array<U32>, xr, a, exr)), C.ld8.fst(xf, (c << 8n : U32))), exr)
                                                                                                  +lp = C.tr(arr => {Laws.cv.at(Laws.L6{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))) == B3.chunk.fin(B3.chunk.go.k(15n, (a, mm6), ((c << 8n : U32) + 1536 : U32), Laws.cv.at(Laws.L6{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}, xr, a, exr, loop.l6(15n, a, B3.ld8(xr, (c << 8n : U32)), fr, mm0, mm1, mm2, mm3, mm4, mm5, mm6, mm7, em, (c << 8n : U32), B3.ZERO8(), t, B3.CHUNK_START(), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))
                                                                                                  %Equal.sym(B3.CV, Laws.cv.at(Laws.L6{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(16n, B3.ld8(a, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))), B3.chunk.fin(B3.chunk.go.k(15n, (a, mm6), ((c << 8n : U32) + 1536 : U32), Laws.cv.at(Laws.L6{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)), lp) :
                                                                                                    {_ == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1536 : U32)), ((c << 8n : U32) + 1536 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
                                                                                                  %Equal.sym(B3.CV, Laws.cv.at(Laws.L6{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, zk(k0, k1, k2, k3, k4, k5, k6, k7)) :
                                                                                                    {B3.chunk.fin(B3.chunk.go.k(15n, (a, mm6), ((c << 8n : U32) + 1536 : U32), _, (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1536 : U32)), ((c << 8n : U32) + 1536 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
                                                                                                  %Equal.cong(Array<U32>, B3.M16, arr => Pair.snd(Array<U32>, B3.M16, B3.ld(arr, ((c << 8n : U32) + 1536 : U32))), a, y6, Equal.sym(Array<U32>, y6, a, ey6)) :
                                                                                                    {B3.chunk.fin(B3.chunk.go.k(15n, (a, _), ((c << 8n : U32) + 1536 : U32), Laws.cv.at(Laws.L6{}, B3.key8(B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1536 : U32)), ((c << 8n : U32) + 1536 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 6 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
