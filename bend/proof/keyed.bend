# BLAKE3's tree, for every span
# -----------------------------

# ref.go at a depth k enough for the span's 1 + q chunks is ev of BLAKE3's
# tree over them.
law spec.go:
  for +k: Nat
  for -a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +q: Nat
  for +ed: {Laws.shr(k, q) == 0n : Nat}
  for +ent: {U32.to_nat(nch) == 1n+q : Nat}
  for w: C.Wits(a, 2n)
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {ref.go.k(k, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(k, q, [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def spec.go(k, a, cb, nch, last, rf, ek, q, ed, ent, w, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match k:
    case 0n:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.chunk.k(a, 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.Tip{}, _, 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      {==}
    case 1n+p:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.tree1.k(~Laws.share, 1n+p, B3.big(1n+p, nch), _, 0, nch, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(1n+p, q, [])), _, 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      %Equal.sym(B3.CV, B3.tree1.k(~Laws.share, 1n+p, B3.big(1n+p, nch), (a, a), 0, nch, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), Laws.ev.k(Laws.tree1(1n+p, B3.big(1n+p, nch), U32.to_nat(nch)), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), t1ev(1n+p, a, ek, 0, nch, cb, nch, last, rf, B3.big(1n+p, nch), {==}, C.tr(arr => C.Wits(arr, 3n), z2, a, ez20, C.wits(2n, z2)), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)) :
                        {_ == Laws.ev.k(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      %Equal.sym(Bool, B3.big(1n+p, nch), Laws.big(1n+p, U32.to_nat(nch)), S.big.br(1n+p, nch, ek)) :
                        {Laws.ev.k(Laws.tree1(1n+p, _, U32.to_nat(nch)), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      %Equal.sym(Nat, U32.to_nat(nch), 1n+q, ent) :
                        {Laws.ev.k(Laws.tree1(1n+p, Laws.big(1n+p, _), _), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      %Equal.sym(Laws.Shape, Laws.tree1(1n+p, Laws.big(1n+p, 1n+q), 1n+q), Laws.tree(Laws.digits(1n+p, q, [])), S.t1d(1n+p, q, ed, Laws.big(1n+p, 1n+q), {==})) :
                        {Laws.ev.k(_, (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      {==}

law ref.spec.b:
  for +nch: U32
  for b: Bool
  for +eb: {U32.is_le(nch, 1) == b : Bool}
  for -a: Array<U32>
  for +cb: U32
  for +last: U32
  for +rf: U32
  for w: C.Wits(a, 2n)
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {ref.at.k(a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def ref.spec.b(nch, b, eb, a, cb, last, rf, w, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match b:
    case True{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      %Equal.sym(Bool, U32.is_le(nch, 1), True{}, eb) :
                        {ref.go.k(B3.depth.go(_, nch), a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth.go(_, nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.chunk.k(a, 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.Tip{}, _, 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      {==}
    case False{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      +e1 = S.nle1(U32.to_nat(nch), Equal.trans(Bool, Nat.is_le(U32.to_nat(nch), 1n), U32.is_le(nch, 1), False{}, Equal.sym(Bool, U32.is_le(nch, 1), Nat.is_le(U32.to_nat(nch), 1n), S.u.is_le_nat(nch, 1)), eb))
                      spec.go(B3.depth(nch), a, cb, nch, last, rf, C.depth.le32(nch), Nat.sub(U32.to_nat(nch), 1n), S.depth.bound(nch), Equal.sym(Nat, 1n+Nat.sub(U32.to_nat(nch), 1n), U32.to_nat(nch), A.n.add_sub(1n, U32.to_nat(nch), e1)), C.tr(arr => C.Wits(arr, 2n), z1, a, ez10, C.wits(1n, z1)), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# The scalar tree over a span is BLAKE3's tree over its chunks.
law ref.spec:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {ref.at.k(a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def ref.spec(a, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  ref.spec.b(nch, U32.is_le(nch, 1), {==}, a, cb, last, rf, C.wits(1n, a), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

law cpu.spec:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def cpu.spec.h(-a: Array<U32>, +cb: U32, +nch: U32, +last: U32, +rf: U32, w: C.Wits(a, 2n), +hi: U32, +k0: U32, +k1: U32, +k2: U32, +k3: U32, +k4: U32, +k5: U32, +k6: U32, +k7: U32, +kf: U32) -> {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}:
  match w:
    case (z1, w1):
      match w1:
        case (+ez10, w1b):
          match w1b:
            case (z2, w2):
              match w2:
                case (+ez20, w2b):
                  _ = w2b
                  Equal.trans(B3.CV, B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), ref.at.k(a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf),
                    C.tr(arr => {B3.hash8.at.k(~Laws.share, arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == ref.at.k(arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}, z1, a, ez10, cpu.at(z1, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)),
                    C.tr(arr => {ref.at.k(arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(arr), 0, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}, z2, a, ez20, ref.spec(z2, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)))

def cpu.spec(a, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  cpu.spec.h(a, cb, nch, last, rf, C.wits(1n, a), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# The keyed tree is BLAKE3's keyed tree: ev.k of tree(digits) over the
# span's chunks, each leaf a keyed chunk and each node a keyed parent.
law keyed.spec:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +key: B3.CV
  for +kf: U32
  {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, key, kf) ==
    Laws.ev.k(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf, key, kf) : B3.CV}

def keyed.spec(a, cb, hi, nch, last, rf, key, kf):
  match key:
    case B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}:
      cpu.spec(a, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)
