# The 8-lane chunk loop hands its array back.
law c8.eta:
  for +n: Nat
  for -a0: Array<U32>
  for r: Array<U32> & B3.B128
  for +er: {Pair.fst(Array<U32>, B3.B128, r) == a0 : Array<U32>}
  for +w: U32
  for +cv: B3.CV8
  for +ctr: U32
  for +fl: U32
  for C.bun: C.Bun1(a0, n)
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  for +d: B3.CV
  {B3.c8.go.k(n, r, w, cv, ctr, hi, fl, kf, d) == (a0, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(n, r, w, cv, ctr, hi, fl, kf, d))) : Array<U32> & B3.CV8}

def c8.eta(n, a0, r, er, w, cv, ctr, fl, C.bun, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, d):
  match n:
    case 0n:
      match r:
        case (a, +m):
          _ = C.bun
          %er : {(a, cv) == (_, cv) : Array<U32> & B3.CV8}
          {==}
    case 1n+q:
      match r:
        case (a, +m):
          match C.bun:
            case (lvl, rest):
              match lvl:
                case (x1, l1):
                  match l1:
                    case (+e1, l1b):
                      _ = l1b
                      +f = C.eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(a, (w + B3.step(q) : U32))), a, a0, C.tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (w + B3.step(q) : U32))) == arr : Array<U32>}, x1, a,
                        C.eq.trans(x1, a0, a, e1, Equal.sym(Array<U32>, a, a0, er)), C.ld8.fst(x1, (w + B3.step(q) : U32))), er)
                      c8.eta(q, a0, B3.ld8(a, (w + B3.step(q) : U32)), f, (w + B3.step(q) : U32), B3.compress8.k(B3.mix8(cv, d), m, ctr, 1, hi, 64, ((fl .|. B3.endf(q) : U32) .|. kf : U32)), ctr, 0, rest, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, B3.CV{0, 0, 0, 0, 0, 0, 0, 0})

def group.eta.h2(-a: Array<U32>, +c: U32, +t: U32, -s: Array<U32>, +es: {s == a : Array<U32>}, r: C.Wits(s, 2n), bb: C.Bun1(a, 16n), +hi: U32, +k0: U32, +k1: U32, +k2: U32, +k3: U32, +k4: U32, +k5: U32, +k6: U32, +k7: U32, +kf: U32) -> {B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) : Array<U32> & B3.CV8}:
  match r:
    case (x1, r1):
      match r1:
        case (+ex1o, r1b):
          match r1b:
            case (x2, r2):
              match r2:
                case (+ex2o, r2b):
                  _ = r2b
                  +ex1 = C.eq.trans(x1, s, a, ex1o, es)
                  +ex2 = C.eq.trans(x2, s, a, ex2o, es)
                  +f = C.eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(x1, (c << 8n : U32))), x1, a, C.tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (c << 8n : U32))) == arr : Array<U32>}, x2, x1, C.eq.trans(x2, a, x1, ex2, Equal.sym(Array<U32>, x1, a, ex1)), C.ld8.fst(x2, (c << 8n : U32))), ex1)
                  C.tr(arr => {B3.c8.go.k(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}) == (a, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))) : Array<U32> & B3.CV8}, x1, a, ex1,
                    c8.eta(16n, a, B3.ld8(x1, (c << 8n : U32)), f, (c << 8n : U32), B3.ZERO8(), t, B3.CHUNK_START(), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))

def group.eta.h1(-a: Array<U32>, +c: U32, +t: U32, r: C.BunS1(a, 16n), +hi: U32, +k0: U32, +k1: U32, +k2: U32, +k3: U32, +k4: U32, +k5: U32, +k6: U32, +k7: U32, +kf: U32) -> {B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) : Array<U32> & B3.CV8}:
  match r:
    case (s, r2):
      match r2:
        case (+es, bb):
          group.eta.h2(a, c, t, s, es, C.wits(1n, s), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# A group hands its array back.
law group.eta:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) : Array<U32> & B3.CV8}

def group.eta(a, c, t, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  group.eta.h1(a, c, t, C.bun1(16n, a), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

