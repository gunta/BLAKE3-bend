                                                                                                  +ey2 = C.eq.trans(y2, s, a, ey20, es)
                                                                                                  +ey3 = C.eq.trans(y3, s, a, ey30, es)
                                                                                                  +ey4 = C.eq.trans(y4, s, a, ey40, es)
                                                                                                  +ey5 = C.eq.trans(y5, s, a, ey50, es)
                                                                                                  +ey6 = C.eq.trans(y6, s, a, ey60, es)
                                                                                                  +ey7 = C.eq.trans(y7, s, a, ey70, es)
                                                                                                  +exe = C.eq.trans(xe, s, a, exe0, es)
                                                                                                  +mm0 = Pair.snd(Array<U32>, B3.M16, B3.ld(y0, (c << 8n : U32)))
                                                                                                  +mm1 = Pair.snd(Array<U32>, B3.M16, B3.ld(y1, ((c << 8n : U32) + 256 : U32)))
                                                                                                  +mm2 = Pair.snd(Array<U32>, B3.M16, B3.ld(y2, ((c << 8n : U32) + 512 : U32)))
                                                                                                  +mm3 = Pair.snd(Array<U32>, B3.M16, B3.ld(y3, ((c << 8n : U32) + 768 : U32)))
                                                                                                  +mm4 = Pair.snd(Array<U32>, B3.M16, B3.ld(y4, ((c << 8n : U32) + 1024 : U32)))
                                                                                                  +mm5 = Pair.snd(Array<U32>, B3.M16, B3.ld(y5, ((c << 8n : U32) + 1280 : U32)))
                                                                                                  +mm6 = Pair.snd(Array<U32>, B3.M16, B3.ld(y6, ((c << 8n : U32) + 1536 : U32)))
                                                                                                  +mm7 = Pair.snd(Array<U32>, B3.M16, B3.ld(y7, ((c << 8n : U32) + 1792 : U32)))
                                                                                                  +em = C.ld8.split(xr, (c << 8n : U32), xz, C.eq.trans(xz, a, xr, exz, Equal.sym(Array<U32>, xr, a, exr)), y0, C.eq.trans(y0, a, xr, ey0, Equal.sym(Array<U32>, xr, a, exr)), y1, C.eq.trans(y1, a, xr, ey1, Equal.sym(Array<U32>, xr, a, exr)), y2, C.eq.trans(y2, a, xr, ey2, Equal.sym(Array<U32>, xr, a, exr)), y3, C.eq.trans(y3, a, xr, ey3, Equal.sym(Array<U32>, xr, a, exr)), y4, C.eq.trans(y4, a, xr, ey4, Equal.sym(Array<U32>, xr, a, exr)), y5, C.eq.trans(y5, a, xr, ey5, Equal.sym(Array<U32>, xr, a, exr)), y6, C.eq.trans(y6, a, xr, ey6, Equal.sym(Array<U32>, xr, a, exr)), y7, C.eq.trans(y7, a, xr, ey7, Equal.sym(Array<U32>, xr, a, exr)))
                                                                                                  +fr = C.eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(xr, (c << 8n : U32))), xr, a, C.tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (c << 8n : U32))) == arr : Array<U32>}, xf, xr, C.eq.trans(xf, a, xr, exf, Equal.sym(Array<U32>, xr, a, exr)), C.ld8.fst(xf, (c << 8n : U32))), exr)
                                                                                                  +lp = C.tr(arr => {Laws.cv.at(Laws.L7{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))) == B3.chunk.fin(B3.chunk.go.k(15n, (a, mm7), ((c << 8n : U32) + 1792 : U32), Laws.cv.at(Laws.L7{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}, xr, a, exr, loop.l7(15n, a, B3.ld8(xr, (c << 8n : U32)), fr, mm0, mm1, mm2, mm3, mm4, mm5, mm6, mm7, em, (c << 8n : U32), B3.ZERO8(), t, B3.CHUNK_START(), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))
                                                                                                  %Equal.sym(B3.CV, Laws.cv.at(Laws.L7{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go.k(16n, B3.ld8(a, (c << 8n : U32)), (c << 8n : U32), B3.ZERO8(), t, hi, B3.CHUNK_START(), kf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}))), B3.chunk.fin(B3.chunk.go.k(15n, (a, mm7), ((c << 8n : U32) + 1792 : U32), Laws.cv.at(Laws.L7{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)), lp) :
                                                                                                    {_ == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1792 : U32)), ((c << 8n : U32) + 1792 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
                                                                                                  %Equal.sym(B3.CV, Laws.cv.at(Laws.L7{}, B3.mix8(B3.ZERO8(), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, zk(k0, k1, k2, k3, k4, k5, k6, k7)) :
                                                                                                    {B3.chunk.fin(B3.chunk.go.k(15n, (a, mm7), ((c << 8n : U32) + 1792 : U32), _, (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1792 : U32)), ((c << 8n : U32) + 1792 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
                                                                                                  %Equal.cong(Array<U32>, B3.M16, arr => Pair.snd(Array<U32>, B3.M16, B3.ld(arr, ((c << 8n : U32) + 1792 : U32))), a, y7, Equal.sym(Array<U32>, y7, a, ey7)) :
                                                                                                    {B3.chunk.fin(B3.chunk.go.k(15n, (a, _), ((c << 8n : U32) + 1792 : U32), Laws.cv.at(Laws.L7{}, B3.key8(B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1792 : U32)), ((c << 8n : U32) + 1792 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
