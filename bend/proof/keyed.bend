  match r:
    case (s, r2):
      match r2:
        case (+es, bb):
          gl.l4.h2(a, c, t, s, es, C.wits(11n, s), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# Lane 4 of a group is the scalar chain of its chunk 4.
law gl.l4:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {Laws.cv.at(Laws.L4{}, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 1024 : U32)), ((c << 8n : U32) + 1024 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 4 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}

