# A full 32-chunk node: the CPU's 32-chunk leaf is the scalar tree over its
# chunks, for every array and every span that holds it whole.
law leaf32.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 32n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 32 : U32), nch, last) == True{} : Bool}
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.leaf32.k(x, c, (cb + c : U32), hi, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 5n, True{}, (x, x), c, 32, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def leaf32.eq(x, c, cb, nch, last, rf, inv, ef, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  leaf32.eq.h(x, c, cb, nch, last, rf, inv, ef, C.wits(9n, x), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# At depth 0 both trees hash the one chunk, whatever kind tree8 was handed.
law t8.zero:
  for +ku: U32
  for d: B3.Node
  for -a1: Array<U32>
  for -a2: Array<U32>
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.tree8.k(~Laws.share, 0n, ku, d, (a1, a2), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 0n, False{}, (a1, a2), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def t8.zero(ku, d, a1, a2, c, n, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match d:
    case B3.Down{}:
      {==}
    case B3.Split{}:
      {==}
    case B3.Leaf8{}:
      {==}
    case B3.Leaf32{}:
      {==}

# The CPU tree is the scalar tree, node for node: tree8's kind (computed
# from ku, a U32 copy of the depth) takes tree1's split exactly where tree1
# does, and its 8- and 32-chunk leaves are the scalar subtrees (leaf8.eq,
# leaf32.eq). Each node holds a clone of x and two live copies of it (pk).
law cpu.tree:
  for +k: Nat
  for -x: Array<U32>
  for pk: C.CloneW(x)
  for +ku: U32
  for +eku: {ku == U32.from_nat(k) : U32}
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for b: Bool
  for +eb: {B3.big(k, n) == b : Bool}
  for f: Bool
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == f : Bool}
  for e5: Bool
  for +ee5: {U32.is_eq(ku, 5) == e5 : Bool}
  for e3: Bool
  for +ee3: {U32.is_eq(ku, 3) == e3 : Bool}
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.tree8.k(~Laws.share, k, ku, B3.kind(ku, n, c, nch, last), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) ==
    B3.tree1.k(~Laws.share, k, B3.big(k, n), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def cpu.tree(k, x, pk, ku, eku, ek, c, n, cb, nch, last, rf, inv, b, eb, f, ef, e5, ee5, e3, ee3, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match k:
    case 0n:
      match pk:
        case (x1, pk2):
          match pk2:
            case (x2, pk3):
              match pk3:
                case (+e1, pk4):
                  match pk4:
                    case (+e2, ecl):
                      _ = x1
                      _ = x2
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), ecl) :
                        {B3.tree8.k(~Laws.share, 0n, ku, B3.kind(ku, n, c, nch, last), _, c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 0n, B3.big(0n, n), _, c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                      t8.zero(ku, B3.kind(ku, n, c, nch, last), x, x, c, n, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)
    case 1n+p:
      match pk:
        case (x1, pk2):
          match pk2:
            case (x2, pk3):
              match pk3:
                case (+e1, pk4):
                  match pk4:
                    case (+e2, ecl):
                      match b f e5 e3:
                        case False{} _ _ _:
                          +ekp = A.le.succ_le(p, 32n, ek)
                          +kd = Equal.trans(U32, (ku - 1 : U32), (U32.from_nat(1n+p) - 1 : U32), U32.from_nat(p), Equal.cong(U32, U32, z => (z - 1 : U32), ku, U32.from_nat(1n+p), eku), A.u.down(p))
                          +tp = Equal.trans(Nat, U32.to_nat((ku - 1 : U32)), U32.to_nat(U32.from_nat(p)), p, Equal.cong(U32, Nat, z => U32.to_nat(z), (ku - 1 : U32), U32.from_nat(p), kd), A.u.tn_fn(p, 32, ekp))
                          %Equal.sym(Nat, U32.to_nat((ku - 1 : U32)), p, tp) :
                            {B3.tree8.k(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, U32.is_gt(n, U32.shln(1, _))), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 1n+p, B3.big(1n+p, n), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                          %Equal.sym(Bool, B3.big(1n+p, n), False{}, eb) :
                            {B3.tree8.k(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, _), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 1n+p, _, Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                          cpu.tree(p, x, (x1, (x2, (e1, (e2, ecl)))), (ku - 1 : U32), kd, ekp, c, n, cb, nch, last, rf, inv, B3.big(p, n), {==}, (U32.is_eq(n, U32.shln(1, U32.to_nat((ku - 1 : U32)))) && B3.full((c + n : U32), nch, last)), {==}, U32.is_eq((ku - 1 : U32), 5), {==}, U32.is_eq((ku - 1 : U32), 3), {==}, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)
                        case True{} False{} _ _:
                          +ekp = A.le.succ_le(p, 32n, ek)
                          +kd = Equal.trans(U32, (ku - 1 : U32), (U32.from_nat(1n+p) - 1 : U32), U32.from_nat(p), Equal.cong(U32, U32, z => (z - 1 : U32), ku, U32.from_nat(1n+p), eku), A.u.down(p))
                          +tp = Equal.trans(Nat, U32.to_nat((ku - 1 : U32)), U32.to_nat(U32.from_nat(p)), p, Equal.cong(U32, Nat, z => U32.to_nat(z), (ku - 1 : U32), U32.from_nat(p), kd), A.u.tn_fn(p, 32, ekp))
                          %Equal.sym(Nat, U32.to_nat((ku - 1 : U32)), p, tp) :
                            {B3.tree8.k(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, U32.is_gt(n, U32.shln(1, _))), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 1n+p, B3.big(1n+p, n), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                          %Equal.sym(Bool, B3.big(1n+p, n), True{}, eb) :
                            {B3.tree8.k(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, _), Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 1n+p, _, Array.clone(U32, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                          %Equal.sym(Bool, (U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)), False{}, ef) :
