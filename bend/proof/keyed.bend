                                                                                                  +mm0 = Pair.snd(Array<U32>, B3.M16, B3.ld(y0, (c << 8n : U32)))
                                                                                                  +mm1 = Pair.snd(Array<U32>, B3.M16, B3.ld(y1, ((c << 8n : U32) + 256 : U32)))
                                                                                                  +mm2 = Pair.snd(Array<U32>, B3.M16, B3.ld(y2, ((c << 8n : U32) + 512 : U32)))
                                                                                                  +mm3 = Pair.snd(Array<U32>, B3.M16, B3.ld(y3, ((c << 8n : U32) + 768 : U32)))
                                                                                                  +mm4 = Pair.snd(Array<U32>, B3.M16, B3.ld(y4, ((c << 8n : U32) + 1024 : U32)))
                                                                                                  +mm5 = Pair.snd(Array<U32>, B3.M16, B3.ld(y5, ((c << 8n : U32) + 1280 : U32)))
