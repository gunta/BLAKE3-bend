law cpu.go:
  for +k: Nat
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.hash8.go.k(~Laws.share, k, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == ref.go.k(k, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def cpu.go(k, a, cb, nch, last, rf, ek, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match k:
    case 0n:
      {==}
    case 1n+p:
      +ku = U32.from_nat(1n+p)
      cpu.tree(1n+p, a, C.clone.w(a), ku, {==}, ek, 0, nch, cb, nch, last, rf, A.n.le_refl(U32.to_nat(nch)),
        B3.big(1n+p, nch), {==}, (U32.is_eq(nch, U32.shln(1, U32.to_nat(ku))) && B3.full((0 + nch : U32), nch, last)), {==}, U32.is_eq(ku, 5), {==}, U32.is_eq(ku, 3), {==}, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# The CPU's 8-lane tree is the scalar tree, for every array and every span.
law cpu.at:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == ref.go.k(B3.depth(nch), a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def cpu.at(a, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  cpu.go(B3.depth(nch), a, cb, nch, last, rf, C.depth.le32(nch), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# ref.go.k at the span's depth is blake3.bend's own hash.at.k.
law ref.hash.k:
  for +k: Nat
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +key: B3.CV
  for +kf: U32
  {ref.go.k(k, a, cb, hi, nch, last, rf, key, kf) == B3.tree1.k(~Laws.share, k, B3.big(k, nch), Laws.share(a), 0, nch, cb, hi, nch, last, rf, key, kf) : B3.CV}

def ref.hash.k(k, a, cb, hi, nch, last, rf, key, kf):
  match k:
    case 0n:
      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.clone.dup(a)) :
        {B3.chunk.k(a, 0, cb, hi, nch, last, rf, key, kf) == B3.tree1.k(~Laws.share, 0n, B3.big(0n, nch), _, 0, nch, cb, hi, nch, last, rf, key, kf) : B3.CV}
      {==}
    case 1n+p:
      _ = a
      {==}

def keyed.at.h(-a: Array<U32>, +cb: U32, +hi: U32, +nch: U32, +last: U32, +rf: U32, +key: B3.CV, +kf: U32, w: C.Wits(a, 2n)) -> {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, key, kf) == B3.hash.at.k(~Laws.share, a, cb, hi, nch, last, rf, key, kf) : B3.CV}:
  match key:
    case B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      Equal.trans(B3.CV, B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), ref.go.k(B3.depth(nch), a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf), B3.hash.at.k(~Laws.share, a, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf),
                        C.tr(arr => {B3.hash8.at.k(~Laws.share, arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == ref.go.k(B3.depth(nch), arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}, z1, a, ez10, cpu.at(z1, cb, nch, last, rf, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)),
                        C.tr(arr => {ref.go.k(B3.depth(nch), arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.hash.at.k(~Laws.share, arr, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}, z2, a, ez20, ref.hash.k(B3.depth(nch), z2, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf)))

# The CPU's keyed tree is the scalar keyed tree, for every array, span, key
# and mode flag.
law keyed.at:
  for a: Array<U32>
  for +cb: U32
  for +hi: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +key: B3.CV
  for +kf: U32
  {B3.hash8.at.k(~Laws.share, a, cb, hi, nch, last, rf, key, kf) == B3.hash.at.k(~Laws.share, a, cb, hi, nch, last, rf, key, kf) : B3.CV}

def keyed.at(a, cb, hi, nch, last, rf, key, kf):
  keyed.at.h(a, cb, hi, nch, last, rf, key, kf, C.wits(1n, a))

# tree1 over n chunks from c is ev of the model's tree1 over U32.to_nat(n),
# node for node: the same split, at the same chunk.
law t1ev:
  for +k: Nat
  for -x: Array<U32>
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for b: Bool
  for +eb: {B3.big(k, n) == b : Bool}
  for w: C.Wits(x, 3n)
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.tree1.k(~Laws.share, k, b, (x, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree1(k, b, U32.to_nat(n)), (x, x), c, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

def t1ev(k, x, ek, c, n, cb, nch, last, rf, b, eb, w, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  match k b:
    case 0n _:
      _ = w
      {==}
    case 1n+p False{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              _ = w3b
                              _ = z2
                              _ = z3
                              +ekp = A.le.succ_le(p, 32n, ek)
                              %S.big.br(p, n, ekp) :
                                {B3.tree1.k(~Laws.share, p, B3.big(p, n), (x, x), c, n, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == Laws.ev.k(Laws.tree1(p, _, U32.to_nat(n)), (x, x), c, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}
                              t1ev(p, x, ekp, c, n, cb, nch, last, rf, B3.big(p, n), {==}, C.tr(arr => C.Wits(arr, 3n), z1, x, ez10, C.wits(2n, z1)), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)
    case 1n+p True{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              _ = w3b
                              +ekp = A.le.succ_le(p, 32n, ek)
                              +th = Equal.trans(Nat, U32.to_nat(U32.shln(1, p)), A.pow2(p), Laws.pow2(p), A.sh.nat(p, ek), S.pow2.br(p))
                              +lt = A.n.gt_lt(U32.to_nat(n), U32.to_nat(U32.shln(1, p)), Equal.trans(Bool, Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), U32.is_gt(n, U32.shln(1, p)), True{}, Equal.sym(Bool, U32.is_gt(n, U32.shln(1, p)), Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), A.u.is_gt_nat(n, U32.shln(1, p))), eb))
                              +tn2 = Equal.trans(Nat, U32.to_nat((n - U32.shln(1, p) : U32)), Nat.sub(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), Nat.sub(U32.to_nat(n), Laws.pow2(p)), A.u.tn_sub(n, U32.shln(1, p), A.n.lt_to_le(U32.to_nat(U32.shln(1, p)), U32.to_nat(n), lt)), Equal.cong(Nat, Nat, z => Nat.sub(U32.to_nat(n), z), U32.to_nat(U32.shln(1, p)), Laws.pow2(p), th))
                              +bh = Equal.trans(Bool, B3.big(p, U32.shln(1, p)), Laws.big(p, U32.to_nat(U32.shln(1, p))), Laws.big(p, Laws.pow2(p)), S.big.br(p, U32.shln(1, p), ekp), Equal.cong(Nat, Bool, z => Laws.big(p, z), U32.to_nat(U32.shln(1, p)), Laws.pow2(p), th))
                              +bn2 = Equal.trans(Bool, B3.big(p, (n - U32.shln(1, p) : U32)), Laws.big(p, U32.to_nat((n - U32.shln(1, p) : U32))), Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), S.big.br(p, (n - U32.shln(1, p) : U32), ekp), Equal.cong(Nat, Bool, z => Laws.big(p, z), U32.to_nat((n - U32.shln(1, p) : U32)), Nat.sub(U32.to_nat(n), Laws.pow2(p)), tn2))
