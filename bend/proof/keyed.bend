def gl.l2.h1(-a: Array<U32>, +c: U32, +t: U32, r: C.BunS(a, 15n), +hi: U32, +k0: U32, +k1: U32, +k2: U32, +k3: U32, +k4: U32, +k5: U32, +k6: U32, +k7: U32, +kf: U32) -> {Laws.cv.at(Laws.L2{}, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 512 : U32)), ((c << 8n : U32) + 512 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 2 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}:
  match r:
    case (s, r2):
      match r2:
        case (+es, bb):
          gl.l2.h2(a, c, t, s, es, C.wits(11n, s), bb, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

# Lane 2 of a group is the scalar chain of its chunk 2.
law gl.l2:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {Laws.cv.at(Laws.L2{}, Pair.snd(Array<U32>, B3.CV8, B3.group.k(a, c, t, hi, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf))) == B3.chunk.fin(B3.chunk.go.k(15n, B3.ld(a, ((c << 8n : U32) + 512 : U32)), ((c << 8n : U32) + 512 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 2 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}

def gl.l2(a, c, t, hi, k0, k1, k2, k3, k4, k5, k6, k7, kf):
  gl.l2.h1(a, c, t, C.bun(15n, a), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf)

