# 8 full chunks on the 8-lane path are their scalar chains under fold8's
# parents, for every array.
law leaf8.lanes:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
