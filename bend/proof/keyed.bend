  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.chunk.k(a, c, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == chunk.b(a, c, cb, last, rf, U32.is_eq((c + 1 : U32), nch), hi, k0, k1, k2, k3, k4, k5, k6, k7, kf) : B3.CV}

