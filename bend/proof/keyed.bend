# A full 8-chunk node: the CPU's 8-lane leaf is the scalar tree over its
# chunks, for every array and every span that holds it whole.
law leaf8.eq:
  for -x: Array<U32>
  for x1: Array<U32>
  for +e1: {x1 == x : Array<U32>}
  for x2: Array<U32>
  for +e2: {x2 == x : Array<U32>}
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 8n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 8 : U32), nch, last) == True{} : Bool}
  for +hi: U32
  for +k0: U32
  for +k1: U32
  for +k2: U32
  for +k3: U32
  for +k4: U32
  for +k5: U32
  for +k6: U32
  for +k7: U32
  for +kf: U32
  {B3.leaf8.k(x, c, (cb + c : U32), hi, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) == B3.tree1.k(~Laws.share, 3n, True{}, (x, x), c, 8, cb, hi, nch, last, rf, B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, kf) : B3.CV}

