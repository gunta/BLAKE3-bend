# 32 full chunks on the 8-lane path: four groups' 8-chunk leaves under two
# levels of parents.
law leaf32.split:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  for +hi: U32
  for +k0: U32
  for +k1: U32
