                                                                                                    {B3.chunk.fin(B3.chunk.go.k(15n, (a, Pair.snd(Array<U32>, B3.M16, B3.ld(a, ((c << 8n : U32) + 1792 : U32)))), ((c << 8n : U32) + 1792 : U32), Laws.cv.at(Laws.L7{}, B3.key8(B3.CV{k0, k1, k2, k3, k4, k5, k6, k7})), (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) == B3.chunk.fin(B3.chunk.go.k(15n, _, ((c << 8n : U32) + 1792 : U32), B3.CV{k0, k1, k2, k3, k4, k5, k6, k7}, (t + 7 : U32), hi, B3.CHUNK_START(), B3.CHUNK_END(), 64, kf)) : B3.CV}
