                  match r2b:
                    case (xz, r3):
                      match r3:
                        case (+exz0, r3b):
                          match r3b:
                            case (y0, r4):
                              match r4:
                                case (+ey00, r4b):
                                  match r4b:
                                    case (y1, r5):
                                      match r5:
                                        case (+ey10, r5b):
                                          match r5b:
                                            case (y2, r6):
                                              match r6:
                                                case (+ey20, r6b):
                                                  match r6b:
                                                    case (y3, r7):
                                                      match r7:
                                                        case (+ey30, r7b):
                                                          match r7b:
                                                            case (y4, r8):
                                                              match r8:
                                                                case (+ey40, r8b):
                                                                  match r8b:
                                                                    case (y5, r9):
                                                                      match r9:
                                                                        case (+ey50, r9b):
                                                                          match r9b:
                                                                            case (y6, r10):
                                                                              match r10:
                                                                                case (+ey60, r10b):
