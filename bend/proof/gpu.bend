law gpu.go:
  for +k: Nat
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  {B3.hash1.go(~Laws.share, k, a, cb, nch, last, rf) == Laws.ref.go(k, a, cb, nch, last, rf) : B3.CV}

def gpu.go(k, a, cb, nch, last, rf, ek):
  match k:
    case 0n:
      {==}
    case 1n+p:
      +ku = U32.from_nat(1n+p)
      +lv = B3.level(ku)
      gpu.tree(1n+p, a, C.clone.w(a), ku, {==}, ek, 0, nch, cb, nch, last, lv, rf, A.n.le_refl(U32.to_nat(nch)),
        B3.big(1n+p, nch), {==}, (U32.is_eq(nch, U32.shln(1, U32.to_nat(ku))) && B3.full((0 + nch : U32), nch, last)), {==}, (U32.is_eq(lv, 6) && U32.is_gt(ku, 6)), {==}, U32.is_le(ku, lv), {==},
        U32.is_eq(ku, 6), {==}, U32.is_eq(ku, 4), {==}, U32.is_eq(ku, 2), {==})

# The GPU's tree (flat leaves, strided lanes) is the scalar tree, for every
# array and every span.
law gpu.at:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.hash1.at(~Laws.share, a, cb, nch, last, rf) == Laws.ref.go(B3.depth(nch), a, cb, nch, last, rf) : B3.CV}

def gpu.at(a, cb, nch, last, rf):
  gpu.go(B3.depth(nch), a, cb, nch, last, rf, C.depth.le32(nch))
