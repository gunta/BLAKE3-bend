                                              {==}

law gquad.eq:
  for +q: Nat
  for x: Array<U32>
  for +ku: U32
  for +eku: {ku == U32.from_nat(6n+q) : U32}
  for +ek: {Nat.is_le(6n+q, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +lv: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for +eb: {B3.big(6n+q, n) == True{} : Bool}
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == True{} : Bool}
  {B3.treeg(~Laws.share, 6n+q, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 6n+q, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}

def gquad.eq(q, x, ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, eb, ef):
  gquad.b(q, Nat.is_le(q, 25n), {==}, x, C.wits(4n, x), ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, eb, ef)

# The GQuad node at depth 1 + p, from treeg's own decision: p >= 5.
law gquad.p:
  for +p: Nat
  for x: Array<U32>
  for +ku: U32
  for +eku: {ku == U32.from_nat(1n+p) : U32}
  for +ek: {Nat.is_le(1n+p, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +lv: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for +eb: {B3.big(1n+p, n) == True{} : Bool}
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == True{} : Bool}
  for +g6: {U32.is_gt(U32.from_nat(1n+p), 6) == True{} : Bool}
  {B3.treeg(~Laws.share, 1n+p, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 1n+p, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}

def gquad.p(p, x, ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, eb, ef, g6):
  match p:
    case 0n:
      _ = x
      Empty.absurd({B3.treeg(~Laws.share, 1n, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 1n, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}, A.absurd.ft(g6))
    case 1n+p1:
      match p1:
        case 0n:
          _ = x
          Empty.absurd({B3.treeg(~Laws.share, 2n, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 2n, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}, A.absurd.ft(g6))
        case 1n+p2:
          match p2:
            case 0n:
              _ = x
              Empty.absurd({B3.treeg(~Laws.share, 3n, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 3n, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}, A.absurd.ft(g6))
            case 1n+p3:
              match p3:
                case 0n:
                  _ = x
                  Empty.absurd({B3.treeg(~Laws.share, 4n, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 4n, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}, A.absurd.ft(g6))
                case 1n+p4:
                  match p4:
                    case 0n:
                      _ = x
                      Empty.absurd({B3.treeg(~Laws.share, 5n, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 5n, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}, A.absurd.ft(g6))
                    case 1n+q:
                      gquad.eq(q, x, ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, eb, ef)

# The GPU tree
# ------------

# At depth 0 both trees hash the one chunk, whatever kind treeg was handed.
law g.zero:
  for +ku: U32
  for d: B3.Node1
  for -a1: Array<U32>
  for -a2: Array<U32>
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +lv: U32
  for +rf: U32
  {B3.treeg(~Laws.share, 0n, ku, d, (a1, a2), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 0n, False{}, (a1, a2), c, n, cb, nch, last, rf) : B3.CV}

def g.zero(ku, d, a1, a2, c, n, cb, nch, last, lv, rf):
  match d:
    case B3.GDown{}:
      {==}
    case B3.GSplit{}:
      {==}
    case B3.G4{}:
      {==}
    case B3.G16{}:
      {==}
    case B3.G64{}:
      {==}
    case B3.GQuad{}:
      {==}

# The GPU tree is the scalar tree, node for node: treeg's kind (computed
# from ku, a U32 copy of the depth, and the leaf level lv) takes tree1's
# split exactly where tree1 does, and its flat leaves and strided lanes are
# the scalar subtrees. Each node holds a clone of x and two live copies (pk).
law gpu.tree:
  for +k: Nat
  for -x: Array<U32>
  for pk: C.CloneW(x)
  for +ku: U32
  for +eku: {ku == U32.from_nat(k) : U32}
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +lv: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for b: Bool
  for +eb: {B3.big(k, n) == b : Bool}
  for f: Bool
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == f : Bool}
  for g: Bool
  for +eg: {(U32.is_eq(lv, 6) && U32.is_gt(ku, 6)) == g : Bool}
  for v: Bool
  for +ev: {U32.is_le(ku, lv) == v : Bool}
  for s6: Bool
  for +es6: {U32.is_eq(ku, 6) == s6 : Bool}
  for s4: Bool
  for +es4: {U32.is_eq(ku, 4) == s4 : Bool}
  for s2: Bool
  for +es2: {U32.is_eq(ku, 2) == s2 : Bool}
  {B3.treeg(~Laws.share, k, ku, B3.kind1(ku, n, c, nch, last, lv), Array.clone(U32, x), c, n, cb, nch, last, lv, rf) ==
    B3.tree1(~Laws.share, k, B3.big(k, n), Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}

def gpu.tree(k, x, pk, ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, b, eb, f, ef, g, eg, v, ev, s6, es6, s4, es4, s2, es2):
  match k:
    case 0n:
      match pk:
        case (x1, pk2):
          match pk2:
            case (x2, pk3):
              match pk3:
                case (+e1, pk4):
                  match pk4:
                    case (+e2, ecl):
                      _ = x1
                      _ = x2
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), ecl) :
                        {B3.treeg(~Laws.share, 0n, ku, B3.kind1(ku, n, c, nch, last, lv), _, c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 0n, B3.big(0n, n), _, c, n, cb, nch, last, rf) : B3.CV}
                      g.zero(ku, B3.kind1(ku, n, c, nch, last, lv), x, x, c, n, cb, nch, last, lv, rf)
    case 1n+p:
      match pk:
        case (x1, pk2):
          match pk2:
            case (x2, pk3):
              match pk3:
                case (+e1, pk4):
                  match pk4:
                    case (+e2, ecl):
                      match b f g v s6 s4 s2:
                        case False{} _ _ _ _ _ _:
                          +ekp = A.le.succ_le(p, 32n, ek)
                          +kd = Equal.trans(U32, (ku - 1 : U32), (U32.from_nat(1n+p) - 1 : U32), U32.from_nat(p), Equal.cong(U32, U32, z => (z - 1 : U32), ku, U32.from_nat(1n+p), eku), A.u.down(p))
                          +tp = Equal.trans(Nat, U32.to_nat((ku - 1 : U32)), U32.to_nat(U32.from_nat(p)), p, Equal.cong(U32, Nat, z => U32.to_nat(z), (ku - 1 : U32), U32.from_nat(p), kd), A.u.tn_fn(p, 32, ekp))
                          %Equal.sym(Nat, U32.to_nat((ku - 1 : U32)), p, tp) :
                            {B3.treeg(~Laws.share, 1n+p, ku, B3.kind1.big(ku, n, c, nch, last, lv, U32.is_gt(n, U32.shln(1, _))), Array.clone(U32, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 1n+p, B3.big(1n+p, n), Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}
