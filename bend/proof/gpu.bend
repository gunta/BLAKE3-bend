                          +lt = A.n.gt_lt(U32.to_nat(n), U32.to_nat(U32.shln(1, p)), Equal.trans(Bool, Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), U32.is_gt(n, U32.shln(1, p)), True{}, Equal.sym(Bool, U32.is_gt(n, U32.shln(1, p)), Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), A.u.is_gt_nat(n, U32.shln(1, p))), eb))
                          %Equal.sym(B3.CV, B3.treeg(~Laws.share, p, (ku - 1 : U32), B3.kind1((ku - 1 : U32), U32.shln(1, p), c, nch, last, lv), Array.clone(U32, x), c, U32.shln(1, p), cb, nch, last, lv, 0), B3.tree1(~Laws.share, p, B3.big(p, U32.shln(1, p)), Array.clone(U32, x), c, U32.shln(1, p), cb, nch, last, 0), gpu.tree(p, x, C.tr(arr => C.CloneW(arr), x1, x, e1, C.clone.w(x1)), (ku - 1 : U32), kd, ekp, c, U32.shln(1, p), cb, nch, last, lv, 0, C.inv.left(c, n, U32.shln(1, p), nch, inv, lt), B3.big(p, U32.shln(1, p)), {==}, (U32.is_eq(U32.shln(1, p), U32.shln(1, U32.to_nat((ku - 1 : U32)))) && B3.full((c + U32.shln(1, p) : U32), nch, last)), {==}, (U32.is_eq(lv, 6) && U32.is_gt((ku - 1 : U32), 6)), {==}, U32.is_le((ku - 1 : U32), lv), {==}, U32.is_eq((ku - 1 : U32), 6), {==}, U32.is_eq((ku - 1 : U32), 4), {==}, U32.is_eq((ku - 1 : U32), 2), {==})) :
                            {B3.parent(_, B3.treeg(~Laws.share, p, (ku - 1 : U32), B3.kind1((ku - 1 : U32), (n - U32.shln(1, p) : U32), (c + U32.shln(1, p) : U32), nch, last, lv), Array.clone(U32, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, lv, 0), rf) == B3.parent(B3.tree1(~Laws.share, p, B3.big(p, U32.shln(1, p)), Array.clone(U32, x), c, U32.shln(1, p), cb, nch, last, 0), B3.tree1(~Laws.share, p, B3.big(p, (n - U32.shln(1, p) : U32)), Array.clone(U32, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, 0), rf) : B3.CV}
                          %Equal.sym(B3.CV, B3.treeg(~Laws.share, p, (ku - 1 : U32), B3.kind1((ku - 1 : U32), (n - U32.shln(1, p) : U32), (c + U32.shln(1, p) : U32), nch, last, lv), Array.clone(U32, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, lv, 0), B3.tree1(~Laws.share, p, B3.big(p, (n - U32.shln(1, p) : U32)), Array.clone(U32, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, 0), gpu.tree(p, x, C.tr(arr => C.CloneW(arr), x2, x, e2, C.clone.w(x2)), (ku - 1 : U32), kd, ekp, (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, lv, 0, C.inv.split(c, n, U32.shln(1, p), nch, inv, lt), B3.big(p, (n - U32.shln(1, p) : U32)), {==}, (U32.is_eq((n - U32.shln(1, p) : U32), U32.shln(1, U32.to_nat((ku - 1 : U32)))) && B3.full(((c + U32.shln(1, p) : U32) + (n - U32.shln(1, p) : U32) : U32), nch, last)), {==}, (U32.is_eq(lv, 6) && U32.is_gt((ku - 1 : U32), 6)), {==}, U32.is_le((ku - 1 : U32), lv), {==}, U32.is_eq((ku - 1 : U32), 6), {==}, U32.is_eq((ku - 1 : U32), 4), {==}, U32.is_eq((ku - 1 : U32), 2), {==})) :
