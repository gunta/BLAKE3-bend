# g4: four gchs, 1 chunk apart, under three parents.
law g4.val:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  {Pair.snd(Array<U32>, B3.CV, B3.g4(a, c, t, rf)) == B3.parent(B3.parent(Pair.snd(Array<U32>, B3.CV, B3.gch(a, c, t, 0)), Pair.snd(Array<U32>, B3.CV, B3.gch(a, (c + 1 : U32), (t + 1 : U32), 0)), 0), B3.parent(Pair.snd(Array<U32>, B3.CV, B3.gch(a, (c + 2 : U32), (t + 2 : U32), 0)), Pair.snd(Array<U32>, B3.CV, B3.gch(a, (c + 3 : U32), (t + 3 : U32), 0)), 0), rf) : B3.CV}

def g4.val(a, c, t, rf):
  g4.val.h(a, c, t, rf, C.wits(3n, a))

