# A GPU 64-chunk leaf is tree1 over its chunks, where the span holds it whole.
law g64.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 64n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 64 : U32), nch, last) == True{} : Bool}
  {B3.g.fin(B3.g64(x, c, (cb + c : U32), rf)) == B3.tree1(~Laws.share, 6n, True{}, (x, x), c, 64, cb, nch, last, rf) : B3.CV}

def g64.eq(x, c, cb, nch, last, rf, inv, ef):
  g64.eq.h(x, c, cb, nch, last, rf, inv, ef, C.wits(10n, x))

# Ranges of a full span
# ---------------------
#
# A range that ends at or before the end en of a full range ends inside the
# span (it is full): its end is below nch, or it is en itself.

law sub.full.b:
  for b: Bool
  for +y: U32
  for +l: U32
  for +en: U32
  for +nch: U32
  for +last: U32
  for +ee: {Nat.is_le(U32.to_nat(en), U32.to_nat(nch)) == True{} : Bool}
  for +fe: {B3.full(en, nch, last) == True{} : Bool}
  for +ey: {Nat.is_le(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(en)) == True{} : Bool}
  for +eb: {Nat.is_lt(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(nch)) == b : Bool}
  {B3.full((y + l : U32), nch, last) == True{} : Bool}

def sub.full.b(b, y, l, en, nch, last, ee, fe, ey, eb):
  match b:
    case True{}:
      +es = A.u.tn_add(y, l, en, ey)
      C.full.from_lt((y + l : U32), nch, last,
        Equal.trans(Bool, U32.is_lt((y + l : U32), nch), Nat.is_lt(U32.to_nat((y + l : U32)), U32.to_nat(nch)), True{}, A.u.is_lt_nat((y + l : U32), nch),
          Equal.trans(Bool, Nat.is_lt(U32.to_nat((y + l : U32)), U32.to_nat(nch)), Nat.is_lt(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(nch)), True{},
            Equal.cong(Nat, Bool, z => Nat.is_lt(z, U32.to_nat(nch)), U32.to_nat((y + l : U32)), Nat.add(U32.to_nat(y), U32.to_nat(l)), es), eb)))
    case False{}:
      +es = A.u.tn_add(y, l, en, ey)
      +te = Equal.trans(Nat, U32.to_nat((y + l : U32)), Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(en), es,
        A.n.squeeze(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(en), U32.to_nat(nch), ey, ee, eb))
      +ue = Equal.trans(U32, (y + l : U32), U32.from_nat(U32.to_nat((y + l : U32))), en,
        Equal.sym(U32, U32.from_nat(U32.to_nat((y + l : U32))), (y + l : U32), A.u.fn_tn((y + l : U32))),
        Equal.trans(U32, U32.from_nat(U32.to_nat((y + l : U32))), U32.from_nat(U32.to_nat(en)), en,
          Equal.cong(Nat, U32, z => U32.from_nat(z), U32.to_nat((y + l : U32)), U32.to_nat(en), te), A.u.fn_tn(en)))
      %Equal.sym(U32, (y + l : U32), en, ue) : {B3.full(_, nch, last) == True{} : Bool}
      fe

law sub.full:
  for +y: U32
  for +l: U32
  for +en: U32
  for +nch: U32
  for +last: U32
  for +ee: {Nat.is_le(U32.to_nat(en), U32.to_nat(nch)) == True{} : Bool}
  for +fe: {B3.full(en, nch, last) == True{} : Bool}
  for +ey: {Nat.is_le(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(en)) == True{} : Bool}
  {B3.full((y + l : U32), nch, last) == True{} : Bool}

def sub.full(y, l, en, nch, last, ee, fe, ey):
  sub.full.b(Nat.is_lt(Nat.add(U32.to_nat(y), U32.to_nat(l)), U32.to_nat(nch)), y, l, en, nch, last, ee, fe, ey, {==})

# Where a range of 2p chunks from o fits, so does its first half...
law hyp.l:
  for +o: U32
  for +p: Nat
  for +en: U32
  for +h: {Nat.is_le(Nat.add(U32.to_nat(o), Nat.double(p)), U32.to_nat(en)) == True{} : Bool}
  {Nat.is_le(Nat.add(U32.to_nat(o), p), U32.to_nat(en)) == True{} : Bool}

def hyp.l(o, p, en, h):
  A.n.le_trans(Nat.add(U32.to_nat(o), p), Nat.add(U32.to_nat(o), Nat.double(p)), U32.to_nat(en),
    A.n.add_le(U32.to_nat(o), p, Nat.double(p), A.le.dbl(p)), h)

# ...and its second half, 2^m chunks on.
law hyp.r:
  for +o: U32
  for +m: Nat
  for +en: U32
  for +em: {Nat.is_le(m, 31n) == True{} : Bool}
  for +h: {Nat.is_le(Nat.add(U32.to_nat(o), Nat.double(A.pow2(m))), U32.to_nat(en)) == True{} : Bool}
  {Nat.is_le(Nat.add(U32.to_nat((o + U32.shln(1, m) : U32)), A.pow2(m)), U32.to_nat(en)) == True{} : Bool}

def hyp.r(o, m, en, em, h):
  +th = A.sh.nat(m, em)
  +hl = hyp.l(o, A.pow2(m), en, h)
  +b = Equal.trans(Bool, Nat.is_le(Nat.add(U32.to_nat(o), U32.to_nat(U32.shln(1, m))), U32.to_nat(en)), Nat.is_le(Nat.add(U32.to_nat(o), A.pow2(m)), U32.to_nat(en)), True{},
