# A GPU 4-chunk leaf is tree1 over its chunks, where the span holds it whole.
law g4.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 4n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 4 : U32), nch, last) == True{} : Bool}
  {B3.g.fin(B3.g4(x, c, (cb + c : U32), rf)) == B3.tree1(~Laws.share, 2n, True{}, (x, x), c, 4, cb, nch, last, rf) : B3.CV}

def g4.eq(x, c, cb, nch, last, rf, inv, ef):
  g4.eq.h(x, c, cb, nch, last, rf, inv, ef, C.wits(6n, x))

