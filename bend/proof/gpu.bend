                                              +tk = Equal.trans(Nat, U32.to_nat(ku), U32.to_nat(U32.from_nat(6n+q)), 6n+q, Equal.cong(U32, Nat, z => U32.to_nat(z), ku, U32.from_nat(6n+q), eku), A.u.tn_fn(6n+q, 32, ek))
                                              +nn = Equal.trans(U32, n, U32.shln(1, U32.to_nat(ku)), U32.shln(1, 6n+q), en, Equal.cong(Nat, U32, z => U32.shln(1, z), U32.to_nat(ku), 6n+q, tk))
