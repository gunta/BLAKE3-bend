# A GPU 16-chunk leaf is tree1 over its chunks, where the span holds it whole.
law g16.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 16n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 16 : U32), nch, last) == True{} : Bool}
  {B3.g.fin(B3.g16(x, c, (cb + c : U32), rf)) == B3.tree1(~Laws.share, 4n, True{}, (x, x), c, 16, cb, nch, last, rf) : B3.CV}

def g16.eq(x, c, cb, nch, last, rf, inv, ef):
  g16.eq.h(x, c, cb, nch, last, rf, inv, ef, C.wits(10n, x))

