law chunk.eq.g3:
  for -x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for b: Bool
  for +eb: {U32.is_eq((((c + 2 : U32) + 1 : U32) + 1 : U32), nch) == b : Bool}
  for +el: {Bool.or(Bool.not(b), U32.is_eq(last, 1024)) == True{} : Bool}
  {B3.chunk(x, ((c + 2 : U32) + 1 : U32), cb, nch, last, 0) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}

def chunk.eq.g3(x, c, cb, nch, last, b, eb, el):
  match b:
    case False{}:
      %Equal.sym(Bool, U32.is_eq((((c + 2 : U32) + 1 : U32) + 1 : U32), nch), False{}, eb) :
        {C.chunk.b(x, ((c + 2 : U32) + 1 : U32), cb, last, 0, _) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
      %Equal.sym(B3.CV, C.chunk.b(x, ((c + 2 : U32) + 1 : U32), cb, last, 0, False{}), B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (((c + 2 : U32) + 1 : U32) << 8n : U32)), (((c + 2 : U32) + 1 : U32) << 8n : U32), B3.IV(), (cb + ((c + 2 : U32) + 1 : U32) : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)), C.chunk.full(x, ((c + 2 : U32) + 1 : U32), cb, last, 0)) :
        {_ == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
      %Equal.sym(U32, (((c + 2 : U32) + 1 : U32) << 8n : U32), ((c << 8n : U32) + 768 : U32), Equal.trans(U32, (((c + 2 : U32) + 1 : U32) << 8n : U32), ((c + 3 : U32) << 8n : U32), ((c << 8n : U32) + 768 : U32), Equal.cong(U32, U32, z => (z << 8n : U32), ((c + 2 : U32) + 1 : U32), (c + 3 : U32), A.u.add_assoc(c, 2, 1)), A.u.shln_add(c, 3, 8n))) :
        {B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, _), _, B3.IV(), (cb + ((c + 2 : U32) + 1 : U32) : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
      %Equal.sym(U32, (cb + ((c + 2 : U32) + 1 : U32) : U32), ((cb + c : U32) + 3 : U32), Equal.trans(U32, (cb + ((c + 2 : U32) + 1 : U32) : U32), (cb + (c + 3 : U32) : U32), ((cb + c : U32) + 3 : U32), Equal.cong(U32, U32, z => (cb + z : U32), ((c + 2 : U32) + 1 : U32), (c + 3 : U32), A.u.add_assoc(c, 2, 1)), Equal.sym(U32, ((cb + c : U32) + 3 : U32), (cb + (c + 3 : U32) : U32), A.u.add_assoc(cb, c, 3)))) :
        {B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), _, B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
      {==}
    case True{}:
      %Equal.sym(Bool, U32.is_eq((((c + 2 : U32) + 1 : U32) + 1 : U32), nch), True{}, eb) :
        {C.chunk.b(x, ((c + 2 : U32) + 1 : U32), cb, last, 0, _) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
      %Equal.sym(U32, last, 1024, A.u.eq_sound(last, 1024, el)) :
        {C.chunk.b(x, ((c + 2 : U32) + 1 : U32), cb, _, 0, True{}) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 768 : U32)), ((c << 8n : U32) + 768 : U32), B3.IV(), ((cb + c : U32) + 3 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
