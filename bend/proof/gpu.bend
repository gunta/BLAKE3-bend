# A lane is four scalar 16-chunk subtrees, where each ends inside a full range.
law quad.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +st: U32
  for +en: U32
  for +ee: {Nat.is_le(U32.to_nat(en), U32.to_nat(nch)) == True{} : Bool}
  for +fe: {B3.full(en, nch, last) == True{} : Bool}
  for +h0: {Nat.is_le(Nat.add(U32.to_nat(c), 16n), U32.to_nat(en)) == True{} : Bool}
  for +h1: {Nat.is_le(Nat.add(U32.to_nat((c + st : U32)), 16n), U32.to_nat(en)) == True{} : Bool}
  for +h2: {Nat.is_le(Nat.add(U32.to_nat((c + (st << 1n : U32) : U32)), 16n), U32.to_nat(en)) == True{} : Bool}
  for +h3: {Nat.is_le(Nat.add(U32.to_nat((c + (st + (st << 1n : U32) : U32) : U32)), 16n), U32.to_nat(en)) == True{} : Bool}
  {B3.quad(x, c, (cb + c : U32), st) == B3.CV4{B3.tree1(~Laws.share, 4n, True{}, (x, x), c, 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (x, x), (c + st : U32), 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (x, x), (c + (st << 1n : U32) : U32), 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (x, x), (c + (st + (st << 1n : U32) : U32) : U32), 16, cb, nch, last, 0)} : B3.CV4}

def quad.eq(x, c, cb, nch, last, st, en, ee, fe, h0, h1, h2, h3):
  quad.eq.h(x, c, cb, nch, last, st, en, ee, fe, h0, h1, h2, h3, C.wits(8n, x))

# 2^r lanes from c (lane j at c + 16j) are four scalar subtrees of 16 << r
# chunks, from c, c + st, c + 2st and c + 3st: at r = 0 a lane's groups, and
# a join pairs its halves' groups into the next level's subtrees.
law qt:
  for +r: Nat
  for -x: Array<U32>
  for w: C.Wits(x, 7n)
  for +c: U32
  for +st: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +en: U32
  for +ee: {Nat.is_le(U32.to_nat(en), U32.to_nat(nch)) == True{} : Bool}
  for +fe: {B3.full(en, nch, last) == True{} : Bool}
  for +er: {Nat.is_le(Nat.add(4n, r), 31n) == True{} : Bool}
  for +h0: {Nat.is_le(Nat.add(U32.to_nat(c), A.pow2(Nat.add(4n, r))), U32.to_nat(en)) == True{} : Bool}
  for +h1: {Nat.is_le(Nat.add(U32.to_nat((c + st : U32)), A.pow2(Nat.add(4n, r))), U32.to_nat(en)) == True{} : Bool}
  for +h2: {Nat.is_le(Nat.add(U32.to_nat((c + (st << 1n : U32) : U32)), A.pow2(Nat.add(4n, r))), U32.to_nat(en)) == True{} : Bool}
  for +h3: {Nat.is_le(Nat.add(U32.to_nat((c + (st + (st << 1n : U32) : U32) : U32)), A.pow2(Nat.add(4n, r))), U32.to_nat(en)) == True{} : Bool}
  {B3.qtree(~Laws.share, r, (x, x), c, (cb + c : U32), st) == B3.CV4{B3.tree1(~Laws.share, Nat.add(4n, r), True{}, (x, x), c, U32.shln(1, Nat.add(4n, r)), cb, nch, last, 0), B3.tree1(~Laws.share, Nat.add(4n, r), True{}, (x, x), (c + st : U32), U32.shln(1, Nat.add(4n, r)), cb, nch, last, 0), B3.tree1(~Laws.share, Nat.add(4n, r), True{}, (x, x), (c + (st << 1n : U32) : U32), U32.shln(1, Nat.add(4n, r)), cb, nch, last, 0), B3.tree1(~Laws.share, Nat.add(4n, r), True{}, (x, x), (c + (st + (st << 1n : U32) : U32) : U32), U32.shln(1, Nat.add(4n, r)), cb, nch, last, 0)} : B3.CV4}

def qt(r, x, w, c, st, cb, nch, last, en, ee, fe, er, h0, h1, h2, h3):
  match r:
    case 0n:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              match w3b:
                                case (z4, w4):
                                  match w4:
                                    case (+ez40, w4b):
                                      match w4b:
                                        case (z5, w5):
                                          match w5:
                                            case (+ez50, w5b):
                                              match w5b:
                                                case (z6, w6):
                                                  match w6:
                                                    case (+ez60, w6b):
                                                      match w6b:
                                                        case (z7, w7):
                                                          match w7:
                                                            case (+ez70, w7b):
                                                              _ = w7b
                                                              _ = z2
                                                              _ = z3
                                                              _ = z4
                                                              _ = z5
                                                              _ = z6
                                                              _ = z7
                                                              C.tr(arr => {B3.quad(arr, c, (cb + c : U32), st) == B3.CV4{B3.tree1(~Laws.share, 4n, True{}, (arr, arr), c, 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (arr, arr), (c + st : U32), 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (arr, arr), (c + (st << 1n : U32) : U32), 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, (arr, arr), (c + (st + (st << 1n : U32) : U32) : U32), 16, cb, nch, last, 0)} : B3.CV4}, z1, x, ez10, quad.eq(z1, c, cb, nch, last, st, en, ee, fe, h0, h1, h2, h3))
    case 1n+s:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              match w3b:
                                case (z4, w4):
                                  match w4:
                                    case (+ez40, w4b):
                                      match w4b:
                                        case (z5, w5):
                                          match w5:
