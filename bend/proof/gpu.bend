# The GPU tree, for every input
# =============================
#
# GENERATED by tools/gen_laws.py (tools/proofs/): edit the generator.
#
# gpu.at: for every array and every span, hash1's tree (treeg: whole, full
# subtrees of 4, 16 or 64 chunks to one lane each, bigger ones at leaf level
# 6 to strided lanes) is blake3.bend's scalar tree. In order:
#
# - A lane's chunk (gch) and its flat leaves (g4, g16, g64: chains of four
#   under parents) hand their array back, and are tree1 over their chunks
#   where the span holds them whole (g4.eq, g16.eq, g64.eq).
# - A strided lane (quad) is four 16-chunk subtrees st chunks apart, and a
#   fork of 2^r lanes (qtree) is four scalar subtrees of 16 << r chunks, by
#   induction on r: a join pairs its halves' groups into the next level's
#   subtrees (qt). A GQuad node is tree1 halved twice (gquad.eq).
# - Node by node, treeg splits where tree1 does (gpu.tree), its kind from a
#   U32 copy of the depth and the leaf level, as in the CPU tree's proof.
#
# The reads, witnesses and node invariants are cpu.bend's (C.).

import Base
import ../blake3.bend as B3
import ../LAWS.bend as Laws
import ./words.bend as A
import ./cpu.bend as C

# The scalar loader and chunk loop hand their array back.
law ld.fst:
  for a: Array<U32>
  for +w: U32
  {Pair.fst(Array<U32>, B3.M16, B3.ld(a, w)) == a : Array<U32>}

def ld.fst(a, w):
  Equal.cong(Array<U32> & B3.M16, Array<U32>, p => Pair.fst(Array<U32>, B3.M16, p), B3.ld(a, w), (a, Pair.snd(Array<U32>, B3.M16, B3.ld(a, w))), C.ld.eta(a, w))

law cg.eta:
  for +n: Nat
  for -a0: Array<U32>
  for r: Array<U32> & B3.M16
  for +er: {Pair.fst(Array<U32>, B3.M16, r) == a0 : Array<U32>}
  for +w: U32
  for +cv: B3.CV
  for +ctr: U32
  for +fl: U32
  for +endf: U32
  for +lastlen: U32
  for C.bun: C.Bun1(a0, n)
  {B3.chunk.go(n, r, w, cv, ctr, fl, endf, lastlen) == (a0, Pair.snd(Array<U32>, B3.CV, B3.chunk.go(n, r, w, cv, ctr, fl, endf, lastlen))) : Array<U32> & B3.CV}

def cg.eta(n, a0, r, er, w, cv, ctr, fl, endf, lastlen, C.bun):
  match n:
    case 0n:
      match r:
        case (a, +m):
          _ = C.bun
          %er : {(a, B3.compress(cv, m, ctr, 0, lastlen, (fl .|. endf : U32))) == (_, B3.compress(cv, m, ctr, 0, lastlen, (fl .|. endf : U32))) : Array<U32> & B3.CV}
          {==}
    case 1n+q:
      match r:
        case (a, +m):
          match C.bun:
            case (lvl, rest):
              match lvl:
                case (x1, l1):
                  match l1:
                    case (+e1, l1b):
                      _ = l1b
                      +f = C.eq.trans(Pair.fst(Array<U32>, B3.M16, B3.ld(a, (w + 16 : U32))), a, a0, C.tr(arr => {Pair.fst(Array<U32>, B3.M16, B3.ld(arr, (w + 16 : U32))) == arr : Array<U32>}, x1, a,
                        C.eq.trans(x1, a0, a, e1, Equal.sym(Array<U32>, a, a0, er)), ld.fst(x1, (w + 16 : U32))), er)
                      cg.eta(q, a0, B3.ld(a, (w + 16 : U32)), f, (w + 16 : U32), B3.compress(cv, m, ctr, 0, 64, fl), ctr, 0, endf, lastlen, rest)

# The CV of a pair, by its fin or by snd.
law fin.snd:
  for r: Array<U32> & B3.CV
  {Pair.snd(Array<U32>, B3.CV, r) == B3.chunk.fin(r) : B3.CV}

def fin.snd(r):
  match r:
    case (a, x):
      {==}

law gfin.snd:
  for r: Array<U32> & B3.CV
  {B3.g.fin(r) == Pair.snd(Array<U32>, B3.CV, r) : B3.CV}

def gfin.snd(r):
  match r:
    case (a, x):
      {==}

def gch.eta.h2(-a: Array<U32>, +c: U32, +t: U32, +rf: U32, -s: Array<U32>, +es: {s == a : Array<U32>}, r: C.Wits(s, 2n), bb: C.Bun1(a, 15n)) -> {B3.gch(a, c, t, rf) == (a, Pair.snd(Array<U32>, B3.CV, B3.gch(a, c, t, rf))) : Array<U32> & B3.CV}:
  match r:
    case (x1, r1):
      match r1:
        case (+ex1o, r1b):
          match r1b:
            case (x2, r2):
              match r2:
                case (+ex2o, r2b):
                  _ = r2b
                  +ex1 = C.eq.trans(x1, s, a, ex1o, es)
                  +ex2 = C.eq.trans(x2, s, a, ex2o, es)
                  +f = C.eq.trans(Pair.fst(Array<U32>, B3.M16, B3.ld(x1, (c << 8n : U32))), x1, a, C.tr(arr => {Pair.fst(Array<U32>, B3.M16, B3.ld(arr, (c << 8n : U32))) == arr : Array<U32>}, x2, x1, C.eq.trans(x2, a, x1, ex2, Equal.sym(Array<U32>, x1, a, ex1)), ld.fst(x2, (c << 8n : U32))), ex1)
                  C.tr(arr => {B3.chunk.go(15n, B3.ld(arr, (c << 8n : U32)), (c << 8n : U32), B3.IV(), t, B3.CHUNK_START(), B3.CHUNK_END(), 64) == (a, Pair.snd(Array<U32>, B3.CV, B3.chunk.go(15n, B3.ld(arr, (c << 8n : U32)), (c << 8n : U32), B3.IV(), t, B3.CHUNK_START(), B3.CHUNK_END(), 64))) : Array<U32> & B3.CV}, x1, a, ex1,
                    cg.eta(15n, a, B3.ld(x1, (c << 8n : U32)), f, (c << 8n : U32), B3.IV(), t, B3.CHUNK_START(), B3.CHUNK_END(), 64, bb))

def gch.eta.h1(-a: Array<U32>, +c: U32, +t: U32, +rf: U32, r: C.BunS1(a, 15n)) -> {B3.gch(a, c, t, rf) == (a, Pair.snd(Array<U32>, B3.CV, B3.gch(a, c, t, rf))) : Array<U32> & B3.CV}:
  match r:
    case (s, r2):
      match r2:
        case (+es, bb):
          gch.eta.h2(a, c, t, rf, s, es, C.wits(1n, s), bb)

# A GPU lane's chunk hands its array back...
law gch.eta:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  {B3.gch(a, c, t, rf) == (a, Pair.snd(Array<U32>, B3.CV, B3.gch(a, c, t, rf))) : Array<U32> & B3.CV}

def gch.eta(a, c, t, rf):
  gch.eta.h1(a, c, t, rf, C.bun1(15n, a))

# ...and its CV is the full chunk's.
law gch.fc:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  {Pair.snd(Array<U32>, B3.CV, B3.gch(a, c, t, rf)) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(a, (c << 8n : U32)), (c << 8n : U32), B3.IV(), t, B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}

def gch.fc(a, c, t, rf):
  fin.snd(B3.gch(a, c, t, rf))

