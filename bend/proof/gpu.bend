    {Nat.is_le(Nat.add(_, A.pow2(m)), U32.to_nat(en)) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.shln(1, m)), A.pow2(m), th) :
    {Nat.is_le(Nat.add(Nat.add(U32.to_nat(o), _), A.pow2(m)), U32.to_nat(en)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(o), A.pow2(m)), A.pow2(m)), Nat.add(U32.to_nat(o), Nat.add(A.pow2(m), A.pow2(m))), A.add_assoc(U32.to_nat(o), A.pow2(m), A.pow2(m))) :
    {Nat.is_le(_, U32.to_nat(en)) == True{} : Bool}
  %A.double_add(A.pow2(m)) :
    {Nat.is_le(Nat.add(U32.to_nat(o), _), U32.to_nat(en)) == True{} : Bool}
  h

# Halving the scalar tree
# -----------------------

def tree1.half.h(+m: Nat, -x: Array<U32>, +c: U32, +cb: U32, +nch: U32, +last: U32, +rf: U32, r: C.Wits(x, 1n)) -> {B3.tree1(~Laws.share, 1n+m, True{}, (x, x), c, U32.shln(1, 1n+m), cb, nch, last, rf) == B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), (c + U32.shln(1, m) : U32), U32.shln(1, m), cb, nch, last, 0), rf) : B3.CV}:
  match r:
    case (z1, r1):
      match r1:
        case (+ez10, r1b):
          _ = r1b
          %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, x, ez10, C.clone.dup(z1))) :
            {B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), _, c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, U32.sub(U32.shln(1, 1n+m), U32.shln(1, m))), _, (c + U32.shln(1, m) : U32), U32.sub(U32.shln(1, 1n+m), U32.shln(1, m)), cb, nch, last, 0), rf) == B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), (c + U32.shln(1, m) : U32), U32.shln(1, m), cb, nch, last, 0), rf) : B3.CV}
          %Equal.sym(U32, U32.sub(U32.shln(1, 1n+m), U32.shln(1, m)), U32.shln(1, m), A.sh.sub(m)) :
            {B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, _), (x, x), (c + U32.shln(1, m) : U32), _, cb, nch, last, 0), rf) == B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), (c + U32.shln(1, m) : U32), U32.shln(1, m), cb, nch, last, 0), rf) : B3.CV}
          {==}

# tree1 over 2^(m+1) chunks from c is a parent over its two halves.
law tree1.half:
  for +m: Nat
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.tree1(~Laws.share, 1n+m, True{}, (x, x), c, U32.shln(1, 1n+m), cb, nch, last, rf) == B3.parent(B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), c, U32.shln(1, m), cb, nch, last, 0), B3.tree1(~Laws.share, m, B3.big(m, U32.shln(1, m)), (x, x), (c + U32.shln(1, m) : U32), U32.shln(1, m), cb, nch, last, 0), rf) : B3.CV}

def tree1.half(m, x, c, cb, nch, last, rf):
  tree1.half.h(m, x, c, cb, nch, last, rf, C.wits(0n, x))

# The same with the halves' own split decided: 2^(m+1) > 2^m while it fits.
law tree1.halfT:
  for +m: Nat
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +em: {Nat.is_le(1n+m, 31n) == True{} : Bool}
  {B3.tree1(~Laws.share, 2n+m, True{}, (x, x), c, U32.shln(1, 2n+m), cb, nch, last, rf) == B3.parent(B3.tree1(~Laws.share, 1n+m, True{}, (x, x), c, U32.shln(1, 1n+m), cb, nch, last, 0), B3.tree1(~Laws.share, 1n+m, True{}, (x, x), (c + U32.shln(1, 1n+m) : U32), U32.shln(1, 1n+m), cb, nch, last, 0), rf) : B3.CV}

def tree1.halfT(m, x, c, cb, nch, last, rf, em):
  %A.sh.gt(m, em) :
    {B3.tree1(~Laws.share, 2n+m, True{}, (x, x), c, U32.shln(1, 2n+m), cb, nch, last, rf) == B3.parent(B3.tree1(~Laws.share, 1n+m, _, (x, x), c, U32.shln(1, 1n+m), cb, nch, last, 0), B3.tree1(~Laws.share, 1n+m, _, (x, x), (c + U32.shln(1, 1n+m) : U32), U32.shln(1, 1n+m), cb, nch, last, 0), rf) : B3.CV}
  tree1.half(1n+m, x, c, cb, nch, last, rf)

