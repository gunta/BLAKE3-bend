    case False{}:
      _ = w
      +en = A.u.eq_sound(n, U32.shln(1, U32.to_nat(ku)), A.and.l(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))), B3.full((c + n : U32), nch, last), ef))
      +g1 = Equal.trans(Bool, U32.is_gt(U32.shln(1, U32.to_nat(ku)), U32.shln(1, 5n+q)), U32.is_gt(n, U32.shln(1, 5n+q)), True{},
        Equal.cong(U32, Bool, z => U32.is_gt(z, U32.shln(1, 5n+q)), U32.shln(1, U32.to_nat(ku)), n, Equal.sym(U32, n, U32.shln(1, U32.to_nat(ku)), en)), eb)
      +g2 = Equal.trans(Bool, U32.is_gt(U32.shln(1, U32.to_nat(U32.from_nat(6n+q))), U32.shln(1, 5n+q)), U32.is_gt(U32.shln(1, U32.to_nat(ku)), U32.shln(1, 5n+q)), True{},
        Equal.cong(U32, Bool, z => U32.is_gt(U32.shln(1, U32.to_nat(z)), U32.shln(1, 5n+q)), U32.from_nat(6n+q), ku, Equal.sym(U32, ku, U32.from_nat(6n+q), eku)), g1)
      +g3 = Equal.trans(Bool, U32.is_gt(U32.shln(1, U32.to_nat(U32.from_nat(32n))), U32.shln(1, 31n)), U32.is_gt(U32.shln(1, U32.to_nat(U32.from_nat(6n+q))), U32.shln(1, 5n+q)), True{},
        Equal.cong(Nat, Bool, y => U32.is_gt(U32.shln(1, U32.to_nat(U32.from_nat(6n+y))), U32.shln(1, 5n+y)), 26n, q,
          Equal.sym(Nat, q, 26n, A.n.top(q, 25n, ek, e25))), g2)
