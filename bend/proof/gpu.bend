# The strided-lane node
# ---------------------

# A whole, full subtree of 2^(6+q) chunks handed to 2^q strided lanes is
# tree1 over it (q <= 25: at q = 26 it would be 2^32 chunks, which kind1's
# split test rules out).
law gquad.b:
  for +q: Nat
  for b: Bool
  for +e25: {Nat.is_le(q, 25n) == b : Bool}
  for -x: Array<U32>
  for w: C.Wits(x, 5n)
  for +ku: U32
  for +eku: {ku == U32.from_nat(6n+q) : U32}
  for +ek: {Nat.is_le(6n+q, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +lv: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for +eb: {B3.big(6n+q, n) == True{} : Bool}
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == True{} : Bool}
  {B3.treeg(~Laws.share, 6n+q, ku, B3.GQuad{}, (x, x), c, n, cb, nch, last, lv, rf) == B3.tree1(~Laws.share, 6n+q, True{}, (x, x), c, n, cb, nch, last, rf) : B3.CV}

def gquad.b(q, b, e25, x, w, ku, eku, ek, c, n, cb, nch, last, lv, rf, inv, eb, ef):
