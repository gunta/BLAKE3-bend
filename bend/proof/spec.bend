    case 0n:
      match w:
        case 0n:
          {==}
        case 1n+u:
          {==}
    case 1n+b:
      sub.add0(b, w)

law sub.dbl:  for +x: Nat
  {Nat.sub(Nat.double(x), x) == x : Nat}

