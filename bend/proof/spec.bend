# BLAKE3's tree, on the code
# ==========================
#
# GENERATED by tools/gen_laws.py (tools/proofs/): edit the generator.
#
# The tree laws (segments, levels, counts, stream) are about Shapes, a model
# of BLAKE3's tree: tree(digits(k, r)) over chunks 0..r. This module ties
# the model to blake3.bend:
#
# - tree1's split rule (n > 2^p) is the digit rule, for every chunk count
#   (t1d, the proof of tree1.digits).
# - A span's depth is enough for its chunks: nch - 1 < 2^depth(nch), from
#   U32.log2's binary search (depth.bound).
# - tree1 computes ev, the CV of the model's Shape over the span's chunks,
#   leaf by leaf and parent by parent (t1ev).
#
# So the scalar tree (ref.spec), and through cpu.at and gpu.at the trees
# that run (cpu.spec, gpu.spec), are BLAKE3's tree over the span.

import Base
import ../blake3.bend as B3
import ../LAWS.bend as Laws
import ./words.bend as A
import ./cpu.bend as C
import ./gpu.bend as G

# BLAKE3's split rule is the digit rule, for every chunk count
# -------------------------------------------------------------

# half and odd past an even number 2p.
law half.dbl:
  for +p: Nat
  for +w: Nat
  {Laws.half(Nat.add(Nat.double(p), w)) == Nat.add(p, Laws.half(w)) : Nat}

def half.dbl(p, w):
  match p:
    case 0n:
      {==}
    case 1n+q:
      Equal.cong(Nat, Nat, z => 1n+z, Laws.half(Nat.add(Nat.double(q), w)), Nat.add(q, Laws.half(w)), half.dbl(q, w))

law odd.dbl:
  for +p: Nat
  for +w: Nat
  {Laws.odd(Nat.add(Nat.double(p), w)) == Laws.odd(w) : Bool}

def odd.dbl(p, w):
  match p:
    case 0n:
      {==}
    case 1n+q:
      odd.dbl(q, w)

# 2^p + w shifted down p bits is one more than w shifted.
law shr.add:
  for +p: Nat
  for +w: Nat
  {Laws.shr(p, Nat.add(Laws.pow2(p), w)) == 1n+Laws.shr(p, w) : Nat}

def shr.add(p, w):
  match p:
    case 0n:
      {==}
    case 1n+q:
      %Equal.sym(Nat, Laws.half(Nat.add(Nat.double(Laws.pow2(q)), w)), Nat.add(Laws.pow2(q), Laws.half(w)), half.dbl(Laws.pow2(q), w)) :
        {Laws.shr(q, _) == 1n+Laws.shr(q, Laws.half(w)) : Nat}
      shr.add(q, Laws.half(w))

law shr.half:
  for +p: Nat
  for +v: Nat
  {Laws.shr(p, Laws.half(v)) == Laws.half(Laws.shr(p, v)) : Nat}

def shr.half(p, v):
  match p:
    case 0n:
      {==}
    case 1n+q:
      shr.half(q, Laws.half(v))

# The low p digits of 2^p + w are w's.
law digits.pow:
  for +p: Nat
  for +w: Nat
  for +acc: List<&2, Bool>
  {Laws.digits(p, Nat.add(Laws.pow2(p), w), acc) == Laws.digits(p, w, acc) : List<&2, Bool>}

def digits.pow(p, w, acc):
  match p:
    case 0n:
      {==}
    case 1n+q:
      %Equal.sym(Nat, Laws.half(Nat.add(Nat.double(Laws.pow2(q)), w)), Nat.add(Laws.pow2(q), Laws.half(w)), half.dbl(Laws.pow2(q), w)) :
        {Laws.digits(q, _, Laws.odd(Nat.add(Nat.double(Laws.pow2(q)), w)) <> acc) == Laws.digits(q, Laws.half(w), Laws.odd(w) <> acc) : List<&2, Bool>}
      %Equal.sym(Bool, Laws.odd(Nat.add(Nat.double(Laws.pow2(q)), w)), Laws.odd(w), odd.dbl(Laws.pow2(q), w)) :
        {Laws.digits(q, Nat.add(Laws.pow2(q), Laws.half(w)), _ <> acc) == Laws.digits(q, Laws.half(w), Laws.odd(w) <> acc) : List<&2, Bool>}
      digits.pow(q, Laws.half(w), Laws.odd(w) <> acc)

law digits.len:
  for +p: Nat
  for +w: Nat
  for +acc: List<&2, Bool>
  {List.length(&2, Bool, Laws.digits(p, w, acc)) == Nat.add(p, List.length(&2, Bool, acc)) : Nat}

def digits.len(p, w, acc):
  match p:
    case 0n:
      {==}
    case 1n+q:
      Equal.trans(Nat, List.length(&2, Bool, Laws.digits(q, Laws.half(w), Laws.odd(w) <> acc)), Nat.add(q, 1n+List.length(&2, Bool, acc)),
        1n+Nat.add(q, List.length(&2, Bool, acc)), digits.len(q, Laws.half(w), Laws.odd(w) <> acc), A.add_succ(q, List.length(&2, Bool, acc)))

# The top digit of p + 1 is bit p.
law digits.top:
  for +p: Nat
  for +v: Nat
  for +acc: List<&2, Bool>
  {Laws.digits(1n+p, v, acc) == Laws.odd(Laws.shr(p, v)) <> Laws.digits(p, v, acc) : List<&2, Bool>}

def digits.top(p, v, acc):
  match p:
    case 0n:
      {==}
    case 1n+q:
      digits.top(q, Laws.half(v), Laws.odd(v) <> acc)

law ltz:
  for +u: Nat
  {Nat.is_lt(u, 0n) == False{} : Bool}

def ltz(u):
  match u:
    case 0n:
      {==}
    case 1n+s:
      {==}

law le0:
  for +s: Nat
  {Nat.is_le(0n, s) == True{} : Bool}

def le0(s):
  match s:
    case 0n:
      {==}
    case 1n+q:
      {==}

law n.gt0:
  for +q: Nat
  for +e: {Nat.is_gt(0n, q) == True{} : Bool}
  {False{} == True{} : Bool}

def n.gt0(q, e):
  match q:
    case 0n:
      e
    case 1n+s:
      e

law pow2.pos:
  for +m: Nat
  {Nat.is_gt(Laws.pow2(m), 0n) == True{} : Bool}

def pow2.pos(m):
  match m:
    case 0n:
      {==}
    case 1n+q:
      A.dpos(Laws.pow2(q), pow2.pos(q))

# v < 2p: half(v) < p.
law half.lt:
  for +v: Nat
  for +p: Nat
  for +e: {Nat.is_lt(v, Nat.double(p)) == True{} : Bool}
  {Nat.is_lt(Laws.half(v), p) == True{} : Bool}

def half.lt(v, p, e):
  match v:
    case 0n:
      match p:
        case 0n:
          Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, A.absurd.ft(e))
        case 1n+q:
          {==}
    case 1n+v1:
      match v1:
        case 0n:
          match p:
            case 0n:
              Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, A.absurd.ft(e))
            case 1n+q:
              {==}
        case 1n+u:
          match p:
            case 0n:
              Empty.absurd({Nat.is_lt(1n+Laws.half(u), 0n) == True{} : Bool}, A.absurd.ft(e))
            case 1n+q:
              half.lt(u, q, e)

law lt.shr:
  for +p: Nat
  for +v: Nat
  for +e: {Nat.is_lt(v, Laws.pow2(p)) == True{} : Bool}
  {Laws.shr(p, v) == 0n : Nat}

def lt.shr(p, v, e):
  match p:
    case 0n:
      match v:
        case 0n:
          {==}
        case 1n+u:
          Empty.absurd({1n+u == 0n : Nat}, A.absurd.tf(Equal.trans(Bool, True{}, Nat.is_lt(u, 0n), False{}, Equal.sym(Bool, Nat.is_lt(u, 0n), True{}, e), ltz(u))))
    case 1n+q:
      lt.shr(q, Laws.half(v), half.lt(v, Laws.pow2(q), e))

# 1 + r chunks are no more than p: r < p.
law ngt.lt:
  for +r: Nat
  for +p: Nat
  for +e: {Nat.is_gt(1n+r, p) == False{} : Bool}
  {Nat.is_lt(r, p) == True{} : Bool}

def ngt.lt(r, p, e):
  match r p:
    case _ 0n:
      Empty.absurd({Nat.is_lt(r, 0n) == True{} : Bool}, A.absurd.tf(e))
    case 0n 1n+q:
      {==}
    case 1n+u 1n+q:
      ngt.lt(u, q, e)

# 1 + r chunks are more than p: p <= r.
law gt.le:
  for +r: Nat
  for +p: Nat
  for +e: {Nat.is_gt(1n+r, p) == True{} : Bool}
  {Nat.is_le(p, r) == True{} : Bool}

def gt.le(r, p, e):
  match r p:
    case _ 0n:
      le0(r)
    case 0n 1n+q:
      Empty.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, A.absurd.ft(n.gt0(q, e)))
    case 1n+u 1n+q:
      gt.le(u, q, e)

