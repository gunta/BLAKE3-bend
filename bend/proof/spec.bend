  %Equal.sym(Nat, Nat.double(x), Nat.add(x, x), A.double_add(x)) : {Nat.sub(_, x) == x : Nat}
  sub.add0(x, x)

law pow2.gt:
  for +q: Nat
  {Nat.is_gt(Nat.double(Laws.pow2(q)), Laws.pow2(q)) == True{} : Bool}

def pow2.gt(q):
  A.dgt(Laws.pow2(q), pow2.pos(q))

# The tree over 2^p chunks is the complete one.
law t1.full:
  for +p: Nat
  {Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)) == Laws.full(p) : Laws.Shape}

def t1.full(p):
  match p:
    case 0n:
      {==}
    case 1n+q:
      %Equal.sym(Bool, Nat.is_gt(Nat.double(Laws.pow2(q)), Laws.pow2(q)), True{}, pow2.gt(q)) :
        {Laws.tree1(1n+q, _, Laws.pow2(1n+q)) == Laws.full(1n+q) : Laws.Shape}
      %Equal.sym(Nat, Nat.sub(Nat.double(Laws.pow2(q)), Laws.pow2(q)), Laws.pow2(q), sub.dbl(Laws.pow2(q))) :
        {Laws.Fork{Laws.tree1(q, Laws.big(q, Laws.pow2(q)), Laws.pow2(q)), Laws.tree1(q, Laws.big(q, _), _)} == Laws.full(1n+q) : Laws.Shape}
      %Equal.sym(Laws.Shape, Laws.tree1(q, Laws.big(q, Laws.pow2(q)), Laws.pow2(q)), Laws.full(q), t1.full(q)) : {Laws.Fork{_, _} == Laws.full(1n+q) : Laws.Shape}
      {==}

law half.one:
  for +x: Nat
  for +e: {Laws.half(1n+x) == 0n : Nat}
  {x == 0n : Nat}

def half.one(x, e):
  match x:
    case 0n:
      {==}
    case 1n+y:
      Empty.absurd({1n+y == 0n : Nat}, A.absurd.ft(Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 1n+Laws.half(y), 0n, e)))

# tree1's rule (n > 2^(k-1)) is the digit rule, for every r < 2^k: the
# decision b is a parameter, so the induction matches it.
law t1d:
  for +k: Nat
  for +r: Nat
  for +e: {Laws.shr(k, r) == 0n : Nat}
  for b: Bool
  for +eb: {Laws.big(k, 1n+r) == b : Bool}
  {Laws.tree1(k, b, 1n+r) == Laws.tree(Laws.digits(k, r, [])) : Laws.Shape}

def t1d(k, r, e, b, eb):
  match k b:
    case 0n _:
      {==}
    case 1n+p False{}:
      +lt = ngt.lt(r, Laws.pow2(p), eb)
      +z = lt.shr(p, r, lt)
      %Equal.sym(List<&2, Bool>, Laws.digits(1n+p, r, []), Laws.odd(Laws.shr(p, r)) <> Laws.digits(p, r, []), digits.top(p, r, [])) :
        {Laws.tree1(p, Laws.big(p, 1n+r), 1n+r) == Laws.tree(_) : Laws.Shape}
      %Equal.sym(Nat, Laws.shr(p, r), 0n, z) : {Laws.tree1(p, Laws.big(p, 1n+r), 1n+r) == Laws.tree(Laws.odd(_) <> Laws.digits(p, r, [])) : Laws.Shape}
      t1d(p, r, z, Laws.big(p, 1n+r), {==})
    case 1n+p True{}:
      +pw = Laws.pow2(p)
      +w = Nat.sub(r, pw)
      +ar = A.n.add_sub(pw, r, gt.le(r, pw, eb))
      +e2 = Equal.trans(Nat, Laws.shr(1n+p, Nat.add(pw, w)), Laws.shr(1n+p, r), 0n, Equal.cong(Nat, Nat, y => Laws.shr(1n+p, y), Nat.add(pw, w), r, ar), e)
      +e3 = Equal.trans(Nat, Laws.half(1n+Laws.shr(p, w)), Laws.half(Laws.shr(p, Nat.add(pw, w))), 0n,
        Equal.cong(Nat, Nat, y => Laws.half(y), 1n+Laws.shr(p, w), Laws.shr(p, Nat.add(pw, w)), Equal.sym(Nat, Laws.shr(p, Nat.add(pw, w)), 1n+Laws.shr(p, w), shr.add(p, w))),
        Equal.trans(Nat, Laws.half(Laws.shr(p, Nat.add(pw, w))), Laws.shr(p, Laws.half(Nat.add(pw, w))), 0n, Equal.sym(Nat, Laws.shr(p, Laws.half(Nat.add(pw, w))), Laws.half(Laws.shr(p, Nat.add(pw, w))), shr.half(p, Nat.add(pw, w))), e2))
      +ew = half.one(Laws.shr(p, w), e3)
      %ar : {Laws.tree1(1n+p, True{}, 1n+_) == Laws.tree(Laws.digits(1n+p, _, [])) : Laws.Shape}
      %Equal.sym(Nat, Nat.sub(1n+Nat.add(pw, w), pw), 1n+w, sub.add1(pw, w)) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, _), _)} == Laws.tree(Laws.digits(1n+p, Nat.add(pw, w), [])) : Laws.Shape}
      %Equal.sym(List<&2, Bool>, Laws.digits(1n+p, Nat.add(pw, w), []), Laws.odd(Laws.shr(p, Nat.add(pw, w))) <> Laws.digits(p, Nat.add(pw, w), []), digits.top(p, Nat.add(pw, w), [])) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.tree(_) : Laws.Shape}
      %Equal.sym(Nat, Laws.shr(p, Nat.add(pw, w)), 1n+Laws.shr(p, w), shr.add(p, w)) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.tree(Laws.odd(_) <> Laws.digits(p, Nat.add(pw, w), [])) : Laws.Shape}
      %Equal.sym(Nat, Laws.shr(p, w), 0n, ew) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.tree(Laws.odd(1n+_) <> Laws.digits(p, Nat.add(pw, w), [])) : Laws.Shape}
      %Equal.sym(List<&2, Bool>, Laws.digits(p, Nat.add(pw, w), []), Laws.digits(p, w, []), digits.pow(p, w, [])) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.tree(True{} <> _) : Laws.Shape}
      %Equal.sym(Nat, List.length(&2, Bool, Laws.digits(p, w, [])), Nat.add(p, 0n), digits.len(p, w, [])) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.Fork{Laws.full(_), Laws.tree(Laws.digits(p, w, []))} : Laws.Shape}
      %Equal.sym(Nat, Nat.add(p, 0n), p, A.add_zero(p)) :
        {Laws.Fork{Laws.tree1(p, Laws.big(p, pw), pw), Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.Fork{Laws.full(_), Laws.tree(Laws.digits(p, w, []))} : Laws.Shape}
      %Equal.sym(Laws.Shape, Laws.tree1(p, Laws.big(p, pw), pw), Laws.full(p), t1.full(p)) : {Laws.Fork{_, Laws.tree1(p, Laws.big(p, 1n+w), 1n+w)} == Laws.Fork{Laws.full(p), Laws.tree(Laws.digits(p, w, []))} : Laws.Shape}
      %Equal.sym(Laws.Shape, Laws.tree1(p, Laws.big(p, 1n+w), 1n+w), Laws.tree(Laws.digits(p, w, [])), t1d(p, w, ew, Laws.big(p, 1n+w), {==})) : {Laws.Fork{Laws.full(p), _} == Laws.Fork{Laws.full(p), Laws.tree(Laws.digits(p, w, []))} : Laws.Shape}
      {==}


# The depth bound
# ---------------

law not.f:
  for a: Bool
  for +e: {Bool.not(a) == False{} : Bool}
  {a == True{} : Bool}

def not.f(a, e):
  match a:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, A.absurd.tf(e))



law half.double:
  for +t: Nat
  {Laws.half(Nat.double(t)) == t : Nat}

def half.double(t):
  match t:
    case 0n:
      {==}
    case 1n+s:
      Equal.cong(Nat, Nat, z => 1n+z, Laws.half(Nat.double(s)), s, half.double(s))

law half.odd:
  for +t: Nat
  {Laws.half(1n+Nat.double(t)) == t : Nat}

def half.odd(t):
  match t:
    case 0n:
      {==}
    case 1n+s:
      Equal.cong(Nat, Nat, z => 1n+z, Laws.half(1n+Nat.double(s)), s, half.odd(s))

# A shift that pads a 0 on top keeps the value.
law w.pad_nat:
  for +p: Nat
  for +t: Word(p)
  {Word.to_nat(1n+p, Word.shr.pad(p, t)) == Word.to_nat(p, t) : Nat}

def w.pad_nat(p, t):
  match p:
    case 0n:
      match t:
        case WNil{}:
          {==}
    case 1n+q:
      match t:
        case WCon{False{}, u}:
          Equal.cong(Nat, Nat, z => Nat.double(z), Word.to_nat(1n+q, Word.shr.pad(q, u)), Word.to_nat(q, u), w.pad_nat(q, u))
        case WCon{True{}, u}:
          Equal.cong(Nat, Nat, z => 1n+Nat.double(z), Word.to_nat(1n+q, Word.shr.pad(q, u)), Word.to_nat(q, u), w.pad_nat(q, u))

# U32.shr halves the value.
law u.shr_half:
  for +x: U32
  {U32.to_nat(U32.shr(x)) == Laws.half(U32.to_nat(x)) : Nat}

def u.shr_half(x):
  match x:
    case U32{w}:
      match w:
        case WCon{False{}, t}:
          %Equal.sym(Nat, Laws.half(Nat.double(Word.to_nat(31n, t))), Word.to_nat(31n, t), half.double(Word.to_nat(31n, t))) :
            {Word.to_nat(32n, Word.shr.pad(31n, t)) == _ : Nat}
          w.pad_nat(31n, t)
        case WCon{True{}, t}:
          %Equal.sym(Nat, Laws.half(1n+Nat.double(Word.to_nat(31n, t))), Word.to_nat(31n, t), half.odd(Word.to_nat(31n, t))) :
            {Word.to_nat(32n, Word.shr.pad(31n, t)) == _ : Nat}
          w.pad_nat(31n, t)


# U32.shrn by k is shr by k on the value.
law u.shrn_nat:
  for +x: U32
  for +k: Nat
  {U32.to_nat(U32.shrn(x, k)) == Laws.shr(k, U32.to_nat(x)) : Nat}

def u.shrn_nat(x, k):
  match k:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, U32.to_nat(U32.shr(U32.shrn(x, p))), Laws.half(U32.to_nat(U32.shrn(x, p))), u.shr_half(U32.shrn(x, p))) :
        {_ == Laws.shr(p, Laws.half(U32.to_nat(x))) : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.shrn(x, p)), Laws.shr(p, U32.to_nat(x)), u.shrn_nat(x, p)) :
        {Laws.half(_) == Laws.shr(p, Laws.half(U32.to_nat(x))) : Nat}
      Equal.sym(Nat, Laws.shr(p, Laws.half(U32.to_nat(x))), Laws.half(Laws.shr(p, U32.to_nat(x))), shr.half(p, U32.to_nat(x)))

# A word of n bits shifted down n is 0.
law w.shr_all:
  for +n: Nat
  for +w: Word(n)
  {Laws.shr(n, Word.to_nat(n, w)) == 0n : Nat}

def w.shr_all(n, w):
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{False{}, t}:
          %Equal.sym(Nat, Laws.half(Nat.double(Word.to_nat(p, t))), Word.to_nat(p, t), half.double(Word.to_nat(p, t))) :
            {Laws.shr(p, _) == 0n : Nat}
          w.shr_all(p, t)
        case WCon{True{}, t}:
          %Equal.sym(Nat, Laws.half(1n+Nat.double(Word.to_nat(p, t))), Word.to_nat(p, t), half.odd(Word.to_nat(p, t))) :
            {Laws.shr(p, _) == 0n : Nat}
          w.shr_all(p, t)

law u.shr32:
  for +x: U32
  {Laws.shr(32n, U32.to_nat(x)) == 0n : Nat}

def u.shr32(x):
  match x:
    case U32{w}:
      w.shr_all(32n, w)

law shr.comp:
  for +a: Nat
  for +b: Nat
  for +v: Nat
  {Laws.shr(a, Laws.shr(b, v)) == Laws.shr(Nat.add(b, a), v) : Nat}

def shr.comp(a, b, v):
  match b:
    case 0n:
      {==}
    case 1n+q:
      shr.comp(a, q, Laws.half(v))

law u.ne_zero:
  for +y: U32
  for +e: {U32.is_ne(y, 0) == False{} : Bool}
  {U32.to_nat(y) == 0n : Nat}

def u.ne_zero(y, e):
  +en = Equal.trans(Bool, Nat.is_eq(U32.to_nat(y), 0n), U32.is_eq(y, 0), True{},
    Equal.sym(Bool, U32.is_eq(y, 0), Nat.is_eq(U32.to_nat(y), 0n), A.u.is_eq_nat(y, 0)), not.f(U32.is_eq(y, 0), e))
  A.n.cmp_eq(U32.to_nat(y), 0n, en)

# log2.go's binary search, invariant: x is v shifted down b, and x < 2^(2^k).
# Then v shifted down 1 + (the result) is 0.
law lg.bound:
  for +k: Nat
  for +x: U32
  for +b: Nat
  for +v: Nat
  for +ek: {Nat.is_le(k, 5n) == True{} : Bool}
  for +ex: {U32.to_nat(x) == Laws.shr(b, v) : Nat}
  for +eh: {Laws.shr(U32.to_nat(U32.shln(1, k)), U32.to_nat(x)) == 0n : Nat}
  for d: Bool
  for +ed: {U32.is_ne(U32.shrn(x, U32.to_nat(U32.shln(1, C.pred(k)))), 0) == d : Bool}
  {Laws.shr(1n+U32.log2.go(k, x, b), v) == 0n : Nat}

def lg.bound(k, x, b, v, ek, ex, eh, d, ed):
  match k d:
    case 0n _:
      %Equal.sym(Nat, Laws.shr(b, Laws.half(v)), Laws.half(Laws.shr(b, v)), shr.half(b, v)) : {_ == 0n : Nat}
      %ex : {Laws.half(_) == 0n : Nat}
      eh
    case 1n+p True{}:
      +s = U32.to_nat(U32.shln(1, p))
      +ep = A.le.succ_le(p, 5n, ek)
      +d2 = Equal.trans(Nat, U32.to_nat(U32.shln(1, 1n+p)), Nat.double(s), Nat.add(s, s),
        A.u.shl_nat(U32.shln(1, p), A.sh.top(p, A.n.le_trans(p, 5n, 30n, ep, {==}))), A.double_add(s))
      +ex2 = Equal.trans(Nat, U32.to_nat(U32.shrn(x, s)), Laws.shr(s, U32.to_nat(x)), Laws.shr(Nat.add(b, s), v), u.shrn_nat(x, s),
        Equal.trans(Nat, Laws.shr(s, U32.to_nat(x)), Laws.shr(s, Laws.shr(b, v)), Laws.shr(Nat.add(b, s), v),
          Equal.cong(Nat, Nat, z => Laws.shr(s, z), U32.to_nat(x), Laws.shr(b, v), ex), shr.comp(s, b, v)))
      +eh2 = Equal.trans(Nat, Laws.shr(s, U32.to_nat(U32.shrn(x, s))), Laws.shr(s, Laws.shr(s, U32.to_nat(x))), 0n,
        Equal.cong(Nat, Nat, z => Laws.shr(s, z), U32.to_nat(U32.shrn(x, s)), Laws.shr(s, U32.to_nat(x)), u.shrn_nat(x, s)),
        Equal.trans(Nat, Laws.shr(s, Laws.shr(s, U32.to_nat(x))), Laws.shr(Nat.add(s, s), U32.to_nat(x)), 0n, shr.comp(s, s, U32.to_nat(x)),
          Equal.trans(Nat, Laws.shr(Nat.add(s, s), U32.to_nat(x)), Laws.shr(U32.to_nat(U32.shln(1, 1n+p)), U32.to_nat(x)), 0n,
            Equal.cong(Nat, Nat, z => Laws.shr(z, U32.to_nat(x)), Nat.add(s, s), U32.to_nat(U32.shln(1, 1n+p)), Equal.sym(Nat, U32.to_nat(U32.shln(1, 1n+p)), Nat.add(s, s), d2)), eh)))
      %Equal.sym(Bool, U32.is_ne(U32.shrn(x, s), 0), True{}, ed) :
        {Laws.shr(1n+U32.log2.go(p, U32.shrn(x, Nat.mul(s, U32.to_nat(Bool.to_u32(_)))), Nat.add(b, Nat.mul(s, U32.to_nat(Bool.to_u32(_))))), v) == 0n : Nat}
      %Equal.sym(Nat, Nat.mul(s, 1n), s, C.n.mul_one(s)) :
        {Laws.shr(1n+U32.log2.go(p, U32.shrn(x, _), Nat.add(b, _)), v) == 0n : Nat}
      lg.bound(p, U32.shrn(x, s), Nat.add(b, s), v, ep, ex2, eh2, U32.is_ne(U32.shrn(U32.shrn(x, s), U32.to_nat(U32.shln(1, C.pred(p)))), 0), {==})
    case 1n+p False{}:
      +s = U32.to_nat(U32.shln(1, p))
      +ep = A.le.succ_le(p, 5n, ek)
      +ex2 = Equal.trans(Nat, U32.to_nat(x), Laws.shr(b, v), Laws.shr(Nat.add(b, 0n), v), ex,
        Equal.cong(Nat, Nat, z => Laws.shr(z, v), b, Nat.add(b, 0n), Equal.sym(Nat, Nat.add(b, 0n), b, A.add_zero(b))))
      +eh2 = Equal.trans(Nat, Laws.shr(s, U32.to_nat(x)), U32.to_nat(U32.shrn(x, s)), 0n,
        Equal.sym(Nat, U32.to_nat(U32.shrn(x, s)), Laws.shr(s, U32.to_nat(x)), u.shrn_nat(x, s)), u.ne_zero(U32.shrn(x, s), ed))
      %Equal.sym(Bool, U32.is_ne(U32.shrn(x, s), 0), False{}, ed) :
        {Laws.shr(1n+U32.log2.go(p, U32.shrn(x, Nat.mul(s, U32.to_nat(Bool.to_u32(_)))), Nat.add(b, Nat.mul(s, U32.to_nat(Bool.to_u32(_))))), v) == 0n : Nat}
      %Equal.sym(Nat, Nat.mul(s, 0n), 0n, C.n.mul_zero(s)) :
        {Laws.shr(1n+U32.log2.go(p, U32.shrn(x, _), Nat.add(b, _)), v) == 0n : Nat}
      lg.bound(p, x, Nat.add(b, 0n), v, ep, ex2, eh2, U32.is_ne(U32.shrn(x, U32.to_nat(U32.shln(1, C.pred(p)))), 0), {==})

law u.is_le_nat:
  for +x: U32
  for +y: U32
  {U32.is_le(x, y) == Nat.is_le(U32.to_nat(x), U32.to_nat(y)) : Bool}

def u.is_le_nat(x, y):
  Equal.cong(Cmp, Bool, z => Cmp.is_le(z), U32.cmp(x, y), Nat.cmp(U32.to_nat(x), U32.to_nat(y)), A.u.cmp_nat(x, y))

law le1.sub:
  for +t: Nat
  for +e: {Nat.is_le(t, 1n) == True{} : Bool}
  {Nat.sub(t, 1n) == 0n : Nat}

def le1.sub(t, e):
  match t:
    case 0n:
      {==}
    case 1n+s:
      %Equal.sym(Nat, s, 0n, A.n.le_zero_eq(s, e)) : {Nat.sub(1n+_, 1n) == 0n : Nat}
      {==}

law nle1:
  for +t: Nat
  for +e: {Nat.is_le(t, 1n) == False{} : Bool}
  {Nat.is_le(1n, t) == True{} : Bool}

def nle1(t, e):
  match t:
    case 0n:
      Empty.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, A.absurd.tf(e))
    case 1n+s:
      C.n.le_zero(s)

law depth.b:
  for +n: U32
  for b: Bool
  for +eb: {U32.is_le(n, 1) == b : Bool}
  {Laws.shr(B3.depth.go(b, n), Nat.sub(U32.to_nat(n), 1n)) == 0n : Nat}

def depth.b(n, b, eb):
  match b:
    case True{}:
      le1.sub(U32.to_nat(n), Equal.trans(Bool, Nat.is_le(U32.to_nat(n), 1n), U32.is_le(n, 1), True{},
        Equal.sym(Bool, U32.is_le(n, 1), Nat.is_le(U32.to_nat(n), 1n), u.is_le_nat(n, 1)), eb))
    case False{}:
      +e1 = nle1(U32.to_nat(n), Equal.trans(Bool, Nat.is_le(U32.to_nat(n), 1n), U32.is_le(n, 1), False{},
        Equal.sym(Bool, U32.is_le(n, 1), Nat.is_le(U32.to_nat(n), 1n), u.is_le_nat(n, 1)), eb))
      lg.bound(5n, (n - 1 : U32), 0n, Nat.sub(U32.to_nat(n), 1n), {==}, A.u.tn_sub(n, 1, e1), u.shr32((n - 1 : U32)),
        U32.is_ne(U32.shrn((n - 1 : U32), 16n), 0), {==})

# A span's depth is enough for its chunks: nch - 1 < 2^depth(nch).
law depth.bound:
  for +n: U32
  {Laws.shr(B3.depth(n), Nat.sub(U32.to_nat(n), 1n)) == 0n : Nat}

def depth.bound(n):
  depth.b(n, U32.is_le(n, 1), {==})

# The tree code computes the model
# --------------------------------

law pow2.br:
  for +p: Nat
  {A.pow2(p) == Laws.pow2(p) : Nat}

def pow2.br(p):
  match p:
    case 0n:
      {==}
    case 1n+q:
      Equal.cong(Nat, Nat, z => Nat.double(z), A.pow2(q), Laws.pow2(q), pow2.br(q))

# blake3.bend's big (on U32) is the model's (on Nat).
law big.br:
  for +p: Nat
  for +n: U32
  for +ep: {Nat.is_le(p, 32n) == True{} : Bool}
  {B3.big(p, n) == Laws.big(p, U32.to_nat(n)) : Bool}

def big.br(p, n, ep):
  match p:
    case 0n:
      {==}
    case 1n+q:
      Equal.trans(Bool, U32.is_gt(n, U32.shln(1, q)), Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, q))), Nat.is_gt(U32.to_nat(n), Laws.pow2(q)),
        A.u.is_gt_nat(n, U32.shln(1, q)),
        Equal.cong(Nat, Bool, z => Nat.is_gt(U32.to_nat(n), z), U32.to_nat(U32.shln(1, q)), Laws.pow2(q),
          Equal.trans(Nat, U32.to_nat(U32.shln(1, q)), A.pow2(q), Laws.pow2(q), A.sh.nat(q, ep), pow2.br(q))))

law tips.full:
  for +p: Nat
  {Laws.tips(Laws.full(p)) == Laws.pow2(p) : Nat}

def tips.full(p):
  match p:
    case 0n:
      {==}
    case 1n+q:
      %Equal.sym(Nat, Laws.tips(Laws.full(q)), Laws.pow2(q), tips.full(q)) : {Nat.add(_, _) == Nat.double(Laws.pow2(q)) : Nat}
      Equal.sym(Nat, Nat.double(Laws.pow2(q)), Nat.add(Laws.pow2(q), Laws.pow2(q)), A.double_add(Laws.pow2(q)))

law fn.pow:
  for +p: Nat
  for +ep: {Nat.is_le(p, 31n) == True{} : Bool}
  {U32.from_nat(Laws.pow2(p)) == U32.shln(1, p) : U32}

def fn.pow(p, ep):
  %pow2.br(p) : {U32.from_nat(_) == U32.shln(1, p) : U32}
  %A.sh.nat(p, ep) : {U32.from_nat(_) == U32.shln(1, p) : U32}
  A.u.fn_tn(U32.shln(1, p))

# tree1 over n chunks from c is ev of the model's tree1 over U32.to_nat(n),
# node for node: the same split, at the same chunk.
law t1ev:
  for +k: Nat
  for -x: Array<U32>
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for b: Bool
  for +eb: {B3.big(k, n) == b : Bool}
  for w: C.Wits(x, 3n)
  for +hi: U32
  {B3.tree1(~Laws.share, k, b, (x, x), c, n, cb, hi, nch, last, rf) == Laws.ev(Laws.tree1(k, b, U32.to_nat(n)), (x, x), c, cb, hi, nch, last, rf) : B3.CV}

def t1ev(k, x, ek, c, n, cb, nch, last, rf, b, eb, w, hi):
  match k b:
    case 0n _:
      _ = w
      {==}
    case 1n+p False{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              _ = w3b
                              _ = z2
                              _ = z3
                              +ekp = A.le.succ_le(p, 32n, ek)
                              %big.br(p, n, ekp) :
                                {B3.tree1(~Laws.share, p, B3.big(p, n), (x, x), c, n, cb, hi, nch, last, rf) == Laws.ev(Laws.tree1(p, _, U32.to_nat(n)), (x, x), c, cb, hi, nch, last, rf) : B3.CV}
                              t1ev(p, x, ekp, c, n, cb, nch, last, rf, B3.big(p, n), {==}, C.tr(arr => C.Wits(arr, 3n), z1, x, ez10, C.wits(2n, z1)), hi)
    case 1n+p True{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      match w2b:
                        case (z3, w3):
                          match w3:
                            case (+ez30, w3b):
                              _ = w3b
                              +ekp = A.le.succ_le(p, 32n, ek)
                              +th = Equal.trans(Nat, U32.to_nat(U32.shln(1, p)), A.pow2(p), Laws.pow2(p), A.sh.nat(p, ek), pow2.br(p))
                              +lt = A.n.gt_lt(U32.to_nat(n), U32.to_nat(U32.shln(1, p)), Equal.trans(Bool, Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), U32.is_gt(n, U32.shln(1, p)), True{}, Equal.sym(Bool, U32.is_gt(n, U32.shln(1, p)), Nat.is_gt(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), A.u.is_gt_nat(n, U32.shln(1, p))), eb))
                              +tn2 = Equal.trans(Nat, U32.to_nat((n - U32.shln(1, p) : U32)), Nat.sub(U32.to_nat(n), U32.to_nat(U32.shln(1, p))), Nat.sub(U32.to_nat(n), Laws.pow2(p)), A.u.tn_sub(n, U32.shln(1, p), A.n.lt_to_le(U32.to_nat(U32.shln(1, p)), U32.to_nat(n), lt)), Equal.cong(Nat, Nat, z => Nat.sub(U32.to_nat(n), z), U32.to_nat(U32.shln(1, p)), Laws.pow2(p), th))
                              +bh = Equal.trans(Bool, B3.big(p, U32.shln(1, p)), Laws.big(p, U32.to_nat(U32.shln(1, p))), Laws.big(p, Laws.pow2(p)), big.br(p, U32.shln(1, p), ekp), Equal.cong(Nat, Bool, z => Laws.big(p, z), U32.to_nat(U32.shln(1, p)), Laws.pow2(p), th))
                              +bn2 = Equal.trans(Bool, B3.big(p, (n - U32.shln(1, p) : U32)), Laws.big(p, U32.to_nat((n - U32.shln(1, p) : U32))), Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), big.br(p, (n - U32.shln(1, p) : U32), ekp), Equal.cong(Nat, Bool, z => Laws.big(p, z), U32.to_nat((n - U32.shln(1, p) : U32)), Nat.sub(U32.to_nat(n), Laws.pow2(p)), tn2))
                              +tp = Equal.trans(Nat, Laws.tips(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p))), Laws.tips(Laws.full(p)), Laws.pow2(p), Equal.cong(Laws.Shape, Nat, s => Laws.tips(s), Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), Laws.full(p), t1.full(p)), tips.full(p))
                              +fh = fn.pow(p, ek)
                              %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, x, ez10, C.clone.dup(z1))) :
                                {B3.parent(B3.tree1(~Laws.share, p, B3.big(p, U32.shln(1, p)), _, c, U32.shln(1, p), cb, hi, nch, last, 0), B3.tree1(~Laws.share, p, B3.big(p, (n - U32.shln(1, p) : U32)), _, (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), _, c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), _, (c + U32.from_nat(Laws.tips(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)))) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %Equal.sym(B3.CV, B3.tree1(~Laws.share, p, B3.big(p, U32.shln(1, p)), (x, x), c, U32.shln(1, p), cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), t1ev(p, x, ekp, c, U32.shln(1, p), cb, nch, last, 0, B3.big(p, U32.shln(1, p)), {==}, C.tr(arr => C.Wits(arr, 3n), z2, x, ez20, C.wits(2n, z2)), hi)) :
                                {B3.parent(_, B3.tree1(~Laws.share, p, B3.big(p, (n - U32.shln(1, p) : U32)), (x, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.from_nat(Laws.tips(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)))) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %Equal.sym(B3.CV, B3.tree1(~Laws.share, p, B3.big(p, (n - U32.shln(1, p) : U32)), (x, x), (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), t1ev(p, x, ekp, (c + U32.shln(1, p) : U32), (n - U32.shln(1, p) : U32), cb, nch, last, 0, B3.big(p, (n - U32.shln(1, p) : U32)), {==}, C.tr(arr => C.Wits(arr, 3n), z3, x, ez30, C.wits(2n, z3)), hi)) :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), _, rf) == B3.parent(Laws.ev(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.from_nat(Laws.tips(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)))) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %Equal.sym(Nat, Laws.tips(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p))), Laws.pow2(p), tp) :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.from_nat(_) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %Equal.sym(U32, U32.from_nat(Laws.pow2(p)), U32.shln(1, p), fh) :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, Laws.big(p, Laws.pow2(p)), Laws.pow2(p)), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + _ : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %bh :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, _, Laws.pow2(p)), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %th :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), _), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, Laws.big(p, Nat.sub(U32.to_nat(n), Laws.pow2(p))), Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %bn2 :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, _, Nat.sub(U32.to_nat(n), Laws.pow2(p))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              %tn2 :
                                {B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), U32.to_nat((n - U32.shln(1, p) : U32))), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) == B3.parent(Laws.ev(Laws.tree1(p, B3.big(p, U32.shln(1, p)), U32.to_nat(U32.shln(1, p))), (x, x), c, cb, hi, nch, last, 0), Laws.ev(Laws.tree1(p, B3.big(p, (n - U32.shln(1, p) : U32)), _), (x, x), (c + U32.shln(1, p) : U32), cb, hi, nch, last, 0), rf) : B3.CV}
                              {==}

# BLAKE3's tree, for every span
# -----------------------------

# ref.go at a depth k enough for the span's 1 + q chunks is ev of BLAKE3's
# tree over them.
law spec.go:
  for +k: Nat
  for -a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +q: Nat
  for +ed: {Laws.shr(k, q) == 0n : Nat}
  for +ent: {U32.to_nat(nch) == 1n+q : Nat}
  for w: C.Wits(a, 2n)
  for +hi: U32
  {Laws.ref.go(k, a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(k, q, [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}

def spec.go(k, a, cb, nch, last, rf, ek, q, ed, ent, w, hi):
  match k:
    case 0n:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.chunk(a, 0, cb, hi, nch, last, rf) == Laws.ev(Laws.Tip{}, _, 0, cb, hi, nch, last, rf) : B3.CV}
                      {==}
    case 1n+p:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.tree1(~Laws.share, 1n+p, B3.big(1n+p, nch), _, 0, nch, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(1n+p, q, [])), _, 0, cb, hi, nch, last, rf) : B3.CV}
                      %Equal.sym(B3.CV, B3.tree1(~Laws.share, 1n+p, B3.big(1n+p, nch), (a, a), 0, nch, cb, hi, nch, last, rf), Laws.ev(Laws.tree1(1n+p, B3.big(1n+p, nch), U32.to_nat(nch)), (a, a), 0, cb, hi, nch, last, rf), t1ev(1n+p, a, ek, 0, nch, cb, nch, last, rf, B3.big(1n+p, nch), {==}, C.tr(arr => C.Wits(arr, 3n), z2, a, ez20, C.wits(2n, z2)), hi)) :
                        {_ == Laws.ev(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf) : B3.CV}
                      %Equal.sym(Bool, B3.big(1n+p, nch), Laws.big(1n+p, U32.to_nat(nch)), big.br(1n+p, nch, ek)) :
                        {Laws.ev(Laws.tree1(1n+p, _, U32.to_nat(nch)), (a, a), 0, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf) : B3.CV}
                      %Equal.sym(Nat, U32.to_nat(nch), 1n+q, ent) :
                        {Laws.ev(Laws.tree1(1n+p, Laws.big(1n+p, _), _), (a, a), 0, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf) : B3.CV}
                      %Equal.sym(Laws.Shape, Laws.tree1(1n+p, Laws.big(1n+p, 1n+q), 1n+q), Laws.tree(Laws.digits(1n+p, q, [])), t1d(1n+p, q, ed, Laws.big(1n+p, 1n+q), {==})) :
                        {Laws.ev(_, (a, a), 0, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(1n+p, q, [])), (a, a), 0, cb, hi, nch, last, rf) : B3.CV}
                      {==}

law ref.spec.b:
  for +nch: U32
  for b: Bool
  for +eb: {U32.is_le(nch, 1) == b : Bool}
  for -a: Array<U32>
  for +cb: U32
  for +last: U32
  for +rf: U32
  for w: C.Wits(a, 2n)
  for +hi: U32
  {Laws.ref.at(a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}

def ref.spec.b(nch, b, eb, a, cb, last, rf, w, hi):
  match b:
    case True{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      %Equal.sym(Bool, U32.is_le(nch, 1), True{}, eb) :
                        {Laws.ref.go(B3.depth.go(_, nch), a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth.go(_, nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, a), (a, a), C.tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z1, a, ez10, C.clone.dup(z1))) :
                        {B3.chunk(a, 0, cb, hi, nch, last, rf) == Laws.ev(Laws.Tip{}, _, 0, cb, hi, nch, last, rf) : B3.CV}
                      {==}
    case False{}:
      match w:
        case (z1, w1):
          match w1:
            case (+ez10, w1b):
              match w1b:
                case (z2, w2):
                  match w2:
                    case (+ez20, w2b):
                      _ = w2b
                      _ = z2
                      +e1 = nle1(U32.to_nat(nch), Equal.trans(Bool, Nat.is_le(U32.to_nat(nch), 1n), U32.is_le(nch, 1), False{}, Equal.sym(Bool, U32.is_le(nch, 1), Nat.is_le(U32.to_nat(nch), 1n), u.is_le_nat(nch, 1)), eb))
                      spec.go(B3.depth(nch), a, cb, nch, last, rf, C.depth.le32(nch), Nat.sub(U32.to_nat(nch), 1n), depth.bound(nch), Equal.sym(Nat, 1n+Nat.sub(U32.to_nat(nch), 1n), U32.to_nat(nch), A.n.add_sub(1n, U32.to_nat(nch), e1)), C.tr(arr => C.Wits(arr, 2n), z1, a, ez10, C.wits(1n, z1)), hi)

# The scalar tree over a span is BLAKE3's tree over its chunks.
law ref.spec:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  {Laws.ref.at(a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}

def ref.spec(a, cb, nch, last, rf, hi):
  ref.spec.b(nch, U32.is_le(nch, 1), {==}, a, cb, last, rf, C.wits(1n, a), hi)

law cpu.spec:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  {B3.hash.at(~Laws.share, a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}

def cpu.spec.h(-a: Array<U32>, +cb: U32, +nch: U32, +last: U32, +rf: U32, w: C.Wits(a, 2n), +hi: U32) -> {B3.hash.at(~Laws.share, a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}:
  match w:
    case (z1, w1):
      match w1:
        case (+ez10, w1b):
          match w1b:
            case (z2, w2):
              match w2:
                case (+ez20, w2b):
                  _ = w2b
                  Equal.trans(B3.CV, B3.hash.at(~Laws.share, a, cb, hi, nch, last, rf), Laws.ref.at(a, cb, hi, nch, last, rf), Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf),
                    C.tr(arr => {B3.hash.at(~Laws.share, arr, cb, hi, nch, last, rf) == Laws.ref.at(arr, cb, hi, nch, last, rf) : B3.CV}, z1, a, ez10, C.cpu.at(z1, cb, nch, last, rf, hi)),
                    C.tr(arr => {Laws.ref.at(arr, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(arr), 0, cb, hi, nch, last, rf) : B3.CV}, z2, a, ez20, ref.spec(z2, cb, nch, last, rf, hi)))

def cpu.spec(a, cb, nch, last, rf, hi):
  cpu.spec.h(a, cb, nch, last, rf, C.wits(1n, a), hi)

law gpu.spec:
  for a: Array<U32>
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +hi: U32
  {B3.hash1.at(~Laws.share, a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}

def gpu.spec.h(-a: Array<U32>, +cb: U32, +nch: U32, +last: U32, +rf: U32, w: C.Wits(a, 2n), +hi: U32) -> {B3.hash1.at(~Laws.share, a, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf) : B3.CV}:
  match w:
    case (z1, w1):
      match w1:
        case (+ez10, w1b):
          match w1b:
            case (z2, w2):
              match w2:
                case (+ez20, w2b):
                  _ = w2b
                  Equal.trans(B3.CV, B3.hash1.at(~Laws.share, a, cb, hi, nch, last, rf), Laws.ref.at(a, cb, hi, nch, last, rf), Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(a), 0, cb, hi, nch, last, rf),
                    C.tr(arr => {B3.hash1.at(~Laws.share, arr, cb, hi, nch, last, rf) == Laws.ref.at(arr, cb, hi, nch, last, rf) : B3.CV}, z1, a, ez10, G.gpu.at(z1, cb, nch, last, rf, hi)),
                    C.tr(arr => {Laws.ref.at(arr, cb, hi, nch, last, rf) == Laws.ev(Laws.tree(Laws.digits(B3.depth(nch), Nat.sub(U32.to_nat(nch), 1n), [])), Laws.share(arr), 0, cb, hi, nch, last, rf) : B3.CV}, z2, a, ez20, ref.spec(z2, cb, nch, last, rf, hi)))

def gpu.spec(a, cb, nch, last, rf, hi):
  gpu.spec.h(a, cb, nch, last, rf, C.wits(1n, a), hi)
