def leaf32.eq.h(-x: Array<U32>, +c: U32, +cb: U32, +nch: U32, +last: U32, +rf: U32, +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 32n), U32.to_nat(nch)) == True{} : Bool}, +ef: {B3.full((c + 32 : U32), nch, last) == True{} : Bool}, r: Wits(x, 10n)) -> {B3.leaf32(x, c, (cb + c : U32), rf) == B3.tree1(~Laws.share, 5n, True{}, (x, x), c, 32, cb, nch, last, rf) : B3.CV}:
