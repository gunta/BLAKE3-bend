# The 8-lane path
# ---------------

law compress8.lane:
  for +l: Laws.Lane
  for +cv: B3.CV8
  for +m: B3.B128
  for +ctr: U32
  for +step: U32
  for +blen: U32
  for +flags: U32
  {Laws.cv.at(l, B3.compress8(cv, m, ctr, step, blen, flags)) ==
    B3.compress(Laws.cv.at(l, cv), Laws.m.at(l, m), (ctr + (step * Laws.Lane.u32(l) : U32) : U32),
      0, blen, flags) : B3.CV}

