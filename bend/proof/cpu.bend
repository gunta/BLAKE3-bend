  for +m1: B3.M16
  for +m2: B3.M16
  for +m3: B3.M16
  for +m4: B3.M16
  for +m5: B3.M16
  for +m6: B3.M16
  for +m7: B3.M16
  for +em: {Pair.snd(Array<U32>, B3.B128, r) == B3.b128.of(m0, m1, m2, m3, m4, m5, m6, m7) : B3.B128}
  for +w: U32
  for +cv: B3.CV8
  for +ctr: U32
  for +fl: U32
  for bun: Bun(a0, p)
  {Laws.cv.at(Laws.L3{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go(1n+p, r, w, cv, ctr, fl))) ==
    B3.chunk.fin(B3.chunk.go(p, (a0, m3), (w + 768 : U32), Laws.cv.at(Laws.L3{}, cv), (ctr + 3 : U32), fl, B3.CHUNK_END(), 64)) : B3.CV}

