  %Equal.sym(Array<U32> & B3.B128, B3.ld8(a, w), (a, B3.b128.of(Pair.snd(Array<U32>, B3.M16, B3.ld(a, w)), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 256 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 512 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 768 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 1024 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 1280 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 1536 : U32))), Pair.snd(Array<U32>, B3.M16, B3.ld(a, (w + 1792 : U32))))), ld8.words(a, w)) :
    {_ == (a, Pair.snd(Array<U32>, B3.B128, _)) : Array<U32> & B3.B128}
  {==}

