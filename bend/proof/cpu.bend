# 32 full chunks on the 8-lane path: four groups' 8-chunk leaves under two
# levels of parents.
law leaf32.split:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  for +rf: U32
  {B3.leaf32(a, c, t, rf) == B3.parent(B3.parent(B3.leaf8(a, c, t, 0), B3.leaf8(a, (c + 8 : U32), (t + 8 : U32), 0), 0), B3.parent(B3.leaf8(a, (c + 16 : U32), (t + 16 : U32), 0), B3.leaf8(a, (c + 24 : U32), (t + 24 : U32), 0), 0), rf) : B3.CV}

def leaf32.split(a, c, t, rf):
  leaf32.split.h(a, c, t, rf, wits(7n, a))

law le.add_r:
  for +j: Nat
  for +n: Nat
  {Nat.is_le(j, Nat.add(j, n)) == True{} : Bool}

def le.add_r(j, n):
  match j:
    case 0n:
      match n:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      le.add_r(p, n)

# c + j + n <= nch when c + m <= nch and j + n <= m.
law inv.off:
  for +c: U32
  for +nch: U32
  for +j: U32
  for +n: Nat
  for +m: Nat
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), m), U32.to_nat(nch)) == True{} : Bool}
  for +ej: {Nat.is_le(Nat.add(U32.to_nat(j), n), m) == True{} : Bool}
  {Nat.is_le(Nat.add(U32.to_nat((c + j : U32)), n), U32.to_nat(nch)) == True{} : Bool}

def inv.off(c, nch, j, n, m, inv, ej):
  +cj = Nat.add(U32.to_nat(c), U32.to_nat(j))
  +jle = A.n.le_trans(U32.to_nat(j), Nat.add(U32.to_nat(j), n), m, le.add_r(U32.to_nat(j), n), ej)
  +le = A.n.le_trans(cj, Nat.add(U32.to_nat(c), m), U32.to_nat(nch), A.n.add_le(U32.to_nat(c), U32.to_nat(j), m, jle), inv)
  %Equal.sym(Nat, U32.to_nat((c + j : U32)), cj, A.u.tn_add(c, j, nch, le)) : {Nat.is_le(Nat.add(_, n), U32.to_nat(nch)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(c), U32.to_nat(j)), n), Nat.add(U32.to_nat(c), Nat.add(U32.to_nat(j), n)), A.add_assoc(U32.to_nat(c), U32.to_nat(j), n)) : {Nat.is_le(_, U32.to_nat(nch)) == True{} : Bool}
  A.n.le_trans(Nat.add(U32.to_nat(c), Nat.add(U32.to_nat(j), n)), Nat.add(U32.to_nat(c), m), U32.to_nat(nch), A.n.add_le(U32.to_nat(c), Nat.add(U32.to_nat(j), n), m, ej), inv)

# c + j < nch when c + m <= nch and j < m.
law lt.off:
  for +c: U32
  for +nch: U32
  for +j: U32
  for +m: Nat
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), m), U32.to_nat(nch)) == True{} : Bool}
  for +ej: {Nat.is_lt(U32.to_nat(j), m) == True{} : Bool}
  {U32.is_lt((c + j : U32), nch) == True{} : Bool}

def lt.off(c, nch, j, m, inv, ej):
  +cj = Nat.add(U32.to_nat(c), U32.to_nat(j))
  +le = A.n.le_trans(cj, Nat.add(U32.to_nat(c), m), U32.to_nat(nch), A.n.add_le(U32.to_nat(c), U32.to_nat(j), m, A.n.lt_to_le(U32.to_nat(j), m, ej)), inv)
  %Equal.sym(Bool, U32.is_lt((c + j : U32), nch), Nat.is_lt(U32.to_nat((c + j : U32)), U32.to_nat(nch)), A.u.is_lt_nat((c + j : U32), nch)) : {_ == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat((c + j : U32)), cj, A.u.tn_add(c, j, nch, le)) : {Nat.is_lt(_, U32.to_nat(nch)) == True{} : Bool}
  A.n.lt_le(cj, Nat.add(U32.to_nat(c), m), U32.to_nat(nch), A.n.add_lt(U32.to_nat(c), U32.to_nat(j), m, ej), inv)

law full.from_lt:
  for +e: U32
  for +nch: U32
  for +last: U32
  for +el: {U32.is_lt(e, nch) == True{} : Bool}
  {B3.full(e, nch, last) == True{} : Bool}

def full.from_lt(e, nch, last, el):
  %Equal.sym(Bool, U32.is_lt(e, nch), True{}, el) : {(_ || (U32.is_eq(e, nch) && U32.is_eq(last, 1024))) == True{} : Bool}
  {==}

def tree1.d5.h(-x: Array<U32>, +c: U32, +cb: U32, +nch: U32, +last: U32, +rf: U32, r: Wits(x, 2n)) -> {B3.tree1(~Laws.share, 5n, True{}, (x, x), c, 32, cb, nch, last, rf) == B3.parent(B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), c, 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 8 : U32), 8, cb, nch, last, 0), 0), B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 16 : U32), 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), ((c + 16 : U32) + 8 : U32), 8, cb, nch, last, 0), 0), rf) : B3.CV}:
