# Many copies
# -----------

def Wits(-a: Array<U32>, n: Nat) -> Type:
  match n:
    case 0n:
      Unit
    case 1n+p:
      Exists(Array<U32>, x => {x == a : Array<U32>} & Wits(a, p))

def wits.grow2(-a: Array<U32>, +p: Nat, -x: Array<U32>, +ex: {x == a : Array<U32>}, r: Two(x), rest: Wits(a, p)) -> Wits(a, 2n+p):
  match r:
    case (y, r2):
      match r2:
        case (z, e):
          match e:
            case (ey, ez):
              (y, (eq.trans(y, x, a, ey, ex), (z, (eq.trans(z, x, a, ez, ex), rest))))

def wits.grow(-a: Array<U32>, +p: Nat, w: Wits(a, 1n+p)) -> Wits(a, 2n+p):
  match w:
    case (x, w2):
      match w2:
        case (ex, rest):
          wits.grow2(a, p, x, ex, dup.w(x), rest)

law wits:
  for +n: Nat
  for a: Array<U32>
  Wits(a, 1n+n)

def wits(n, a):
  match n:
    case 0n:
      (a, ({==}, Unit{}))
    case 1n+p:
      wits.grow(a, p, wits(p, a))

# The 8-lane loader hands its array back.
law ld8.fst:
  for a: Array<U32>
  for +w: U32
  {Pair.fst(Array<U32>, B3.B128, B3.ld8(a, w)) == a : Array<U32>}

