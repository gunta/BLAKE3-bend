  for +m2: B3.M16
  for +m3: B3.M16
  for +m4: B3.M16
  for +m5: B3.M16
  for +m6: B3.M16
  for +m7: B3.M16
  for +em: {Pair.snd(Array<U32>, B3.B128, r) == B3.b128.of(m0, m1, m2, m3, m4, m5, m6, m7) : B3.B128}
  for +w: U32
  for +cv: B3.CV8
  for +ctr: U32
  for +fl: U32
  for bun: Bun(a0, p)
  {Laws.cv.at(Laws.L2{}, Pair.snd(Array<U32>, B3.CV8, B3.c8.go(1n+p, r, w, cv, ctr, fl))) ==
