                          %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z2, x, ez20, clone.dup(z2))) :
                            {B3.parent(B3.parent(B3.tree1(~Laws.share, 1n, True{}, _, c, 2, cb, nch, last, 0), B3.tree1(~Laws.share, 1n, True{}, _, (c + 2 : U32), 2, cb, nch, last, 0), 0), B3.parent(B3.tree1(~Laws.share, 1n, True{}, _, (c + 4 : U32), 2, cb, nch, last, 0), B3.tree1(~Laws.share, 1n, True{}, _, ((c + 4 : U32) + 2 : U32), 2, cb, nch, last, 0), 0), rf) == B3.parent(B3.parent(B3.parent(B3.chunk(x, c, cb, nch, last, 0), B3.chunk(x, (c + 1 : U32), cb, nch, last, 0), 0), B3.parent(B3.chunk(x, (c + 2 : U32), cb, nch, last, 0), B3.chunk(x, ((c + 2 : U32) + 1 : U32), cb, nch, last, 0), 0), 0), B3.parent(B3.parent(B3.chunk(x, (c + 4 : U32), cb, nch, last, 0), B3.chunk(x, ((c + 4 : U32) + 1 : U32), cb, nch, last, 0), 0), B3.parent(B3.chunk(x, ((c + 4 : U32) + 2 : U32), cb, nch, last, 0), B3.chunk(x, (((c + 4 : U32) + 2 : U32) + 1 : U32), cb, nch, last, 0), 0), 0), rf) : B3.CV}
                          %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), tr(arr => {Array.clone(U32, arr) == (arr, arr) : Array<U32> & Array<U32>}, z3, x, ez30, clone.dup(z3))) :
