# One copy per block left.
def Bun1(-a: Array<U32>, p: Nat) -> Type:
  match p:
    case 0n:
      Unit
    case 1n+q:
      Wits(a, 1n) & Bun1(a, q)

def BunS1(-a: Array<U32>, p: Nat) -> Type:
  Exists(Array<U32>, s => {s == a : Array<U32>} & Bun1(a, p))

def bun1.add2(-a: Array<U32>, +q: Nat, -s: Array<U32>, +es: {s == a : Array<U32>}, w: Wits(s, 2n), rest: Bun1(a, q)) -> BunS1(a, 1n+q):
  match w:
    case (s2, w2):
      match w2:
        case (es2, lvl):
          (s2, (eq.trans(s2, s, a, es2, es), (tr(c => Wits(c, 1n), s, a, es, lvl), rest)))

def bun1.add(-a: Array<U32>, +q: Nat, r: BunS1(a, q)) -> BunS1(a, 1n+q):
  match r:
    case (s, r2):
      match r2:
        case (es, rest):
          bun1.add2(a, q, s, es, wits(1n, s), rest)

law bun1:
  for +p: Nat
  for a: Array<U32>
  BunS1(a, p)

def bun1(p, a):
  match p:
    case 0n:
      (a, ({==}, Unit{}))
    case 1n+q:
      bun1.add(a, q, bun1(q, a))

# The 8-lane chunk loop hands its array back.
law c8.eta:
  for +n: Nat
  for -a0: Array<U32>
  for r: Array<U32> & B3.B128
  for +er: {Pair.fst(Array<U32>, B3.B128, r) == a0 : Array<U32>}
  for +w: U32
  for +cv: B3.CV8
  for +ctr: U32
  for +fl: U32
  for bun: Bun1(a0, n)
  {B3.c8.go(n, r, w, cv, ctr, fl) == (a0, Pair.snd(Array<U32>, B3.CV8, B3.c8.go(n, r, w, cv, ctr, fl))) : Array<U32> & B3.CV8}

def c8.eta(n, a0, r, er, w, cv, ctr, fl, bun):
  match n:
    case 0n:
      match r:
        case (a, +m):
          _ = bun
          %er : {(a, cv) == (_, cv) : Array<U32> & B3.CV8}
          {==}
    case 1n+q:
      match r:
        case (a, +m):
          match bun:
            case (lvl, rest):
              match lvl:
                case (x1, l1):
                  match l1:
                    case (+e1, l1b):
                      _ = l1b
                      +f = eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(a, (w + B3.step(q) : U32))), a, a0, tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (w + B3.step(q) : U32))) == arr : Array<U32>}, x1, a,
                        eq.trans(x1, a0, a, e1, Equal.sym(Array<U32>, a, a0, er)), ld8.fst(x1, (w + B3.step(q) : U32))), er)
                      c8.eta(q, a0, B3.ld8(a, (w + B3.step(q) : U32)), f, (w + B3.step(q) : U32), B3.compress8(cv, m, ctr, 1, 64, (fl .|. B3.endf(q) : U32)), ctr, 0, rest)

def group.eta.h2(-a: Array<U32>, +c: U32, +t: U32, -s: Array<U32>, +es: {s == a : Array<U32>}, r: Wits(s, 2n), bb: Bun1(a, 16n)) -> {B3.group(a, c, t) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))) : Array<U32> & B3.CV8}:
  match r:
    case (x1, r1):
      match r1:
        case (+ex1o, r1b):
          match r1b:
            case (x2, r2):
              match r2:
                case (+ex2o, r2b):
                  _ = r2b
                  +ex1 = eq.trans(x1, s, a, ex1o, es)
                  +ex2 = eq.trans(x2, s, a, ex2o, es)
                  +f = eq.trans(Pair.fst(Array<U32>, B3.B128, B3.ld8(x1, (c << 8n : U32))), x1, a, tr(arr => {Pair.fst(Array<U32>, B3.B128, B3.ld8(arr, (c << 8n : U32))) == arr : Array<U32>}, x2, x1, eq.trans(x2, a, x1, ex2, Equal.sym(Array<U32>, x1, a, ex1)), ld8.fst(x2, (c << 8n : U32))), ex1)
                  tr(arr => {B3.c8.go(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.IV8(), t, B3.CHUNK_START()) == (a, Pair.snd(Array<U32>, B3.CV8, B3.c8.go(16n, B3.ld8(arr, (c << 8n : U32)), (c << 8n : U32), B3.IV8(), t, B3.CHUNK_START()))) : Array<U32> & B3.CV8}, x1, a, ex1,
                    c8.eta(16n, a, B3.ld8(x1, (c << 8n : U32)), f, (c << 8n : U32), B3.IV8(), t, B3.CHUNK_START(), bb))

def group.eta.h1(-a: Array<U32>, +c: U32, +t: U32, r: BunS1(a, 16n)) -> {B3.group(a, c, t) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))) : Array<U32> & B3.CV8}:
  match r:
    case (s, r2):
      match r2:
        case (+es, bb):
          group.eta.h2(a, c, t, s, es, wits(1n, s), bb)

# A group hands its array back.
law group.eta:
  for a: Array<U32>
  for +c: U32
  for +t: U32
  {B3.group(a, c, t) == (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))) : Array<U32> & B3.CV8}

def group.eta(a, c, t):
  group.eta.h1(a, c, t, bun1(16n, a))

law fold.par2:
  for +g0: B3.CV8
  for +g1: B3.CV8
  for +g2: B3.CV8
  for +g3: B3.CV8
  for +rf: U32
  {B3.fold8(B3.par8(B3.par8(g0, g1), B3.par8(g2, g3)), rf) == B3.parent(B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), B3.parent(B3.fold8(g2, 0), B3.fold8(g3, 0), 0), rf) : B3.CV}

def fold.par2(g0, g1, g2, g3, rf):
  %Equal.sym(B3.CV, B3.fold8(B3.par8(B3.par8(g0, g1), B3.par8(g2, g3)), rf), B3.parent(B3.fold8(B3.par8(g0, g1), 0), B3.fold8(B3.par8(g2, g3), 0), rf), fold.par(B3.par8(g0, g1), B3.par8(g2, g3), rf)) :
    {_ == B3.parent(B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), B3.parent(B3.fold8(g2, 0), B3.fold8(g3, 0), 0), rf) : B3.CV}
  %Equal.sym(B3.CV, B3.fold8(B3.par8(g0, g1), 0), B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), fold.par(g0, g1, 0)) :
    {B3.parent(_, B3.fold8(B3.par8(g2, g3), 0), rf) == B3.parent(B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), B3.parent(B3.fold8(g2, 0), B3.fold8(g3, 0), 0), rf) : B3.CV}
  %Equal.sym(B3.CV, B3.fold8(B3.par8(g2, g3), 0), B3.parent(B3.fold8(g2, 0), B3.fold8(g3, 0), 0), fold.par(g2, g3, 0)) :
    {B3.parent(B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), _, rf) == B3.parent(B3.parent(B3.fold8(g0, 0), B3.fold8(g1, 0), 0), B3.parent(B3.fold8(g2, 0), B3.fold8(g3, 0), 0), rf) : B3.CV}
  {==}

def leaf32.split.h(-a: Array<U32>, +c: U32, +t: U32, +rf: U32, r: Wits(a, 8n)) -> {B3.leaf32(a, c, t, rf) == B3.parent(B3.parent(B3.leaf8(a, c, t, 0), B3.leaf8(a, (c + 8 : U32), (t + 8 : U32), 0), 0), B3.parent(B3.leaf8(a, (c + 16 : U32), (t + 16 : U32), 0), B3.leaf8(a, (c + 24 : U32), (t + 24 : U32), 0), 0), rf) : B3.CV}:
  match r:
    case (u0, r1):
      match r1:
        case (+eu00, r1b):
          match r1b:
            case (u1, r2):
              match r2:
                case (+eu10, r2b):
                  match r2b:
                    case (u2, r3):
                      match r3:
                        case (+eu20, r3b):
                          match r3b:
                            case (u3, r4):
                              match r4:
                                case (+eu30, r4b):
                                  match r4b:
                                    case (y0, r5):
                                      match r5:
                                        case (+ey00, r5b):
                                          match r5b:
                                            case (y1, r6):
                                              match r6:
                                                case (+ey10, r6b):
                                                  match r6b:
                                                    case (y2, r7):
                                                      match r7:
                                                        case (+ey20, r7b):
                                                          match r7b:
                                                            case (y3, r8):
                                                              match r8:
                                                                case (+ey30, r8b):
                                                                  _ = r8b
                                                                  %Equal.sym(Array<U32> & B3.CV8, B3.group(a, c, t), (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))), tr(arr => {B3.group(arr, c, t) == (arr, Pair.snd(Array<U32>, B3.CV8, B3.group(arr, c, t))) : Array<U32> & B3.CV8}, u0, a, eu00, group.eta(u0, c, t))) :
                                                                    {B3.leaf8.fin(B3.leaf32.s0(_, c, t), rf) == B3.parent(B3.parent(B3.leaf8.fin(_, 0), B3.leaf8(a, (c + 8 : U32), (t + 8 : U32), 0), 0), B3.parent(B3.leaf8(a, (c + 16 : U32), (t + 16 : U32), 0), B3.leaf8(a, (c + 24 : U32), (t + 24 : U32), 0), 0), rf) : B3.CV}
                                                                  %Equal.sym(Array<U32> & B3.CV8, B3.group(a, (c + 8 : U32), (t + 8 : U32)), (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, (c + 8 : U32), (t + 8 : U32)))), tr(arr => {B3.group(arr, (c + 8 : U32), (t + 8 : U32)) == (arr, Pair.snd(Array<U32>, B3.CV8, B3.group(arr, (c + 8 : U32), (t + 8 : U32)))) : Array<U32> & B3.CV8}, u1, a, eu10, group.eta(u1, (c + 8 : U32), (t + 8 : U32)))) :
                                                                    {B3.leaf8.fin(B3.leaf32.s1(_, c, t, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))), rf) == B3.parent(B3.parent(B3.leaf8.fin((a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))), 0), B3.leaf8.fin(_, 0), 0), B3.parent(B3.leaf8(a, (c + 16 : U32), (t + 16 : U32), 0), B3.leaf8(a, (c + 24 : U32), (t + 24 : U32), 0), 0), rf) : B3.CV}
                                                                  %Equal.sym(Array<U32> & B3.CV8, B3.group(a, (c + 16 : U32), (t + 16 : U32)), (a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, (c + 16 : U32), (t + 16 : U32)))), tr(arr => {B3.group(arr, (c + 16 : U32), (t + 16 : U32)) == (arr, Pair.snd(Array<U32>, B3.CV8, B3.group(arr, (c + 16 : U32), (t + 16 : U32)))) : Array<U32> & B3.CV8}, u2, a, eu20, group.eta(u2, (c + 16 : U32), (t + 16 : U32)))) :
                                                                    {B3.leaf8.fin(B3.leaf32.s2(_, c, t, B3.par8(Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t)), Pair.snd(Array<U32>, B3.CV8, B3.group(a, (c + 8 : U32), (t + 8 : U32))))), rf) == B3.parent(B3.parent(B3.leaf8.fin((a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, c, t))), 0), B3.leaf8.fin((a, Pair.snd(Array<U32>, B3.CV8, B3.group(a, (c + 8 : U32), (t + 8 : U32)))), 0), 0), B3.parent(B3.leaf8.fin(_, 0), B3.leaf8(a, (c + 24 : U32), (t + 24 : U32), 0), 0), rf) : B3.CV}
