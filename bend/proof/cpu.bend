  {==}

# A chunk that is not the last holds 1024 bytes, whatever last is.
law chunk.full:
  for -a: Array<U32>
  for +c: U32
  for +cb: U32
  for +last: U32
  for +rf: U32
  {chunk.b(a, c, cb, last, rf, False{}) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(a, (c << 8n : U32)), (c << 8n : U32), B3.IV(), (cb + c : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. rf : U32), 64)) : B3.CV}

def chunk.full(a, c, cb, last, rf):
  %Equal.sym(U32, (last .&. 0 : U32), 0, A.u.and_zero(last)) :
    {chunk.r(a, c, cb, rf, (_ .|. (1024 .&. U32.not(0) : U32) : U32)) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(a, (c << 8n : U32)), (c << 8n : U32), B3.IV(), (cb + c : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. rf : U32), 64)) : B3.CV}
  {==}

# The last chunk, when it holds 1024 bytes.
law chunk.last:
  for -a: Array<U32>
  for +c: U32
  for +cb: U32
  for +rf: U32
  {chunk.b(a, c, cb, 1024, rf, True{}) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(a, (c << 8n : U32)), (c << 8n : U32), B3.IV(), (cb + c : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. rf : U32), 64)) : B3.CV}

