# fold8 of a par8 level is the parent of the two halves' folds.
law fold.par:
  for +p: B3.CV8
  for +q: B3.CV8
  for +rf: U32
  {B3.fold8(B3.par8(p, q), rf) == B3.parent(B3.fold8(p, 0), B3.fold8(q, 0), rf) : B3.CV}

def fold.par(p, q, rf):
  %Equal.sym(B3.CV, B3.fold8(B3.par8(p, q), rf), B3.parent(B3.parent(B3.parent(Laws.cv.at(Laws.L0{}, B3.par8(p, q)), Laws.cv.at(Laws.L1{}, B3.par8(p, q)), 0), B3.parent(Laws.cv.at(Laws.L2{}, B3.par8(p, q)), Laws.cv.at(Laws.L3{}, B3.par8(p, q)), 0), 0), B3.parent(B3.parent(Laws.cv.at(Laws.L4{}, B3.par8(p, q)), Laws.cv.at(Laws.L5{}, B3.par8(p, q)), 0), B3.parent(Laws.cv.at(Laws.L6{}, B3.par8(p, q)), Laws.cv.at(Laws.L7{}, B3.par8(p, q)), 0), 0), rf), fold8.lanes(B3.par8(p, q), rf)) :
    {_ == B3.parent(B3.fold8(p, 0), B3.fold8(q, 0), rf) : B3.CV}
  %Equal.sym(B3.CV, Laws.cv.at(Laws.L0{}, B3.par8(p, q)), Laws.par.ref(Laws.L0{}, p, q), par8.lane(Laws.L0{}, p, q)) :
    {B3.parent(B3.parent(B3.parent(_, Laws.cv.at(Laws.L1{}, B3.par8(p, q)), 0), B3.parent(Laws.cv.at(Laws.L2{}, B3.par8(p, q)), Laws.cv.at(Laws.L3{}, B3.par8(p, q)), 0), 0), B3.parent(B3.parent(Laws.cv.at(Laws.L4{}, B3.par8(p, q)), Laws.cv.at(Laws.L5{}, B3.par8(p, q)), 0), B3.parent(Laws.cv.at(Laws.L6{}, B3.par8(p, q)), Laws.cv.at(Laws.L7{}, B3.par8(p, q)), 0), 0), rf) == B3.parent(B3.fold8(p, 0), B3.fold8(q, 0), rf) : B3.CV}
