                          +ekp = A.le.succ_le(p, 32n, ek)
                          +kd = Equal.trans(U32, (ku - 1 : U32), (U32.from_nat(1n+p) - 1 : U32), U32.from_nat(p), Equal.cong(U32, U32, z => (z - 1 : U32), ku, U32.from_nat(1n+p), eku), A.u.down(p))
                          +tp = Equal.trans(Nat, U32.to_nat((ku - 1 : U32)), U32.to_nat(U32.from_nat(p)), p, Equal.cong(U32, Nat, z => U32.to_nat(z), (ku - 1 : U32), U32.from_nat(p), kd), A.u.tn_fn(p, 32, ekp))
                          %Equal.sym(Nat, U32.to_nat((ku - 1 : U32)), p, tp) :
                            {B3.tree8(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, U32.is_gt(n, U32.shln(1, _))), Array.clone(U32, x), c, n, cb, nch, last, rf) == B3.tree1(~Laws.share, 1n+p, B3.big(1n+p, n), Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}
                          %Equal.sym(Bool, B3.big(1n+p, n), False{}, eb) :
                            {B3.tree8(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, _), Array.clone(U32, x), c, n, cb, nch, last, rf) == B3.tree1(~Laws.share, 1n+p, _, Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}
                          cpu.tree(p, x, (x1, (x2, (e1, (e2, ecl)))), (ku - 1 : U32), kd, ekp, c, n, cb, nch, last, rf, inv, B3.big(p, n), {==}, (U32.is_eq(n, U32.shln(1, U32.to_nat((ku - 1 : U32)))) && B3.full((c + n : U32), nch, last)), {==}, U32.is_eq((ku - 1 : U32), 5), {==}, U32.is_eq((ku - 1 : U32), 3), {==})
                        case True{} False{} _ _:
                          +ekp = A.le.succ_le(p, 32n, ek)
                          +kd = Equal.trans(U32, (ku - 1 : U32), (U32.from_nat(1n+p) - 1 : U32), U32.from_nat(p), Equal.cong(U32, U32, z => (z - 1 : U32), ku, U32.from_nat(1n+p), eku), A.u.down(p))
                          +tp = Equal.trans(Nat, U32.to_nat((ku - 1 : U32)), U32.to_nat(U32.from_nat(p)), p, Equal.cong(U32, Nat, z => U32.to_nat(z), (ku - 1 : U32), U32.from_nat(p), kd), A.u.tn_fn(p, 32, ekp))
                          %Equal.sym(Nat, U32.to_nat((ku - 1 : U32)), p, tp) :
                            {B3.tree8(~Laws.share, 1n+p, ku, B3.kind.big(ku, n, c, nch, last, U32.is_gt(n, U32.shln(1, _))), Array.clone(U32, x), c, n, cb, nch, last, rf) == B3.tree1(~Laws.share, 1n+p, B3.big(1n+p, n), Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}
                          %Equal.sym(Bool, B3.big(1n+p, n), True{}, eb) :
