def tree1.d3(x, c, cb, nch, last, rf):
  tree1.d3.h(x, c, cb, nch, last, rf, wits(2n, x))

law chunk.eq0:
  for -x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +e: {U32.is_eq((c + 1 : U32), nch) == False{} : Bool}
  {B3.chunk(x, c, cb, nch, last, 0) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), ((cb + c : U32) + 0 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}

def chunk.eq0(x, c, cb, nch, last, e):
  %Equal.sym(Bool, U32.is_eq((c + 1 : U32), nch), False{}, e) :
    {chunk.b(x, c, cb, last, 0, _) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), ((cb + c : U32) + 0 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
  %Equal.sym(B3.CV, chunk.b(x, c, cb, last, 0, False{}), B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), (cb + c : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)), chunk.full(x, c, cb, last, 0)) :
    {_ == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), ((cb + c : U32) + 0 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
  %Equal.sym(U32, (cb + c : U32), ((cb + c : U32) + 0 : U32), Equal.sym(U32, ((cb + c : U32) + 0 : U32), (cb + c : U32), A.u.add_zero_r((cb + c : U32)))) :
    {B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), _, B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, (c << 8n : U32)), (c << 8n : U32), B3.IV(), ((cb + c : U32) + 0 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
  {==}

law chunk.eq1:
  for -x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +e: {U32.is_eq(((c + 1 : U32) + 1 : U32), nch) == False{} : Bool}
  {B3.chunk(x, (c + 1 : U32), cb, nch, last, 0) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 256 : U32)), ((c << 8n : U32) + 256 : U32), B3.IV(), ((cb + c : U32) + 1 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}

def chunk.eq1(x, c, cb, nch, last, e):
  %Equal.sym(Bool, U32.is_eq(((c + 1 : U32) + 1 : U32), nch), False{}, e) :
    {chunk.b(x, (c + 1 : U32), cb, last, 0, _) == B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c << 8n : U32) + 256 : U32)), ((c << 8n : U32) + 256 : U32), B3.IV(), ((cb + c : U32) + 1 : U32), B3.CHUNK_START(), B3.CHUNK_END(), 64)) : B3.CV}
  %Equal.sym(B3.CV, chunk.b(x, (c + 1 : U32), cb, last, 0, False{}), B3.chunk.fin(B3.chunk.go(15n, B3.ld(x, ((c + 1 : U32) << 8n : U32)), ((c + 1 : U32) << 8n : U32), B3.IV(), (cb + (c + 1 : U32) : U32), B3.CHUNK_START(), (B3.CHUNK_END() .|. 0 : U32), 64)), chunk.full(x, (c + 1 : U32), cb, last, 0)) :
