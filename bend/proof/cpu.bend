                    {B3.parent(B3.tree1(~Laws.share, 4n, True{}, _, c, 16, cb, nch, last, 0), B3.tree1(~Laws.share, 4n, True{}, _, (c + 16 : U32), 16, cb, nch, last, 0), rf) == B3.parent(B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), c, 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 8 : U32), 8, cb, nch, last, 0), 0), B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 16 : U32), 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), ((c + 16 : U32) + 8 : U32), 8, cb, nch, last, 0), 0), rf) : B3.CV}
