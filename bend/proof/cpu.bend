                                                                                  _ = r10b
                                                                                  %Equal.sym(B3.CV, B3.leaf32(x, c, (cb + c : U32), rf), B3.parent(B3.parent(B3.leaf8(x, c, (cb + c : U32), 0), B3.leaf8(x, (c + 8 : U32), ((cb + c : U32) + 8 : U32), 0), 0), B3.parent(B3.leaf8(x, (c + 16 : U32), ((cb + c : U32) + 16 : U32), 0), B3.leaf8(x, (c + 24 : U32), ((cb + c : U32) + 24 : U32), 0), 0), rf), tr(arr => {B3.leaf32(arr, c, (cb + c : U32), rf) == B3.parent(B3.parent(B3.leaf8(arr, c, (cb + c : U32), 0), B3.leaf8(arr, (c + 8 : U32), ((cb + c : U32) + 8 : U32), 0), 0), B3.parent(B3.leaf8(arr, (c + 16 : U32), ((cb + c : U32) + 16 : U32), 0), B3.leaf8(arr, (c + 24 : U32), ((cb + c : U32) + 24 : U32), 0), 0), rf) : B3.CV}, xs, x, exs0, leaf32.split(xs, c, (cb + c : U32), rf))) :
                                                                                    {_ == B3.tree1(~Laws.share, 5n, True{}, (x, x), c, 32, cb, nch, last, rf) : B3.CV}
                                                                                  %Equal.sym(B3.CV, B3.tree1(~Laws.share, 5n, True{}, (x, x), c, 32, cb, nch, last, rf), B3.parent(B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), c, 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 8 : U32), 8, cb, nch, last, 0), 0), B3.parent(B3.tree1(~Laws.share, 3n, True{}, (x, x), (c + 16 : U32), 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (x, x), ((c + 16 : U32) + 8 : U32), 8, cb, nch, last, 0), 0), rf), tr(arr => {B3.tree1(~Laws.share, 5n, True{}, (arr, arr), c, 32, cb, nch, last, rf) == B3.parent(B3.parent(B3.tree1(~Laws.share, 3n, True{}, (arr, arr), c, 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (arr, arr), (c + 8 : U32), 8, cb, nch, last, 0), 0), B3.parent(B3.tree1(~Laws.share, 3n, True{}, (arr, arr), (c + 16 : U32), 8, cb, nch, last, 0), B3.tree1(~Laws.share, 3n, True{}, (arr, arr), ((c + 16 : U32) + 8 : U32), 8, cb, nch, last, 0), 0), rf) : B3.CV}, xt, x, ext0, tree1.d5(xt, c, cb, nch, last, rf))) :
                                                                                    {B3.parent(B3.parent(B3.leaf8(x, c, (cb + c : U32), 0), B3.leaf8(x, (c + 8 : U32), ((cb + c : U32) + 8 : U32), 0), 0), B3.parent(B3.leaf8(x, (c + 16 : U32), ((cb + c : U32) + 16 : U32), 0), B3.leaf8(x, (c + 24 : U32), ((cb + c : U32) + 24 : U32), 0), 0), rf) == _ : B3.CV}
