# A level's copies, and one level per block left.
def Bun(-a: Array<U32>, p: Nat) -> Type:
  match p:
    case 0n:
      Unit
    case 1n+q:
      Wits(a, 11n) & Bun(a, q)

def BunS(-a: Array<U32>, p: Nat) -> Type:
  Exists(Array<U32>, s => {s == a : Array<U32>} & Bun(a, p))

def bun.add2(-a: Array<U32>, +q: Nat, -s: Array<U32>, +es: {s == a : Array<U32>}, w: Wits(s, 12n), rest: Bun(a, q)) -> BunS(a, 1n+q):
  match w:
    case (s2, w2):
      match w2:
        case (es2, lvl):
          (s2, (eq.trans(s2, s, a, es2, es), (tr(c => Wits(c, 11n), s, a, es, lvl), rest)))

def bun.add(-a: Array<U32>, +q: Nat, r: BunS(a, q)) -> BunS(a, 1n+q):
  match r:
    case (s, r2):
      match r2:
        case (es, rest):
          bun.add2(a, q, s, es, wits(11n, s), rest)

law bun:
  for +p: Nat
  for a: Array<U32>
  BunS(a, p)

def bun(p, a):
  match p:
    case 0n:
      (a, ({==}, Unit{}))
    case 1n+q:
      bun.add(a, q, bun(q, a))

# (w + 16) + k is (w + k) + 16.
law swap16:
  for +w: U32
  for +k: U32
  {((w + 16 : U32) + k : U32) == ((w + k : U32) + 16 : U32) : U32}

def swap16(w, k):
