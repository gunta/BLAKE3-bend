# A full 32-chunk node: the CPU's 32-chunk leaf is the scalar tree over its
# chunks, for every array and every span that holds it whole.
law leaf32.eq:
  for x: Array<U32>
  for +c: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), 32n), U32.to_nat(nch)) == True{} : Bool}
  for +ef: {B3.full((c + 32 : U32), nch, last) == True{} : Bool}
  {B3.leaf32(x, c, (cb + c : U32), rf) == B3.tree1(~Laws.share, 5n, True{}, (x, x), c, 32, cb, nch, last, rf) : B3.CV}

def leaf32.eq(x, c, cb, nch, last, rf, inv, ef):
  leaf32.eq.h(x, c, cb, nch, last, rf, inv, ef, wits(9n, x))

# At depth 0 both trees hash the one chunk, whatever kind tree8 was handed.
law t8.zero:
  for +ku: U32
  for d: B3.Node
  for -a1: Array<U32>
  for -a2: Array<U32>
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  {B3.tree8(~Laws.share, 0n, ku, d, (a1, a2), c, n, cb, nch, last, rf) == B3.tree1(~Laws.share, 0n, False{}, (a1, a2), c, n, cb, nch, last, rf) : B3.CV}

def t8.zero(ku, d, a1, a2, c, n, cb, nch, last, rf):
  match d:
    case B3.Down{}:
      {==}
    case B3.Split{}:
      {==}
    case B3.Leaf8{}:
      {==}
    case B3.Leaf32{}:
      {==}

def pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

# The right child of a split keeps c + n <= nch.
law inv.split:
  for +c: U32
  for +n: U32
  for +h: U32
  for +nch: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for +lt: {Nat.is_lt(U32.to_nat(h), U32.to_nat(n)) == True{} : Bool}
  {Nat.is_le(Nat.add(U32.to_nat((c + h : U32)), U32.to_nat((n - h : U32))), U32.to_nat(nch)) == True{} : Bool}

def inv.split(c, n, h, nch, inv, lt):
  +C = U32.to_nat(c)
  +N = U32.to_nat(n)
  +H = U32.to_nat(h)
  +le_h = A.n.lt_to_le(H, N, lt)
  +inv_l = A.n.le_trans(Nat.add(C, H), Nat.add(C, N), U32.to_nat(nch), A.n.add_le(C, H, N, le_h), inv)
  %Equal.sym(Nat, U32.to_nat((c + h : U32)), Nat.add(C, H), A.u.tn_add(c, h, nch, inv_l)) : {Nat.is_le(Nat.add(_, U32.to_nat((n - h : U32))), U32.to_nat(nch)) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat((n - h : U32)), Nat.sub(N, H), A.u.tn_sub(n, h, le_h)) : {Nat.is_le(Nat.add(Nat.add(C, H), _), U32.to_nat(nch)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(Nat.add(C, H), Nat.sub(N, H)), Nat.add(C, Nat.add(H, Nat.sub(N, H))), A.add_assoc(C, H, Nat.sub(N, H))) : {Nat.is_le(_, U32.to_nat(nch)) == True{} : Bool}
  %Equal.sym(Nat, Nat.add(H, Nat.sub(N, H)), N, A.n.add_sub(H, N, le_h)) : {Nat.is_le(Nat.add(C, _), U32.to_nat(nch)) == True{} : Bool}
  inv

# The left child keeps it too.
law inv.left:
  for +c: U32
  for +n: U32
  for +h: U32
  for +nch: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for +lt: {Nat.is_lt(U32.to_nat(h), U32.to_nat(n)) == True{} : Bool}
  {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(h)), U32.to_nat(nch)) == True{} : Bool}

def inv.left(c, n, h, nch, inv, lt):
  A.n.le_trans(Nat.add(U32.to_nat(c), U32.to_nat(h)), Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch), A.n.add_le(U32.to_nat(c), U32.to_nat(h), U32.to_nat(n), A.n.lt_to_le(U32.to_nat(h), U32.to_nat(n), lt)), inv)

# The node's depth, from its U32 copy: 1 + p is ku's value.
law k.val:
  for +p: Nat
  for +ku: U32
  for +j: U32
  for +eku: {ku == U32.from_nat(1n+p) : U32}
  for +ek: {Nat.is_le(1n+p, 32n) == True{} : Bool}
  for +ej: {ku == j : U32}
  {1n+p == U32.to_nat(j) : Nat}

def k.val(p, ku, j, eku, ek, ej):
  Equal.trans(Nat, 1n+p, U32.to_nat(ku), U32.to_nat(j),
    Equal.trans(Nat, 1n+p, U32.to_nat(U32.from_nat(1n+p)), U32.to_nat(ku), Equal.sym(Nat, U32.to_nat(U32.from_nat(1n+p)), 1n+p, A.u.tn_fn(1n+p, 32, ek)),
      Equal.cong(U32, Nat, z => U32.to_nat(z), U32.from_nat(1n+p), ku, Equal.sym(U32, ku, U32.from_nat(1n+p), eku))),
    Equal.cong(U32, Nat, z => U32.to_nat(z), ku, j, ej))

# The CPU tree is the scalar tree, node for node: tree8's kind (computed
# from ku, a U32 copy of the depth) takes tree1's split exactly where tree1
# does, and its 8- and 32-chunk leaves are the scalar subtrees (leaf8.eq,
# leaf32.eq). Each node holds a clone of x and two live copies of it (pk).
law cpu.tree:
  for +k: Nat
  for -x: Array<U32>
  for pk: CloneW(x)
  for +ku: U32
  for +eku: {ku == U32.from_nat(k) : U32}
  for +ek: {Nat.is_le(k, 32n) == True{} : Bool}
  for +c: U32
  for +n: U32
  for +cb: U32
  for +nch: U32
  for +last: U32
  for +rf: U32
  for +inv: {Nat.is_le(Nat.add(U32.to_nat(c), U32.to_nat(n)), U32.to_nat(nch)) == True{} : Bool}
  for b: Bool
  for +eb: {B3.big(k, n) == b : Bool}
  for f: Bool
  for +ef: {(U32.is_eq(n, U32.shln(1, U32.to_nat(ku))) && B3.full((c + n : U32), nch, last)) == f : Bool}
  for e5: Bool
  for +ee5: {U32.is_eq(ku, 5) == e5 : Bool}
  for e3: Bool
  for +ee3: {U32.is_eq(ku, 3) == e3 : Bool}
  {B3.tree8(~Laws.share, k, ku, B3.kind(ku, n, c, nch, last), Array.clone(U32, x), c, n, cb, nch, last, rf) ==
    B3.tree1(~Laws.share, k, B3.big(k, n), Array.clone(U32, x), c, n, cb, nch, last, rf) : B3.CV}

def cpu.tree(k, x, pk, ku, eku, ek, c, n, cb, nch, last, rf, inv, b, eb, f, ef, e5, ee5, e3, ee3):
  match k:
    case 0n:
      match pk:
        case (x1, pk2):
          match pk2:
            case (x2, pk3):
              match pk3:
                case (+e1, pk4):
                  match pk4:
                    case (+e2, ecl):
                      _ = x1
                      _ = x2
                      %Equal.sym(Array<U32> & Array<U32>, Array.clone(U32, x), (x, x), ecl) :
                        {B3.tree8(~Laws.share, 0n, ku, B3.kind(ku, n, c, nch, last), _, c, n, cb, nch, last, rf) == B3.tree1(~Laws.share, 0n, B3.big(0n, n), _, c, n, cb, nch, last, rf) : B3.CV}
                      t8.zero(ku, B3.kind(ku, n, c, nch, last), x, x, c, n, cb, nch, last, rf)
