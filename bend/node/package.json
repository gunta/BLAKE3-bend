{
  "name": "b3bend",
  "version": "1.8.7",
  "description": "BLAKE3 for Node, Bun and Deno, with big inputs hashed on every core by a Bend2 engine: a drop-in for @noble/hashes/blake3 and the blake3 package",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "build.mjs",
    "src/",
    "csrc/",
    "README.md"
  ],
  "scripts": {
    "install": "node build.mjs",
    "build": "node build.mjs",
    "test": "node test/test.mjs",
    "bench": "node bench.mjs"
  },
  "dependencies": {
    "node-api-headers": "^1.5.0"
  },
  "devDependencies": {
    "@napi-rs/blake-hash": "^1.4.0",
    "@noble/hashes": "^2.4.0",
    "hash-wasm": "^4.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "blake3",
    "hash",
    "bend",
    "native",
    "bun"
  ],
  "homepage": "https://gunta.github.io/BLAKE3-bend/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gunta/BLAKE3-bend.git",
    "directory": "bend/node"
  },
  "license": "CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception"
}
