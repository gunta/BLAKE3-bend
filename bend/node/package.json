{
  "name": "turboblake",
  "version": "1.8.8",
  "description": "BLAKE3 for Node, Bun, Deno and browsers, with big inputs hashed on every core by a Bend2 engine (or by Bend's own JavaScript): a drop-in for @noble/hashes/blake3 and the blake3 package",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./js/index.js",
      "worker": "./js/index.js",
      "workerd": "./js/index.js",
      "default": "./index.js"
    },
    "./js": {
      "types": "./index.d.ts",
      "default": "./js/index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "api.js",
    "js/",
    "prebuilt.mjs",
    "build.mjs",
    "src/",
    "csrc/",
    "README.md"
  ],
  "scripts": {
    "install": "node build.mjs --optional",
    "prepack": "node -e \"require('fs').cpSync('../lib/csrc','csrc',{recursive:true})\"",
    "build": "node build.mjs",
    "test": "node test/test.mjs",
    "bench": "node bench.mjs"
  },
  "dependencies": {
    "node-api-headers": "^1.5.0"
  },
  "optionalDependencies": {
    "@turboblake/darwin-arm64": "1.8.8",
    "@turboblake/darwin-x64": "1.8.8",
    "@turboblake/linux-x64-gnu": "1.8.8",
    "@turboblake/linux-arm64-gnu": "1.8.8"
  },
  "devDependencies": {
    "@napi-rs/blake-hash": "^1.4.0",
    "@noble/hashes": "^2.4.0",
    "hash-wasm": "^4.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "blake3",
    "hash",
    "bend",
    "native",
    "bun"
  ],
  "homepage": "https://gunta.github.io/turboblake/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gunta/turboblake.git",
    "directory": "bend/node"
  },
  "license": "CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception",
  "browser": "./js/index.js"
}
